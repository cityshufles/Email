@using Microsoft.AspNetCore.Components.Forms

<div class="d-flex align-items-center gap-1 mb-2 flex-wrap">
    <InputDate @bind-Value="SelectedDate" class="form-control form-control-sm" style="max-width: 150px; font-size: 0.875rem;" />
    <button class="btn btn-sm btn-outline-primary" style="font-size: 0.8rem; padding: 0.25rem 0.5rem;" @onclick="OnApplyClicked">
        <i class="bi bi-search me-1"></i> Apply
    </button>
    <button class="btn btn-sm btn-outline-secondary" style="font-size: 0.8rem; padding: 0.25rem 0.5rem;" @onclick="OnTodayClicked">
        Today
    </button>
    <button class="btn btn-sm btn-outline-secondary" style="font-size: 0.8rem; padding: 0.25rem 0.5rem;" @onclick="OnClearClicked">
        Clear
    </button>
</div>

@code {
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public EventCallback<DateTime?> SelectedDateChanged { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }

    private async Task OnApplyClicked()
    {
        await SelectedDateChanged.InvokeAsync(SelectedDate);
        await OnApply.InvokeAsync();
    }

    private async Task OnTodayClicked()
    {
        SelectedDate = DateTime.Today;
        await SelectedDateChanged.InvokeAsync(SelectedDate);
        await OnApply.InvokeAsync();
    }

    private async Task OnClearClicked()
    {
        SelectedDate = null;
        await SelectedDateChanged.InvokeAsync(SelectedDate);
        await OnApply.InvokeAsync();
    }
}



