@using Email.Models
@using Email.Services
@using Email.Services.GmailProcessing.Normalization
@using Email.Services.GmailProcessing.Extraction
@using System.Globalization
@using Email.Components.Mobile

@inject ITourTreeService TourTreeService
@inject IToursApiService ToursApiService
@inject ITourCatalogService TourCatalogService
@inject IVendorsApiService VendorsApi
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<div class="mobile-edit-booking h-100 d-flex flex-column">
    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading booking details...</p>
        </div>
    }
    else if (booking == null)
    {
        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-center p-4">
            <i class="bi bi-exclamation-circle text-warning display-1 mb-3"></i>
            <h5>Booking Not Found</h5>
            <p class="text-muted">Could not retrieve details for this booking.</p>
            <button class="btn btn-primary" @onclick="OnCancelCallback">Close</button>
        </div>
    }
    else
    {
        <div class="flex-grow-1 overflow-auto p-3">
            @* Matches TourTreeDisplay.razor ' Edit Dialog' fields exactly (stacked for mobile) *@
            @* Left Column Equivalent *@
            
            <div class="mb-2">
                <label class="form-label fw-semibold">Customer Name</label>
                <input type="text" class="form-control" @bind="booking.CustomerName" />
            </div>
            
            <div class="mb-2">
                <label class="form-label fw-semibold">Customer Email</label>
                <input type="email" class="form-control" @bind="booking.CustomerEmail" />
            </div>
            
            <div class="mb-2">
                <label class="form-label fw-semibold">Customer Phone</label>
                <input type="tel" class="form-control" @bind="booking.CustomerPhone" />
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Number of Attendees</label>
                <input type="number" class="form-control" @bind="booking.NumberOfAttendees" />
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Number of Adults</label>
                <input type="number" class="form-control" @bind="booking.NumberOfAdults" />
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Number of Children</label>
                <input type="number" class="form-control" @bind="booking.NumberOfChildren" />
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Special Requests</label>
                <textarea class="form-control" rows="4" @bind="booking.BookingAlterationNotes"></textarea>
            </div>

            <!-- Right Column Equivalent -->
            <h6 class="text-primary mt-4 mb-3 border-bottom pb-2">Tour Details</h6>

            <div class="mb-2">
                <label class="form-label fw-semibold">Tour Name</label>
                <select class="form-select"
                        value="@booking?.TourName"
                        @onchange="OnTourNameChanged">
                    @if (availableTourNames.Count == 0)
                    {
                        <option value="">No tours available</option>
                    }
                    else
                    {
                        @foreach (var tourName in availableTourNames)
                        {
                            <option value="@tourName">@tourName</option>
                        }
                    }
                </select>
                 @if (!string.IsNullOrEmpty(booking?.TourName))
                {
                    <small class="form-text text-muted">Current: @booking.TourName</small>
                }
            </div>
            
            <div class="mb-2">
                <label class="form-label fw-semibold">Tour Date</label>
                <input type="date" class="form-control" 
                       value="@(GetDateValue(booking.TourDate))"
                       @onchange="OnDateChanged" />
                <small class="text-muted">Must be today or later</small>
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Tour Time</label>
                <select class="form-select" @bind="booking.TourTime">
                    @if (availableTimes.Count == 0)
                    {
                        <option value="" disabled>No time options found</option>
                    }
                    else
                    {
                        @foreach (var t in availableTimes)
                        {
                            <option value="@t">@t</option>
                        }
                    }
                </select>
                 @if (!string.IsNullOrEmpty(booking?.TourTime))
                {
                    <small class="form-text text-muted">Current: @booking.TourTime</small>
                }
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Tour Location</label>
                <input type="text" class="form-control" @bind="booking.TourLocation" />
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Vendor Name</label>
                <select class="form-select"
                        value="@booking?.VendorName"
                        @onchange="OnVendorChanged"
                        disabled="@IsWalkUpVendor()">
                    @if (availableVendorNames.Count == 0)
                    {
                        <option value="@booking?.VendorName">@booking?.VendorName</option>
                    }
                    else
                    {
                        @foreach (var vendorName in availableVendorNames)
                        {
                            <option value="@vendorName">@vendorName</option>
                        }
                    }
                </select>
                @if (IsWalkUpVendor())
                {
                    <small class="text-muted">Walk-Up vendor is locked.</small>
                }
            </div>
            
            <div class="mb-2">
                <label class="form-label fw-semibold">Email Type</label>
                <select class="form-select" @bind="booking.EmailType">
                    <option value="booking">Booking</option>
                    <option value="modification">Modification</option>
                    <option value="cancellation">Cancellation</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label fw-semibold">Language</label>
                <input type="text" class="form-control" @bind="booking.Language" />
            </div>

             <div class="mb-2">
                <label class="form-label fw-semibold">Booking Code</label>
                <input type="text" class="form-control" @bind="booking.BookingCode" readonly disabled />
            </div>
        </div>

        <div class="p-3 border-top mt-auto">
            <div class="d-grid gap-2">
                <button class="btn btn-warning btn-lg" @onclick="SaveAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-save me-2"></i><span>Save Changes</span>
                    }
                </button>
                 <button class="btn btn-outline-secondary" @onclick="OnCancelCallback" disabled="@isSaving">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? MessageId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ProcessedEmail? booking;
    private bool isLoading = true;
    private bool isSaving = false;
    
    // Catalog Data
    private TourCatalogSnapshot? catalog;
    private List<string> availableTourNames = new();
    private List<string> availableTimes = new();
    private List<string> availableVendorNames = new();

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(MessageId)) return;

        // Reset if ID changes
        if (booking?.MessageId != MessageId)
        {
            isLoading = true;
            booking = null;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            // 1. Ensure Catalog
            if (catalog == null)
            {
                catalog = await TourCatalogService.BuildCatalogAsync();
                availableTourNames = catalog.Entries
                    .Select(x => x.CanonicalName)
                    .Distinct()
                    .OrderBy(x => x)
                    .ToList();
            }

            // 2. Ensure vendor options
            if (availableVendorNames.Count == 0)
            {
                var vendors = await VendorsApi.GetVendorsAsync();
                availableVendorNames = vendors
                    .Where(v => v.IsActive && !string.IsNullOrWhiteSpace(v.VendorName))
                    .Select(v => v.VendorName.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(v => v)
                    .ToList();
            }

            // 3. Fetch Booking
            if (!string.IsNullOrWhiteSpace(MessageId))
            {
                booking = await TourTreeService.GetProcessedEmailByMessageIdAsync(MessageId);
                
                if (booking != null)
                {
                    // Update times based on loaded tour name
                    UpdateTimesForTour(booking.TourName);
                    IncludeCurrentVendorOption(booking.VendorName);
                }
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", "Failed to load booking details");
            Console.WriteLine($"Error loading booking: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateTimesForTour(string? tourName)
    {
        availableTimes.Clear();
        if (string.IsNullOrWhiteSpace(tourName) || catalog == null) return;

        var norm = TourCatalogService.NormalizeName(tourName);
        // Find matching entries
        var times = catalog.Entries
            .Where(e => TourCatalogService.NormalizeName(e.CanonicalName) == norm)
            .SelectMany(e => e.Times)
            .Distinct()
            .OrderBy(t => t)
            .ToList();
            
        availableTimes = times;
    }

    private void OnTourNameChanged(ChangeEventArgs e)
    {
        if (booking == null) return;
        
        booking.TourName = TourCatalogService.NormalizeName(e.Value?.ToString() ?? string.Empty);
        UpdateTimesForTour(booking.TourName);
        
        // Auto-select time if only one exists and current is unset or invalid
        if (availableTimes.Count == 1)
        {
            var valid = !string.IsNullOrWhiteSpace(booking.TourTime) && availableTimes.Contains(booking.TourTime);
            if (!valid)
            {
                booking.TourTime = availableTimes[0];
            }
        }
        else if (availableTimes.Count > 0 && !string.IsNullOrWhiteSpace(booking.TourTime) && !availableTimes.Contains(booking.TourTime))
        {
             booking.TourTime = availableTimes[0];
        }
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (booking == null) return;
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            booking.TourDate = dt;
        }
    }

    private bool IsWalkUpVendor()
    {
        return string.Equals(booking?.VendorName?.Trim(), "Walk-Up", StringComparison.OrdinalIgnoreCase);
    }

    private void IncludeCurrentVendorOption(string? vendorName)
    {
        if (string.IsNullOrWhiteSpace(vendorName))
        {
            return;
        }

        var trimmed = vendorName.Trim();
        if (availableVendorNames.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        availableVendorNames.Add(trimmed);
        availableVendorNames = availableVendorNames
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();
    }

    private void OnVendorChanged(ChangeEventArgs e)
    {
        if (booking == null || IsWalkUpVendor())
        {
            return;
        }

        booking.VendorName = e.Value?.ToString()?.Trim() ?? string.Empty;
    }

    private string GetDateValue(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    private async Task SaveAsync()
    {
        if (booking == null) return;
        isSaving = true;

        try
        {
            // Basic normalization
            booking.TourName = TourCatalogService.NormalizeName(booking.TourName ?? "");
            booking.NumberOfAttendees = (booking.NumberOfAdults ?? 0) + (booking.NumberOfChildren ?? 0);

            // Use UpdateProcessedEmailAndBookingAsync from ITourTreeService
            var success = await TourTreeService.UpdateProcessedEmailAndBookingAsync(booking);
            if (success)
            {
                await ToastService.ShowSuccessAsync("Saved", "Booking updated successfully");
                await OnSaved.InvokeAsync();
            }
            else
            {
                await ToastService.ShowErrorAsync("Save Failed", "Could not update booking in database.");
            }
        }
        catch (Exception ex)
        {
             await ToastService.ShowErrorAsync("Error", $"Save failed: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OnCancelCallback()
    {
        await OnCancel.InvokeAsync();
    }
}
