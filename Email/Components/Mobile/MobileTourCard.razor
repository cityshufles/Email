    private async Task ToggleContactStateAsync(MobileWalkerInfoModel walker, string channel)
    {
        if (walker == null) return;
        if (string.IsNullOrWhiteSpace(walker.MessageId) || string.IsNullOrWhiteSpace(walker.BookingCode)) return;

        var normalizedChannel = NormalizeContactChannel(channel);
        if (normalizedChannel == null) return;

        var busyKey = BuildContactStateBusyKey(walker, normalizedChannel);
        if (!contactStateBusyKeys.Add(busyKey))
        {
            return;
        }

        try
        {
            ContactChannelStateResult? result;
            if (normalizedChannel == ContactChannelPlatform)
            {
                var nextState = walker.PlatformContactState == 1 ? (byte)0 : (byte)1;
                result = await TourEmailsApiService.SetBookingContactChannelStateAsync(
                    walker.MessageId,
                    walker.BookingCode,
                    normalizedChannel,
                    nextState,
                    source: "mobile-dashboard");
            }
            else
            {
                result = await TourEmailsApiService.CycleBookingContactChannelStateAsync(
                    walker.MessageId,
                    walker.BookingCode,
                    normalizedChannel,
                    source: "mobile-dashboard");
            }

            if (result != null)
            {
                ApplyContactState(walker, normalizedChannel, result.ContactState);
                StateHasChanged();
            }
        }
        catch
        {
            // Keep UI non-blocking for quick interactions.
        }
        finally
        {
            contactStateBusyKeys.Remove(busyKey);
        }
    }

    private async Task MarkContactStateQuickSendAsync(MobileWalkerInfoModel walker, string channel)
    {
        if (walker == null) return;
        if (string.IsNullOrWhiteSpace(walker.MessageId) || string.IsNullOrWhiteSpace(walker.BookingCode)) return;

        var normalizedChannel = NormalizeContactChannel(channel);
        if (normalizedChannel == null) return;

        try
        {
            var result = await TourEmailsApiService.MarkBookingContactChannelQuickSendAsync(
                walker.MessageId,
                walker.BookingCode,
                normalizedChannel,
                source: "mobile-dashboard");

            if (result != null)
            {
                ApplyContactState(walker, normalizedChannel, result.ContactState);
                StateHasChanged();
            }
        }
        catch
        {
            // silent; quick actions should not block
        }
    }

    private bool IsContactStateBusy(MobileWalkerInfoModel walker, string channel)
    {
        var normalizedChannel = NormalizeContactChannel(channel);
        if (normalizedChannel == null || walker == null) return false;
        return contactStateBusyKeys.Contains(BuildContactStateBusyKey(walker, normalizedChannel));
    }

    private static string BuildContactStateBusyKey(MobileWalkerInfoModel walker, string channel)
    {
        return $"{walker.MessageId?.Trim()}||{walker.BookingCode?.Trim()}||{channel}";
    }

    private void ToggleBlankQuickSendMode()
    {
        blankQuickSendMode = !blankQuickSendMode;
