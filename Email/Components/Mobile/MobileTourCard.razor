    private string BuildTemplateMessage(MobileWalkerInfoModel walker)
    {
        if (walker == null || string.IsNullOrWhiteSpace(SelectedMessageId) || SelectedMessageId == "none")
        {
            return string.Empty;
        }

        var template = MessageTemplates?.FirstOrDefault(t => t.Id == SelectedMessageId);
        if (template == null)
        {
            return string.Empty;
        }

        DbGuide? guide = null;
        if (GuideId.HasValue && DbGuides != null)
        {
            guide = DbGuides.FirstOrDefault(g => g.Id == GuideId.Value);
        }

        var tourName = !string.IsNullOrWhiteSpace(walker.TourName) ? walker.TourName : Card.TourName;
        var vendorName = !string.IsNullOrWhiteSpace(walker.VendorName)
            ? walker.VendorName
            : Card.Vendors.FirstOrDefault()?.VendorName;
        var stageHint = !string.IsNullOrWhiteSpace(template.Type) ? template.Type : template.Name;

        var resolvedLinks = VendorLinkResolver.Resolve(
            null,
            tourName,
            vendorName,
            stageHint,
            template.VendorLink,
            null,
            null,
            AvailableTourLinks,
            AvailableVendors,
            AvailableTours,
            ActiveVendorAssignments);

        var resolvedGalleryLink = ResolveEffectiveGalleryLink(walker);
        return TemplateService.PopulateMessageTemplate(template, walker, guide, resolvedLinks.AllToursLink, resolvedLinks, resolvedGalleryLink);
    }

    private string ResolveQuickSendMessage(MobileWalkerInfoModel walker)
    {
        return blankQuickSendMode ? string.Empty : BuildTemplateMessage(walker);
    }

    // 2025-12-18 - WhatsApp URL text needs LF line breaks; normalize to avoid single-line messages on WhatsApp Web
    private static string NormalizeLineBreaksForUrl(string? text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Replace("\r\n", "\n").Replace("\r", "\n");
    }

