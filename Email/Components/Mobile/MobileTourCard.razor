@code {
    [Parameter] public MobileTourCardModel Card { get; set; } = new();
    [Parameter] public EventCallback<MobileTourCardModel> OnCopyWalkers { get; set; }
    [Parameter] public EventCallback<MobileTourCardModel> OnDownloadVcards { get; set; }
    [Parameter] public EventCallback<MobileWalkerInfoModel> OnEditWalker { get; set; }
    [Parameter] public EventCallback<MobileWalkerInfoModel> OnDownloadVcard { get; set; }
    [Parameter] public EventCallback<MobileWalkerInfoModel> OnReportDataIssue { get; set; }
    [Parameter] public EventCallback<MobileTourCardModel> OnBulkSendToGuide { get; set; }
    [Parameter] public EventCallback<BookingPrefillRequest> OnAddBookingFromTour { get; set; }
    [Parameter] public List<InMemoryMessageTemplate>? MessageTemplates { get; set; }
    // Guide data for template replacements
    [Parameter] public List<DbGuide>? DbGuides { get; set; }
    [Parameter] public IReadOnlyList<DbTour>? AvailableTours { get; set; }
    [Parameter] public IReadOnlyList<TourLink>? AvailableTourLinks { get; set; }
    [Parameter] public IReadOnlyList<DbVendor>? AvailableVendors { get; set; }
    [Parameter] public IReadOnlyDictionary<string, HashSet<string>>? ActiveVendorAssignments { get; set; }
    [Parameter] public int? GuideId { get; set; }

    [Parameter] public bool ShowDate { get; set; } = true;
    // 2025-12-18 00:00 UTC - DB-powered message selection
    [Parameter] public string SelectedMessageId { get; set; } = "";
    [Parameter] public EventCallback<string> OnMessageSelected { get; set; }
    [Parameter] public EventCallback<int?> OnGuideSelected { get; set; }

    private string DisplayTourName => string.IsNullOrWhiteSpace(Card.TourNameDisplay) ? Card.TourName : Card.TourNameDisplay;
    private bool HasSubmittedGuideReport => Card?.EnumerateAllWalkers().Any(w => w.HasSubmittedGuideReport) == true;
    private bool IsGuideReportPastDue => IsGuideReportPastDueForTour(Card?.DateLabel, Card?.TourName);
    private bool HasGuideGalleryInDb => Card?.EnumerateAllWalkers().Any(w => w.HasGuideGalleryInDb) == true;
    private string TourGalleryUrl => BuildTourGalleryUrl();
    private string GuideReportUrl => BuildGuideReportUrl(Card?.DateLabel, Card?.TourName);
    private static readonly TimeZoneInfo EasternTimeZone = ResolveEasternTimeZone();

    private bool expanded = false;
    private bool showSheet = false;
    private bool showConnectCopyDialog = false;
    private string connectCopyDialogContent = string.Empty;
    private string connectCopyDialogTitle = string.Empty;
    private ElementReference connectCopyTextAreaRef;
    private bool pendingConnectCopyTextSelect = false;
    private bool blankQuickSendMode = false;
    private readonly HashSet<string> contactStateBusyKeys = new(StringComparer.OrdinalIgnoreCase);
    private const string ContactChannelSms = "sms";
    private const string ContactChannelWa = "wa";
    private const string ContactChannelPlatform = "platform";
    private const string ContactChannelSmsLabel = "SMS";
    private const string ContactChannelWaLabel = "WA";
    // 2025-12-18 - Toggle commented out: Red button always uses web (safe), purple button is for app deep links
    // private bool useWhatsAppAppQuickSend = true;

    private async Task InvokeBulkSend()
    {
        if (OnBulkSendToGuide.HasDelegate)
        {
            await OnBulkSendToGuide.InvokeAsync(Card);
        }
    }

    private string BuildTourGalleryUrl()
    {
        var publicId = Card?.EnumerateAllWalkers()
            .Select(w => w.GuideReportPublicId)
            .FirstOrDefault(id => !string.IsNullOrWhiteSpace(id));

        return BuildGalleryUrlFromPublicId(publicId);
    }

    private void OpenGuideReportForCard()
    {
        Navigation.NavigateTo(GuideReportUrl);
    }

    private async Task OpenAddBookingForTourAsync()
    {
        if (!OnAddBookingFromTour.HasDelegate)
        {
            return;
        }

        var parsedDate = ParseDateFromLabel(Card?.DateLabel);
        var (tourName, tourTime) = SplitTourNameAndTimeForRoute(Card?.TourName);
        var effectiveTourName = !string.IsNullOrWhiteSpace(tourName)
            ? tourName
            : (Card?.TourName ?? string.Empty).Trim();

        await OnAddBookingFromTour.InvokeAsync(new BookingPrefillRequest
        {
            TourName = effectiveTourName,
            TourDate = parsedDate,
            TourTime = string.IsNullOrWhiteSpace(tourTime) ? null : tourTime
        });
    }

    private string BuildGuideReportUrl(string? dateLabel, string? tourLabel)
    {
        var query = new List<string>();
        var parsedDate = ParseDateFromLabel(dateLabel);
        if (parsedDate.HasValue)
        {
            query.Add($"date={Uri.EscapeDataString(parsedDate.Value.ToString("yyyy-MM-dd"))}");
        }

        var (tourName, tourTime) = SplitTourNameAndTimeForRoute(tourLabel);
        var effectiveTourName = !string.IsNullOrWhiteSpace(tourName) ? tourName : (tourLabel ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(effectiveTourName))
        {
            query.Add($"tourName={Uri.EscapeDataString(effectiveTourName)}");
        }

        if (!string.IsNullOrWhiteSpace(tourTime))
        {
            query.Add($"tourTime={Uri.EscapeDataString(tourTime)}");
        }

        return query.Count == 0 ? "/guide-report" : $"/guide-report?{string.Join("&", query)}";
    }

    private static DateTime? ParseDateFromLabel(string? label)
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            return null;
        }

        return DateTime.TryParse(label, out var parsedDate) ? parsedDate.Date : null;
    }

    private static bool IsGuideReportPastDueForTour(string? dateLabel, string? tourLabel)
    {
        var parsedDate = ParseDateFromLabel(dateLabel);
        if (!parsedDate.HasValue)
        {
            return false;
        }

        var (_, tourTime) = SplitTourNameAndTimeForRoute(tourLabel);
        var nowEastern = GetCurrentEasternTime();

        if (TryParseTourStartTime(tourTime, out var tourStartTime))
        {
            var scheduledTourStart = parsedDate.Value.Date.Add(tourStartTime);
            return scheduledTourStart <= nowEastern;
        }

        return parsedDate.Value.Date < nowEastern.Date;
    }

    private static bool TryParseTourStartTime(string? tourTime, out TimeSpan startTime)
    {
        startTime = default;
        if (string.IsNullOrWhiteSpace(tourTime))
        {
            return false;
        }

        var normalized = tourTime.Trim();
        var styles = DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.NoCurrentDateDefault;

        DateTime parsed;
        if (DateTime.TryParse(normalized, CultureInfo.InvariantCulture, styles, out parsed) ||
            DateTime.TryParse(normalized, CultureInfo.CurrentCulture, styles, out parsed))
        {
            startTime = parsed.TimeOfDay;
            return true;
        }

        return false;
    }

    private static DateTime GetCurrentEasternTime()
    {
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, EasternTimeZone);
    }

    private static TimeZoneInfo ResolveEasternTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
        }
        catch (TimeZoneNotFoundException)
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
            }
            catch
            {
                return TimeZoneInfo.Utc;
            }
        }
        catch (InvalidTimeZoneException)
        {
            return TimeZoneInfo.Utc;
        }
    }

    private static (string name, string time) SplitTourNameAndTimeForRoute(string? label)
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            return (string.Empty, string.Empty);
        }

        var normalizedLabel = label.Trim();
        var separators = new[] { " \u2014 ", " \u2013 ", " - ", " \u00E2\u20AC\u201D ", " \u00E2\u20AC\u201C " };
        foreach (var separator in separators)
        {
            var separatorIndex = normalizedLabel.LastIndexOf(separator, StringComparison.Ordinal);
            if (separatorIndex <= 0)
            {
                continue;
            }

            var candidateName = normalizedLabel[..separatorIndex].Trim();
            var candidateTime = normalizedLabel[(separatorIndex + separator.Length)..].Trim();
            if (!string.IsNullOrWhiteSpace(candidateName) && LooksLikeTourTime(candidateTime))
            {
                return (candidateName, candidateTime);
            }
        }

        return (normalizedLabel, string.Empty);
    }

    private static bool LooksLikeTourTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = value.Trim();
        if (!normalized.Any(char.IsDigit))
        {
            return false;
        }

        return normalized.Contains(':') ||
               normalized.IndexOf("am", StringComparison.OrdinalIgnoreCase) >= 0 ||
               normalized.IndexOf("pm", StringComparison.OrdinalIgnoreCase) >= 0;
    }

    private string ResolveEffectiveGalleryLink(MobileWalkerInfoModel? walker)
    {
        var walkerPublicId = walker?.GuideReportPublicId;
        if (!string.IsNullOrWhiteSpace(walkerPublicId))
        {
            return BuildGalleryUrlFromPublicId(walkerPublicId);
        }

        if (!string.IsNullOrWhiteSpace(TourGalleryUrl))
        {
            return TourGalleryUrl;
        }

        return string.Empty;
    }

    private string BuildGalleryUrlFromPublicId(string? publicId)
    {
        if (string.IsNullOrWhiteSpace(publicId))
        {
            return string.Empty;
        }

        var baseUrl = Configuration["PublicGallery:BaseUrl"] ?? "https://cityshufflesguides.com";
        return $"{baseUrl}/tour-gallery/{publicId.Trim()}.html";
    }

    private void ToggleExpanded()
    {
        expanded = !expanded;
    }

    private void OpenActionSheet()
    {
        showSheet = true;
    }

    private void CloseActionSheet()
    {
        showSheet = false;
    }

    // 2025-12-18 00:00 UTC - Handle dropdown selection change
    private async Task OnMessageSelectChange(ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? "";
        if (OnMessageSelected.HasDelegate)
        {
            await OnMessageSelected.InvokeAsync(newValue);
        }
    }

    private async Task OnGuideSelectChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        int? newId = null;
        if (!string.IsNullOrWhiteSpace(val) && val != "none" && int.TryParse(val, out var id))
        {
            newId = id;
        }

        if (OnGuideSelected.HasDelegate)
        {
            await OnGuideSelected.InvokeAsync(newId);
        }
    }


    private async Task CopyWalkers()
