    // 2025-12-18 - Red button ALWAYS uses web (https://wa.me/) to prevent closing the page. Never uses whatsapp:// deep links.
    // Purple button is for app deep links (iPad/iPhone variant).
    private string GetQuickWhatsAppUrl(MobileWalkerInfoModel walker)
    {
        if (walker == null || string.IsNullOrWhiteSpace(walker.Phone)) return "";

        var cleanPhone = new string(walker.Phone.Where(c => char.IsDigit(c)).ToArray());
        if (string.IsNullOrWhiteSpace(cleanPhone)) return "";

        var message = ResolveQuickSendMessage(walker);

        // Always use web - never whatsapp:// (which closes the page)
        return string.IsNullOrEmpty(message)
            ? $"https://wa.me/{cleanPhone}"
            : $"https://wa.me/{cleanPhone}?text={Uri.EscapeDataString(NormalizeLineBreaksForUrl(message))}";
    }

    // 2025-12-18 - iOS variant: whatsapp:// link with phone param INCLUDING leading '+', matching TestIosLinks.razor Section 1
    private string GetQuickWhatsAppUrlPlusPhone(MobileWalkerInfoModel walker)
    {
        if (walker == null || string.IsNullOrWhiteSpace(walker.Phone)) return "";

        var cleanPhone = new string(walker.Phone.Where(c => char.IsDigit(c)).ToArray());
        if (string.IsNullOrWhiteSpace(cleanPhone)) return "";

        var phoneWithPlus = "+" + cleanPhone;

        var message = ResolveQuickSendMessage(walker);

        return string.IsNullOrEmpty(message)
            ? $"whatsapp://send?phone={phoneWithPlus}"
            : $"whatsapp://send?phone={phoneWithPlus}&text={Uri.EscapeDataString(NormalizeLineBreaksForUrl(message))}";
    }

