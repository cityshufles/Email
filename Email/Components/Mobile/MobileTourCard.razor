    private static string BuildConnectPromptMessage(MobileWalkerInfoModel? walker)
    {
        var walkerName = "there";
        var rawName = walker?.DisplayName?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(rawName))
        {
            // Inline first-name parse for connect copy text.
            var firstToken = rawName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
            firstToken = firstToken.Trim('\"', '\'', ',', '.', ';', ':', '!', '?', '(', ')', '[', ']', '{', '}');
            if (!string.IsNullOrWhiteSpace(firstToken))
            {
                walkerName = firstToken;
            }
        }

        var dateText = FormatConnectPromptDate(walker?.DateLabel);
        return $"Hey {walkerName}, we'd like to connect you with your guide for {dateText}. Would you please text us? We're also on WhatsApp. Thank you :) (917) 938-1170";
    }

    private static string FormatConnectPromptDate(string? dateLabel)
    {
        if (DateTime.TryParse(dateLabel, out var date))
        {
            return date.ToString("M/d/yy");
        }

        return string.IsNullOrWhiteSpace(dateLabel) ? "your tour date" : dateLabel;
    }

