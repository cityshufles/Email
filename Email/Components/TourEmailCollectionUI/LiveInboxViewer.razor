@using Syncfusion.Blazor.Lists
@using Email.Models
@using Email.Services
@inject ITourEmailsService TourEmailsService

<div class="card live-inbox-root">
    <div class="card-header d-flex align-items-center gap-2">
        <button class="btn btn-outline-primary btn-sm" @onclick="RefreshAsync" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadMoreAsync" disabled="@isLoading || (items?.Count ?? 0) == 0">
            <i class="bi bi-chevron-down me-1"></i>
            Load More
        </button>
        <span class="ms-2 small text-muted">Total: @items?.Count</span>
    </div>
    <div class="card-body p-2">
        @if (isLoading && (items == null || items.Count == 0))
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" style="width: 2rem; height: 2rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (items?.Any() == true)
        {
            <!-- Debug info -->
            <div class="debug-info mb-3 p-2 border rounded">
                <small>
                    <strong>Debug:</strong> 
                    Total items: @items.Count | 
                    Processed: @items.Count(x => x.HasProcessedEmail) | 
                    Not Processed: @items.Count(x => !x.HasProcessedEmail) |
                    Group values: @string.Join(", ", items.Select(x => x.ProcessedGroupStatus).Distinct())
                </small>
            </div>
            
            <div class="live-inbox">
