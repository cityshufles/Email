        // 1. We must select the tour context first
        if (selectedTourId != canonicalTourId)
        {
            selectedTourId = canonicalTourId;
            await OnTourSelectionChangedAsync();
        }

        // 2. Now call EditSchedule
        s.TourId = canonicalTourId;
        if (selectedDbTour != null)
        {
            s.TourName = selectedDbTour.TourName;
        }
        EditSchedule(s);
    }
    
    // 2026-02-05: Create a NEW Override schedule based on an existing schedule
    // This does NOT edit the original - it creates a fresh schedule with Id=0
    private async Task CreateOverrideFromSchedule(DbTourSchedule source)
    {
        var canonicalTourId = NormalizeToCanonicalTourId(source.TourId);

        // 1. Set tour context
        if (selectedTourId != canonicalTourId)
        {
            selectedTourId = canonicalTourId;
            await OnTourSelectionChangedAsync();
        }
        
        // 2. Create a FRESH schedule (Id=0 means new, not edit)
        currentSchedule = new DbTourSchedule
        {
            Id = 0, // NEW schedule, not editing the source!
            TourId = canonicalTourId,
            ScheduleName = $"{source.TourName} Override",
            IsActive = true,
            IsOverride = true // This is the key - mark it as Override
        };
        scheduleNameInput = currentSchedule.ScheduleName; // Sync local var
        
        // 3. Pre-fill dates: default to today (manager will pick the actual override date)
        startDate = DateTime.Today;
        endDate = DateTime.Today;
        
        // 4. Copy time slots from source (user can modify)
        selectedTimes = ParseTimeSlots(source.TimeSlotsJson);
        
        // 5. Copy active days but CLEAR guide assignments (user will pick new guide)
        activeDays.Clear();
        foreach (var day in daysOfWeek) selectedGuides[day] = "";
        
        var srcDays = new Dictionary<string, string>();
        if (!string.IsNullOrWhiteSpace(source.DayAssignmentsJson))
        {
            try { srcDays = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(source.DayAssignmentsJson) ?? new(); } catch {}
        }
        foreach (var kvp in srcDays)
        {
            activeDays.Add(kvp.Key);
            // Intentionally NOT copying guide - user must pick newguide for override
        }
        
        // 6. Set Override checkbox
        isOverride = true;
        
        // 7. Switch to main tab
        activeTab = 0;
        
        Console.WriteLine($"[CreateOverride] Created new Override template from '{source.ScheduleName}' - User should now pick date and guide.");
    }
    
