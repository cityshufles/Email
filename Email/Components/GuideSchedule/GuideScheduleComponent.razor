    private async Task OnSaveSchedule()
    {
        // 1. Validation
        if (currentSchedule == null) return;
        if (selectedDbTour == null) return;

        currentSchedule.TourId = selectedDbTour.Id;
        
        // 2. Hydrate the schedule object from UI state
        currentSchedule.StartDate = startDate;
        currentSchedule.EndDate = endDate;
        // 2026-02-05: Preserve user-edited Schedule Name
        // Update from local input binding
        if (!string.IsNullOrWhiteSpace(scheduleNameInput))
        {
            currentSchedule.ScheduleName = scheduleNameInput;
        }
        else
        {
             // Default if empty
             currentSchedule.ScheduleName = selectedDbTour.TourName.EndsWith("Tour", StringComparison.OrdinalIgnoreCase) 
                ? $"{selectedDbTour.TourName} Schedule" 
                : $"{selectedDbTour.TourName} Tour Schedule";
        }
        
        // Serialize assignments and times slots
        // ONLY include days that are actually marked as 'Active'
        var activeGuideMap = selectedGuides
            .Where(kvp => activeDays.Contains(kvp.Key))
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
            
        currentSchedule.DayAssignmentsJson = System.Text.Json.JsonSerializer.Serialize(activeGuideMap);
        
        // NEW: Serialize List<TimeSlotModel>
        currentSchedule.TimeSlotsJson = System.Text.Json.JsonSerializer.Serialize(selectedTimes);
        
        // 2026-02-05: Set IsOverride from UI checkbox
        currentSchedule.IsOverride = isOverride;
        
        // 2026-02-05: Check for conflicts using detailed method
        var (hasStandardConflict, hasOverrideConflict, conflictNames) = await ToursApi.CheckScheduleConflictsDetailedAsync(currentSchedule);
        
        if (conflictNames.Count > 0)
        {
            if (isOverride)
            {
                // User is trying to create an Override schedule
                if (hasOverrideConflict)
                {
                    // Already an Override exists - block
                    await JSRuntime.InvokeVoidAsync("alert", $"An override already exists: '{string.Join(", ", conflictNames)}'.\n\nDelete the current override to create a new one.");
                    return;
                }
                else
                {
                    // Overriding a Standard schedule - confirm
                    var msg = $"This contradicts '{string.Join(", ", conflictNames)}'.\n\nOverride?";
                    bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", msg);
                    if (!confirm) return;
                }
            }
            else
            {
                // User is trying to create a Standard schedule
                // Block if there's already a Standard schedule for this slot
                if (hasStandardConflict)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"A standard schedule already exists: '{string.Join(", ", conflictNames)}'.\n\nDeactivate or delete the existing schedule first.");
                    return;
                }
                // If only Override conflict, allow (Standard + Override is fine)
            }
        }
        else
        {
            // 2026-02-05: No conflicts found (no overlaps)
            // If user checked 'Override' but there is nothing to override, warn them!
            if (isOverride)
            {
                 bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Warning: You are creating an 'Override' but no Standard schedule was found active for these dates.\n\nThis means you are creating an 'Orphan Override' - it will work, but you won't be able to override it later (since max 1 override is allowed).\n\nAre you sure you want to proceed?");
                 if (!confirm) return;
            }
        }

        // 3. Save to Backend
        try
        {
            Console.WriteLine("Saving schedule...");
            var id = await ToursApi.SaveTourScheduleAsync(currentSchedule);
            currentSchedule.Id = id; // Update ID if new
            
            Console.WriteLine($"Schedule Saved! ID: {id}");

            // Trigger generation of individual assignments based on this rule
            await ToursApi.GenerateAssignmentsFromScheduleAsync(currentSchedule);
            Console.WriteLine("Assignments generated successfully.");
            
            // Refresh list
            await LoadExistingSchedules();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving schedule: {ex.Message}");
        }
    }
    
