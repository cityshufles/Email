            if (!string.IsNullOrEmpty(kvp.Value)) // If guide assigned, or day marked active
            {
               activeDays.Add(kvp.Key);
               selectedGuides[kvp.Key] = kvp.Value;
            }
            // Logic gap: if active but no guide? assuming map key existence = active
            activeDays.Add(kvp.Key);
        }
        
        selectedTimes = ParseTimeSlots(s.TimeSlotsJson);
        
        // Switch to main tab
