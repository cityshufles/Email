    private void AddTime()
    {
        // Use logic 
        if (!selectedTimes.Any(x => x.TourTime == newTimeStr))
        {
            var calculated = CalculateMeetingTime(newTimeStr);
            var slot = new TimeSlotModel 
            { 
               TourTime = newTimeStr,
               MeetingTime = calculated,
               // Seed with defaults from the schedule/tour
               MeetingPlace = currentSchedule?.MeetingPlace,
               MeetingInstructions = currentSchedule?.MeetingInstructions,
               VendorLink = currentSchedule?.VendorLink
            };
            selectedTimes.Add(slot);
            selectedTimes.Sort((a,b) => string.Compare(a.TourTime, b.TourTime));
            
            // Sync global meeting time from first slot for backwards compatibility
            if (currentSchedule != null && selectedTimes.Count == 1)
            {
                 currentSchedule.MeetingTime = calculated;
            }

            // Auto-select the new slot so user can edit logistics immediately if they want
            SelectTimeSlot(slot);
        }
    }

