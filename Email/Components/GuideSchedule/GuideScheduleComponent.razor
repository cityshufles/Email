    private Dictionary<string, string> ParseDayMap(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new Dictionary<string, string>();
        try
        {
            // Try parse as <string, string>
            return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json) 
                   ?? new Dictionary<string, string>();
        }
        catch 
        {
            // Backward compat or error
            return new Dictionary<string, string>(); 
        }
    }
    
    private List<TimeSlotModel> ParseTimeSlots(string? json)
    {
         if (string.IsNullOrWhiteSpace(json)) return new List<TimeSlotModel>();
         
         try 
         {
             // Try NEW format first
             if (json.Trim().StartsWith("["))
             {
                 return System.Text.Json.JsonSerializer.Deserialize<List<TimeSlotModel>>(json) ?? new List<TimeSlotModel>();
             }
         }
         catch {}
         
         // Fallback to OLD CSV format
         return json.Split(',', StringSplitOptions.RemoveEmptyEntries)
             .Select(s => s.Trim())
             .Select(t => new TimeSlotModel { TourTime = t, MeetingTime = CalculateMeetingTime(t) })
             .ToList();
    }
    
    private string GetGuideName(string? guideIdStr)
    {
        if (string.IsNullOrWhiteSpace(guideIdStr) || !int.TryParse(guideIdStr, out var gid)) return "";
        var g = availableGuides.FirstOrDefault(x => x.Id == gid);
        return g == null ? "" : FormatGuideName(g);
    }
    
    private string FormatTimeDisplay(string timeStr)
    {
