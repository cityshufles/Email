@* 2026-06-04 - Global guest directory: every guest, alphabetical, searchable *@
@page "/guests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Email.Models.Reports
@using Email.Services
@inject IBookingsInboxService BookingsInboxService

<PageTitle>Guests</PageTitle>

<div class="container-fluid py-3" style="max-width: 1000px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="mb-0"><i class="bi bi-people me-2"></i>Guests</h4>
        <div class="input-group input-group-sm" style="max-width: 360px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" type="text" placeholder="Search name, phone, or email..."
                   @bind="SearchText" @bind:event="oninput" @bind:after="LoadAsync" />
            @if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted"><div class="spinner-border me-2"></div>Loading guests...</div>
    }
    else if (customers.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-people fs-1 d-block mb-2"></i>
            @(string.IsNullOrWhiteSpace(SearchText) ? "No guests yet." : "No guests match your search.")
        </div>
    }
    else
    {
        <div class="small text-muted mb-2">@customers.Count guest(s)</div>
        <div class="list-group">
            @foreach (var c in customers)
            {
                <a href="@($"/guest/{c.Id}")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-semibold">@(string.IsNullOrWhiteSpace(c.FullName) ? "(no name)" : c.FullName)</span>
                        @if (c.TotalBookings > 1)
                        {
                            <span class="badge text-bg-primary ms-2"><i class="bi bi-arrow-repeat me-1"></i>@c.TotalBookings tours</span>
                        }
                        <div class="small text-muted">
                            @if (!string.IsNullOrWhiteSpace(c.PhoneNumber))
                            {
                                <span class="me-3"><i class="bi bi-telephone me-1"></i>@c.PhoneNumber</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.Email))
                            {
                                <span><i class="bi bi-envelope me-1"></i>@c.Email</span>
                            }
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<CustomerDirectoryItem> customers = new();
    private bool isLoading = true;
    private string SearchText { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            customers = await BookingsInboxService.GetAllCustomersAsync(
                string.IsNullOrWhiteSpace(SearchText) ? null : SearchText);
        }
        catch
        {
            customers = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearSearch()
    {
        SearchText = string.Empty;
        await LoadAsync();
    }
}
