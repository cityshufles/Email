    // Modified: 2026-03-13 - Do not auto-expand notes for Positive status
    private Task ToggleReviewStatusAsync(GuideReportWalker walker, string status)
    {
        var originalIsCheckedIn = walker.IsCheckedIn;
        var originalReviewStatus = walker.ReviewStatus;
        var originalReviewNotes = walker.ReviewNotes;
        var originalDoNotContact = walker.DoNotContact;

        // Toggle OFF (if clicking same status again)
        if (walker.ReviewStatus == status)
        {
            var wasNoContact = (status == "NoContact");
            walker.ReviewStatus = null;

            if (wasNoContact)
            {
                walker.DoNotContact = false;
                walker.IsExpanded = false; // Collapse
            }
        }
        else // Set NEW status (or switch)
        {
            walker.ReviewStatus = status;

            if (status == "NoContact")
            {
                walker.DoNotContact = true;
            }
            else
            {
                walker.DoNotContact = false;
            }

            // Keep notes closed for Positive; still auto-open for statuses likely needing notes.
            if (status == "NoContact" || status == "Negative")
            {
                walker.IsExpanded = true;
            }
        }

        return PersistWalkerGuideStateAsync(
            walker,
            originalIsCheckedIn,
            originalReviewStatus,
            originalReviewNotes,
            originalDoNotContact);
    }

    private async Task PersistWalkerGuideStateAsync(
        GuideReportWalker walker,
        bool originalIsCheckedIn,
        string? originalReviewStatus,
        string? originalReviewNotes,
        bool originalDoNotContact)
    {
        if (walker.BookingId <= 0)
        {
            return;
        }

        if (!_attendanceSavePendingBookingIds.Add(walker.BookingId))
        {
            return;
        }

        await InvokeAsync(StateHasChanged);

        try
        {
            await ReportService.UpdateBookingGuideStateAsync(
                walker.BookingId,
                walker.ReviewStatus,
                walker.ReviewNotes,
                walker.IsCheckedIn,
                walker.DoNotContact);
        }
        catch (Exception ex)
        {
            walker.IsCheckedIn = originalIsCheckedIn;
            walker.ReviewStatus = originalReviewStatus;
            walker.ReviewNotes = originalReviewNotes;
            walker.DoNotContact = originalDoNotContact;
            await ToastService.ShowErrorAsync("Save Failed", $"Could not save booking status: {ex.Message}");
        }
        finally
        {
            _attendanceSavePendingBookingIds.Remove(walker.BookingId);
            await InvokeAsync(StateHasChanged);
        }
    }

