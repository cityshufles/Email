    private Task AdjustAdultsAsync(GuideReportWalker walker, int delta)
    {
        return AdjustAttendanceAsync(walker, adultsDelta: delta, childrenDelta: 0);
    }

    private Task AdjustChildrenAsync(GuideReportWalker walker, int delta)
    {
        return AdjustAttendanceAsync(walker, adultsDelta: 0, childrenDelta: delta);
    }

    private async Task AdjustAttendanceAsync(GuideReportWalker walker, int adultsDelta, int childrenDelta)
    {
        if (walker == null)
        {
            return;
        }

        var originalAdults = walker.ActualAdults;
        var originalChildren = walker.ActualChildren;

        var updatedAdults = Math.Max(0, originalAdults + adultsDelta);
        var updatedChildren = Math.Max(0, originalChildren + childrenDelta);

        if (updatedAdults == originalAdults && updatedChildren == originalChildren)
        {
            return;
        }

        walker.ActualAdults = updatedAdults;
        walker.ActualChildren = updatedChildren;
        walker.ActualAttendees = walker.ActualAdults + walker.ActualChildren;

        var hasPersistableBookingId = walker.BookingId > 0;
        if (hasPersistableBookingId && !_attendanceSavePendingBookingIds.Add(walker.BookingId))
        {
            return;
        }

        await InvokeAsync(StateHasChanged);

        if (!hasPersistableBookingId)
        {
            return;
        }

        try
        {
            await ReportService.UpdateBookingAttendeesAsync(
                walker.BookingId,
                walker.ActualAdults,
                walker.ActualChildren);
        }
        catch (Exception ex)
        {
            walker.ActualAdults = originalAdults;
            walker.ActualChildren = originalChildren;
            walker.ActualAttendees = originalAdults + originalChildren;
            await ToastService.ShowErrorAsync("Save Failed", $"Could not save attendee counts: {ex.Message}");
        }
        finally
        {
            _attendanceSavePendingBookingIds.Remove(walker.BookingId);
            await InvokeAsync(StateHasChanged);
        }
    }

