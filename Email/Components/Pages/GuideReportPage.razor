        foreach (var walker in Report.Walkers)
        {
            Console.WriteLine($"[GuideReport] Walker: BookingId={walker.BookingId}, Name='{walker.CustomerName}', Vendor='{walker.VendorName}', Adults={walker.ActualAdults}, Children={walker.ActualChildren}, Attendees={walker.ActualAttendees}, CheckedIn={walker.IsCheckedIn}, ReviewStatus='{walker.ReviewStatus}', DoNotContact={walker.DoNotContact}");
        }

        isSaving = true;
        _calculationResult = null;
        StateHasChanged();

        try
        {
            Report.IsSubmitted = true;
            Report.SubmittedAt = DateTime.UtcNow;
            Report.TourDate = SelectedDate;
            Report.TourName = SelectedTour.TourName;
            Report.TourTime = SelectedTour.RawTourTime;

