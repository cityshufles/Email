        if (isContactModeLockEnabled)
        {
            contactMessageMode = ContactModeBlank;
        }
    }

    private void OnContactMessageModeChanged(ChangeEventArgs e)
    {
        if (isContactModeLockEnabled)
        {
            contactMessageMode = ContactModeBlank;
            return;
        }

        var requestedMode = e.Value?.ToString() ?? string.Empty;
        if (string.Equals(requestedMode, ContactModeGreeting, StringComparison.OrdinalIgnoreCase))
        {
            contactMessageMode = ContactModeGreeting;
            return;
        }

        if (string.Equals(requestedMode, ContactModeGalleryLink, StringComparison.OrdinalIgnoreCase))
        {
            contactMessageMode = ContactModeGalleryLink;
            return;
        }

        contactMessageMode = ContactModeBlank;
