    private List<TourDaySummary> GetVisibleTours()
    {
        if (DailyTours.Count == 0)
        {
            return DailyTours;
        }

        if (SelectedGuideFilter == "all")
        {
            return DailyTours;
        }

        if (SelectedGuideFilter == "unassigned")
        {
            return DailyTours.Where(t => !t.GuideId.HasValue).ToList();
        }

        if (SelectedGuideFilter.StartsWith("guide-", StringComparison.OrdinalIgnoreCase))
        {
            var idPart = SelectedGuideFilter.Substring("guide-".Length);
            if (int.TryParse(idPart, out var guideId))
            {
                return DailyTours.Where(t => t.GuideId == guideId).ToList();
            }
        }

        return DailyTours;
    }

    private List<DbGuide> GetDistinctGuidesForFilter()
    {
        return Guides
            .GroupBy(g =>
            {
                var first = (g.FirstName ?? string.Empty).Trim();
                var last = (g.LastName ?? string.Empty).Trim();
                return $"{first} {last}".Trim().ToLowerInvariant();
            })
            .Select(g => g.First())
            .OrderBy(g => g.FirstName)
            .ThenBy(g => g.LastName)
            .ToList();
    }

    private async Task EnsureTourSelectionAsync()
    {
        var visibleTours = GetVisibleTours();
        if (visibleTours.Count == 0)
        {
            SelectedTour = null;
            Report = null;
            _calculationResult = null;
            ReportPhotos = new();
            return;
        }

        if (SelectedTour != null &&
            visibleTours.Any(t =>
                t.TourDate == SelectedTour.TourDate &&
                string.Equals(t.GroupFamilyKey, SelectedTour.GroupFamilyKey, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(t.GroupTimeKey, SelectedTour.GroupTimeKey, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        await SelectTour(visibleTours[0]);
    }

    private async Task CopyVendorGalleryLink(string vendor, string elementId)
    {
        if (Report == null) return;

        try
        {
            var url = GetGalleryUrl(Report, vendor);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
            await ToastService.ShowSuccessAsync("Copied!", "Gallery link copied to clipboard.");
        }
        catch
        {
            // Fallback for browsers that don't support clipboard API
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{elementId}').select(); document.execCommand('copy');");
                await ToastService.ShowSuccessAsync("Copied!", "Gallery link copied to clipboard.");
            }
            catch
            {
                await ToastService.ShowErrorAsync("Error", "Could not copy link. Please copy manually.");
            }
        }
    }

    private bool HasVendorGallery(string vendorKey)
    {
        if (Report?.Walkers == null || Report.Walkers.Count == 0) return false;
        var key = vendorKey?.ToLowerInvariant() ?? "";
        foreach (var walker in Report.Walkers)
        {
            if (string.IsNullOrWhiteSpace(walker.VendorName)) continue;
            var normalized = NormalizeVendorKey(walker.VendorName);
            if (normalized.Contains(key)) return true;
        }
        return false;
    }

    private static string NormalizeVendorKey(string? vendor)
    {
        if (string.IsNullOrWhiteSpace(vendor)) return string.Empty;
        var cleaned = System.Text.RegularExpressions.Regex.Replace(vendor, "[^a-zA-Z0-9]", "");
        return cleaned.ToLowerInvariant();
    }

    private async Task RefreshPhotos()
    {
        await SyncReportPhotosAsync(showSuccessToast: true, autoTriggered: false);
    }

    /// <summary>
    /// 2026-03-31: Auto-sync photo paths on uploader return and keep retry UI hidden unless sync fails.
    /// </summary>
    private async Task TryAutoSyncPhotosAfterUploadReturnAsync()
    {
        if (!_shouldAutoSyncAfterUploadReturn)
        {
            return;
        }

        _shouldAutoSyncAfterUploadReturn = false;
        await SyncReportPhotosAsync(showSuccessToast: false, autoTriggered: true);
    }

    /// <summary>
    /// 2026-03-31: Refreshes filesystem photos and upserts TourReports.ImagePaths for cross-page consistency.
    /// </summary>
    private async Task SyncReportPhotosAsync(bool showSuccessToast, bool autoTriggered)
    {
        if (SelectedTour == null || Report == null)
        {
            Logger.LogWarning(
                "TourPhotoRefresh SKIPPED Reason=MissingSelectedTourOrReport AutoTriggered={AutoTriggered}",
                autoTriggered);
            return;
        }

        var refreshId = Guid.NewGuid().ToString("N")[..12];
        var refreshTimer = System.Diagnostics.Stopwatch.StartNew();
        isUploadingPhotos = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            Logger.LogInformation(
                "TourPhotoRefresh START RefreshId={RefreshId} TourDate={TourDate} TourName={TourName} TourTime={TourTime}",
                refreshId, SelectedDate.ToString("yyyy-MM-dd"), SelectedTour.TourName, SelectedTour.RawTourTime);

            var photos = await PhotoService.GetPhotosForTourAsync(
                SelectedDate.ToString("yyyy-MM-dd"), 
                SelectedTour.TourName, 
                SelectedTour.RawTourTime
            );
            
            Report.ImagePaths = string.Join(",", photos);
            ReportPhotos = photos;
            
            // Persist only image paths to avoid unnecessary walker/bookings updates during sync.
            var reportId = await ReportService.UpsertReportImagePathsAsync(
                SelectedDate.Date,
                SelectedTour.TourName,
                SelectedTour.RawTourTime ?? string.Empty,
                Report.ImagePaths);

            if (Report.Id == 0 && reportId > 0)
            {
                Report.Id = reportId;
            }

            Logger.LogInformation(
                "TourPhotoRefresh SUCCESS RefreshId={RefreshId} PhotoCount={PhotoCount} ReportId={ReportId}",
                refreshId, photos.Count, reportId > 0 ? reportId : Report.Id);

            showPhotoSyncHint = false;
            photoSyncHintMessage = string.Empty;
            photoSyncHintAlertClass = "alert-info";

            if (showSuccessToast)
            {
                await ToastService.ShowSuccessAsync("Synced", "Photos refreshed and report updated.");
            }
        }
        catch (Exception ex)
        {
            await LogPhotoUploadErrorAsync(
                "GuideReportPage.TourPhotoRefresh",
                $"RefreshId={refreshId}; TourDate={SelectedDate:yyyy-MM-dd}; TourName={SelectedTour?.TourName}; TourTime={SelectedTour?.RawTourTime}",
                ex);
            Logger.LogError(ex, "Error refreshing photos RefreshId={RefreshId}", refreshId);
            showPhotoSyncHint = true;
            photoSyncHintMessage = autoTriggered
                ? "Upload completed, but auto-sync did not finish. Tap Try Again."
                : "Upload completed, but sync did not finish. Tap Try Again.";
            photoSyncHintAlertClass = "alert-warning";
            await ToastService.ShowErrorAsync("Warning", "Photos synced locally but report update may have failed.");
        }
        finally
        {
            refreshTimer.Stop();
            Logger.LogInformation("TourPhotoRefresh END RefreshId={RefreshId} DurationMs={DurationMs}", refreshId, refreshTimer.ElapsedMilliseconds);
            isUploadingPhotos = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetMobileUploaderUrl()
    {
        // 2026-06-13 - Use the in-app uploader (/tour-photos) instead of the external static page.
        // Both post to /tour-photos/upload-alt (direct XHR, no SignalR) so there is no circuit timeout,
        // and this stays authenticated + same-origin.
        if (SelectedTour == null)
        {
            return "/tour-photos";
        }

        var tourDate = Uri.EscapeDataString(SelectedDate.ToString("yyyy-MM-dd"));
        var tourName = Uri.EscapeDataString(SelectedTour.TourName ?? string.Empty);
        var tourTime = Uri.EscapeDataString(SelectedTour.RawTourTime ?? string.Empty);
        return $"/tour-photos?tourDate={tourDate}&tourName={tourName}&tourTime={tourTime}";
    }

    private void ApplyRouteContextFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("date", out var dateValues))
        {
            var rawDate = dateValues.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(rawDate) &&
                DateTime.TryParseExact(rawDate, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsedDate))
            {
                SelectedDate = parsedDate.Date;
                SelectedMonth = new DateTime(parsedDate.Year, parsedDate.Month, 1);
                DateViewMode = "day";
            }
        }

        _requestedTourNameFromQuery = query.TryGetValue("tourName", out var tourNameValues)
            ? tourNameValues.FirstOrDefault()
            : null;
        _requestedTourTimeFromQuery = query.TryGetValue("tourTime", out var tourTimeValues)
            ? tourTimeValues.FirstOrDefault()
            : null;
        _shouldAutoSyncAfterUploadReturn = query.TryGetValue("photoReturn", out var photoReturnValues)
            && IsTruthyQueryFlag(photoReturnValues.FirstOrDefault());
    }

    private async Task TrySelectTourFromRouteContextAsync()
    {
        if (string.IsNullOrWhiteSpace(_requestedTourNameFromQuery))
        {
            return;
        }

        var requestedTimeKey = NormalizeTourTimeKey(_requestedTourTimeFromQuery);
        var match = DailyTours.FirstOrDefault(t =>
            t.TourDate.Date == SelectedDate.Date &&
            TourMatchesRequestedName(t, _requestedTourNameFromQuery) &&
            (string.IsNullOrWhiteSpace(_requestedTourTimeFromQuery) ||
             string.Equals(t.GroupTimeKey ?? string.Empty, requestedTimeKey, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(t.RawTourTime ?? string.Empty, _requestedTourTimeFromQuery, StringComparison.OrdinalIgnoreCase)));

        if (match == null)
        {
            return;
        }

        if (SelectedTour != null &&
            SelectedTour.TourDate.Date == match.TourDate.Date &&
            string.Equals(SelectedTour.GroupFamilyKey ?? string.Empty, match.GroupFamilyKey ?? string.Empty, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(SelectedTour.GroupTimeKey ?? string.Empty, match.GroupTimeKey ?? string.Empty, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await SelectTour(match);
    }

    private static bool IsTruthyQueryFlag(string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            return false;
        }

        var value = rawValue.Trim();
        return value == "1" ||
               value.Equals("true", StringComparison.OrdinalIgnoreCase) ||
               value.Equals("yes", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TourMatchesRequestedName(TourDaySummary tour, string? requestedTourName)
    {
        if (tour == null || string.IsNullOrWhiteSpace(requestedTourName))
        {
            return false;
        }

        if (string.Equals(tour.TourName ?? string.Empty, requestedTourName, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(tour.ListDisplayName ?? string.Empty, requestedTourName, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(tour.GroupFamilyDesktopName ?? string.Empty, requestedTourName, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(tour.GroupFamilyMobileName ?? string.Empty, requestedTourName, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return tour.TourNameAliases.Any(alias =>
            string.Equals(alias, requestedTourName, StringComparison.OrdinalIgnoreCase));
    }

    private string GetGalleryUrl(TourReport? report, string? vendor = null)
    {
        if (report == null) return "";
        var baseUrl = GetConfiguredBaseUrl();
        
        var fileName = $"{report.PublicId}.html";
        if (!string.IsNullOrWhiteSpace(vendor))
        {
             // Sanitize vendor to match generator logic
             var suffix = System.Text.RegularExpressions.Regex.Replace(vendor, "[^a-zA-Z0-9]", "");
             if (!string.IsNullOrEmpty(suffix))
             {
                 fileName = $"{report.PublicId}_{suffix}.html";
             }
        }
        
        return $"{baseUrl}/tour-gallery/{fileName}";
    }

    private string GetConfiguredBaseUrl()
    {
        var configured = Configuration["PublicGallery:BaseUrl"];
        if (string.IsNullOrWhiteSpace(configured))
        {
            return "http://testcity.w41.wh-2.com";
        }

        return configured.Trim().TrimEnd('/');
    }

    private bool HasGalleryFile(TourReport? report)
    {
        if (report == null || string.IsNullOrWhiteSpace(report.PublicId))
        {
            return false;
        }

        var fileName = $"{report.PublicId}.html";
        var fullPath = Path.Combine(WebHostEnvironment.WebRootPath, "tour-gallery", fileName);
        return File.Exists(fullPath);
    }

    // Walk-Up Dialog Logic
    private bool showWalkUpDialog = false;
    private GuideReportWalker walkUpGuest = new();

    private void OpenWalkUpDialog()
    {
        walkUpGuest = new GuideReportWalker 
        { 
            ActualAdults = 1, 
            ActualChildren = 0,
            ActualAttendees = 1
        };
        showWalkUpDialog = true;
    }

    private void EditWalkUpGuest(GuideReportWalker walker)
    {
        walkUpGuest = new GuideReportWalker 
        { 
            BookingId = walker.BookingId,
            CustomerName = walker.CustomerName,
            Phone = walker.Phone,
            Email = walker.Email,
            VendorName = walker.VendorName,
            ActualAdults = walker.ActualAdults,
            ActualChildren = walker.ActualChildren,
            ActualAttendees = walker.ActualAttendees,
            ReviewNotes = walker.ReviewNotes
        };
        showWalkUpDialog = true;
    }

    private async Task DeleteWalkUpGuest(int bookingId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this walk-up guest?"))
        {
            return;
        }

        isSaving = true;
        StateHasChanged();
        try
        {
            await ReportService.DeleteWalkUpBookingAsync(bookingId);
            await ToastService.ShowSuccessAsync("Success", "Guest deleted.");
            await SelectTour(SelectedTour!); 
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", $"Delete failed: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveWalkUpGuest()
    {
        if (string.IsNullOrWhiteSpace(walkUpGuest.CustomerName) || string.IsNullOrWhiteSpace(walkUpGuest.Phone))
        {
            await ToastService.ShowErrorAsync("Required", "Name and Phone are required.");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            walkUpGuest.ActualAttendees = walkUpGuest.ActualAdults + walkUpGuest.ActualChildren;
            
            if (walkUpGuest.BookingId > 0)
            {
                await ReportService.UpdateWalkUpBookingAsync(walkUpGuest);
                await ToastService.ShowSuccessAsync("Success", "Guest updated.");
            }
            else
            {
                await ReportService.AddWalkUpBookingAsync(
                    walkUpGuest, 
                    SelectedDate, 
                    SelectedTour!.TourName, 
                    SelectedTour.RawTourTime
                );
                await ToastService.ShowSuccessAsync("Success", "Walk-up guest added.");
            }

            showWalkUpDialog = false;
            await SelectTour(SelectedTour!); 
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", $"Failed to save guest: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // Phone Edit Logic
    private bool showPhoneEditDialog = false;
    private GuideReportWalker? editingWalker;
    private string newPhone = string.Empty;
    private bool isPhoneError = false;

    private void OpenPhoneEditDialog(GuideReportWalker walker)
    {
        editingWalker = walker;
        newPhone = walker.Phone ?? string.Empty;
        isPhoneError = false;
        showPhoneEditDialog = true;
    }

    private async Task SavePhone()
    {
        if (editingWalker == null) return;

        var clean = newPhone?.Trim() ?? "";
        if (string.IsNullOrEmpty(clean) || !clean.StartsWith("+") || clean.Length < 2 || !char.IsDigit(clean[1]))
        {
            isPhoneError = true;
            return;
        }
        isPhoneError = false;

        isSaving = true;
        StateHasChanged();

        try
        {
            await ReportService.UpdateBookingPhoneAsync(editingWalker.BookingId, newPhone);
            editingWalker.Phone = newPhone;
            await ToastService.ShowSuccessAsync("Success", "Phone number updated.");
            showPhoneEditDialog = false;
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", $"Failed to update phone: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private string GetWalkerWhatsAppActionLink(TourReport? report, GuideReportWalker walker)
    {
        var waPhone = GetWhatsappPhoneDigits(walker.Phone);
        if (string.IsNullOrWhiteSpace(waPhone))
        {
            return string.Empty;
        }

        if (IsGalleryLinkContactMode && report != null)
        {
            return GetWhatsAppLink(report, waPhone);
        }

        return $"https://wa.me/{waPhone}";
    }

    private string GetWalkerSmsActionLink(TourReport? report, GuideReportWalker walker)
    {
        var smsPhone = walker.Phone ?? string.Empty;
        if (string.IsNullOrWhiteSpace(smsPhone))
        {
            return string.Empty;
        }

        if (IsGalleryLinkContactMode && report != null)
        {
            return GetSmsLink(report, smsPhone);
        }

        return $"sms:{smsPhone}";
    }

    private string GetWhatsAppLink(TourReport? report, string phone)
    {
        if (report == null) return "";
        
        var walker = report.Walkers.FirstOrDefault(w => 
            (w.Phone?.Replace("+", "").Replace(" ", "") ?? "") == (phone?.Replace("+", "").Replace(" ", "") ?? ""));
 
        var msg = BuildGalleryMessage(report, walker?.VendorName);
        return $"https://wa.me/{phone}?text={Uri.EscapeDataString(msg)}";
    }

    private static string GetContactStateButtonClass(byte state, bool enabled)
    {
        if (!enabled)
        {
            return "btn-outline-secondary";
        }

        return state switch
        {
            1 => "btn-outline-success",
            2 => "btn-outline-danger",
            3 => "btn-outline-secondary",
            _ => "btn-outline-warning"
        };
    }

    private static string GetContactActionTitle(string channelLabel, byte state, bool enabled)
    {
        if (!enabled)
        {
            return $"{channelLabel}: No phone";
        }

        return $"{channelLabel}: {GetContactStateLabel(state)}";
    }

    private static string GetContactStateLabel(byte state)
    {
        return state switch
        {
            1 => "Green (contacted)",
            2 => "Red (failed)",
            3 => "Gray (skipped / unknown)",
            _ => "Yellow (no outcome)"
        };
    }

    private string GetSmsLink(TourReport? report, string phone)
    {
         if (report == null) return "";
        
        var walker = report.Walkers.FirstOrDefault(w => 
            (w.Phone?.Replace("+", "").Replace(" ", "") ?? "") == (phone?.Replace("+", "").Replace(" ", "") ?? ""));
 
        var msg = BuildGalleryMessage(report, walker?.VendorName);
        return $"sms:{phone}?body={Uri.EscapeDataString(msg)}";
    }

    private string BuildGalleryMessage(TourReport report, string? vendorName)
    {
        var url = GetGalleryUrl(report, vendorName);
        var tourName = NormalizeMessageTourName(report.TourName);
        var suffix = tourName.EndsWith("tour", StringComparison.OrdinalIgnoreCase) ? "" : " tour";
        return $"Thanks for taking our {tourName}{suffix}! Here are the photos: {url}";
    }

    private static string NormalizeMessageTourName(string? rawTourName)
    {
        var decoded = System.Net.WebUtility.HtmlDecode(rawTourName ?? string.Empty).Trim();
        decoded = System.Text.RegularExpressions.Regex.Replace(decoded, "\\s+", " ");

        if (decoded.EndsWith("reservation", StringComparison.OrdinalIgnoreCase))
        {
            decoded = decoded.Substring(0, decoded.Length - "reservation".Length).TrimEnd(' ', '-', ':', '|', '/');
        }

        return string.IsNullOrWhiteSpace(decoded) ? "tour" : decoded;
    }

