            await ReportService.SaveReportAsync(Report);
            Console.WriteLine($"[GuideReport] Report saved. PublicId='{Report.PublicId}', SubmittedAt={Report.SubmittedAt:O}");
            if (SelectedTour != null)
            {
                SelectedTour.IsSubmitted = true;
            }
            
            // 2026-02-15: Enable static gallery generation in Development for testing.
            Console.WriteLine("[GuideReport] Generating static gallery...");
            await GalleryGenerator.GenerateAndSaveHtmlAsync(Report);
            Console.WriteLine("[GuideReport] Static gallery generation complete.");

            await ToastService.ShowSuccessAsync("Success", "Report submitted successfully!");

            try
            {
                Console.WriteLine("[GuideReport] Starting calculation from report...");
                _calculationResult = await CalculatorService.CalculateFromReportAsync(Report);
                if (_calculationResult != null)
                {
                    Console.WriteLine($"[GuideReport] Calculation complete. GuideId={_calculationResult.GuideId}, GuideName='{_calculationResult.GuideName}', Tours={_calculationResult.Tours.Count}, TotalGuests={_calculationResult.Tours.Sum(t => t.TotalGuests)}, TotalEarned={_calculationResult.TotalEarned:N2}, TotalOwed={_calculationResult.TotalOwed:N2}");
                    foreach (var tour in _calculationResult.Tours)
                    {
                        Console.WriteLine($"[GuideReport] TourCalc: Tour='{tour.TourName}', Time='{tour.TourTime}', Guests={tour.TotalGuests}, Earned={tour.TourEarned:N2}, Owed={tour.TourOwed:N2}");
                        foreach (var guest in tour.GuestRoster)
                        {
                            Console.WriteLine($"[GuideReport] Guest: Pos={guest.Position}, Name='{guest.CustomerName}', Vendor='{guest.VendorName}', IsChild={guest.IsChild}, Chargeable={guest.IsChargeable}, Charge={guest.ChargeAmount:N2}, Earn={guest.EarnAmount:N2}");
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[GuideReport] Calculation error: {ex.Message}");
                _calculationResult = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GuideReport] Save error: {ex.Message}");
            await ToastService.ShowErrorAsync("Error", $"Failed to save: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

