    private async Task LoadGuideProfile()
    {
        currentUsername = null;
        string? currentPhone = null;
        
        var state = AuthStateTask != null
            ? await AuthStateTask
            : await AuthStateProvider.GetAuthenticationStateAsync();

        currentUsername = state.User.Identity?.Name;
        currentPhone = state.User.FindFirst(ClaimTypes.MobilePhone)?.Value;

        Guides = await GuidesService.GetGuidesAsync();

        currentGuideProfile = null;
        var matchedByEmail = false;
        var matchedByPhone = false;
        var matchedByLast10 = false;
        var trimmedUsername = currentUsername?.Trim();

        if (!string.IsNullOrWhiteSpace(trimmedUsername))
        {
            currentGuideProfile = Guides.FirstOrDefault(g =>
                string.Equals(g.Email?.Trim(), trimmedUsername, StringComparison.OrdinalIgnoreCase));
            matchedByEmail = currentGuideProfile != null;
        }

        if (currentGuideProfile == null && !string.IsNullOrWhiteSpace(currentPhone))
        {
            var normalizedUserPhone = NormalizePhoneDigits(currentPhone);
            if (!string.IsNullOrWhiteSpace(normalizedUserPhone))
            {
                currentGuideProfile = Guides.FirstOrDefault(g =>
                    NormalizePhoneDigits(g.Phone) == normalizedUserPhone);
                matchedByPhone = currentGuideProfile != null;

                if (currentGuideProfile == null && normalizedUserPhone.Length >= 10)
                {
                    var userLast10 = normalizedUserPhone[^10..];
                    var matches = Guides
                        .Where(g =>
                        {
                            var gp = NormalizePhoneDigits(g.Phone);
                            return gp.Length >= 10 && gp[^10..] == userLast10;
                        })
                        .ToList();

                    if (matches.Count == 1)
                    {
                        currentGuideProfile = matches[0];
                        matchedByPhone = true;
                        matchedByLast10 = true;
                    }
                    else
                    {
                        Console.WriteLine($"[GuideProfile] Last10 match count={matches.Count} userLast10={userLast10}");
                    }
                }
            }
        }

        if (currentGuideProfile != null)
        {
            editEmail = matchedByPhone && !string.IsNullOrWhiteSpace(trimmedUsername)
                ? trimmedUsername
                : currentGuideProfile.Email ?? trimmedUsername ?? "";
            editPhone = currentGuideProfile.Phone ?? "";
            editGuideImage = currentGuideProfile.GuideImage;
        }

        Console.WriteLine(
            $"[GuideProfile] isAuth={state.User.Identity?.IsAuthenticated} username={trimmedUsername ?? "(null)"} phoneClaim={currentPhone ?? "(null)"} " +
            $"normalizedPhone={NormalizePhoneDigits(currentPhone)} guides={Guides.Count} " +
            $"matchedByEmail={matchedByEmail} matchedByPhone={matchedByPhone} matchedByLast10={matchedByLast10} " +
            $"guideId={(currentGuideProfile?.Id.ToString() ?? "(null)")} " +
            $"guideEmail={(currentGuideProfile?.Email ?? "(null)")} " +
            $"guidePhone={(currentGuideProfile?.Phone ?? "(null)")}"
        );

        StateHasChanged();
    }

    private static string NormalizePhoneDigits(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return string.Empty;
        return new string(phone.Where(char.IsDigit).ToArray());
    }

    private async Task SaveProfile()
    {
        if (currentGuideProfile == null) return;
        
        isSavingProfile = true;
        StateHasChanged();

        try
        {
            var oldEmail = currentGuideProfile.Email ?? "";
            await GuidesService.UpdateGuideProfileAsync(currentGuideProfile.Id, editEmail, editPhone, editGuideImage);
            
            // Update local model
            currentGuideProfile.Email = editEmail;
            currentGuideProfile.Phone = editPhone;
            currentGuideProfile.GuideImage = editGuideImage;

            await ToastService.ShowSuccessAsync("Profile Updated", "Your changes have been saved.");
            
            if (!string.Equals(oldEmail, editEmail, StringComparison.OrdinalIgnoreCase))
            {
                await ToastService.ShowInfoAsync("Notice", "Email changed. Use new email for next login.");
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", $"Failed to save profile: {ex.Message}");
        }
        finally
        {
            isSavingProfile = false;
            StateHasChanged();
        }
    }

    private async Task HandlePhotoUpload(InputFileChangeEventArgs e)
    {
        if (currentGuideProfile == null)
        {
            Logger.LogWarning("ProfilePhotoUpload REJECTED Reason=NoCurrentGuideProfile");
            return;
        }

        var file = e.File;
        if (file == null)
        {
            Logger.LogWarning(
                "ProfilePhotoUpload REJECTED Reason=NoFile GuideId={GuideId}",
                currentGuideProfile.Id);
            return;
        }

        var uploadId = Guid.NewGuid().ToString("N")[..12];
        var uploadTimer = System.Diagnostics.Stopwatch.StartNew();
        Logger.LogInformation(
            "ProfilePhotoUpload START UploadId={UploadId} GuideId={GuideId} FileName={FileName} FileSizeBytes={FileSizeBytes} ContentType={ContentType}",
            uploadId, currentGuideProfile.Id, file.Name, file.Size, file.ContentType);

        if (file.Size > 5 * 1024 * 1024)
        {
            Logger.LogWarning(
                "ProfilePhotoUpload REJECTED UploadId={UploadId} GuideId={GuideId} Reason=FileTooLarge FileName={FileName} FileSizeBytes={FileSizeBytes} MaxBytes={MaxBytes}",
                uploadId, currentGuideProfile.Id, file.Name, file.Size, 5 * 1024 * 1024);
            await ToastService.ShowErrorAsync("Error", "Image payload too large (Max 5MB).");
            return;
        }

        try
        {
            isSavingPhoto = true;
            StateHasChanged();

            var wwwroot = WebHostEnvironment.WebRootPath;
            var uploadsDir = Path.Combine(wwwroot, "guidephotos");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var ext = Path.GetExtension(file.Name);
            var fileName = $"{Guid.NewGuid()}{ext}";
            var path = Path.Combine(uploadsDir, fileName);

            var writeTimer = System.Diagnostics.Stopwatch.StartNew();
            await using var fs = new FileStream(path, FileMode.Create);
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(fs);
            writeTimer.Stop();
            Logger.LogInformation(
                "ProfilePhotoUpload FILE WRITTEN UploadId={UploadId} GuideId={GuideId} FileName={FileName} FullPath={FullPath} BytesWritten={BytesWritten} WriteDurationMs={WriteDurationMs}",
                uploadId, currentGuideProfile.Id, file.Name, path, file.Size, writeTimer.ElapsedMilliseconds);

            editGuideImage = $"guidephotos/{fileName}";
            await GuidesService.UpdateGuideProfileAsync(currentGuideProfile.Id, editEmail, editPhone, editGuideImage);
            currentGuideProfile.GuideImage = editGuideImage;
            Logger.LogInformation(
                "ProfilePhotoUpload DB UPDATED UploadId={UploadId} GuideId={GuideId} ImagePath={ImagePath}",
                uploadId, currentGuideProfile.Id, editGuideImage);
            await ToastService.ShowSuccessAsync("Saved", "Profile photo updated.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LogPhotoUploadErrorAsync(
                "GuideReportPage.ProfilePhotoUpload",
                $"UploadId={uploadId}; GuideId={currentGuideProfile.Id}; FileName={file.Name}; Size={file.Size}; TourDate={SelectedDate:yyyy-MM-dd}",
                ex);
            await ToastService.ShowErrorAsync("Error", ex.Message);
        }
        finally
        {
            uploadTimer.Stop();
            Logger.LogInformation(
                "ProfilePhotoUpload END UploadId={UploadId} GuideId={GuideId} DurationMs={DurationMs}",
                uploadId, currentGuideProfile.Id, uploadTimer.ElapsedMilliseconds);
            isSavingPhoto = false;
            StateHasChanged();
        }
    }

    private Task LogPhotoUploadErrorAsync(string componentName, string context, Exception ex)
    {
        Logger.LogError(ex, "Photo upload error in {Component}. Context: {Context}", componentName, context);
        return Task.CompletedTask;
    }

    private async Task DeletePhoto()
    {
        if (currentGuideProfile == null) return;

        isSavingPhoto = true;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrWhiteSpace(editGuideImage))
            {
                var relativePath = editGuideImage.TrimStart('/');
                if (relativePath.StartsWith("guidephotos/", StringComparison.OrdinalIgnoreCase))
                {
                    var wwwroot = WebHostEnvironment.WebRootPath;
                    var fullPath = Path.Combine(wwwroot, relativePath.Replace('/', Path.DirectorySeparatorChar));
                    if (File.Exists(fullPath))
                    {
                        File.Delete(fullPath);
                    }
                }
            }

            editGuideImage = null;
            await GuidesService.UpdateGuideProfileAsync(currentGuideProfile.Id, editEmail, editPhone, editGuideImage);
            currentGuideProfile.GuideImage = editGuideImage;
            await ToastService.ShowSuccessAsync("Saved", "Profile photo removed.");
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Delete Failed", ex.Message);
        }
        finally
        {
            isSavingPhoto = false;
            StateHasChanged();
        }
    }

