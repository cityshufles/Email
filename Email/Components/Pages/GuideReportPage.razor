@page "/guide-report"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Email.Models
@using Email.Models.GuideCalculator
@using Email.Models.Mobile
@using Email.Models.Reports
@using Email.Services
@using Email.Calendar.Services
@using Email.Calendar.Models
@using Email.Components.Tours
@inject ITourGuideAssignmentService AssignmentService
@inject ICalendarDataService CalendarService
@inject IGuidesApiService GuidesService
@inject IGuideReportService ReportService
@inject IGuideCalculatorService CalculatorService
@inject IToastService ToastService
@inject ITourPhotoService PhotoService
@inject ITourNameNormalizer TourNameNormalizerService
@inject IConfiguration Configuration
@inject StaticGalleryGeneratorService GalleryGenerator
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IWebHostEnvironment WebHostEnvironment
@inject Microsoft.Extensions.Logging.ILogger<GuideReportPage> Logger
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Configuration
@using System.IO
@using System.Security.Claims

<!-- Created: 1/28/2026 9:30 PM - Added expander, check-in, notes, photo upload -->

<PageTitle>Guide Report</PageTitle>

<div class="container-fluid py-3 @(_buttonFontSize)">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="ForcePageRefresh"
                    title="Refresh page">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                <span class="visually-hidden">Refresh page</span>
            </button>
            <h4 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Guide Reports</h4>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/guide-lite" class="btn btn-outline-secondary" title="Open Guide Lite">
                <i class="bi bi-grid-3x3-gap me-1"></i>Lite
            </a>
            <form method="post" action="/logout" class="d-inline">
                <button type="submit" class="btn btn-danger" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
            <button class="btn btn-outline-secondary border-0" @onclick="ToggleSettings" title="Page Settings">
                <i class="bi bi-gear-fill"></i>
            </button>
        </div>
    </div>
    
    <div class="row">
        <!-- Left Panel: Date Picker & Tour List -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <i class="bi bi-calendar3 me-1"></i> Select Date
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person me-1"></i>
                        <select class="form-select form-select-sm" style="width: 170px;"
                                value="@SelectedGuideFilter"
                                @onchange="OnGuideFilterChange">
                            <option value="all">All Guides</option>
                            <option value="unassigned">Unassigned</option>
                            <option disabled>---------</option>
                            @foreach (var guide in GetDistinctGuidesForFilter())
                            {
                                <option value="guide-@guide.Id">@guide.FirstName @guide.LastName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 mb-3">
                        <input type="date" class="form-control" style="width: 50%;"
                               value="@SelectedDate.ToString("yyyy-MM-dd")" 
                               @onchange="OnDateChanged" />
                        <input type="month" class="form-control" style="width: 50%;"
                               value="@SelectedMonth.ToString("yyyy-MM")"
                               @onchange="OnMonthChanged" />
                    </div>
                    @{
                        var visibleTours = GetVisibleTours();
                    }
                    
                    @if (isLoading)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (visibleTours.Count == 0)
                    {
                        <div class="text-muted small">No tours found for this date.</div>
                    }
                    else
                    {
                        <div class="fw-semibold mb-2">
                            @if (DateViewMode == "month")
                            {
                                <span>Tours in @SelectedMonth.ToString("MMMM yyyy"):</span>
                            }
                            else
                            {
                                <span>Tours on @SelectedDate.ToString("MMM d, yyyy"):</span>
                            }
                        </div>
                        <ul class="list-unstyled">
                            @foreach (var tour in visibleTours)
                            {
                                var isActive = SelectedTour?.TourDate == tour.TourDate &&
                                               string.Equals(SelectedTour?.GroupFamilyKey, tour.GroupFamilyKey, StringComparison.OrdinalIgnoreCase) &&
                                               string.Equals(SelectedTour?.GroupTimeKey, tour.GroupTimeKey, StringComparison.OrdinalIgnoreCase);
                                <li class="mb-1">
                                    <button class='@($"btn btn-sm w-100 text-start d-flex justify-content-between align-items-start gap-2 {(isActive ? "btn-primary" : "btn-outline-secondary")}")'
                                            @onclick="() => SelectTour(tour)">
                                        <span class="flex-grow-1">
                                            @if (DateViewMode == "month")
                                            {
                                                <small class="text-muted">@tour.TourDate.ToString("MMM d")</small>
                                                <br />
                                            }
                                            <i class="bi bi-clock me-1"></i>@tour.DisplayTime
                                            <br />
                                            <small>@tour.ListDisplayName (@tour.TotalBookings bookings)</small>
                                        </span>
                                        @if (tour.IsSubmitted)
                                        {
                                            <i class="bi bi-check-circle-fill text-success align-self-start" style="font-size: 1.1rem;" title="Report submitted"></i>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        
        <!-- Right Panel: Tour Detail & Report -->
        <div class="col-md-9">
            @if (SelectedTour == null)
            {
                <div class="card">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-arrow-left-circle" style="font-size: 3rem;"></i>
                        <div class="mt-3">Select a tour from the left panel to view details</div>
                    </div>
                </div>
            }
            else if (isLoadingReport)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Loading report...</p>
                    </div>
                </div>
            }
            else if (Report != null)
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@SelectedDate.ToString("dddd, MMMM d, yyyy")</strong>
                            <span class="badge border ms-2">@Report.Walkers.Sum(w => w.ActualAttendees) guests</span>
                        </div>
                        <div>
                            @if (Report.IsSubmitted)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Submitted</span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Tour Header -->
                        <div class="mb-3 p-2 border rounded guide-tour-header-row">
                            <div>
                                <h5 class="mb-0">@SelectedTour.TourName</h5>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@SelectedTour.DisplayTime</small>
                            </div>
                            <div class="guide-tour-header-actions">
                                <div class="form-check form-switch guide-contact-mode-lock mb-0">
                                    <input class="form-check-input m-0"
                                           type="checkbox"
                                           role="switch"
                                           checked="@isContactModeLockEnabled"
                                           @onchange="OnContactModeLockChanged"
                                           title="Lock to Blank mode"
                                           aria-label="Lock contact mode to Blank" />
                                </div>
                                <select class="form-select form-select-sm guide-contact-mode-select"
                                        value="@contactMessageMode"
                                        @onchange="OnContactMessageModeChanged"
                                        disabled="@isContactModeLockEnabled"
                                        title="Contact mode">
                                    <option value="@ContactModeBlank">Blank</option>
                                    <option value="@ContactModeGalleryLink">Gallery Link</option>
                                    <option value="@ContactModeGreeting">Greeting</option>
                                </select>
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning guide-tour-bulk-btn"
                                        @onclick="OpenBulkGuideContactDialog"
                                        title="Bulk contact guide">
                                    <i class="bi bi-chat-dots-fill"></i>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Walker List with Expanders -->
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">
                                <i class="bi bi-building me-1"></i>All Bookings
                                <span class="badge border ms-1">@Report.Walkers.Count bookings</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0 guide-bookings-table">
                                <thead>
                                    <tr>
                                        <th style="width: 30px;"></th>
                                        <th>Name</th>
                                        <th class="text-center" style="width: 80px;" title="Adults" aria-label="Adults">
                                            <span aria-hidden="true">&#x1F9D3;</span>
                                            <span class="visually-hidden">Adults</span>
                                        </th>
                                        <th class="text-center" style="width: 80px;" title="Children" aria-label="Children">
                                            <span aria-hidden="true">&#x1F9D2;</span>
                                            <span class="visually-hidden">Children</span>
                                        </th>
                                        <th class="text-center" style="width: 72px;" title="Contact" aria-label="Contact">
                                            <i class="bi bi-telephone-outbound-fill" aria-hidden="true"></i>
                                            <span class="visually-hidden">Contact</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var walker in Report.Walkers)
                                    {
                                        var isPositive = walker.ReviewStatus == "Positive";
                                        var isNegative = walker.ReviewStatus == "Negative";
                                        var isNoContact = walker.ReviewStatus == "NoContact";
                                        
                                        <!-- Main Walker Row -->
                                        <tr>
                                            <td>
                                                <button class="btn btn-sm btn-link p-0" @onclick="() => walker.IsExpanded = !walker.IsExpanded">
                                                    <i class='@($"bi bi-chevron-{(walker.IsExpanded ? "down" : "right")}")'></i>
                                                </button>
                                            </td>
                                            <td class="booking-name-cell">
                                                <div class="fw-semibold text-break">@walker.CustomerName</div>
                                                @if (!string.IsNullOrWhiteSpace(walker.VendorName))
                                                {
                                                    <div class="small text-muted text-break">@walker.VendorName</div>
                                                }
                                                <div class="walker-status-actions mt-1">
                                                    <button type="button"
                                                            class='@($"btn btn-sm btn-outline-info checkin-icon-btn {(walker.IsCheckedIn ? "checked" : "")}")'
                                                            disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                            @onclick='() => ToggleCheckInButtonAsync(walker)'
                                                            title="@(walker.IsCheckedIn ? "Checked in. Tap to mark not checked in." : "Not checked in. Tap to check in.")"
                                                            aria-label="@(walker.IsCheckedIn ? "Mark not checked in" : "Mark checked in")">
                                                        @if (walker.IsCheckedIn)
                                                        {
                                                            <i class="bi bi-person-check-fill text-success"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-clipboard2-check-fill text-body"></i>
                                                        }
                                                    </button>
                                                    <button type="button" class='@($"btn btn-sm status-positive-btn {(isPositive ? "btn-success" : "btn-outline-success")}")' 
                                                            disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                            @onclick='() => ToggleReviewStatusAsync(walker, "Positive")' 
                                                            title="Thumbs Up">
                                                        <i class="bi bi-hand-thumbs-up-fill"></i>
                                                    </button>
                                                    <button type="button" class='@($"btn btn-sm status-nocontact-btn {(isNoContact ? "btn-warning" : "btn-outline-warning")}")' 
                                                            disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                            @onclick='() => ToggleReviewStatusAsync(walker, "NoContact")' 
                                                            title="No Contact">
                                                        <i class="bi bi-person-x-fill"></i>
                                                    </button>
                                                    <button type="button" class='@($"btn btn-sm status-negative-btn {(isNegative ? "btn-danger" : "btn-outline-danger")}")' 
                                                            disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                            @onclick='() => ToggleReviewStatusAsync(walker, "Negative")' 
                                                            title="Thumbs Down">
                                                        <i class="bi bi-hand-thumbs-down-fill"></i>
                                                    </button>
                                                    @if (walker.VendorName == "Walk-Up")
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger" 
                                                                @onclick="() => DeleteWalkUpGuest(walker.BookingId)" 
                                                                title="Delete Guest">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    } 
                                                </div>
                                            </td>
                                            @* Replaced by icon toggle button under walker name. *@
                                            @* <td class="text-center">
                                                <div class="form-check form-switch d-inline-block mb-0">
                                                    <input class="form-check-input" type="checkbox" role="switch"
                                                           checked="@walker.IsCheckedIn" 
                                                           disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                           @onchange="@(e => UpdateCheckInAsync(walker, e))" />
                                                </div>
                                            </td> *@
                                            @* Adults *@
                                            <td class="text-center align-middle">
                                                <div class="d-flex flex-column align-items-center gap-0">
                                                    <button class="btn btn-sm btn-link text-success p-0" type="button" 
                                                            disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                            style="font-size: 1.2rem; line-height: 1;"
                                                            @onclick="() => AdjustAdultsAsync(walker, 1)" title="Increase Adults">
                                                        <i class="bi bi-caret-up-fill"></i>
                                                    </button>
                                                    <span class="fw-bold px-1 my-1" style="min-width: 24px;">@walker.ActualAdults</span>
                                                    <button class="btn btn-sm btn-link text-danger p-0" type="button" 
                                                            disabled="@(IsFutureDate || walker.ActualAdults <= 0 || IsAttendanceSavePending(walker))"
                                                            style="font-size: 1.2rem; line-height: 1;"
                                                            @onclick="() => AdjustAdultsAsync(walker, -1)" title="Decrease Adults">
                                                        <i class="bi bi-caret-down-fill"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            @* Children *@
                                            <td class="text-center align-middle">
                                                <div class="d-flex flex-column align-items-center gap-0">
                                                    <button class="btn btn-sm btn-link text-success p-0" type="button" 
                                                            disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                            style="font-size: 1.2rem; line-height: 1;"
                                                            @onclick="() => AdjustChildrenAsync(walker, 1)" title="Increase Children">
                                                        <i class="bi bi-caret-up-fill"></i>
                                                    </button>
                                                    <span class="fw-bold px-1 my-1" style="min-width: 24px;">@walker.ActualChildren</span>
                                                    <button class="btn btn-sm btn-link text-danger p-0" type="button" 
                                                            disabled="@(IsFutureDate || walker.ActualChildren <= 0 || IsAttendanceSavePending(walker))"
                                                            style="font-size: 1.2rem; line-height: 1;"
                                                            @onclick="() => AdjustChildrenAsync(walker, -1)" title="Decrease Children">
                                                        <i class="bi bi-caret-down-fill"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                @{
                                                    var smsActionUrl = GetWalkerSmsActionLink(Report, walker);
                                                    var waActionUrl = GetWalkerWhatsAppActionLink(Report, walker);
                                                    var canLaunchSms = !string.IsNullOrWhiteSpace(smsActionUrl);
                                                    var canLaunchWa = !string.IsNullOrWhiteSpace(waActionUrl);
                                                    var smsButtonClass = GetContactStateButtonClass(walker.SmsContactState, canLaunchSms);
                                                    var waButtonClass = GetContactStateButtonClass(walker.WaContactState, canLaunchWa);
                                                }
                                                <div class="d-inline-flex flex-column align-items-center gap-1">
                                                    @if (canLaunchSms)
                                                    {
                                                        <a href="@smsActionUrl"
                                                           class='@($"btn btn-sm {smsButtonClass} p-1")'
                                                           title="@GetContactActionTitle("SMS", walker.SmsContactState, canLaunchSms)"
                                                           aria-label="SMS">
                                                            <i class="bi bi-chat-dots"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class='@($"btn btn-sm {smsButtonClass} p-1")'
                                                                title="@GetContactActionTitle("SMS", walker.SmsContactState, canLaunchSms)"
                                                                aria-label="SMS"
                                                                disabled>
                                                            <i class="bi bi-chat-dots"></i>
                                                        </button>
                                                    }
                                                    @if (canLaunchWa)
                                                    {
                                                        <a href="@waActionUrl"
                                                           target="_blank"
                                                           rel="noopener"
                                                           class='@($"btn btn-sm {waButtonClass} p-1")'
                                                           title="@GetContactActionTitle("WA", walker.WaContactState, canLaunchWa)"
                                                           aria-label="WhatsApp">
                                                            <i class="bi bi-whatsapp"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class='@($"btn btn-sm {waButtonClass} p-1")'
                                                                title="@GetContactActionTitle("WA", walker.WaContactState, canLaunchWa)"
                                                                aria-label="WhatsApp"
                                                                disabled>
                                                            <i class="bi bi-whatsapp"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-outline-primary p-1" 
                                                            disabled="@IsFutureDate"
                                                            @onclick="() => OpenPhoneEditDialog(walker)" 
                                                            title="Edit Phone">
                                                        <i class="bi bi-telephone"></i>
                                                    </button>
                                                </div>
                                            </td>

                                        </tr>
                                        
                                        <!-- Expandable Details Row -->
                                        @if (walker.IsExpanded)
                                        {
                                            <tr>
                                                <td colspan="5" class="ps-4 border-0">
                                                    <div class="p-2 border rounded">
                                                        <div class="row g-2">
                                                            <div class="col-md-8">
                                                                <label class="form-label small mb-1">Notes</label>
                                                                <textarea class="form-control form-control-sm" rows="2"
                                                                          placeholder="Add notes about this walker..."
                                                                          value="@walker.ReviewNotes"
                                                                          disabled="@(IsFutureDate || IsAttendanceSavePending(walker))"
                                                                          @onchange="@(e => UpdateReviewNotesAsync(walker, e.Value?.ToString()))"></textarea>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label small mb-1">Status</label>
                                                                <div class="small text-muted">
                                                                    @if (walker.ReviewStatus == "Positive")
                                                                    {
                                                                        <i class="bi bi-hand-thumbs-up-fill text-success me-1"></i><span>Positive</span>
                                                                    }
                                                                    else if (walker.ReviewStatus == "Negative")
                                                                    {
                                                                        <i class="bi bi-hand-thumbs-down-fill text-danger me-1"></i><span>Negative</span>
                                                                    }
                                                                    else if (walker.ReviewStatus == "NoContact")
                                                                    {
                                                                        <i class="bi bi-person-x-fill text-warning me-1"></i><span>No Contact</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>No status set</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    
                                    <!-- Walk-up Guest Row -->
                                    <tr>
                                        <td></td>
                                        <td class="text-primary">
                                            <i class="bi bi-person-plus me-1"></i>Walk up Guest
                                        </td>
                                        <td class="text-center text-primary">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <button class="btn btn-sm btn-outline-danger" type="button" 
                                                        @onclick="@(() => ToastService.ShowInfoAsync("Info", "Please remove walk-up guests from the main list above."))"
                                                        title="Remove from list">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <span class="fw-bold px-1">
                                                    @(Report?.Walkers.Count(w => w.VendorName == "Walk-Up") ?? 0)
                                                </span>
                                                <button class="btn btn-sm btn-outline-success" type="button" 
                                                        @onclick="OpenWalkUpDialog"
                                                        title="Add Walk-up Guest">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        </div>

                        @{
                            var headerCanOpenGallery = Report != null && Report.IsSubmitted;
                            var headerHasGallery = Report != null && HasGalleryFile(Report);
                        }
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold"><i class="bi bi-camera me-1"></i>Tour Photos</span>
                                <div class="d-inline-flex align-items-center gap-2">
                                    <a class="btn btn-sm btn-outline-success"
                                       href="@GetMobileUploaderUrl()"
                                       title="Upload photos">
                                        <i class="bi bi-images"></i>
                                    </a>
                                    @if (headerCanOpenGallery && headerHasGallery)
                                    {
                                        <a href="@GetGalleryUrl(Report)"
                                           target="_blank"
                                           rel="noopener"
                                           class="btn btn-sm btn-outline-info"
                                           title="Preview gallery"
                                           aria-label="Preview gallery">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    else if (!headerCanOpenGallery)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info"
                                                disabled
                                                title="Send Report First"
                                                aria-label="Preview gallery (disabled)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info"
                                                disabled
                                                title="Gallery not generated yet"
                                                aria-label="Preview gallery">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                    <span class="d-inline-block" tabindex="0" title="@(IsReportValid ? "" : "Notes required for 'No Contact' guests")">
                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                @onclick="SendReport"
                                                @onclick:preventDefault="true"
                                                disabled="@(isSaving || !IsReportValid || IsFutureDate)"
                                                title="Send report"
                                                aria-label="Send report">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    </span>
                                </div>
                            </div>
                            @if (showPhotoSyncHint)
                            {
                                <div class='@($"alert {photoSyncHintAlertClass} d-flex justify-content-between align-items-center py-2 mb-2")' role="status">
                                    <span class="small">@photoSyncHintMessage</span>
                                    <button class="btn btn-sm btn-outline-warning" @onclick="RefreshPhotos" disabled="@isUploadingPhotos" title="Retry photo sync">
                                        @if (isUploadingPhotos) { <span class="spinner-border spinner-border-sm me-1"></span><span>Syncing</span> }
                                        else { <i class="bi bi-arrow-clockwise me-1"></i><span>Try Again</span> }
                                    </button>
                                </div>
                            }
                            @if (ReportPhotos.Count > 0)
                            {
                                <TourPhotoGallery 
                                    Photos="ReportPhotos" 
                                    AllowDelete="false" />
                            }
                            else
                            {
                                <div class="text-muted small">No photos uploaded for this tour.</div>
                            }
                        </div>

                        <!-- Gallery Link Copy Section -->
                        @if (Report != null && !string.IsNullOrEmpty(Report.PublicId))
                        {
                            var canOpenGallery = Report.IsSubmitted;
                            <div class="mb-3">
                                @if (!canOpenGallery)
                                {
                                    <div class="d-inline-flex align-items-center gap-1 badge text-bg-info mb-2">
                                        <i class="bi bi-info-circle"></i>
                                        <span>Links available after submitting report</span>
                                    </div>
                                }
                                <div class="input-group">
