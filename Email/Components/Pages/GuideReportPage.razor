    private int? ResolvePreferredGuideForSelectedTour()
    {
        var candidates = new[] { SelectedGuideId, Report?.GuideId, SelectedTour?.GuideId };
        foreach (var candidate in candidates)
        {
            if (candidate.HasValue && candidate.Value > 0 && Guides.Any(g => g.Id == candidate.Value))
