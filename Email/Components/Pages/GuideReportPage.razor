@* Bulk Guide Contact Dialog *@
@if (showBulkGuideContactDialog && Report != null && SelectedTour != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-chat-dots-fill me-2 text-warning"></i>Bulk Contact Guide</h5>
                    <button type="button" class="btn-close" @onclick="CloseBulkGuideContactDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6 class="mb-2">Tour Info</h6>
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td class="text-muted">Tour</td>
                                    <td>@SelectedTour.TourName</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Time</td>
                                    <td>@SelectedTour.DisplayTime</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Date</td>
                                    <td>@SelectedDate.ToString("dddd, MMM d, yyyy")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Totals</td>
                                    <td>@Report.Walkers.Count bookings / @Report.Walkers.Sum(w => w.ActualAttendees) guests</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Guide Name</label>
                            <input type="text"
                                   class="form-control"
                                   value="@bulkGuideGuideName"
                                   list="bulkGuideContactGuideLookup"
                                   placeholder="Type or pick a guide"
                                   @oninput="OnBulkGuideNameInput" />
                            <datalist id="bulkGuideContactGuideLookup">
                                @foreach (var guide in Guides.OrderBy(x => x.FirstName).ThenBy(x => x.LastName))
                                {
                                    <option value="@GetGuideDisplayName(guide)"></option>
                                }
                            </datalist>
                            <div class="mt-2">
                                <label class="form-label mb-1">Guide Phone</label>
                                <input type="tel"
                                       class="form-control"
                                       value="@bulkGuidePhone"
                                       placeholder="+12125551234"
                                       @oninput="OnBulkGuidePhoneInput" />
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-2 bulk-guide-mode-wrap">
                        <button type="button"
                                class='@($"btn btn-sm {(bulkGuideChannelMode == BulkGuideModeWaApp ? "btn-success" : "btn-outline-secondary")}")'
                                @onclick='() => SetBulkGuideChannelMode(BulkGuideModeWaApp)'>WA App</button>
                        <button type="button"
                                class='@($"btn btn-sm {(bulkGuideChannelMode == BulkGuideModeWaWeb ? "btn-primary" : "btn-outline-secondary")}")'
                                @onclick='() => SetBulkGuideChannelMode(BulkGuideModeWaWeb)'>WA Web</button>
                        <button type="button"
                                class='@($"btn btn-sm {(bulkGuideChannelMode == BulkGuideModeSmsApp ? "btn-primary" : "btn-outline-secondary")}")'
                                @onclick='() => SetBulkGuideChannelMode(BulkGuideModeSmsApp)'>SMS App</button>
                        <button type="button"
                                class='@($"btn btn-sm {(bulkGuideChannelMode == BulkGuideModeSmsWeb ? "btn-primary" : "btn-outline-secondary")}")'
                                @onclick='() => SetBulkGuideChannelMode(BulkGuideModeSmsWeb)'>SMS Web</button>
                        <button type="button"
                                class='@($"btn btn-sm {(bulkGuideChannelMode == BulkGuideModeCopy ? "btn-dark" : "btn-outline-secondary")}")'
                                @onclick='() => SetBulkGuideChannelMode(BulkGuideModeCopy)'>Copy</button>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Message Payload</label>
                        <textarea class="form-control"
                                  rows="12"
                                  value="@bulkGuideMessage"
                                  @oninput="OnBulkGuideMessageInput"></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted">@GetBulkGuideModeDescription()</small>
                            <small class='@($"{(bulkGuideMessage.Length > 3500 ? "text-warning" : "text-muted")}")'>@bulkGuideMessage.Length characters</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseBulkGuideContactDialog">Cancel</button>
                    @if (bulkGuideChannelMode == BulkGuideModeCopy)
                    {
                        <button type="button"
                                class="btn btn-outline-dark"
                                @onclick="CopyBulkGuideTextAsync"
                                disabled="@string.IsNullOrWhiteSpace(bulkGuideCopyText)">
                            <i class="bi bi-clipboard me-1"></i>Copy
                        </button>
                    }
                    else if (!string.IsNullOrWhiteSpace(GetBulkGuideLaunchUrl()))
                    {
                        <a class='@($"btn {GetBulkGuideLaunchButtonClass()}")'
                           href="@GetBulkGuideLaunchUrl()"
                           target="_blank"
                           rel="noopener"
                           @onclick="CloseBulkGuideContactDialog">
                            <i class='@($"{GetBulkGuideLaunchIconClass()} me-1")'></i>@GetBulkGuideLaunchLabel()
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" disabled>
                            <i class='@($"{GetBulkGuideLaunchIconClass()} me-1")'></i>@GetBulkGuideLaunchLabel()
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* Walk-Up Guest Dialog *@
@if (showWalkUpDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add Walk-Up Guest</h5>
                    <button type="button" class="btn-close" @onclick="() => showWalkUpDialog = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Guest Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="walkUpGuest.CustomerName" placeholder="John Doe" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Phone <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" @bind="walkUpGuest.Phone" placeholder="+1234567890" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Email <span class="text-muted">(Optional)</span></label>
                            <input type="email" class="form-control" @bind="walkUpGuest.Email" placeholder="john@example.com" />
                        </div>
                    </div>
                    
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Adults</label>
                            <div class="input-group">
                                <button class="btn btn-outline-secondary" @onclick="() => { if(walkUpGuest.ActualAdults > 0) walkUpGuest.ActualAdults--; }">-</button>
                                <input type="number" class="form-control text-center" @bind="walkUpGuest.ActualAdults" readonly />
                                <button class="btn btn-outline-secondary" @onclick="() => walkUpGuest.ActualAdults++">+</button>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Children</label>
                            <div class="input-group">
                                <button class="btn btn-outline-secondary" @onclick="() => { if(walkUpGuest.ActualChildren > 0) walkUpGuest.ActualChildren--; }">-</button>
                                <input type="number" class="form-control text-center" @bind="walkUpGuest.ActualChildren" readonly />
                                <button class="btn btn-outline-secondary" @onclick="() => walkUpGuest.ActualChildren++">+</button>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Notes / Message</label>
                        <textarea class="form-control" rows="2" @bind="walkUpGuest.ReviewNotes" placeholder="Any special requests or notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showWalkUpDialog = false">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveWalkUpGuest" disabled="@isSaving">
                         @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                         Save Guest
                    </button>
                </div>
            </div>
        </div>
    </div>
}



@* Settings Drawer (Offcanvas) *@
@if (showSettings)
{
    <div class="offcanvas offcanvas-end show" tabindex="-1" style="visibility: visible;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title"><i class="bi bi-gear me-2"></i>Settings</h5>
            <button type="button" class="btn-close" @onclick="ToggleSettings"></button>
        </div>
        <div class="offcanvas-body">
            @if (currentGuideProfile != null)
            {
                <!-- Profile Settings -->
                <div class="card mb-3">
                    <div class="card-header fw-bold">Profile Info</div>
                    <div class="card-body">
                         <div class="mb-3">
                            <label class="form-label small">Email (Username)</label>
                            <input type="email" class="form-control" @bind="editEmail" />
                            <div class="form-text small">Updating this will change your login.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Phone Number</label>
                            <input type="tel" class="form-control" @bind="editPhone" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="SaveProfile" disabled="@isSavingProfile">
                            @if (isSavingProfile) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Save Changes
                        </button>
                    </div>
                </div>

                <!-- Photo Settings -->
                <div class="card mb-3">
                    <div class="card-header fw-bold">Profile Photo</div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(editGuideImage))
                        {
                            <div class="position-relative d-inline-block mb-3">
                                <img src="@editGuideImage" class="img-thumbnail rounded-circle" style="width: 120px; height: 120px; object-fit: cover;" />
                                <button class="btn btn-sm btn-danger position-absolute top-0 start-100 translate-middle rounded-circle p-1" 
                                        @onclick="DeletePhoto" title="Remove Photo" style="width: 24px; height: 24px; line-height: 1;">
                                    <i class="bi bi-x small"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 text-muted">
                                <i class="bi bi-person-circle" style="font-size: 4rem;"></i>
                                <p class="small">No photo uploaded</p>
                            </div>
                        }
                        
                        <div class="mt-2">
                             <InputFile OnChange="HandlePhotoUpload" class="form-control form-control-sm" accept=".jpg,.jpeg,.png" disabled="@isSavingPhoto" />
                             @if (isSavingPhoto)
                             {
                                 <div class="small mt-2">
                                     <span class="spinner-border spinner-border-sm me-1"></span>
                                     Saving photo...
                                 </div>
                             }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 mb-2 d-block"></i>
                    <strong>Profile Not Found</strong>
                    <p class="small mb-2">
                        Your login <code>@currentUsername</code> is not linked to any Guide profile.
                    </p>
                    <p class="small mb-0 text-muted">
                        This usually happens if the Guide record has no email set.
                    </p>
                </div>
            }

            <hr/>
            
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Button Font Size</label>
                <div class="list-group">
                    <button class='@($"list-group-item list-group-item-action d-flex justify-content-between align-items-center {(_buttonFontSize == "font-normal" ? "active" : "")}")'
                            @onclick='() => SetFontSize("font-normal")'>
                        <span>Normal</span>
                        @if (_buttonFontSize == "font-normal") { <i class="bi bi-check-lg"></i> }
                    </button>
                    <button class='@($"list-group-item list-group-item-action d-flex justify-content-between align-items-center {(_buttonFontSize == "font-large" ? "active" : "")}")'
                            @onclick='() => SetFontSize("font-large")'>
                        <span style="font-size: 1.15rem;">Large</span>
                        @if (_buttonFontSize == "font-large") { <i class="bi bi-check-lg"></i> }
                    </button>
                    <button class='@($"list-group-item list-group-item-action d-flex justify-content-between align-items-center {(_buttonFontSize == "font-supersize" ? "active" : "")}")'
                            @onclick='() => SetFontSize("font-supersize")'>
                        <span style="font-size: 1.4rem;">Supersize</span>
                        @if (_buttonFontSize == "font-supersize") { <i class="bi bi-check-lg"></i> }
                    </button>
                </div>
                <div class="mt-3 small text-muted fst-italic">
                    <i class="bi bi-info-circle me-1"></i> Changes apply to all buttons on this page.
                </div>
            </div>
        </div>
    </div>
    <div class="offcanvas-backdrop fade show" @onclick="ToggleSettings"></div>
}

