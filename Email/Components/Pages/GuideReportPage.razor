        }

        bulkGuideChannelMode = BulkGuideModeWaApp;
        bulkGuideSelectedGuideId = ResolvePreferredGuideForSelectedTour();
        if (bulkGuideSelectedGuideId.HasValue)
        {
            var matchedGuide = Guides.FirstOrDefault(g => g.Id == bulkGuideSelectedGuideId.Value);
            if (matchedGuide != null)
            {
                bulkGuideGuideName = GetGuideDisplayName(matchedGuide);
                bulkGuidePhone = matchedGuide.Phone ?? string.Empty;
            }
            else
            {
                bulkGuideGuideName = string.Empty;
                bulkGuidePhone = string.Empty;
            }
