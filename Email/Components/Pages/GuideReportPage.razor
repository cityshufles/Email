    private void RefreshBulkGuideUrls()
    {
        var body = BuildBulkGuideMessageBody();
        bulkGuideWaAppUrl = BuildWhatsAppAppUrl(bulkGuidePhone, body);
        bulkGuideWaWebUrl = BuildWhatsAppWebUrl(bulkGuidePhone, body);
        bulkGuideSmsAppUrl = BuildSmsAppUrl(bulkGuidePhone, body);
        bulkGuideSmsWebUrl = BuildSmsWebUrl(bulkGuidePhone, body);
    }

    private string BuildWhatsAppAppUrl(string? phone, string body)
    {
        var waPhone = GetWhatsappPhoneDigits(phone);
        if (string.IsNullOrWhiteSpace(waPhone))
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(body)
            ? $"whatsapp://send?phone={waPhone}"
            : $"whatsapp://send?phone={waPhone}&text={Uri.EscapeDataString(body)}";
    }

    private string BuildWhatsAppWebUrl(string? phone, string body)
    {
        var waPhone = GetWhatsappPhoneDigits(phone);
        if (string.IsNullOrWhiteSpace(waPhone))
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(body)
            ? $"https://wa.me/{waPhone}"
            : $"https://wa.me/{waPhone}?text={Uri.EscapeDataString(body)}";
    }

    private string BuildSmsAppUrl(string? phone, string body)
    {
        var e164 = FormatPhoneToE164Local(phone);
        if (string.IsNullOrWhiteSpace(e164))
        {
            return string.Empty;
        }

        return $"sms:{e164}&body={Uri.EscapeDataString(body ?? string.Empty)}";
    }

    private string BuildSmsWebUrl(string? phone, string body)
    {
        // Locked behavior: SMS Web aliases SMS App deeplink.
        return BuildSmsAppUrl(phone, body);
    }

    private static string FormatPhoneToE164Local(string? phone)
    {
        var digits = NormalizePhoneDigits(phone);
        if (string.IsNullOrWhiteSpace(digits))
        {
            return string.Empty;
        }

        if (digits.Length == 10)
        {
            return $"+1{digits}";
        }

        if (digits.Length == 11 && digits.StartsWith("1", StringComparison.Ordinal))
        {
            return $"+{digits}";
        }

        if ((phone ?? string.Empty).TrimStart().StartsWith("+", StringComparison.Ordinal))
        {
            return $"+{digits}";
        }

        return $"+{digits}";
    }

    private static string GetWhatsappPhoneDigits(string? phone)
    {
        var e164 = FormatPhoneToE164Local(phone);
        return new string((e164 ?? string.Empty).Where(char.IsDigit).ToArray());
    }

