    private string BuildBulkGuideCopyText()
    {
        if (Report == null || SelectedTour == null)
        {
            return string.Empty;
        }

        var sb = new System.Text.StringBuilder();
        var tourTime = SelectedTour.DisplayTime?.Trim();
        var tourHeader = string.IsNullOrWhiteSpace(tourTime)
            ? SelectedTour.TourName
            : $"{SelectedTour.TourName} - {tourTime}";

        sb.AppendLine(tourHeader);
        sb.AppendLine(SelectedDate.ToString("dddd, MMMM d, yyyy"));
        sb.AppendLine();

        var totalBookings = Report.Walkers.Count;
        var totalGuests = Report.Walkers.Sum(GetWalkerGuestCount);
        sb.AppendLine($"{totalBookings} bookings {totalGuests} guests");
        sb.AppendLine();

        var vendorGroups = Report.Walkers.GroupBy(w =>
            string.IsNullOrWhiteSpace(w.VendorName) ? "Unknown Vendor" : w.VendorName.Trim());

        foreach (var vendorGroup in vendorGroups)
        {
            var vendorBookings = vendorGroup.Count();
            var vendorGuests = vendorGroup.Sum(GetWalkerGuestCount);
            sb.AppendLine($"*{vendorGroup.Key} {vendorBookings}/{vendorGuests}*");
            sb.AppendLine();

            foreach (var walker in vendorGroup)
            {
                var name = string.IsNullOrWhiteSpace(walker.CustomerName) ? "Unknown" : walker.CustomerName.Trim();
                var attendeesDisplay = string.IsNullOrWhiteSpace(walker.AttendeeDisplay)
                    ? GetWalkerGuestCount(walker).ToString()
                    : walker.AttendeeDisplay;
                sb.AppendLine($"{name} {attendeesDisplay}");
                sb.AppendLine(string.IsNullOrWhiteSpace(walker.Phone) ? "No number" : walker.Phone.Trim());
                sb.AppendLine();
            }
        }

        return sb.ToString().TrimEnd();
    }

    private static int GetWalkerGuestCount(GuideReportWalker walker)
    {
        if (walker.ActualAttendees > 0)
        {
            return walker.ActualAttendees;
        }

        var adults = Math.Max(0, walker.ActualAdults);
        var children = Math.Max(0, walker.ActualChildren);
        return adults + children;
    }

