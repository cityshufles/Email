@if (showPhoneEditDialog && editingWalker != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-telephone-plus me-2"></i>Edit Phone</h5>
                    <button type="button" class="btn-close" @onclick="() => showPhoneEditDialog = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Phone Number</label>
                        <input type="tel" class="@($"form-control {(isPhoneError ? "border-danger text-danger" : "")}")" 
                               @bind="newPhone" 
                               placeholder="+1234567890" />
                        <div class="@(isPhoneError ? "text-danger fw-bold small" : "form-text small")">
