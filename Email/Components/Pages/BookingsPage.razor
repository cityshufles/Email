@page "/bookings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Email.Models.Reports
@using Email.Models
@using Email.Services
@inject IBookingsInboxService BookingsInboxService
@inject IVendorsApiService VendorsService
@inject ITourEmailsService EmailsService
@inject ITourMessagesApiService TourMessagesService
@inject IGuideReportService GuideReportService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<PageTitle>Bookings Dashboard</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Bookings Dashboard</h4>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <label class="small text-muted">Rows</label>
            <select class="form-select form-select-sm" style="width: 100px;" @bind="SelectedLimit" @bind:after="LoadBookingsAsync">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="500">500</option>
                <option value="5000">All</option>
            </select>
            <label class="small text-muted">Sort</label>
            <select class="form-select form-select-sm" style="width: 170px;" @bind="SelectedOrderBy" @bind:after="LoadBookingsAsync">
                <option value="booking_date">Booking date</option>
                <option value="tour_date">Tour date</option>
                <option value="group_size">Group size</option>
                <option value="language">Language</option>
            </select>
            <label class="small text-muted">Language</label>
            <select class="form-select form-select-sm" style="width: 130px;" @bind="SelectedLanguageFilter" @bind:after="LoadBookingsAsync">
                <option value="">All</option>
                <option value="English">English</option>
                <option value="Spanish">Spanish</option>
                <option value="French">French</option>
                <option value="Portuguese">Portuguese</option>
                <option value="German">German</option>
            </select>
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadBookingsAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>

    @* Vendor filter pills *@
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button class='@($"btn btn-sm {(AllVendors ? "btn-primary" : "btn-outline-secondary")}")' @onclick="SelectAllVendors">All</button>
        @foreach (var vendor in VendorFilters)
        {
            var isSelected = SelectedVendors.Contains(vendor);
            <button class='@($"btn btn-sm {(isSelected ? "btn-primary" : "btn-outline-secondary")}")' @onclick="() => ToggleVendor(vendor)">@vendor</button>
        }
    </div>

    @* Search bar *@
    <div class="mb-3">
        <div class="input-group input-group-sm" style="max-width: 400px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" type="text" placeholder="Search by name, phone, or email..." @bind="SearchText" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
            }
        </div>
        <small class="text-muted">@GetResultsLabel()</small>
    </div>

    @if (selectedBookingIds.Count > 0)
    {
        <div class="alert alert-primary d-flex flex-wrap align-items-center gap-2 py-2">
            <span class="fw-semibold">@selectedBookingIds.Count selected</span>
            <button class="btn btn-sm btn-primary" @onclick="DownloadSelectedVcardsAsync">
                <i class="bi bi-download me-1"></i>Download vCards
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">Clear</button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted">
            <div class="spinner-border me-2"></div>Loading bookings...
        </div>
    }
    else if (GetVisibleBookings().Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            @(string.IsNullOrWhiteSpace(SearchText) ? "No bookings found." : "No bookings match your search.")
        </div>
    }
    else
    {
        @foreach (var dayGroup in GetBookingsByDay())
        {
            var dayKey = dayGroup.Key;
            var dayBookings = dayGroup.Value;
            var collapsed = collapsedDays.Contains(dayKey);
            <div class="card mb-3 booking-day-group">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button class="btn btn-link text-decoration-none fw-semibold p-0" @onclick="() => ToggleDay(dayKey)">
                        <i class="bi @(collapsed ? "bi-chevron-right" : "bi-chevron-down") me-1"></i>
                        @FormatDayHeader(dayKey)
                        <span class="badge text-bg-secondary ms-1">@dayBookings.Count booking(s)</span>
                        <span class="badge text-bg-info ms-1">@dayBookings.Sum(b => b.NumberOfAttendees ?? 0) guest(s)</span>
                    </button>
                    <button class="btn btn-sm btn-outline-info" @onclick="() => DownloadDayVcardsAsync(dayBookings)" title="Download all vCards for this day">
                        <i class="bi bi-download me-1"></i>Download all vCards
                    </button>
                </div>
                @if (!collapsed)
                {
                    <div class="card-body">
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                            @foreach (var booking in dayBookings)
                            {
                <div class="col">
                    <div class="card h-100 bookings-card">
                        <div class="card-body pb-2">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <input type="checkbox" class="form-check-input mt-0"
                                           checked="@selectedBookingIds.Contains(booking.BookingId)"
                                           @onchange="() => ToggleSelect(booking.BookingId)"
                                           title="Select for bulk vCard download" />
                                    <h6 class="card-title mb-0 fw-bold">@booking.CustomerName</h6>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(booking.BookingStatus))
                                {
                                    <span class='@($"badge {GetStatusBadgeClass(booking)}")'>@FormatEventType(booking)</span>
                                }
                                else
                                {
                                    <span class='@($"badge {GetStatusBadgeClass(booking)}")'>@FormatEventType(booking)</span>
                                }
                            </div>

                            <div class="small mb-1">
                                <i class="bi bi-geo-alt me-1 text-muted"></i>@booking.TourName
                            </div>
                            <div class="small mb-1 text-muted">
                                <i class="bi bi-calendar me-1"></i>@FormatTourDateTime(booking.TourDate, booking.TourTime)
                            </div>

                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class='@($"badge {GetVendorBadgeClass(booking.VendorName)}")'>@booking.VendorName</span>
                                @if (!string.IsNullOrWhiteSpace(booking.Language))
                                {
                                    <span class="badge text-bg-info">@booking.Language</span>
                                }
                                @if (booking.IsReturningGuest)
                                {
                                    <span class="badge text-bg-primary" title="@booking.CustomerBookingCount booking(s)"><i class="bi bi-arrow-repeat me-1"></i>Returning</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light text-dark border">First-time</span>
                                }
                                @if (booking.Responded)
                                {
                                    <span class="badge text-bg-success"><i class="bi bi-reply-fill me-1"></i>Replied</span>
                                }
                                @if (booking.NeedsNumber)
                                {
                                    <span class="badge text-bg-warning">needs number</span>
                                }
                            </div>

                            @if (booking.NumberOfAttendees.HasValue)
                            {
                                <div class="small mb-2">
                                    <i class="bi bi-people me-1 text-muted"></i>
                                    <strong>@booking.NumberOfAttendees</strong> attendee(s)
                                    @if (booking.NumberOfAdults.HasValue || booking.NumberOfChildren.HasValue)
                                    {
                                        <span class="text-muted"> (@(booking.NumberOfAdults ?? 0) adults, @(booking.NumberOfChildren ?? 0) children)</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            @if (allTemplates.Count > 0)
                            {
                                <div class="mb-2">
                                    <label class="form-label small mb-0 text-muted">Message to send</label>
                                    <select class="form-select form-select-sm"
                                            value="@(selectedTemplateByBooking.TryGetValue(booking.BookingId, out var selTid) ? selTid : 0)"
                                            @onchange="(e) => OnTemplateSelected(booking.BookingId, e)">
                                        @foreach (var t in allTemplates)
                                        {
                                            <option value="@t.Id">@t.MessageName</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.CustomerPhone))
                            {
                                <div class="d-flex flex-wrap gap-3 align-items-start mb-2">
                                    @* SMS quick-send (anchor: OS handles protocol, no circuit drop) + 4-state circle *@
                                    <div class="d-flex flex-column align-items-center">
                                        <a class="btn btn-sm btn-outline-primary" href="@BuildSmsUrl(booking.CustomerPhone, BuildMessageBody(booking))" @onclick='() => MarkQuickSendAsync(booking, "sms")' title="Send SMS (auto-selects First-time/Returning template)">
                                            <i class="bi bi-chat-dots me-1"></i>SMS
                                        </a>
                                        <button class="btn btn-link btn-sm p-0 mt-1" title="@GetStateToggleTitle("SMS", booking.SmsContactState)" @onclick='() => CycleStateAsync(booking, "sms")'>
                                            <i class="bi bi-circle-fill @GetStateColorClass(booking.SmsContactState)"></i>
                                        </button>
                                    </div>
                                    @* WhatsApp quick-send (anchor) + 4-state circle *@
                                    <div class="d-flex flex-column align-items-center">
                                        <a class="btn btn-sm btn-outline-success" href="@BuildWhatsAppUrl(booking.CustomerPhone, BuildMessageBody(booking))" @onclick='() => MarkQuickSendAsync(booking, "wa")' title="Send WhatsApp (auto-selects First-time/Returning template)">
                                            <i class="bi bi-whatsapp me-1"></i>WhatsApp
                                        </a>
                                        <button class="btn btn-link btn-sm p-0 mt-1" title="@GetStateToggleTitle("WhatsApp", booking.WaContactState)" @onclick='() => CycleStateAsync(booking, "wa")'>
                                            <i class="bi bi-circle-fill @GetStateColorClass(booking.WaContactState)"></i>
                                        </button>
                                    </div>
                                    @* Platform (binary) = contacted on the booking platform *@
                                    <div class="d-flex flex-column align-items-center">
                                        <span class="small text-muted" title="Mark when you've messaged this guest on the booking platform (Viator/GYG inbox)">On platform</span>
                                        <button class="btn btn-link btn-sm p-0 mt-1" title="@GetPlatformToggleTitle(booking.PlatformContactState)" @onclick="() => TogglePlatformAsync(booking)">
                                            <i class="@GetPlatformIconClass(booking.PlatformContactState)"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @* No phone → message must be sent on the platform; copy it to paste there *@
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                    <span class="small text-muted"><i class="bi bi-telephone-x me-1"></i>No phone</span>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => CopyMessageAsync(booking)" title="Copy the message to paste on the booking platform">
                                        <i class="bi bi-clipboard me-1"></i>Copy message
                                    </button>
                                    <div class="d-flex flex-column align-items-center">
                                        <span class="small text-muted" title="Mark when you've messaged this guest on the booking platform">On platform</span>
                                        <button class="btn btn-link btn-sm p-0" title="@GetPlatformToggleTitle(booking.PlatformContactState)" @onclick="() => TogglePlatformAsync(booking)">
                                            <i class="@GetPlatformIconClass(booking.PlatformContactState)"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button class="btn btn-sm @(booking.Responded ? "btn-success" : "btn-outline-secondary")" @onclick="() => ToggleRespondedAsync(booking)" title="Mark whether the guest has responded at all">
                                    <i class="bi bi-reply me-1"></i>@(booking.Responded ? "Responded" : "No reply")
                                </button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => CopyMessageAsync(booking)" title="Copy the templated message">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => BeginEdit(booking)" title="Edit guest name / phone / email">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info" @onclick="() => DownloadVcardAsync(booking)" title="Download vCard">
                                    <i class="bi bi-person-vcard"></i>
                                </button>
                                <a href="@($"/guest/{booking.CustomerId}")" class="btn btn-sm btn-outline-secondary ms-auto" title="Guest profile & history">
                                    <i class="bi bi-person-lines-fill"></i>
                                </a>
                            </div>
                            @if (editingBookingId == booking.BookingId)
                            {
                                <div class="border rounded p-2 mt-2">
                                    <div class="mb-1"><label class="form-label small mb-0">Name</label>
                                        <input class="form-control form-control-sm" @bind="editName" /></div>
                                    <div class="mb-1"><label class="form-label small mb-0">Phone</label>
                                        <input class="form-control form-control-sm" @bind="editPhone" placeholder="+1..." /></div>
                                    <div class="mb-2"><label class="form-label small mb-0">Email</label>
                                        <input class="form-control form-control-sm" @bind="editEmail" /></div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(booking)" disabled="@isSavingEdit">
                                            @if (isSavingEdit) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            Save
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<BookingsLiveListItem> Bookings { get; set; } = new();
    private List<string> VendorFilters { get; set; } = new();
    private HashSet<string> SelectedVendors { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private bool AllVendors { get; set; } = true;
    private bool isLoading;
    private int SelectedLimit { get; set; } = 100;
    private string SelectedOrderBy { get; set; } = "booking_date";
    private string SelectedLanguageFilter { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;

    // Command-center: message templates + busy guard for contact-state toggles
    private string? firstTimeTemplate;
    private string? returningTemplate;
    private List<DbTourMessage> allTemplates = new();
    private int firstTimeTemplateId;
    private int returningTemplateId;
    private readonly Dictionary<int, int> selectedTemplateByBooking = new();
    private readonly HashSet<string> busyStateKeys = new();
    private readonly HashSet<int> selectedBookingIds = new();
    private readonly HashSet<string> collapsedDays = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVendorsAsync();
        await LoadTemplatesAsync();
        await LoadBookingsAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        try
        {
            var msgs = await TourMessagesService.GetTourMessagesAsync();
            allTemplates = msgs.Where(m => m.IsActive).OrderBy(m => m.MessageName).ToList();
            var ft = msgs.FirstOrDefault(m => string.Equals(m.MessageName, "First-Time Guest", StringComparison.OrdinalIgnoreCase));
            var rt = msgs.FirstOrDefault(m => string.Equals(m.MessageName, "Returning Guest", StringComparison.OrdinalIgnoreCase));
            firstTimeTemplate = ft?.MessageContent;
            returningTemplate = rt?.MessageContent;
            firstTimeTemplateId = ft?.Id ?? 0;
            returningTemplateId = rt?.Id ?? 0;
        }
        catch { /* templates optional; quick-send still opens blank */ }
    }

    // Default each booking's template to the First-time/Returning one (user can change in the dropdown).
    private void SetDefaultTemplateSelections()
    {
        foreach (var b in Bookings)
        {
            if (selectedTemplateByBooking.ContainsKey(b.BookingId)) continue;
            var def = b.IsReturningGuest ? returningTemplateId : firstTimeTemplateId;
            if (def > 0) selectedTemplateByBooking[b.BookingId] = def;
        }
    }

    private void OnTemplateSelected(int bookingId, ChangeEventArgs e)
    {
        if (int.TryParse(e?.Value?.ToString(), out var tid))
        {
            selectedTemplateByBooking[bookingId] = tid;
        }
    }

    private async Task LoadVendorsAsync()
    {
        var vendors = await VendorsService.GetVendorsAsync();
        VendorFilters = vendors
            .Where(v => v.IsActive && !string.IsNullOrWhiteSpace(v.VendorName))
            .Select(v => v.VendorName.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();
    }

    private async Task LoadBookingsAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            IEnumerable<string>? vendorFilter = AllVendors ? null : SelectedVendors.ToList();
            string? langFilter = string.IsNullOrWhiteSpace(SelectedLanguageFilter) ? null : SelectedLanguageFilter;
            var rows = await BookingsInboxService.GetRecentBookingsAsync(SelectedLimit, vendorFilter, SelectedOrderBy, langFilter);
            Bookings = rows.ToList();
            await MergeContactStatesAsync();
            SetDefaultTemplateSelections();

            foreach (var vendor in Bookings
                .Where(b => !string.IsNullOrWhiteSpace(b.VendorName))
                .Select(b => b.VendorName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase))
            {
                if (!VendorFilters.Contains(vendor, StringComparer.OrdinalIgnoreCase))
                {
                    VendorFilters.Add(vendor);
                }
            }
            VendorFilters = VendorFilters.OrderBy(v => v).ToList();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SelectAllVendors()
    {
        AllVendors = true;
        SelectedVendors.Clear();
        _ = LoadBookingsAsync();
    }

    private void ToggleVendor(string vendor)
    {
        AllVendors = false;
        if (SelectedVendors.Contains(vendor))
        {
            SelectedVendors.Remove(vendor);
        }
        else
        {
            SelectedVendors.Add(vendor);
        }

        if (SelectedVendors.Count == 0)
        {
            AllVendors = true;
        }

        _ = LoadBookingsAsync();
    }

    private List<BookingsLiveListItem> GetVisibleBookings()
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return Bookings;
        }

        var term = SearchText.Trim();
        return Bookings
            .Where(row =>
                (!string.IsNullOrWhiteSpace(row.CustomerName) && row.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(row.CustomerPhone) && row.CustomerPhone.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(row.CustomerEmail) && row.CustomerEmail.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(row.TourName) && row.TourName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(row.BookingCode) && row.BookingCode.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private string GetResultsLabel()
    {
        var visible = GetVisibleBookings().Count;
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return $"{visible} booking(s)";
        }
        return $"{visible} match(es)";
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
    }

    // ---- Contact-state batch load + merge ----
    private async Task MergeContactStatesAsync()
    {
        var keys = Bookings
            .Where(b => !string.IsNullOrWhiteSpace(b.MessageId) && !string.IsNullOrWhiteSpace(b.BookingCode))
            .Select(b => new ContactChannelStateKey { MessageId = b.MessageId, BookingCode = b.BookingCode })
            .ToList();
        if (keys.Count == 0) return;
        try
        {
            var states = await EmailsService.GetBookingContactChannelStatesAsync(keys);
            var byKey = Bookings.ToLookup(b => $"{b.MessageId}|{b.BookingCode}");
            foreach (var s in states)
            {
                foreach (var b in byKey[$"{s.MessageId}|{s.BookingCode}"])
                {
                    ApplyState(b, (s.Channel ?? string.Empty).ToLowerInvariant(), s.ContactState);
                }
            }
        }
        catch { /* states are best-effort */ }
    }

    private static void ApplyState(BookingsLiveListItem b, string channel, byte state)
    {
        var s = state > 3 ? (byte)0 : state;
        switch (channel)
        {
            case "sms": b.SmsContactState = s; break;
            case "wa": b.WaContactState = s; break;
            case "platform": b.PlatformContactState = s; break;
        }
    }

    // ---- Contact-state toggles ----
    private async Task CycleStateAsync(BookingsLiveListItem b, string channel)
    {
        if (string.IsNullOrWhiteSpace(b.MessageId) || string.IsNullOrWhiteSpace(b.BookingCode)) return;
        var key = $"{b.MessageId}|{b.BookingCode}|{channel}";
        if (!busyStateKeys.Add(key)) return;
        try
        {
            var res = await EmailsService.CycleBookingContactChannelStateAsync(b.MessageId, b.BookingCode, channel, source: "bookings-page");
            if (res != null) ApplyState(b, channel, res.ContactState);
        }
        finally { busyStateKeys.Remove(key); }
    }

    private async Task TogglePlatformAsync(BookingsLiveListItem b)
    {
        if (string.IsNullOrWhiteSpace(b.MessageId) || string.IsNullOrWhiteSpace(b.BookingCode)) return;
        var next = b.PlatformContactState == 1 ? (byte)0 : (byte)1;
        var res = await EmailsService.SetBookingContactChannelStateAsync(b.MessageId, b.BookingCode, "platform", next, source: "bookings-page");
        if (res != null) b.PlatformContactState = res.ContactState;
    }

    private async Task ToggleRespondedAsync(BookingsLiveListItem b)
    {
        var newVal = !b.Responded;
        try
        {
            await BookingsInboxService.SetCustomerLabelAsync(b.CustomerId, "responded", newVal, updatedBy: "bookings-page");
            b.Responded = newVal;
        }
        catch { await ToastService.ShowErrorAsync("Responded", "Could not update responded status."); }
    }

    // ---- Message quick-send (auto First-time / Returning template). The SMS/WhatsApp
    // anchors open the OS app directly (href); this only records the quick-send + logs. ----
    private async Task MarkQuickSendAsync(BookingsLiveListItem b, string channel)
    {
        if (string.IsNullOrWhiteSpace(b.MessageId) || string.IsNullOrWhiteSpace(b.BookingCode)) return;
        try
        {
            var res = await EmailsService.MarkBookingContactChannelQuickSendAsync(b.MessageId, b.BookingCode, channel, source: "bookings-page");
            if (res != null) ApplyState(b, channel, res.ContactState);
            await BookingsInboxService.LogMessageEventAsync(new BookingMessageEventWriteModel
            {
                CustomerId = b.CustomerId,
                CustomerIdentifier = b.CustomerIdentifier,
                BookingId = b.BookingId,
                BookingCode = b.BookingCode,
                MessageId = b.MessageId,
                TourName = b.TourName,
                TourDate = b.TourDate,
                TourTime = b.TourTime,
                VendorName = b.VendorName,
                Stage = "welcome",
                Channel = channel,
                TriggerType = "open_channel",
                SentAtUtc = DateTime.UtcNow
            });
        }
        catch { /* logging/marking is best-effort */ }
    }

    private string BuildMessageBody(BookingsLiveListItem b)
    {
        string? tpl = null;
        if (selectedTemplateByBooking.TryGetValue(b.BookingId, out var tid))
        {
            tpl = allTemplates.FirstOrDefault(m => m.Id == tid)?.MessageContent;
        }
        if (string.IsNullOrWhiteSpace(tpl))
        {
            tpl = b.IsReturningGuest ? returningTemplate : firstTimeTemplate;
        }
        if (string.IsNullOrWhiteSpace(tpl)) return string.Empty;
        var firstName = (b.CustomerName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? (b.CustomerName ?? string.Empty);
        var dateStr = b.TourDate.HasValue ? b.TourDate.Value.ToString("MMM d, yyyy") : string.Empty;
        return tpl
            .Replace("{name}", firstName, StringComparison.OrdinalIgnoreCase)
            .Replace("{guest}", firstName, StringComparison.OrdinalIgnoreCase)
            .Replace("{tour}", b.TourName ?? string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("{tourname}", b.TourName ?? string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("{date}", dateStr, StringComparison.OrdinalIgnoreCase)
            .Replace("{displaydate}", dateStr, StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildSmsUrl(string phone, string body)
    {
        var digits = new string((phone ?? string.Empty).Where(char.IsDigit).ToArray());
        var formatted = digits.Length == 10 ? $"+1{digits}" : $"+{digits}";
        return string.IsNullOrWhiteSpace(body)
            ? $"sms:{formatted}"
            : $"sms:{formatted}?body={Uri.EscapeDataString(body)}";
    }

    private static string BuildWhatsAppUrl(string phone, string body)
    {
        var digits = new string((phone ?? string.Empty).Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(body)
            ? $"whatsapp://send?phone={digits}"
            : $"whatsapp://send?phone={digits}&text={Uri.EscapeDataString(body)}";
    }

    // ---- Per-row vCard (no extra tab) ----
    private async Task DownloadVcardAsync(BookingsLiveListItem b)
    {
        var safe = (b.CustomerName ?? "contact").Replace(" ", "_").Replace(",", "");
        await JSRuntime.InvokeVoidAsync("downloadServerFile", $"/vcards/booking?bookingId={b.BookingId}", $"{safe}.vcf");
    }

    // ---- Day grouping (bookings grouped by the day they came in = CreatedAt) ----
    private List<KeyValuePair<string, List<BookingsLiveListItem>>> GetBookingsByDay()
    {
        return GetVisibleBookings()
            .GroupBy(b => b.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .Select(g => new KeyValuePair<string, List<BookingsLiveListItem>>(
                g.Key.ToString("yyyy-MM-dd"), g.ToList()))
            .ToList();
    }

    private void ToggleDay(string dayKey)
    {
        if (!collapsedDays.Add(dayKey)) collapsedDays.Remove(dayKey);
    }

    private static string FormatDayHeader(string dayKey)
    {
        return DateTime.TryParse(dayKey, out var d)
            ? d.ToString("ddd, MMM d, yyyy")
            : dayKey;
    }

    private async Task DownloadDayVcardsAsync(List<BookingsLiveListItem> dayBookings)
    {
        var ids = dayBookings.Select(b => b.BookingId).Where(id => id > 0).Distinct().ToList();
        if (ids.Count == 0)
        {
            await ToastService.ShowErrorAsync("vCards", "No contacts for this day.");
            return;
        }
        await JSRuntime.InvokeVoidAsync("downloadServerFile", $"/vcards/bookings?bookingIds={string.Join(",", ids)}", $"contacts_{ids.Count}.vcf");
    }

    // ---- Copy templated message (for guests contacted on the platform / no phone) ----
    private async Task CopyMessageAsync(BookingsLiveListItem b)
    {
        var msg = BuildMessageBody(b);
        if (string.IsNullOrWhiteSpace(msg))
        {
            await ToastService.ShowErrorAsync("Copy", "No message template found. Add First-Time/Returning templates.");
            return;
        }
        try
        {
            await JSRuntime.InvokeVoidAsync("blazorCopyText", msg);
            await ToastService.ShowSuccessAsync("Copied", "Message copied — paste it on the platform.");
        }
        catch { await ToastService.ShowErrorAsync("Copy", "Could not copy to clipboard."); }
    }

    // ---- Edit guest name / phone / email ----
    private int? editingBookingId;
    private string editName = string.Empty;
    private string editPhone = string.Empty;
    private string editEmail = string.Empty;
    private bool isSavingEdit;

    private void BeginEdit(BookingsLiveListItem b)
    {
        editingBookingId = b.BookingId;
        editName = b.CustomerName ?? string.Empty;
        editPhone = b.CustomerPhone ?? string.Empty;
        editEmail = b.CustomerEmail ?? string.Empty;
    }

    private void CancelEdit() => editingBookingId = null;

    private async Task SaveEditAsync(BookingsLiveListItem b)
    {
        isSavingEdit = true;
        StateHasChanged();
        try
        {
            await GuideReportService.UpdateBookingContactAsync(b.BookingId, editName?.Trim() ?? string.Empty, editPhone?.Trim() ?? string.Empty, editEmail?.Trim() ?? string.Empty);
            b.CustomerName = editName?.Trim() ?? string.Empty;
            b.CustomerPhone = string.IsNullOrWhiteSpace(editPhone) ? null : editPhone.Trim();
            b.CustomerEmail = string.IsNullOrWhiteSpace(editEmail) ? null : editEmail.Trim();
            if (!string.IsNullOrWhiteSpace(b.CustomerPhone)) b.NeedsNumber = false;
            editingBookingId = null;
            await ToastService.ShowSuccessAsync("Saved", "Guest info updated.");
        }
        catch
        {
            await ToastService.ShowErrorAsync("Save", "Could not update guest info.");
        }
        finally
        {
            isSavingEdit = false;
            StateHasChanged();
        }
    }

    // ---- Bulk vCard selection (by booking id) ----
    private void ToggleSelect(int bookingId)
    {
        if (bookingId <= 0) return;
        if (!selectedBookingIds.Add(bookingId)) selectedBookingIds.Remove(bookingId);
    }

    private void ClearSelection() => selectedBookingIds.Clear();

    private async Task DownloadSelectedVcardsAsync()
    {
        if (selectedBookingIds.Count == 0) return;
        await JSRuntime.InvokeVoidAsync("downloadServerFile", $"/vcards/bookings?bookingIds={string.Join(",", selectedBookingIds)}", $"contacts_{selectedBookingIds.Count}.vcf");
    }

    // ---- Contact-state display helpers (mirror Tour Dashboard) ----
    private static string GetStateColorClass(byte s) => s switch
    {
        1 => "text-success",
        2 => "text-danger",
        3 => "text-secondary",
        _ => "text-contact-yellow"
    };

    private static string GetStateLabel(byte s) => s switch
    {
        1 => "Green (contacted)",
        2 => "Red (number fails here)",
        3 => "Gray (use other channel)",
        _ => "Yellow (uncontacted)"
    };

    private static string GetStateToggleTitle(string channel, byte cur)
        => $"{channel}: {GetStateLabel(cur)}. Click to set {GetStateLabel((byte)((cur + 1) % 4))}.";

    private static string GetPlatformToggleTitle(byte s)
        => s == 1 ? "Platform: contacted. Click to uncheck." : "Platform: not contacted. Click to mark contacted.";

    private static string GetPlatformIconClass(byte s)
        => s == 1 ? "bi bi-check-square-fill text-success" : "bi bi-square text-secondary";

    private static string FormatTourDateTime(DateTime? date, string? time)
    {
        if (date.HasValue)
        {
            return $"{date.Value:MMM d, yyyy} {time}".Trim();
        }
        return time ?? string.Empty;
    }

    private static string FormatEventType(BookingsLiveListItem row)
    {
        if (row.IsCancellation) return "Cancelled";
        if (row.IsModification) return "Rescheduled";
        return "Booked";
    }

    private static string GetStatusBadgeClass(BookingsLiveListItem row)
    {
        if (row.IsCancellation) return "text-bg-danger";
        if (row.IsModification) return "text-bg-warning";
        return "text-bg-success";
    }

    private static string GetVendorBadgeClass(string vendorName)
    {
        if (string.IsNullOrWhiteSpace(vendorName)) return "text-bg-secondary";
        var hash = Math.Abs(vendorName.GetHashCode());
        var classes = new[] { "text-bg-primary", "text-bg-secondary", "text-bg-dark" };
        return classes[hash % classes.Length];
    }
