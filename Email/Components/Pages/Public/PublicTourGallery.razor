@page "/tour-gallery/{PublicId}"
@layout Email.Components.Layout.PublicLayout
@using Email.Services
@using Email.Models.Reports
@using Email.Components.Tours
@using System.Text.Json
@inject IGuideReportService ReportService
@inject IPublicGalleryService GalleryService
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Tour Photos - City Shuffles</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Loading gallery...</p>
    </div>
}
else if (report == null)
{
    <div class="text-center py-5">
        <i class="bi bi-exclamation-circle fs-1 text-warning"></i>
        <h3 class="mt-3">Tour Not Found</h3>
        <p class="text-muted">The gallery you are looking for does not exist or has been removed.</p>
    </div>
}
else
{
    <div class="gallery-page px-3">
        <header class="mb-4 text-center">
            @if (string.IsNullOrWhiteSpace(headerHtml))
            {
                 <h1 class="display-6">Thanks for joining us!</h1>
                 <p class="lead">Here are the photos from your <strong>@report.TourName</strong> tour.</p>
            }
            else
            {
                @((MarkupString)headerHtml)
            }

            <div class="text-muted small mt-2">
                <i class="bi bi-calendar-event me-1"></i>@report.TourDate.ToLongDateString()
                <span class="mx-2">|</span>
                <i class="bi bi-clock me-1"></i>@report.TourTime
                <span class="mx-2">|</span>
                <i class="bi bi-images me-1"></i>@Photos.Count photo(s)
            </div>

            @* Share buttons *@
            <div class="d-flex justify-content-center gap-2 mt-3">
                <button class="btn btn-sm btn-outline-success" @onclick="ShareWhatsApp" title="Share via WhatsApp">
                    <i class="bi bi-whatsapp me-1"></i>Share
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyLink" title="Copy gallery link">
                    <i class="bi bi-link-45deg me-1"></i>@(linkCopied ? "Copied!" : "Copy Link")
                </button>
                @if (Photos.Count > 0)
                {
                    <a href="/tour-photos/download-all/@PublicId" class="btn btn-sm btn-outline-primary" title="Download all photos">
                        <i class="bi bi-download me-1"></i>Download All
                    </a>
                }
            </div>
        </header>

        <TourPhotoGallery Photos="@Photos" AllowDelete="false" />

        <div class="mt-5 pt-4 border-top">
            @if (FooterLinks.Any())
            {
                <h4 class="text-center mb-4">Check out our other tours</h4>
                <div class="row g-3 justify-content-center">
                    @foreach (var link in FooterLinks)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <h5 class="card-title">@link.Title</h5>
                                    <p class="card-text small text-muted">@link.CardText</p>
                                    <a href="@link.Url" class="btn btn-sm btn-outline-primary stretched-link">Learn More</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string PublicId { get; set; } = string.Empty;
    private TourReport? report;
    private GallerySettings? Settings;
    private List<string> Photos { get; set; } = new();
    private List<FooterLink> FooterLinks { get; set; } = new();
    private string headerHtml = "";
    private bool isLoading = true;
    private bool linkCopied = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            report = await ReportService.GetReportByPublicIdAsync(PublicId);
            if (report != null && !string.IsNullOrWhiteSpace(report.ImagePaths))
            {
                Photos = report.ImagePaths.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
            }

            Settings = await GalleryService.GetSettingsAsync();
            if (Settings != null)
            {
                if (!string.IsNullOrWhiteSpace(Settings.HeaderText))
                {
                    headerHtml = Settings.HeaderText.Replace("{TourName}", report?.TourName ?? "our tour");
                }

                if (!string.IsNullOrWhiteSpace(Settings.FooterLinksJson))
                {
                    try
                    {
                        FooterLinks = JsonSerializer.Deserialize<List<FooterLink>>(Settings.FooterLinksJson) ?? new();
                    }
                    catch { }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading gallery: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShareWhatsApp()
    {
        var url = await GetCurrentUrl();
        var text = $"Check out our tour photos! {url}";
        var waUrl = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
        await JSRuntime.InvokeVoidAsync("open", waUrl, "_blank");
    }

    private async Task CopyLink()
    {
        var url = await GetCurrentUrl();
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        linkCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        linkCopied = false;
        StateHasChanged();
    }

    private async Task<string> GetCurrentUrl()
    {
        try
        {
            return await JSRuntime.InvokeAsync<string>("eval", "window.location.href");
        }
        catch
        {
            return $"/tour-gallery/{PublicId}";
        }
    }
}
