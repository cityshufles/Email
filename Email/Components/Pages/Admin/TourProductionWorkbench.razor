    private static string BuildDefaultOverrideKey(string? label)
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            return string.Empty;
        }

        var cleaned = System.Text.RegularExpressions.Regex.Replace(label.Trim().ToLowerInvariant(), @"[^a-z0-9]+", "-");
        return cleaned.Trim('-');
    }

    private static string? NormalizeOverrideKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var cleaned = System.Text.RegularExpressions.Regex.Replace(value.Trim().ToLowerInvariant(), @"\s+", "-");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"[^a-z0-9\-]+", string.Empty);
        cleaned = cleaned.Trim('-');
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            return null;
        }

        return cleaned.Length <= 200 ? cleaned : cleaned[..200];
    }

    private static string StatusBadgeClass(string status)
    {
        return status switch
        {
            "Mapped" => "text-bg-success",
            "Needs Tour" => "text-bg-danger",
            "Needs Alias" => "text-bg-warning text-dark",
            "Needs Meeting Place" => "text-bg-info",
            _ => "text-bg-secondary"
        };
    }
