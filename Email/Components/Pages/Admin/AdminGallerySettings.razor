@page "/admin/gallery-settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Manager")]
@using Email.Models.Reports
@using Email.Services
@using Syncfusion.Blazor.RichTextEditor
@using System.Text.Json
@inject IPublicGalleryService GalleryService
@inject IToastService ToastService

<PageTitle>Gallery Settings</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bi bi-palette me-2"></i>Public Gallery Settings</h4>
        <button class="btn btn-primary" @onclick="SaveSettings" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-save me-1"></i>Save Changes
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading settings...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Header Text Editor -->
            <div class="col-md-12">
                <div class="card shadow-sm h-100">
                    <div class="card-header border-bottom">
                        <h5 class="card-title mb-0">Header Template</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">Use <strong>{TourName}</strong> as a placeholder for the tour name.</p>
                        
                        <SfRichTextEditor @bind-Value="@Settings.HeaderText" Height="250px">
                             <RichTextEditorToolbarSettings Items="@Tools" />
                        </SfRichTextEditor>
                    </div>
                </div>
            </div>

            <!-- Footer Links Editor -->
            <div class="col-md-12">
                <div class="card shadow-sm h-100">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Footer Links</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick="AddLink">
                            <i class="bi bi-plus-lg me-1"></i>Add Link
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>URL</th>
                                    <th>Card Text</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var link in Links)
                                {
                                    <tr>
                                        <td><input type="text" class="form-control form-control-sm" @bind="link.Title" placeholder="Link Title" /></td>
                                        <td><input type="text" class="form-control form-control-sm" @bind="link.Url" placeholder="https://..." /></td>
                                        <td><input type="text" class="form-control form-control-sm" @bind="link.CardText" placeholder="Description" /></td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLink(link)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (Links.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No links configured.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-3 text-end">
             <button class="btn btn-primary" @onclick="SaveSettings" disabled="@isSaving">
                <i class="bi bi-save me-1"></i>Save Changes
            </button>
        </div>
    }
</div>

@code {
    private GallerySettings Settings { get; set; } = new();
    private List<FooterLink> Links { get; set; } = new();
    private bool isLoading = true;
    private bool isSaving = false;

    // Toolbar settings for RichTextEditor
    private List<ToolbarItemModel> Tools = new List<ToolbarItemModel>()
    {
        new ToolbarItemModel() { Command = ToolbarCommand.Bold },
        new ToolbarItemModel() { Command = ToolbarCommand.Italic },
        new ToolbarItemModel() { Command = ToolbarCommand.Underline },
        new ToolbarItemModel() { Command = ToolbarCommand.Separator },
        new ToolbarItemModel() { Command = ToolbarCommand.Formats },
        new ToolbarItemModel() { Command = ToolbarCommand.Alignments },
        new ToolbarItemModel() { Command = ToolbarCommand.Separator },
        new ToolbarItemModel() { Command = ToolbarCommand.OrderedList },
        new ToolbarItemModel() { Command = ToolbarCommand.UnorderedList },
        new ToolbarItemModel() { Command = ToolbarCommand.Separator },
        new ToolbarItemModel() { Command = ToolbarCommand.CreateLink },
        new ToolbarItemModel() { Command = ToolbarCommand.Image },
        new ToolbarItemModel() { Command = ToolbarCommand.SourceCode },
        new ToolbarItemModel() { Command = ToolbarCommand.Undo },
        new ToolbarItemModel() { Command = ToolbarCommand.Redo }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Settings = await GalleryService.GetSettingsAsync();
            if (!string.IsNullOrEmpty(Settings.FooterLinksJson))
            {
                try 
                {
                    Links = JsonSerializer.Deserialize<List<FooterLink>>(Settings.FooterLinksJson) ?? new();
                }
                catch 
                { 
                    Links = new(); 
                }
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", "Failed to load settings.");
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddLink()
    {
        Links.Add(new FooterLink { Title = "New Link", Url = "#", CardText = "Description" });
    }

    private void RemoveLink(FooterLink link)
    {
        Links.Remove(link);
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        try
        {
            Settings.FooterLinksJson = JsonSerializer.Serialize(Links);
            await GalleryService.SaveSettingsAsync(Settings);
            await ToastService.ShowSuccessAsync("Success", "Gallery settings saved successfully.");
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", "Failed to save settings.");
            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
}
