@* 2025-12-21 - Tour Photos page - standalone photo management *@
@page "/tour-photos"
@using Email.Services
@using Email.Components.Tours
@using Microsoft.JSInterop
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ITourPhotoService PhotoService
@inject ITourTreeService TourTreeService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<div class="container-fluid py-3">
    <div class="row mb-4">
        <div class="col">
            <h4 class="mb-0">
                <i class="bi bi-camera me-2"></i>Tour Photos
            </h4>
            <p class="text-muted mb-0">Upload and manage group photos for tours</p>
        </div>
    </div>

    @* Action Buttons *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-primary" @onclick="() => showUploader = !showUploader">
                    <i class="bi bi-upload me-1"></i>
                    @(showUploader ? "Hide Uploader" : "Upload Photo")
                </button>
                <button class="btn btn-primary" @onclick="OpenCamera">
                    <i class="bi bi-camera me-1"></i>Take Photo
                </button>
            </div>
        </div>
    </div>

    @* Upload Section with drag-and-drop *@
    @if (showUploader)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-upload me-2"></i>Upload Photos
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Tour Date</label>
                                <input type="date" class="form-control" @bind="uploadDate" @bind:after="PushMeta" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tour Name</label>
                                <input type="text" class="form-control" list="tourNamesList" @bind="uploadTourName" @bind:after="PushMeta" placeholder="Select or enter tour name..." />
                                <datalist id="tourNamesList">
                                    @foreach (var name in tourNames)
                                    {
                                        <option value="@name" />
                                    }
                                </datalist>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label d-flex align-items-center gap-2">
                                    <span>Tour Time</span>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-info rounded-circle p-0"
                                            style="width: 1.35rem; height: 1.35rem; line-height: 1;"
                                            title="Tour time help"
                                            @onclick="ShowTourTimeHelp">
                                        ?
                                    </button>
                                </label>
                                <input type="time" class="form-control" @bind="uploadTime" @bind:after="OnTimePicked" />
                                @if (!string.IsNullOrWhiteSpace(uploadTourTime))
                                {
                                    <small class="text-muted">Tour time: @uploadTourTime</small>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(uploadTourName) && !string.IsNullOrWhiteSpace(uploadTourTime))
                        {
                            @* Direct-HTTP uploader (bypasses Blazor SignalR circuit to avoid upload timeouts).
                               This host div is owned entirely by tour-photos-uploader.js. *@
                            <div id="tpUploaderHost"></div>
                        }
                        else
                        {
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-info-circle me-2"></i>Enter both tour name and tour time to start uploading.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* Camera Capture Modal *@
    <CameraCapture @bind-isOpen="showCamera" OnPhotoCaptured="OnPhotoCaptured" />

    @* Photo Gallery *@
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-images me-2"></i>All Photos
                        @if (allPhotos.Count > 0)
                        {
                            <span class="badge bg-primary ms-2">@filteredPhotos.Count</span>
                        }
                    </h5>
                    <div class="d-flex gap-2 align-items-center">
                        <select class="form-select form-select-sm" style="width: auto;" @bind="filterFolder" @bind:after="ApplyFilter">
                            <option value="">All Dates</option>
                            @foreach (var folder in dateFolders)
                            {
                                <option value="@folder">@folder</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary btn-sm" @onclick="LoadAllPhotos" title="Refresh">
                            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border" role="status"></div>
                            <p class="mt-2">Loading photos...</p>
                        </div>
                    }
                    else
                    {
                        <TourPhotoGallery
                            Photos="@filteredPhotos.Select(p => p.Path).ToList()"
                            AllowDelete="true"
                            OnPhotoDeleted="LoadAllPhotos" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PhotoInfo> allPhotos = new();
    private List<PhotoInfo> filteredPhotos = new();
    private List<string> dateFolders = new();
    private List<string> tourNames = new();
    private string filterFolder = "";
    private bool isLoading = true;
    private bool showUploader = false;
    private bool showCamera = false;

    // Upload form fields
    private DateTime uploadDate = DateTime.Today;
    private string uploadTourName = "Quick Photo";
    private string uploadTourTime = string.Empty;
    private TimeOnly? uploadTime; // value from the <input type="time"> picker

    // Direct-HTTP uploader interop (see wwwroot/js/tour-photos-uploader.js)
    private DotNetObjectReference<TourPhotos>? uploaderRef;
    private bool uploaderInitialized = false;

    private bool UploaderHostVisible =>
        showUploader
        && !string.IsNullOrWhiteSpace(uploadTourName)
        && !string.IsNullOrWhiteSpace(uploadTourTime);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tourNames = await TourTreeService.GetDistinctTourNamesAsync();
        }
        catch { tourNames = new(); }

        await LoadAllPhotos();
    }

    private async Task LoadAllPhotos()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            allPhotos = await PhotoService.GetAllPhotosAsync();
            dateFolders = allPhotos.Select(p => p.DateFolder).Distinct().OrderByDescending(d => d).ToList();
            ApplyFilter();
        }
        catch
        {
            allPhotos = new();
            filteredPhotos = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(filterFolder))
        {
            filteredPhotos = allPhotos;
        }
        else
        {
            filteredPhotos = allPhotos.Where(p => p.DateFolder == filterFolder).ToList();
        }
        StateHasChanged();
    }

    // Initialize (or tear down) the JS-owned direct-HTTP uploader as its host div appears/disappears.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (UploaderHostVisible && !uploaderInitialized)
        {
            uploaderRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("tourPhotosUploader.init", "tpUploaderHost", uploaderRef, new
                {
                    tourDate = uploadDate.ToString("yyyy-MM-dd"),
                    tourName = uploadTourName,
                    tourTime = uploadTourTime
                });
                uploaderInitialized = true;
            }
            catch
            {
                // Script may not be loaded yet on the very first render; retry on the next render.
            }
        }
        else if (!UploaderHostVisible && uploaderInitialized)
        {
            uploaderInitialized = false;
            try { await JSRuntime.InvokeVoidAsync("tourPhotosUploader.dispose"); } catch { /* no-op */ }
        }
    }

    // Convert the picker's 24h "HH:mm" into the app's "h:mm tt" (e.g., "10:00 AM") format.
    private async Task OnTimePicked()
    {
        uploadTourTime = uploadTime.HasValue
            ? uploadTime.Value.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)
            : string.Empty;
        await PushMeta();
    }

    // Push tour metadata to the uploader whenever the date/name/time fields change.
    private async Task PushMeta()
    {
        if (uploaderInitialized)
        {
            await JSRuntime.InvokeVoidAsync("tourPhotosUploader.setMeta",
                uploadDate.ToString("yyyy-MM-dd"), uploadTourName, uploadTourTime);
        }
    }

    // Called from JS (tour-photos-uploader.js) after an upload session finishes.
    [JSInvokable]
    public async Task OnUploadComplete(int saved, int failed)
    {
        if (saved > 0)
        {
            await ToastService.ShowSuccessAsync("Upload complete", $"{saved} photo(s) uploaded.");
            await LoadAllPhotos();
        }
        if (failed > 0)
        {
            await ToastService.ShowErrorAsync("Upload issues", $"{failed} file(s) failed.");
        }
        StateHasChanged();
    }

    private async Task OpenCamera()
    {
        if (string.IsNullOrWhiteSpace(uploadTourTime))
        {
            await ShowTourTimeHelp();
            return;
        }

        showCamera = true;
        StateHasChanged();
    }

    private async Task OnPhotoCaptured(string imageData)
    {
        var tourDate = DateTime.Today.ToString("yyyy-MM-dd");
        var tourName = string.IsNullOrWhiteSpace(uploadTourName) ? "Quick Photo" : uploadTourName;
        if (string.IsNullOrWhiteSpace(uploadTourTime))
        {
            await ShowTourTimeHelp();
            return;
        }

        var tourTime = uploadTourTime;

        var savedPath = await PhotoService.SavePhotoAsync(imageData, tourDate, tourName, tourTime);

        if (!string.IsNullOrWhiteSpace(savedPath))
        {
            await LoadAllPhotos();
        }

        showCamera = false;
        StateHasChanged();
    }

    private async Task ShowTourTimeHelp()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Tour time must match actual tour time");
    }

    public void Dispose()
    {
        uploaderRef?.Dispose();
    }
}

<style>
    /* Direct-HTTP uploader (tour-photos-uploader.js) */
    .tpu-dropzone {
        position: relative;
        border: 2px dashed var(--bs-border-color);
        border-radius: 0.75rem;
        padding: 2rem;
        text-align: center;
        transition: border-color 0.2s, background 0.2s;
        cursor: pointer;
    }

    .tpu-dropzone:hover,
    .tpu-dropzone.tpu-active {
        border-color: var(--bs-primary);
        background: rgba(var(--bs-primary-rgb), 0.05);
    }

    .tpu-file-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .tpu-dz-content {
        pointer-events: none;
    }

    .tpu-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.75rem;
    }

    .tpu-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .tpu-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        background: var(--bs-tertiary-bg);
    }

    .tpu-thumb {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 0.25rem;
        background: var(--bs-body-bg);
        image-orientation: from-image;
    }

    .tpu-meta {
        flex: 1;
        min-width: 0;
    }

    .tpu-action {
        flex-shrink: 0;
    }

    @@media (max-width: 575px) {
        .tpu-dropzone {
            padding: 1.5rem 1rem;
        }

        .tpu-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
