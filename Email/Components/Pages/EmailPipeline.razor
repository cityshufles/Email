	private async Task ApplyPlainTextHighlightsAsync()
	{
		try
		{
			// processed plaintext → only if this item is a modification
			if (processedFullDiagnostic != null &&
			    string.Equals(processedFullDiagnostic.EmailType, "Modification", StringComparison.OrdinalIgnoreCase) &&
			    !string.IsNullOrWhiteSpace(processedFullDiagnostic.PlainTextContent))
			{
				await JS.InvokeVoidAsync("emailModHighlighter.highlight", processedPlainRef, processedFullDiagnostic.VendorName ?? "");
			}

			// latest modification plaintext
