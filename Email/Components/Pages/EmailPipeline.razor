@if (showAdminHelp)
{
	<div class="modal d-block" tabindex="-1">
		<div class="modal-dialog modal-lg modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header py-2">
					<h6 class="modal-title">Admin functions: order &amp; purpose</h6>
					<button type="button" class="btn-close" aria-label="Close" @onclick="(() => showAdminHelp = false)"></button>
				</div>
				<div class="modal-body">
					<ol class="small">
						<li>
							<strong>Repair Booking Codes (All)</strong><br />
							Fixes <code>AutomaticGmail_ProcessedEmails.BookingCode</code> for <em>Modification</em>/<em>Cancellation</em> rows to match the selection rules
							(Cancellation uses <code>PreviousBookingCode</code>; Modification prefers <code>NewBookingCode</code>).
							Run this first so the thread associations are correct.
						</li>
						<li class="mt-2">
							<strong>Rebuild Origin Pointers (All)</strong><br />
							Computes the canonical root booking for each inbox row (walking the code chain) and <em>overrides</em>
							<code>OriginalBookingId</code>, <code>OriginalBookingCode</code>, <code>OriginalBookingMessageId</code>.
							Run this second. Safe to re-run; it will correct non-root pointers.
						</li>
						<li class="mt-2">
							<strong>Backfill Origins (All)</strong> (optional / legacy)<br />
							Populates missing <code>OriginalBooking*</code> via COALESCE (no overwrite). Useful for initial fill,
							but does not correct previously set non-root pointers. Prefer “Rebuild Origin Pointers” for accuracy.
						</li>
					</ol>
					<div class="alert alert-warning small mb-0">
						<strong>Recommended order:</strong> 1) Repair Booking Codes → 2) Rebuild Origin Pointers.<br />
						The UI will then build full history from the true original booking across code changes.
					</div>
				</div>
				<div class="modal-footer py-2">
					<button class="btn btn-secondary btn-sm" @onclick="(() => showAdminHelp = false)">Close</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal-backdrop fade show"></div>
}

