@page "/email-pipeline"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Email.Services.GmailProcessing.Dtos
@using Email.Services.GmailProcessing.Models
@using Email.Services.GmailCollection.Models
@using Microsoft.AspNetCore.Components
@inject Email.Services.GmailProcessing.GmailProcessingV2Service ProcessingService
@inject Email.Services.ITourEmailsService TourEmailsService
@inject Email.Services.TourDataErrorReportsSqlService ErrorReportsService
@inject ILogger<EmailPipeline> Logger
@inject IJSRuntime JS

<PageTitle>Email Pipeline</PageTitle>

<div class="container-fluid py-3">
	<h5 class="mb-3">Email Processing Pipeline (Visualization)</h5>
	@* commented out the first tab item for processed threads, we are building up the other list (processed emails)*@
	<div class="row">
		<div class="col-3">
			<ul class="nav nav-tabs nav-fill small mb-2">
				@* <li class="nav-item">
					<button class="nav-link @(listScope == "processed" ? "active" : "")" @onclick="SetScopeProcessed">Processed Threads</button>
				</li> *@
				<li class="nav-item">
					<button class="nav-link @(listScope == "processed_emails" ? "active" : "")" @onclick="SetScopeProcessedEmails">Processed Emails</button>
				</li>
			</ul>
			<div class="d-flex align-items-center gap-2 mb-2">
				<button class="btn btn-primary btn-sm" @onclick="RefreshListAsync" disabled="@isBusy">Reload</button>
			</div>

			@if (detailTab == "errors")
			{
				<div class="list-group" style="max-height: 70vh; overflow-y: auto;">
					@if (errorReports.Count == 0)
					{
						<div class="list-group-item p-2 text-muted">No errors.</div>
					}
					else
					{
						@foreach (var er in errorReports)
						{
							<button type="button" class="list-group-item list-group-item-action p-2"
							        title="Open error report"
							        @onclick="(() => SelectError(er))">
								<div class="d-flex justify-content-between align-items-center">
									<div class="d-flex align-items-center gap-2">
										<span class="badge bg-danger">ERR</span>
										<small class="text-truncate">@((er.VendorName ?? "—") + " " + (er.BookingCode ?? "—"))</small>
									</div>
									<small class="text-muted ms-2">@er.CreatedAt.ToString("MM/dd HH:mm")</small>
								</div>
								<div class="d-flex justify-content-between">
									<small class="text-muted">@ShortMessageId(er.MessageId)</small>
								</div>
							</button>
						}
					}
				</div>
			}
			else
			{
				@if (listScope == "processed")
				{
					<div class="list-group" style="max-height: 70vh; overflow-y: auto;">
						@foreach (var g in leftGroups)
						{
							<button type="button" class="list-group-item list-group-item-action p-2"
							        title="Open booking thread"
							        @onclick="(() => SelectByBookingCodeAsync(g.BookingCode))">
								<div class="d-flex justify-content-between">
									<strong class="text-truncate">@g.BookingCode</strong>
									<small class="text-muted ms-2">@g.LatestAt.ToString("MM/dd HH:mm")</small>
								</div>
								<small class="text-muted">@g.Count processed emails</small>
							</button>
						}
					</div>
				}
				@if (listScope == "processed_emails")
				{
					<div class="mb-2 small">
						<div class="d-flex flex-wrap align-items-center gap-1 mb-1">
							<button type="button" class='@GetTypeChipClass("Booking")' @onclick='() => ToggleType("Booking")'>Booking</button>
							<button type="button" class='@GetTypeChipClass("Modification")' @onclick='() => ToggleType("Modification")'>Modification</button>
							<button type="button" class='@GetTypeChipClass("Cancellation")' @onclick='() => ToggleType("Cancellation")'>Cancellation</button>
						</div>
						<div class="d-flex flex-wrap align-items-center gap-1 mb-1">
							<button type="button" class="@GetDatePresetBtnClass(DatePreset.Today)" @onclick="(() => SetDatePreset(DatePreset.Today))">Today</button>
							<button type="button" class="@GetDatePresetBtnClass(DatePreset.Last7)" @onclick="(() => SetDatePreset(DatePreset.Last7))">7 days</button>
							<button type="button" class="@GetDatePresetBtnClass(DatePreset.Last30)" @onclick="(() => SetDatePreset(DatePreset.Last30))">30 days</button>
							<button type="button" class="@GetDatePresetBtnClass(DatePreset.Custom)" @onclick="(() => SetDatePreset(DatePreset.Custom))">Custom</button>
							@if (datePreset == DatePreset.Custom)
							{
								<div class="d-flex align-items-center gap-1">
									<input type="date" class="form-control form-control-sm" value="@fromDateStr" @onchange="OnFromDateChanged" />
									<span class="text-muted">to</span>
									<input type="date" class="form-control form-control-sm" value="@toDateStr" @onchange="OnToDateChanged" />
								</div>
							}
						</div>
						<div class="d-flex align-items-center gap-1">
							<div class="btn-group btn-group-sm" role="group">
								<button type="button" class="@GetSearchModeBtnClass(SearchMode.Customer)" @onclick="(() => SetSearchMode(SearchMode.Customer))">Customer</button>
								<button type="button" class="@GetSearchModeBtnClass(SearchMode.BookingCode)" @onclick="(() => SetSearchMode(SearchMode.BookingCode))">Booking Code</button>
								<button type="button" class="@GetSearchModeBtnClass(SearchMode.MessageId)" @onclick="(() => SetSearchMode(SearchMode.MessageId))">MessageId</button>
							</div>
							<input type="text" class="form-control form-control-sm" placeholder="Search..." value="@searchText" @oninput="OnSearchInput" />
						</div>

						@if (HasActiveFilters())
						{
							<div class="d-flex flex-wrap align-items-center gap-1 mt-1">
								@foreach (var t in new[] { "Booking", "Modification", "Cancellation" })
								{
									if (selectedTypes.Contains(t))
									{
										<span class="badge bg-light text-dark border">Type: @t</span>
									}
								}
								@if (datePreset != DatePreset.None)
								{
									<span class="badge bg-light text-dark border">
										@((datePreset == DatePreset.Last7) ? "Last 7 days" : (datePreset == DatePreset.Last30) ? "Last 30 days" : (datePreset == DatePreset.Today) ? "Today" : "Custom date")
									</span>
								}
								@if (datePreset == DatePreset.Custom && (!string.IsNullOrWhiteSpace(fromDateStr) || !string.IsNullOrWhiteSpace(toDateStr)))
								{
									<span class="badge bg-light text-dark border">Range: @(string.IsNullOrWhiteSpace(fromDateStr) ? "—" : fromDateStr) → @(string.IsNullOrWhiteSpace(toDateStr) ? "—" : toDateStr)</span>
								}
								@if (!string.IsNullOrWhiteSpace(searchText))
								{
									<span class="badge bg-light text-dark border">
										@((searchMode == SearchMode.Customer) ? "Customer" : (searchMode == SearchMode.BookingCode) ? "Booking" : "Message"): @searchText
									</span>
								}
								<button type="button" class="btn btn-link btn-sm p-0 ms-1" title="Clear all filters" @onclick="ClearAllFilters">clear all</button>
							</div>
						}
					</div>

					<div class="list-group" style="max-height: 70vh; overflow-y: auto;">
						@if (leftFiltered.Count == 0)
						{
							<div class="list-group-item p-2 text-muted">No results.</div>
						}
						else
						{
							@foreach (var p in leftFiltered)
							{
								<button type="button" class="list-group-item list-group-item-action p-2"
								        title="Open processed email"
								        @onclick="(() => SelectByMessageIdAsync(p.MessageId))">
									<div class="d-flex justify-content-between align-items-center">
										<div class="d-flex align-items-center gap-2">
											<span class="@GetTypePillClass(p.EmailType)">@NormalizeTypeForDisplay(p.EmailType)</span>
											<span class="badge bg-light text-dark border">@GetVendorInitials(p.VendorName)</span>
											<small class="text-truncate">@p.CustomerName</small>
										</div>
										<small class="text-muted ms-2">@((p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MinValue).ToString("MM/dd HH:mm"))</small>
									</div>
									<div class="d-flex justify-content-between">
										<small class="text-muted">@ShortMessageId(p.MessageId)</small>
										@if (!string.Equals(p.ProcessingStatus ?? string.Empty, "completed", StringComparison.OrdinalIgnoreCase))
										{
											<span class="@GetStatusPillClass(p.ProcessingStatus)">@p.ProcessingStatus</span>
										}
									</div>
								</button>
							}
						}
					</div>
				}
			}
		</div>

		<div class="col-9">
			<div class="mb-2 d-flex gap-2 align-items-center">
				<button class="btn btn-success btn-sm" @onclick="ProcessSelectedAsync" disabled="@(!CanProcess)">Process This</button>
				<button class="btn btn-secondary btn-sm" @onclick="ReloadSelectedAsync" disabled="@string.IsNullOrWhiteSpace(selectedMessageId)">Load Processed</button>
				@if (!string.IsNullOrWhiteSpace(selectedMessageId))
				{
					<small class="text-muted">Selected: <code>@selectedMessageId</code></small>
				}
				@if (!string.IsNullOrWhiteSpace(selectedBookingCode))
				{
					<small class="text-muted">Booking: <code>@selectedBookingCode</code></small>
				}
			</div>

			@if (!string.IsNullOrWhiteSpace(selectedBookingCode))
			{
				<div class="card mb-2">
					<div class="card-body py-2">
						<div class="d-flex flex-wrap gap-3 align-items-center">
							<div><small class="text-muted">Booking Code:</small> @selectedBookingCode</div>
							@if (finalBooking != null)
							{
								<div><small class="text-muted">Customer Id:</small> @finalBooking.CustomerId</div>
							}
						</div>
					</div>
				</div>

				@if (hydratedDiagnostic != null)
				{
					<div class="card mb-2">
						<div class="card-header py-2"><small class="fw-bold">diagnostic (inbox / processed / booking / customer)</small></div>
						<div class="card-body p-2 small">
							<div class="row row-cols-1 row-cols-md-2 g-2">
								<div>
									<div class="fw-bold text-uppercase mb-1">inbox</div>
									<div><small class="text-muted">subject</small><div>@(Fmt(hydratedDiagnostic.InboxDiagnostic?.Subject))</div></div>
									<div><small class="text-muted">from</small><div>@(Fmt(hydratedDiagnostic.InboxDiagnostic?.FromEmail))</div></div>
									<div><small class="text-muted">to</small><div>@(Fmt(hydratedDiagnostic.InboxDiagnostic?.ToEmail))</div></div>
									<div><small class="text-muted">received</small><div><strong>@(hydratedDiagnostic.InboxDiagnostic?.ReceivedDate.ToString("MM/dd/yyyy h:mm:ss tt") ?? "—")</strong></div></div>
									<div><small class="text-muted">attachments</small><div>@(hydratedDiagnostic.InboxDiagnostic?.AttachmentCount ?? 0) @(Fmt(hydratedDiagnostic.InboxDiagnostic?.AttachmentNames))</div></div>
									<div><small class="text-muted">status</small><div>@(hydratedDiagnostic.InboxDiagnostic?.ProcessingStatus.ToString() ?? "—")</div></div>
								</div>
								<div>
									<div class="fw-bold text-uppercase mb-1">processed</div>
									<div class="row row-cols-1 row-cols-md-2 g-2">
										<div><small class="text-muted">type</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.EmailType))</div></div>
										<div><small class="text-muted">vendor</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.VendorName))</div></div>
										<div><small class="text-muted">tour</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.TourName))</div></div>
										<div><small class="text-muted">date</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.TourDate))</div></div>
										<div><small class="text-muted">time</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.TourTime))</div></div>
										<div><small class="text-muted">location</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.TourLocation))</div></div>
										<div><small class="text-muted">customer</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.CustomerName))</div></div>
										<div><small class="text-muted">email</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.CustomerEmail))</div></div>
										<div><small class="text-muted">phone</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.CustomerPhone))</div></div>
										<div><small class="text-muted">language</small><div>@(Fmt(hydratedDiagnostic.ProcessedDiagnostic?.Language))</div></div>
										<div><small class="text-muted">started</small><div>@(hydratedDiagnostic.ProcessedDiagnostic?.ProcessingStartedAt?.ToString("MM/dd/yyyy h:mm:ss tt") ?? "—")</div></div>
										<div><small class="text-muted">completed</small><div><strong>@(hydratedDiagnostic.ProcessedDiagnostic?.ProcessingCompletedAt?.ToString("MM/dd/yyyy h:mm:ss tt") ?? "—")</strong></div></div>
									</div>
									@if (!string.IsNullOrWhiteSpace(GetDiagnosticPlainText(hydratedDiagnostic)))
									{
										<div class="card mt-2">
											<div class="card-body p-2">
												<pre @key="hydratedDiagnostic?.ProcessedDiagnostic?.MessageId"
													 class="mb-0"
													 style="white-space: pre-wrap; font-size: .825rem;"
													 @ref="diagnosticPlainRef">@GetDiagnosticPlainText(hydratedDiagnostic)</pre>
											</div>
										</div>
									}
								</div>
							</div>
							<div class="row row-cols-1 row-cols-md-2 g-2 mt-2">
								<div>
									<div class="fw-bold text-uppercase mb-1">booking</div>
									@if (hydratedDiagnostic.BookingDiagnostic == null)
									{
										<div><small class="text-muted">—</small></div>
									}
									else
									{
										<div class="row row-cols-1 row-cols-md-2 g-2">
											<div><small class="text-muted">code</small><div>@(Fmt(hydratedDiagnostic.BookingDiagnostic.BookingCode))</div></div>
											<div><small class="text-muted">status</small><div>@(Fmt(hydratedDiagnostic.BookingDiagnostic.BookingStatus))</div></div>
											<div><small class="text-muted">is active</small><div>@hydratedDiagnostic.BookingDiagnostic.IsActive</div></div>
											<div><small class="text-muted">flags</small><div>@(hydratedDiagnostic.BookingDiagnostic.IsConfirmation ? "confirmation " : "")@(hydratedDiagnostic.BookingDiagnostic.IsModification ? "modification " : "")@(hydratedDiagnostic.BookingDiagnostic.IsCancellation ? "cancellation" : "")</div></div>
											<div><small class="text-muted">updated</small><div><strong>@hydratedDiagnostic.BookingDiagnostic.UpdatedAt.ToString("MM/dd/yyyy h:mm:ss tt")</strong></div></div>
										</div>
									}
								</div>
								<div>
									<div class="fw-bold text-uppercase mb-1">customer</div>
									@if (hydratedDiagnostic.CustomerDiagnostic == null)
									{
										<div><small class="text-muted">—</small></div>
									}
									else
									{
										<div class="row row-cols-1 row-cols-md-2 g-2">
											<div><small class="text-muted">name</small><div>@(Fmt(hydratedDiagnostic.CustomerDiagnostic.FullName))</div></div>
											<div><small class="text-muted">email</small><div>@(Fmt(hydratedDiagnostic.CustomerDiagnostic.Email))</div></div>
											<div><small class="text-muted">phone</small><div>@(Fmt(hydratedDiagnostic.CustomerDiagnostic.PhoneNumber))</div></div>
											<div><small class="text-muted">identifier</small><div>@(Fmt(hydratedDiagnostic.CustomerDiagnostic.CustomerIdentifier))</div></div>
											<div><small class="text-muted">total bookings</small><div>@hydratedDiagnostic.CustomerDiagnostic.TotalBookings</div></div>
											<div><small class="text-muted">updated</small><div>@hydratedDiagnostic.CustomerDiagnostic.UpdatedAt.ToString("MM/dd/yyyy h:mm:ss tt")</div></div>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
				}

				@if (initialProcessed != null)
				{
					<div class="card mb-2">
						<div class="card-header py-2"><small class="fw-bold">booking/confirmation info</small></div>
						<div class="card-body p-2">
							<div class="row row-cols-2 row-cols-md-4 g-2 small">
								<div><small class="text-muted">date</small><div>@initialProcessedFull?.TourDate?.ToString("yyyy-MM-dd")</div></div>
								<div><small class="text-muted">tour</small><div>@initialProcessedFull?.TourName</div></div>
								<div><small class="text-muted">customer</small><div>@initialProcessedFull?.CustomerName</div></div>
								<div><small class="text-muted">time</small><div>@initialProcessedFull?.TourTime</div></div>
							</div>
							<div class="row row-cols-1 row-cols-md-2 g-2 small mt-1">
								<div><small class="text-muted">customer email</small><div>@(Fmt(initialProcessedFull?.CustomerEmail))</div></div>
								<div><small class="text-muted">customer phone</small><div>@(Fmt(initialProcessedFull?.CustomerPhone))</div></div>
							</div>
							<div class="row row-cols-1 row-cols-md-3 g-2 small mt-1">
								<div><small class="text-muted">language</small><div>@(Fmt(initialProcessedFull?.Language))</div></div>
								<div><small class="text-muted">tour location</small><div>@(Fmt(initialProcessedFull?.TourLocation))</div></div>
								<div><small class="text-muted">vendor</small><div>@(Fmt(initialProcessedFull?.VendorName))</div></div>
							</div>
							<div class="row row-cols-1 row-cols-md-3 g-2 small mt-1">
								<div><small class="text-muted">booking</small><div>@(selectedBookingCode ?? initialProcessed?.BookingCode ?? "—")</div></div>
								<div><small class="text-muted">received</small><div><strong>@(initialInboxEmail?.ReceivedDate.ToString("MM/dd/yyyy h:mm:ss tt") ?? "—")</strong></div></div>
								<div><small class="text-muted">processed</small><div><strong>@(initialProcessed?.ProcessingCompletedAt?.ToString("MM/dd/yyyy h:mm:ss tt") ?? "—")</strong></div></div>
							</div>
							@if (!string.IsNullOrWhiteSpace(initialPlainText))
							{
								<div class="card mt-2">
									<div class="card-body p-2">
										<pre class="mb-0" style="white-space: pre-wrap; font-size: .825rem;">@initialPlainText</pre>
									</div>
								</div>
							}
						</div>
					</div>
				}

				@* 2025-12-01 00:00 UTC - Admin tab also available in booking-code view *@
				<ul class="nav nav-tabs nav-fill small mb-2">
					<li class="nav-item"><button class='@GetDetailTabBtnClass("processed")' @onclick='(() => SetDetailTab("processed"))'>Processed Email</button></li>
					<li class="nav-item"><button class='@GetDetailTabBtnClass("admin")' @onclick='(() => SetDetailTab("admin"))'>Admin</button></li>
					<li class="nav-item"><button class='@GetDetailTabBtnClass("errors")' @onclick='(() => SetDetailTab("errors"))'>Tour Errors</button></li>
					<li class="nav-item"><button class="nav-link" disabled>Booking</button></li>
					<li class="nav-item"><button class="nav-link" disabled>Customer</button></li>
				</ul>

				@if (detailTab == "errors")
				{
					<Email.Components.Diagnostics.TourErrorReportsView SelectedReport="selectedErrorReport" />
				}

				@if (detailTab == "admin")
				{
					<div class="card mb-2">
						<div class="card-header py-2 d-flex align-items-center justify-content-between">
							<small class="fw-bold">admin</small>
							<div class="d-flex align-items-center gap-2">
								<button type="button"
										class="btn btn-link btn-sm p-0"
										title="Admin functions help"
										@onclick="(() => showAdminHelp = true)">?</button>
							</div>
						</div>
						<div class="card-body p-2">
							<table class="table table-sm table-striped mb-2 small">
								<thead><tr><th>Action</th><th>Description</th><th class="text-end">Run</th></tr></thead>
								<tbody>
									<tr>
										<td>Repair Booking Codes (All)</td>
										<td>Fixes AutomaticGmail_ProcessedEmails.BookingCode for Modification/Cancellation rows.</td>
										<td class="text-end">
											<button class="btn btn-outline-danger btn-sm"
													disabled="@isBusy"
													@onclick="RepairCodesAsync">Run</button>
										</td>
									</tr>
									<tr>
										<td>Reprocess Mods Missing Tour Fields (All)</td>
										<td>Finds modification emails with blank tour name/date/time/location/language and reprocesses them.</td>
										<td class="text-end">
											<button class="btn btn-outline-primary btn-sm"
													disabled="@isBusy"
													@onclick="ReprocessMissingTourFieldsAsync">Run</button>
										</td>
									</tr>
									<tr>
										<td>Rebuild Origin Pointers (All)</td>
										<td>Overrides OriginalBooking* fields across inbox to canonical root bookings.</td>
										<td class="text-end">
											<button class="btn btn-outline-warning btn-sm"
													disabled="@isBusy"
													@onclick="RebuildOriginsAsync">Run</button>
										</td>
									</tr>
									<tr>
										<td>Backfill Origins (All)</td>
										<td>Populate missing OriginalBooking* via COALESCE (no overwrite).</td>
										<td class="text-end">
											<button class="btn btn-outline-secondary btn-sm"
													disabled="@isBusy"
													@onclick="BackfillOriginsAsync">Run</button>
										</td>
									</tr>
								</tbody>
							</table>
							@if (!string.IsNullOrWhiteSpace(repairStatus) || !string.IsNullOrWhiteSpace(rebuildStatus) || !string.IsNullOrWhiteSpace(backfillStatus) || !string.IsNullOrWhiteSpace(reprocessMissingStatus))
							{
								<div class="small text-muted">
									@if (!string.IsNullOrWhiteSpace(repairStatus)) { <div>@repairStatus</div> }
									@if (!string.IsNullOrWhiteSpace(reprocessMissingStatus)) { <div>@reprocessMissingStatus</div> }
									@if (!string.IsNullOrWhiteSpace(rebuildStatus)) { <div>@rebuildStatus</div> }
									@if (!string.IsNullOrWhiteSpace(backfillStatus)) { <div>@backfillStatus</div> }
								</div>
							}
						</div>
					</div>
				}

				@if (modificationProcessed.Count > 0)
				{
					<div class="card mb-2">
						<div class="card-header py-2"><small class="fw-bold">modification</small></div>
						<div class="card-body p-2">
							<div class="row row-cols-1 row-cols-md-3 g-2 small">
								<div><small class="text-muted">received</small><div><strong>@(latestModInboxEmail?.ReceivedDate.ToString("MM/dd/yyyy h:mm:ss tt") ?? "—")</strong></div></div>
								<div><small class="text-muted">processed</small><div><strong>@(modificationProcessed[^1].ProcessingCompletedAt?.ToString("MM/dd/yyyy h:mm:ss tt") ?? "—")</strong></div></div>
								<div><small class="text-muted">type</small><div>modification</div></div>
							</div>
							@if (!string.IsNullOrWhiteSpace(modificationPlainText))
							{
								<div class="card mb-2">
									<div class="card-body p-2">
										<pre class="mb-0" style="white-space: pre-wrap; font-size: .825rem;">@modificationPlainText</pre>
									</div>
								</div>
