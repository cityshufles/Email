	private static string GetVendorInitials(string? vendorName)
	{
		var v = (vendorName ?? string.Empty).Trim();
		if (string.IsNullOrEmpty(v)) return "—";
		var parts = v.Split(' ', StringSplitOptions.RemoveEmptyEntries);
		if (parts.Length == 1)
		{
			return parts[0].Length >= 2 ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[0][1])}" : parts[0][0].ToString().ToUpperInvariant();
		}
		return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
	}
	private static bool ContainsInvariant(string? haystack, string needle)
	{
		if (string.IsNullOrWhiteSpace(needle)) return true;
		return (haystack ?? string.Empty).IndexOf(needle, StringComparison.OrdinalIgnoreCase) >= 0;
	}
	private static string NormalizeSpaces(string s) => string.Join(" ", (s ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries));
	private static DateTime? EffectiveTimestamp(ProcessedEmailDisplayDto p) => p.ProcessingCompletedAt ?? p.ExtractedAt;
	private static string NormalizeTypeForFilter(string? emailType)
	{
		if (string.Equals(emailType ?? string.Empty, "Confirmation", StringComparison.OrdinalIgnoreCase)) return "Booking";
		return emailType ?? string.Empty;
	}
	private void ApplyLeftFiltersDebounced()
	{
		_filterCts?.Cancel();
		_filterCts?.Dispose();
		_filterCts = new System.Threading.CancellationTokenSource();
		var token = _filterCts.Token;
		_ = Task.Run(async () =>
		{
			try
			{
				await Task.Delay(200, token);
				if (token.IsCancellationRequested) return;
				await InvokeAsync(ApplyLeftFiltersNow);
			}
			catch { /* ignore */ }
		}, token);
	}
	private void ApplyLeftFiltersNow()
	{
		IEnumerable<ProcessedEmailDisplayDto> query = leftProcessedEmails;

		// Sort: CompletedAt desc (fallback ExtractedAt desc)
		query = query.OrderByDescending(p => EffectiveTimestamp(p) ?? DateTime.MinValue);

		// Type chips
		if (selectedTypes.Count > 0)
		{
			query = query.Where(p => selectedTypes.Contains(NormalizeTypeForFilter(p.EmailType)));
		}

		// Dates
		DateTime today = DateTime.UtcNow.Date;
		if (datePreset == DatePreset.Today)
		{
			query = query.Where(p => (EffectiveTimestamp(p)?.Date ?? DateTime.MinValue.Date) == today);
		}
		else if (datePreset == DatePreset.Last7)
		{
			var from = today.AddDays(-6);
			query = query.Where(p =>
			{
				var d = EffectiveTimestamp(p)?.Date;
				return d.HasValue && d.Value >= from && d.Value <= today;
			});
		}
		else if (datePreset == DatePreset.Last30)
		{
			var from = today.AddDays(-29);
			query = query.Where(p =>
			{
				var d = EffectiveTimestamp(p)?.Date;
				return d.HasValue && d.Value >= from && d.Value <= today;
			});
		}
		else if (datePreset == DatePreset.Custom && (!string.IsNullOrWhiteSpace(fromDateStr) || !string.IsNullOrWhiteSpace(toDateStr)))
		{
			DateTime? from = DateTime.TryParse(fromDateStr, out var fd) ? fd.Date : (DateTime?)null;
			DateTime? to = DateTime.TryParse(toDateStr, out var td) ? td.Date : (DateTime?)null;
			query = query.Where(p =>
			{
				var d = EffectiveTimestamp(p)?.Date;
				if (!d.HasValue) return false;
				if (from.HasValue && d.Value < from.Value) return false;
				if (to.HasValue && d.Value > to.Value) return false;
				return true;
			});
		}

		// Search
		var term = (searchText ?? string.Empty).Trim();
		if (!string.IsNullOrWhiteSpace(term))
		{
			if (searchMode == SearchMode.Customer)
			{
				query = query.Where(p => ContainsInvariant(p.CustomerName, term));
			}
			else if (searchMode == SearchMode.BookingCode)
			{
				var t = NormalizeSpaces(term);
				query = query.Where(p => ContainsInvariant(NormalizeSpaces(p.BookingCode ?? string.Empty), t));
			}
			else if (searchMode == SearchMode.MessageId)
			{
				query = query.Where(p => ContainsInvariant(p.MessageId, term));
			}
		}

		leftFiltered = query.ToList();
		StateHasChanged();
	}

	private bool HasActiveFilters()
	{
		if (selectedTypes.Count > 0) return true;
		if (datePreset != DatePreset.None) return true;
		if (!string.IsNullOrWhiteSpace(fromDateStr) || !string.IsNullOrWhiteSpace(toDateStr)) return true;
		if (!string.IsNullOrWhiteSpace(searchText)) return true;
		return false;
	}

