	private async Task BackfillOriginsAsync()
	{
		try
		{
			isBusy = true;
			backfillStatus = "Running backfill…";
			StateHasChanged();

			// No limit as requested - process all
			var updated = await ProcessingService.BackfillOriginalBookingsAsync(int.MaxValue, CancellationToken.None);

			backfillStatus = $"Backfill completed. Updated {updated} inbox rows.";

			// Refresh left list and keep selection current
			await LoadLeftAsync();
			if (!string.IsNullOrWhiteSpace(selectedMessageId))
			{
				await ReloadSelectedAsync();
			}
		}
		catch (Exception ex)
		{
			backfillStatus = $"Backfill failed: {ex.Message}";
