	private async Task LoadLeftAsync()
	{
		try
		{
			leftList.Clear();
			leftGroups.Clear();
			if (listScope == "pending")
			{
				var rows = await ProcessingService.GetUnprocessedAsync(200, CancellationToken.None);
				leftList = rows.Select(r => new LeftItem
				{
					MessageId = r.MessageId,
					Title = string.IsNullOrWhiteSpace(r.Subject) ? r.MessageId : r.Subject,
					Subtitle = r.FromEmail,
					Date = r.ReceivedDate
				}).ToList();
			}
			else if (listScope == "processed")
			{
				var rows = await ProcessingService.GetRecentProcessedAsync(200, CancellationToken.None);
				var grouped = rows
					.Where(r => !string.IsNullOrWhiteSpace(r.BookingCode))
					.GroupBy(r => r.BookingCode!.Trim())
					.OrderByDescending(g => g.Max(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MinValue));

				leftGroups = grouped.Select(g => new LeftGroup
				{
					BookingCode = g.Key,
					Count = g.Count(),
					LatestAt = g.Max(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MinValue)
				}).ToList();
			}
			else if (listScope == "processed_emails")
			{
				var rows = await ProcessingService.GetRecentProcessedAsync(200, CancellationToken.None);
				leftProcessedEmails = rows.ToList();
				ApplyLeftFiltersNow();
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "[EmailPipeline] LoadLeftAsync failed: {Message}", ex.Message);
		}
		StateHasChanged();
	}

