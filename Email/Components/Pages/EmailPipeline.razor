	private async Task ReloadSelectedAsync()
	{
		if (string.IsNullOrWhiteSpace(selectedMessageId)) return;
		try
		{
			isBusy = true;
			processedPlainHeaderSummary = string.Empty;
			originalBookingMessageId = null;
			cancellationWarningActiveBookingPresent = false;
			cancellationWarningDetail = string.Empty;
			modificationWarningOldBookingActive = false;
			modificationWarningDetail = string.Empty;
			selectedInbox = await ProcessingService.GetInboxByMessageIdAsync(selectedMessageId, CancellationToken.None);

			// Allow nulls and type mismatches gracefully
			try
			{
				processed = await TourEmailsService.GetProcessedEmailByMessageIdAsync(selectedMessageId);
			}
			catch
			{
				processed = null;
			}

			try
			{
				plainText = processed?.PlainTextContent
							?? processed?.HtmlContent
							?? (await TourEmailsService.GetInboxEmailByMessageIdAsync(selectedMessageId))?.TextBody
							?? string.Empty;
			}
			catch
			{
				plainText = string.Empty;
			}

			currentBookingCode = SelectBookingCodeForDisplayDiagnostic(processed?.BookingCode, processed?.NewBookingCode, processed?.PreviousBookingCode, processed?.EmailType);

			// Hydrated diagnostic (inbox + processed + booking + customer)
			try
			{
				hydratedDiagnostic = await ProcessingService.GetHydratedDiagnosticByMessageIdAsync(selectedMessageId, CancellationToken.None);
			}
			catch
			{
				hydratedDiagnostic = null;
			}
			try
			{
				processedFullDiagnostic = await ProcessingService.GetProcessedFullByMessageIdAsync(selectedMessageId, CancellationToken.None);
				processedFullJsonDiagnostic = processedFullDiagnostic == null
					? string.Empty
					: System.Text.Json.JsonSerializer.Serialize(processedFullDiagnostic, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
			}
			catch
			{
				processedFullDiagnostic = null;
				processedFullJsonDiagnostic = string.Empty;
			}

			// Prefer DB-stored origin pointer for baseline to avoid cross-tour bleeding
			// If available, load that original booking email as our baseline and cache message id
			var originPointerMsgId = hydratedDiagnostic?.InboxDiagnostic?.OriginalBookingMessageId;
			bool baselineFromOriginPointer = false;
			if (!string.IsNullOrWhiteSpace(originPointerMsgId))
			{
				try
				{
					var pe = await TourEmailsService.GetProcessedEmailByMessageIdAsync(originPointerMsgId!);
					if (pe != null)
					{
						initialProcessedFull = pe;
						originalBookingMessageId = originPointerMsgId;
						baselineFromOriginPointer = true;
					}

					// Resolve original booking via pointer to surface original tour name/time
					try
					{
						var hd = await ProcessingService.GetHydratedDiagnosticByMessageIdAsync(originPointerMsgId!, CancellationToken.None);
						originBookingFromPointer = hd?.BookingDiagnostic;
					}
					catch { originBookingFromPointer = null; }
				}
				catch { /* ignore */ }
			}

			// Load booking by ANY available booking code (bottom card)
			bookingByCodeDiagnostic = null;
			var codeFromProcessed = SelectBookingCodeForDisplayDiagnostic(processed?.BookingCode, processed?.NewBookingCode, processed?.PreviousBookingCode, processed?.EmailType);
			var codeFromFull = SelectBookingCodeForDisplayDiagnostic(processedFullDiagnostic?.BookingCode, processedFullDiagnostic?.NewBookingCode, processedFullDiagnostic?.PreviousBookingCode, processedFullDiagnostic?.EmailType);
			var bestCode = !string.IsNullOrWhiteSpace(codeFromProcessed) ? codeFromProcessed
				: (!string.IsNullOrWhiteSpace(codeFromFull) ? codeFromFull
				: processedFullDiagnostic?.ExtractedBookingCode);
			if (!string.IsNullOrWhiteSpace(bestCode))
			{
				try
				{
					bookingByCodeDiagnostic = await ProcessingService.GetBookingByCodeAsync(bestCode!, CancellationToken.None);
				}
				catch { /* ignore */ }
			}

			// Load thread-related items (modification / cancellation) for the same booking code
			relatedProcessed.Clear();
			finalBooking = null;
			bookingCustomer = null;
			if (!string.IsNullOrWhiteSpace(currentBookingCode))
			{
				// Load full thread by computed canonical root so history includes A->B->C chains
				// Do not rely on inbox original pointer here; it may be stale or non-root for historical rows.
				var computedRoot = await ProcessingService.ResolveRootBookingCodeAsync(currentBookingCode!, CancellationToken.None);
				relatedProcessed = (await ProcessingService.GetProcessedThreadByRootBookingCodeAsync(computedRoot, CancellationToken.None)).ToList();
				// Compute initial (booking/confirmation) in this thread
				initialProcessed = relatedProcessed
					.Where(p => string.Equals(p.EmailType, "Booking", StringComparison.OrdinalIgnoreCase) ||
								string.Equals(p.EmailType, "Confirmation", StringComparison.OrdinalIgnoreCase))
					.OrderBy(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MaxValue)
					.FirstOrDefault();
				finalBooking = await ProcessingService.GetBookingByCodeAsync(currentBookingCode, CancellationToken.None);
				bookingCustomer = await ProcessingService.GetCustomerForBookingCodeAsync(currentBookingCode, CancellationToken.None);

				// Determine latest modification and cancellation in this thread
				modificationProcessed = relatedProcessed
					.Where(p => string.Equals(p.EmailType, "Modification", StringComparison.OrdinalIgnoreCase))
					.GroupBy(p => p.MessageId)
					.Select(g => g.OrderBy(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MaxValue).First())
					.OrderBy(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MaxValue)
					.ToList();

				// Determine initial booking/confirmation (ensure unique by MessageId)
				initialProcessed = relatedProcessed
					.Where(p => string.Equals(p.EmailType, "Booking", StringComparison.OrdinalIgnoreCase) ||
								string.Equals(p.EmailType, "Confirmation", StringComparison.OrdinalIgnoreCase))
					.GroupBy(p => p.MessageId)
					.Select(g => g.OrderBy(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MaxValue).First())
					.OrderBy(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MaxValue)
					.FirstOrDefault();

				latestCancellation = relatedProcessed
					.Where(p => string.Equals(p.EmailType, "Cancellation", StringComparison.OrdinalIgnoreCase))
					.GroupBy(p => p.MessageId)
					.Select(g => g.OrderByDescending(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MinValue).First())
					.OrderByDescending(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MinValue)
					.FirstOrDefault();

				// Load content/inbox for latest modification
				modificationPlainText = string.Empty;
				if (modificationProcessed.Count > 0 && !string.IsNullOrWhiteSpace(modificationProcessed[^1].MessageId))
				{
					var me = await TourEmailsService.GetProcessedEmailByMessageIdAsync(modificationProcessed[^1].MessageId!);
					latestModificationFull = me;
					modificationPlainText = me?.PlainTextContent ?? me?.HtmlContent ?? string.Empty;
					latestModInboxEmail = await ProcessingService.GetInboxByMessageIdAsync(modificationProcessed[^1].MessageId!, CancellationToken.None);
				}

				// Load content/inbox for latest cancellation
				cancellationPlainText = string.Empty;
				if (latestCancellation != null && !string.IsNullOrWhiteSpace(latestCancellation.MessageId))
				{
					var ce = await TourEmailsService.GetProcessedEmailByMessageIdAsync(latestCancellation.MessageId);
					latestCancellationFull = ce;
					cancellationPlainText = ce?.PlainTextContent ?? ce?.HtmlContent ?? string.Empty;
					latestCancelInboxEmail = await ProcessingService.GetInboxByMessageIdAsync(latestCancellation.MessageId, CancellationToken.None);
				}

				// Load initial processed full for comparison
				if (initialProcessed != null && !string.IsNullOrWhiteSpace(initialProcessed.MessageId))
				{
					initialProcessedFull = await TourEmailsService.GetProcessedEmailByMessageIdAsync(initialProcessed.MessageId);
					// Also resolve the Booking row for the true initial (root) to drive the summary's "original" row
					try
					{
						originBookingForSummary = null;
						if (!string.IsNullOrWhiteSpace(initialProcessedFull?.BookingCode))
						{
							originBookingForSummary = await ProcessingService.GetBookingByCodeAsync(initialProcessedFull.BookingCode!, CancellationToken.None);
						}
					}
					catch { originBookingForSummary = null; }
				}

				// Build plaintext header summary for modifications (compare initial vs current)
				if (processedFullDiagnostic != null &&
					string.Equals(processedFullDiagnostic.EmailType, "Modification", StringComparison.OrdinalIgnoreCase) &&
					initialProcessedFull != null)
				{
					var prev = MapToSimple(initialProcessedFull);
					var curr = MapToSimple(processedFullDiagnostic);
					processedPlainHeaderSummary = BuildModificationSummary(prev, curr);
				}

				// Compute warnings for cancellation/modification inconsistent DB bookings
				await ComputeBookingStateWarningsAsync(processedFullDiagnostic, relatedProcessed, currentBookingCode, CancellationToken.None);

				// 2025-11-30 00:00 UTC - Improve modification baseline by unifying across new/previous/current codes
			if (!baselineFromOriginPointer &&
				processedFullDiagnostic != null &&
					string.Equals(processedFullDiagnostic.EmailType, "Modification", StringComparison.OrdinalIgnoreCase))
				{
					var codeSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					void add(string? s) { if (!string.IsNullOrWhiteSpace(s)) codeSet.Add(s!.Trim()); }
					// include codes from both processed models
					add(processed?.BookingCode); add(processed?.NewBookingCode); add(processed?.PreviousBookingCode);
					add(processedFullDiagnostic.BookingCode); add(processedFullDiagnostic.NewBookingCode); add(processedFullDiagnostic.PreviousBookingCode);

					var unionThread = await LoadThreadByCodesAsync(codeSet, CancellationToken.None);
					var unionInitial = unionThread
						.Where(p => string.Equals(p.EmailType, "Booking", StringComparison.OrdinalIgnoreCase) ||
									string.Equals(p.EmailType, "Confirmation", StringComparison.OrdinalIgnoreCase))
						.OrderBy(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MaxValue)
						.FirstOrDefault();
					if (unionInitial != null && !string.IsNullOrWhiteSpace(unionInitial.MessageId))
					{
						try
						{
							var pe = await TourEmailsService.GetProcessedEmailByMessageIdAsync(unionInitial.MessageId);
							if (pe != null)
							{
								var prev = MapToSimple(pe);
								var curr = MapToSimple(processedFullDiagnostic);
								var unifiedSummary = BuildModificationSummary(prev, curr);
								if (!string.IsNullOrWhiteSpace(unifiedSummary))
								{
									processedPlainHeaderSummary = unifiedSummary;
								}
								initialProcessedFull = pe; // adopt better baseline
								originalBookingMessageId = unionInitial.MessageId;

								// Build the timeline based on unified baseline
								await BuildModificationTimelineAsync(MapToSimple(initialProcessedFull), CancellationToken.None);
							}
						}
						catch { /* ignore */ }
					}
					else
					{
						// Build timeline from existing baseline if available
						if (initialProcessed != null && !string.IsNullOrWhiteSpace(initialProcessed.MessageId))
						{
							originalBookingMessageId = initialProcessed.MessageId;
						}
						await BuildModificationTimelineAsync(initialProcessedFull != null ? MapToSimple(initialProcessedFull) : null, CancellationToken.None);
					}
				}
				else
				{
					// Not a modification; clear timeline
					modificationTimeline.Clear();
				}
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "[EmailPipeline] ReloadSelectedAsync failed: {Message}", ex.Message);
		}
		finally
		{
			isBusy = false;
		}
		pendingHighlight = true;
		StateHasChanged();
	}

	private async Task ReloadSelectedByBookingAsync()
	{
		if (string.IsNullOrWhiteSpace(selectedBookingCode)) return;
		try
		{
			isBusy = true;
			processedPlainHeaderSummary = string.Empty;
			originalBookingMessageId = null;
			cancellationWarningActiveBookingPresent = false;
			cancellationWarningDetail = string.Empty;
			modificationWarningOldBookingActive = false;
			modificationWarningDetail = string.Empty;
			modificationTimeline.Clear();

			// Load full processed thread starting from canonical root
			{
				var rootCode = await ProcessingService.ResolveRootBookingCodeAsync(selectedBookingCode!, CancellationToken.None);
				relatedProcessed = (await ProcessingService.GetProcessedThreadByRootBookingCodeAsync(rootCode, CancellationToken.None)).ToList();
			}

			// Determine timeline buckets
			initialProcessed = relatedProcessed
				.Where(p => string.Equals(p.EmailType, "Booking", StringComparison.OrdinalIgnoreCase) ||
				            string.Equals(p.EmailType, "Confirmation", StringComparison.OrdinalIgnoreCase))
				.GroupBy(p => p.MessageId)
				.Select(g => g.OrderBy(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MaxValue).First())
				.OrderBy(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MaxValue)
				.FirstOrDefault();
			if (initialProcessed != null && !string.IsNullOrWhiteSpace(initialProcessed.MessageId))
			{
				originalBookingMessageId = initialProcessed.MessageId;
			}

			modificationProcessed = relatedProcessed
				.Where(p => string.Equals(p.EmailType, "Modification", StringComparison.OrdinalIgnoreCase))
				.GroupBy(p => p.MessageId)
				.Select(g => g.OrderBy(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MaxValue).First())
				.OrderBy(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MaxValue)
				.ToList();

			latestCancellation = relatedProcessed
				.Where(p => string.Equals(p.EmailType, "Cancellation", StringComparison.OrdinalIgnoreCase))
				.GroupBy(p => p.MessageId)
				.Select(g => g.OrderByDescending(x => x.ProcessingCompletedAt ?? x.ExtractedAt ?? DateTime.MinValue).First())
				.OrderByDescending(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MinValue)
				.FirstOrDefault();

			// Load content for initial + most recent modification (if any)
			initialPlainText = string.Empty;
			modificationPlainText = string.Empty;
			if (initialProcessed != null && !string.IsNullOrWhiteSpace(initialProcessed.MessageId))
			{
				var pe = await TourEmailsService.GetProcessedEmailByMessageIdAsync(initialProcessed.MessageId);
				initialProcessedFull = pe;
				initialPlainText = pe?.PlainTextContent ?? pe?.HtmlContent ?? string.Empty;
				initialInboxEmail = await ProcessingService.GetInboxByMessageIdAsync(initialProcessed.MessageId, CancellationToken.None);
				initialHydratedDiagnostic = await ProcessingService.GetHydratedDiagnosticByMessageIdAsync(initialProcessed.MessageId, CancellationToken.None);
				// Resolve original booking from the true initial processed for summary display
				try
				{
					originBookingForSummary = null;
					if (!string.IsNullOrWhiteSpace(pe?.BookingCode))
					{
						originBookingForSummary = await ProcessingService.GetBookingByCodeAsync(pe.BookingCode!, CancellationToken.None);
					}
				}
				catch { originBookingForSummary = null; }
			}
			if (modificationProcessed.Count > 0 && !string.IsNullOrWhiteSpace(modificationProcessed[^1].MessageId))
			{
				var me = await TourEmailsService.GetProcessedEmailByMessageIdAsync(modificationProcessed[^1].MessageId!);
				latestModificationFull = me;
				modificationPlainText = me?.PlainTextContent ?? me?.HtmlContent ?? string.Empty;
				latestModInboxEmail = await ProcessingService.GetInboxByMessageIdAsync(modificationProcessed[^1].MessageId!, CancellationToken.None);
				modificationHydratedDiagnostic = await ProcessingService.GetHydratedDiagnosticByMessageIdAsync(modificationProcessed[^1].MessageId!, CancellationToken.None);
			}

			// Final booking record and linked customer
			finalBooking = await ProcessingService.GetBookingByCodeAsync(selectedBookingCode!, CancellationToken.None);
			bookingCustomer = finalBooking != null
				? await ProcessingService.GetCustomerForBookingCodeAsync(selectedBookingCode!, CancellationToken.None)
				: null;
			currentBookingCode = selectedBookingCode;
			selectedInbox = null;
			processed = null;
			plainText = string.Empty;

			// Cancellation content (if any)
			cancellationPlainText = string.Empty;
			if (latestCancellation != null && !string.IsNullOrWhiteSpace(latestCancellation.MessageId))
			{
				var ce = await TourEmailsService.GetProcessedEmailByMessageIdAsync(latestCancellation.MessageId);
				latestCancellationFull = ce;
				cancellationPlainText = ce?.PlainTextContent ?? ce?.HtmlContent ?? string.Empty;
				cancellationHydratedDiagnostic = await ProcessingService.GetHydratedDiagnosticByMessageIdAsync(latestCancellation.MessageId, CancellationToken.None);
			}

			// Compute warnings for cancellation/modification inconsistent DB bookings
			await ComputeBookingStateWarningsAsync(null, relatedProcessed, currentBookingCode, CancellationToken.None);

			// Build modifications timeline when applicable
			if (modificationProcessed.Count > 0)
			{
				await BuildModificationTimelineAsync(initialProcessedFull != null ? MapToSimple(initialProcessedFull) : null, CancellationToken.None);
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "[EmailPipeline] ReloadSelectedByBookingAsync failed: {Message}", ex.Message);
		}
		finally
		{
			isBusy = false;
		}
		pendingHighlight = true;
		StateHasChanged();
	}

	private async Task ProcessSelectedAsync()
	{
		if (string.IsNullOrWhiteSpace(selectedMessageId)) return;
		try
		{
			isBusy = true;
			var inboxId = await ProcessingService.GetInboxIdByMessageIdAsync(selectedMessageId, CancellationToken.None);
			if (inboxId.HasValue)
			{
				await ProcessingService.ProcessSpecificAsync(new List<int> { inboxId.Value }, CancellationToken.None);
				await ReloadSelectedAsync();
				if (listScope == "pending")
				{
					await LoadLeftAsync();
				}
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "[EmailPipeline] ProcessSelectedAsync failed: {Message}", ex.Message);
		}
		finally
		{
			isBusy = false;
		}
	}

