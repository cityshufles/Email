				             ?? processedFullDiagnostic?.VendorName
				             ?? hydratedDiagnostic?.ProcessedDiagnostic?.VendorName
				             ?? string.Empty;
				await JS.InvokeVoidAsync("emailModHighlighter.highlight", modPlainRef, vendor);
			}

			// diagnostic plaintext → only highlight when selected processed is a modification
			if (hydratedDiagnostic?.ProcessedDiagnostic != null &&
			    string.Equals(hydratedDiagnostic.ProcessedDiagnostic.EmailType, "Modification", StringComparison.OrdinalIgnoreCase))
			{
				await JS.InvokeVoidAsync("emailModHighlighter.highlight", diagnosticPlainRef, hydratedDiagnostic.ProcessedDiagnostic.VendorName ?? "");
