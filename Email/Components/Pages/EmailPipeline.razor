				if (!string.IsNullOrWhiteSpace(processedFullDiagnostic?.HtmlContent) && string.Equals(processedFullDiagnostic?.MessageId, messageId, StringComparison.OrdinalIgnoreCase))
				{
					html = processedFullDiagnostic!.HtmlContent!;
				}
			}
			if (string.IsNullOrWhiteSpace(html))
			{
				html = "<!doctype html><html><head><meta charset=\"utf-8\"><title>No HTML</title></head><body><div style=\"padding:1rem;font-family:system-ui\">No HTML body available for this message.</div></body></html>";
			}
