	private static string ShortMessageId(string? messageId)
	{
		if (string.IsNullOrWhiteSpace(messageId)) return "";
		if (messageId.Length <= 24) return messageId;
		return messageId[..12] + "..." + messageId[^9..];
	}

	private static string Fmt(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

	private static string StripHtml(string? html)
	{
		if (string.IsNullOrWhiteSpace(html)) return string.Empty;
		var s = html.Replace("<br>", "\n", StringComparison.OrdinalIgnoreCase)
			.Replace("<br/>", "\n", StringComparison.OrdinalIgnoreCase)
			.Replace("<br />", "\n", StringComparison.OrdinalIgnoreCase);
		return System.Text.RegularExpressions.Regex.Replace(s, "<.*?>", string.Empty);
	}

	// 2025-12-02 00:00 UTC - Flow-aware booking code selection for display/use
	// Mirrors processing rules:
	// - Modification: New -> Booking -> Previous
	// - Cancellation: Previous -> Booking
	// - Booking/Confirmation/Other: Booking
	private static string? SelectBookingCodeForDisplayDiagnostic(string? bookingCode, string? newBookingCode, string? previousBookingCode, string? emailType = null)
	{
		var type = (emailType ?? string.Empty).Trim();
		if (string.Equals(type, "Modification", StringComparison.OrdinalIgnoreCase))
		{
			if (!string.IsNullOrWhiteSpace(newBookingCode)) return newBookingCode!.Trim();
			if (!string.IsNullOrWhiteSpace(bookingCode)) return bookingCode!.Trim();
			if (!string.IsNullOrWhiteSpace(previousBookingCode)) return previousBookingCode!.Trim();
			return null;
		}
		if (string.Equals(type, "Cancellation", StringComparison.OrdinalIgnoreCase))
		{
			if (!string.IsNullOrWhiteSpace(previousBookingCode)) return previousBookingCode!.Trim();
			if (!string.IsNullOrWhiteSpace(bookingCode)) return bookingCode!.Trim();
			return null;
		}
		// Default: Booking/Confirmation/Other
		if (!string.IsNullOrWhiteSpace(bookingCode)) return bookingCode!.Trim();
		if (!string.IsNullOrWhiteSpace(newBookingCode)) return newBookingCode!.Trim();
		if (!string.IsNullOrWhiteSpace(previousBookingCode)) return previousBookingCode!.Trim();
		return null;
	}

	private string GetDiagnosticPlainText(HydratedEmailDiagnosticContext? ctx)
	{
		if (ctx == null) return string.Empty;
		if (!string.IsNullOrWhiteSpace(ctx.ProcessedDiagnostic?.PlainTextContent))
		{
			return ctx.ProcessedDiagnostic!.PlainTextContent!;
		}
		if (!string.IsNullOrWhiteSpace(ctx.ProcessedDiagnostic?.HtmlContent))
		{
			return StripHtml(ctx.ProcessedDiagnostic!.HtmlContent);
		}
		return ctx.InboxDiagnostic?.TextBody ?? string.Empty;
	}

