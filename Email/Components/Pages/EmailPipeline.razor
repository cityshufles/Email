	private static string BuildModificationSummary(SimpleProcessed? previous, SimpleProcessed? current)
	{
		if (previous == null || current == null) return string.Empty;
		var changes = new List<string>();
		// Tour date
		var prevDate = previous.TourDate?.ToString("M/d/yy");
		var currDate = current.TourDate?.ToString("M/d/yy");
		if (!string.Equals(prevDate, currDate, StringComparison.Ordinal))
		{
			if (!string.IsNullOrWhiteSpace(prevDate) || !string.IsNullOrWhiteSpace(currDate))
				changes.Add($"tour date: {prevDate ?? "—"} -> {currDate ?? "—"}");
		}
		// Tour time
		if (!string.Equals(previous.TourTime ?? string.Empty, current.TourTime ?? string.Empty, StringComparison.OrdinalIgnoreCase))
		{
			changes.Add($"tour time {previous.TourTime ?? "—"} -> {current.TourTime ?? "—"}");
		}
		// Tour name
		if (!string.Equals(previous.TourName ?? string.Empty, current.TourName ?? string.Empty, StringComparison.OrdinalIgnoreCase))
		{
			changes.Add($"tour: {previous.TourName ?? "—"} -> {current.TourName ?? "—"}");
		}
		// Customer name
		if (!string.Equals(previous.CustomerName ?? string.Empty, current.CustomerName ?? string.Empty, StringComparison.OrdinalIgnoreCase))
		{
			changes.Add($"walker: {previous.CustomerName ?? "—"} -> {current.CustomerName ?? "—"}");
		}
		// Phone
		if (!string.Equals(previous.CustomerPhone ?? string.Empty, current.CustomerPhone ?? string.Empty, StringComparison.OrdinalIgnoreCase))
		{
			changes.Add($"phone: {previous.CustomerPhone ?? "—"} -> {current.CustomerPhone ?? "—"}");
		}
		// Attendees
		var prevAtt = previous.NumberOfAttendees;
		var currAtt = current.NumberOfAttendees;
		if ((prevAtt ?? -1) != (currAtt ?? -1))
		{
			// format arrow without spaces as requested
			changes.Add($"attendees: {(prevAtt?.ToString() ?? "—")}->{(currAtt?.ToString() ?? "—")}");
		}
		// Adults
		var prevAdults = previous.NumberOfAdults;
		var currAdults = current.NumberOfAdults;
		if ((prevAdults ?? -1) != (currAdults ?? -1))
		{
			changes.Add($"adults: {(prevAdults?.ToString() ?? "—")}->{(currAdults?.ToString() ?? "—")}");
		}
		// Children
		var prevChildren = previous.NumberOfChildren;
		var currChildren = current.NumberOfChildren;
		if ((prevChildren ?? -1) != (currChildren ?? -1))
		{
			changes.Add($"children: {(prevChildren?.ToString() ?? "—")}->{(currChildren?.ToString() ?? "—")}");
		}
		return string.Join(" | ", changes);
	}

	private async Task ComputeBookingStateWarningsAsync(Email.Services.GmailProcessing.Models.ProcessedEmailRecord? currentProcessedFull, List<ProcessedEmailDisplayDto> thread, string? threadBookingCode, CancellationToken ct)
	{
		try
		{
			// Cancellation: if thread has a cancellation (or current is cancellation), ensure the booking is not active
			var hasCancellation = thread.Any(p => string.Equals(p.EmailType, "Cancellation", StringComparison.OrdinalIgnoreCase))
				|| (currentProcessedFull?.IsCancellation ?? false);
			if (hasCancellation)
			{
				var code = threadBookingCode
					?? currentProcessedFull?.BookingCode
					?? currentProcessedFull?.PreviousBookingCode;
				if (!string.IsNullOrWhiteSpace(code))
				{
					Email.Services.GmailProcessing.Models.Booking? b = null;
					try { b = await ProcessingService.GetBookingByCodeAsync(code!, ct); } catch { }
					if (b != null && (b.IsActive || !string.Equals(b.BookingStatus ?? string.Empty, "Cancelled", StringComparison.OrdinalIgnoreCase)))
					{
						cancellationWarningActiveBookingPresent = true;
						cancellationWarningDetail = $"Booking {code} is still active (status: {b.BookingStatus ?? "Unknown"})";
					}
				}
			}

			// Modification: if thread has a modification (or current is modification), ensure the previous code is not active
			var hasModification = thread.Any(p => string.Equals(p.EmailType, "Modification", StringComparison.OrdinalIgnoreCase))
				|| (currentProcessedFull?.IsModification ?? false);
			if (hasModification)
			{
				// Prefer latest modification from thread for codes
				var latestMod = thread
					.Where(p => string.Equals(p.EmailType, "Modification", StringComparison.OrdinalIgnoreCase))
					.OrderByDescending(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MinValue)
					.FirstOrDefault();
				string? prevCode = currentProcessedFull?.PreviousBookingCode;
				if (string.IsNullOrWhiteSpace(prevCode) && latestMod != null && !string.IsNullOrWhiteSpace(latestMod.MessageId))
				{
					try
					{
						var latestModFull = await ProcessingService.GetProcessedFullByMessageIdAsync(latestMod.MessageId!, ct);
						prevCode = latestModFull?.PreviousBookingCode;
					}
					catch { /* ignore */ }
				}
				if (!string.IsNullOrWhiteSpace(prevCode))
				{
					Email.Services.GmailProcessing.Models.Booking? prev = null;
					try { prev = await ProcessingService.GetBookingByCodeAsync(prevCode!, ct); } catch { }
					if (prev != null && prev.IsActive)
					{
						modificationWarningOldBookingActive = true;
						modificationWarningDetail = $"Previous booking {prevCode} is still active (status: {prev.BookingStatus ?? "Unknown"})";
					}
				}
			}
		}
		catch
		{
			// ignore warning calc errors
		}
	}

	private async Task<List<ProcessedEmailDisplayDto>> LoadThreadByCodesAsync(IEnumerable<string?> codes, CancellationToken ct)
	{
		var all = new List<ProcessedEmailDisplayDto>();
		var seen = new HashSet<int>();
		foreach (var code in codes)
		{
			if (string.IsNullOrWhiteSpace(code)) continue;
			List<ProcessedEmailDisplayDto> rows;
			try { rows = (await ProcessingService.GetProcessedByBookingCodeAsync(code!, ct)).ToList(); }
			catch { continue; }
			foreach (var r in rows)
			{
				if (seen.Add(r.Id)) all.Add(r);
			}
		}
		return all;
	}

	private async Task BuildModificationTimelineAsync(SimpleProcessed? baseline, CancellationToken ct)
	{
		modificationTimeline.Clear();
		var prev = baseline;
		foreach (var mp in modificationProcessed.OrderBy(p => p.ProcessingCompletedAt ?? p.ExtractedAt ?? DateTime.MaxValue))
		{
			if (string.IsNullOrWhiteSpace(mp.MessageId)) continue;
			Email.Models.ProcessedEmail? pe = null;
			try { pe = await TourEmailsService.GetProcessedEmailByMessageIdAsync(mp.MessageId); } catch { }
			if (pe == null) continue;
			var curr = MapToSimple(pe);
			var summary = BuildModificationSummary(prev, curr);
			modificationTimeline.Add(new ModificationStepSummary
			{
				MessageId = mp.MessageId!,
				CompletedAt = mp.ProcessingCompletedAt ?? mp.ExtractedAt,
				Summary = summary,
				BookingCode = pe.BookingCode,
				VendorName = pe.VendorName
			});
			prev = curr;
		}
	}

