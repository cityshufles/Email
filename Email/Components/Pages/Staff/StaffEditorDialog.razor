                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <div class="fw-semibold mb-2">Profile Photo</div>
                                    <div class="d-flex flex-wrap gap-3 align-items-center">
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(editStaff.ImagePath))
                                            {
                                                <img src="@editStaff.ImagePath" alt="Guide photo" class="rounded-circle staff-photo-img" />
                                            }
                                            else
                                            {
                                                <div class="staff-photo-placeholder d-flex align-items-center justify-content-center border rounded-circle">
                                                    <i class="bi bi-person-circle"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <InputFile OnChange="HandlePhotoUpload" class="form-control" accept=".jpg,.jpeg,.png" disabled="@(isSavingPhoto || !editStaff.GuideId.HasValue)" />
                                            @if (!editStaff.GuideId.HasValue)
                                            {
                                                <div class="small text-muted mt-2">Save staff first to enable photo upload.</div>
                                            }
                                            @if (isSavingPhoto)
                                            {
                                                <div class="small mt-2">
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                    Saving photo...
                                                </div>
                                            }
                                            <div class="mt-2">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="DeletePhoto" disabled="@isSavingPhoto || string.IsNullOrWhiteSpace(editStaff.ImagePath)">
                                                    <i class="bi bi-trash me-1"></i>Remove Photo
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <div class="fw-semibold mb-2">Login Info</div>
                                    <div class="small text-muted mb-2">Login uses Username + Password. Email Address is stored on the user record.</div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small">Username (login)</label>
                                            <input type="text"
                                                   class="form-control @(usernameInvalid ? "is-invalid" : "")"
                                                   placeholder="username"
                                                   @bind="editStaff.Username"
                                                   @bind:event="oninput"
                                                   @bind:after="ValidateUsernameAfter" />
                                            @if (usernameInvalid)
                                            {
