<style>
    .staff-photo-img,
    .staff-photo-placeholder {
        width: 96px;
        height: 96px;
    }

    .staff-photo-img {
        object-fit: cover;
    }

    .staff-photo-placeholder i {
        font-size: 2.5rem;
    }

    .phone-input-row .form-control {
        width: 72px;
    }

    .phone-input-row .phone-cc {
        width: 64px;
    }

    .phone-input-row .phone-line {
        width: 88px;
    }
</style>

@code {
    [Parameter] public StaffMember? Staff { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public bool IsSimple { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private StaffMember editStaff = new();
    private bool isSaving = false;
    private bool isSavingPhoto = false;
    private string? saveStatusLabel = null;
    private string? saveStatusKind = null;
    private string SaveStatusClass => string.Equals(saveStatusKind, "success", StringComparison.OrdinalIgnoreCase)
        ? "text-success"
        : (string.Equals(saveStatusKind, "error", StringComparison.OrdinalIgnoreCase) ? "text-danger" : "text-muted");
    private bool usernameInvalid = false;
    private string usernameValidationMessage = "Username is required.";
    private bool userEmailInvalid = false;
    private string userEmailValidationMessage = "Enter a valid email address.";
    private bool userPhoneInvalid = false;
    private string userPhoneValidationMessage = "Enter a full phone number.";
    private bool guidePhoneInvalid = false;
    private string guidePhoneValidationMessage = "Enter a full phone number.";
    private string[] selectedLanguages = Array.Empty<string>();
    private List<string> languageOptions = new()
    {
        "English",
        "Spanish",
        "French",
        "German",
        "Italian",
        "Portuguese",
        "Dutch",
        "Russian",
        "Mandarin",
        "Cantonese",
        "Japanese",
        "Korean",
        "Arabic",
        "Hindi",
        "Hebrew",
        "Greek",
        "Turkish"
    };

    private string userCountry = "+1";
    private string userArea = string.Empty;
    private string userPrefix = string.Empty;
    private string userLine = string.Empty;
    
    private string guideCountry = "+1";
    private string guideArea = string.Empty;
    private string guidePrefix = string.Empty;
    private string guideLine = string.Empty;
    private bool guidePhoneTouched = false;

    private string[] SelectedLanguages
    {
        get => selectedLanguages;
        set
        {
            selectedLanguages = value ?? Array.Empty<string>();
            editStaff.Languages = selectedLanguages.Length == 0 ? null : string.Join(", ", selectedLanguages);
        }
    }

    protected override void OnParametersSet()
    {
        // 2026-02-09 00:00 UTC - Created.
        try
        {
            if (!IsOpen)
            {
                return;
            }

            saveStatusLabel = null;
            saveStatusKind = null;
            editStaff = CloneStaff(Staff, IsNew);
            ValidateUsername();
            ValidateUserEmail();
            LoadSelectedLanguages();
            LoadPhoneSegments();
        }
