                                            }
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">Email Address (contact)</label>
                                            <input type="email"
                                                   class="form-control @(userEmailInvalid ? "is-invalid" : "")"
                                                   placeholder="email@domain.com"
                                                   @bind="editStaff.UserEmail"
