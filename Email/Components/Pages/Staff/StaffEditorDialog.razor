    private static IEnumerable<string> ParseLanguages(string? raw)
    {
        // 2026-02-09 00:00 UTC - Created.
        if (string.IsNullOrWhiteSpace(raw)) return Array.Empty<string>();
        var trimmed = raw.Trim();
        if (trimmed.StartsWith("["))
        {
            try
            {
                var list = JsonSerializer.Deserialize<List<string>>(trimmed);
                if (list != null)
                {
                    return list.Where(l => !string.IsNullOrWhiteSpace(l)).Select(l => l.Trim());
                }
            }
            catch
            {
                // fall back to comma split
            }
        }

        return trimmed
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(l => !string.IsNullOrWhiteSpace(l));
    }

    private void LoadPhoneSegments()
    {
        // 2026-02-14 00:00 UTC - Created.
        ParsePhoneSegments(editStaff.UserPhone, out userCountry, out userArea, out userPrefix, out userLine);
        ParsePhoneSegments(editStaff.GuidePhone, out guideCountry, out guideArea, out guidePrefix, out guideLine);

        var normalizedUser = NormalizePhoneDigits(editStaff.UserPhone);
        var normalizedGuide = NormalizePhoneDigits(editStaff.GuidePhone);
        guidePhoneTouched = !string.IsNullOrWhiteSpace(editStaff.GuidePhone) && normalizedGuide != normalizedUser;

        if (string.IsNullOrWhiteSpace(editStaff.GuidePhone) && !string.IsNullOrWhiteSpace(editStaff.UserPhone))
        {
            CopyUserToGuideSegments();
            guidePhoneTouched = false;
        }

        UpdateUserPhoneSegments();
        UpdateGuidePhoneSegments(markTouched: false);
    }

    private void UpdateUserPhoneSegments()
    {
        // 2026-02-14 00:00 UTC - Created.
        userCountry = NormalizeCountry(userCountry);
        userArea = SanitizeDigits(userArea, 3);
        userPrefix = SanitizeDigits(userPrefix, 3);
        userLine = SanitizeDigits(userLine, 4);

        editStaff.UserPhone = BuildPhone(userCountry, userArea, userPrefix, userLine);

        if (!guidePhoneTouched)
        {
            CopyUserToGuideSegments();
            UpdateGuidePhoneSegments(markTouched: false);
        }

        editStaff.Phone = editStaff.GuidePhone ?? editStaff.UserPhone ?? string.Empty;
    }

    private void UpdateGuidePhoneSegments(bool markTouched = true)
    {
        // 2026-02-14 00:00 UTC - Created.
        guideCountry = NormalizeCountry(guideCountry);
        guideArea = SanitizeDigits(guideArea, 3);
        guidePrefix = SanitizeDigits(guidePrefix, 3);
        guideLine = SanitizeDigits(guideLine, 4);

        editStaff.GuidePhone = BuildPhone(guideCountry, guideArea, guidePrefix, guideLine);
        editStaff.Phone = editStaff.GuidePhone ?? editStaff.UserPhone ?? string.Empty;

        if (markTouched)
        {
            guidePhoneTouched = true;
        }
    }

    private void NormalizePhoneInputsForSave()
    {
        // 2026-02-20 00:00 UTC - Created.
        try
        {
            NormalizePastedPhone(ref userCountry, ref userArea, ref userPrefix, ref userLine);
            NormalizePastedPhone(ref guideCountry, ref guideArea, ref guidePrefix, ref guideLine);

            UpdateUserPhoneSegments();
            UpdateGuidePhoneSegments(markTouched: false);

            if (!IsPhoneComplete(userCountry, userArea, userPrefix, userLine)
                && IsPhoneComplete(guideCountry, guideArea, guidePrefix, guideLine))
            {
                userCountry = guideCountry;
                userArea = guideArea;
                userPrefix = guidePrefix;
                userLine = guideLine;
                UpdateUserPhoneSegments();
            }

            if (!IsPhoneComplete(guideCountry, guideArea, guidePrefix, guideLine)
                && IsPhoneComplete(userCountry, userArea, userPrefix, userLine))
            {
                guideCountry = userCountry;
                guideArea = userArea;
                guidePrefix = userPrefix;
                guideLine = userLine;
                UpdateGuidePhoneSegments(markTouched: false);
            }
        }
        catch (Exception ex)
        {
#if DEBUG
            Console.WriteLine($"[StaffEditorDialog] NormalizePhoneInputsForSave failed: {ex}");
#endif
        }
    }

    private void NormalizePastedPhone(ref string country, ref string area, ref string prefix, ref string line)
    {
        // 2026-02-20 00:00 UTC - Created.
        try
        {
            var combined = $"{country}{area}{prefix}{line}";
            var digits = NormalizePhoneDigits(combined);
            if (digits.Length < 7)
            {
                return;
            }

            var hasOverflow = (country?.Length ?? 0) > 4
                || (area?.Length ?? 0) > 3
                || (prefix?.Length ?? 0) > 3
                || (line?.Length ?? 0) > 4;

            if (!hasOverflow)
            {
                return;
            }

            ParsePhoneSegments(combined, out country, out area, out prefix, out line);
        }
        catch (Exception ex)
        {
#if DEBUG
            Console.WriteLine($"[StaffEditorDialog] NormalizePastedPhone failed: {ex}");
#endif
        }
    }

    private void UpdateGuidePhoneSegmentsAfter()
    {
        // 2026-02-14 00:00 UTC - Created.
        UpdateGuidePhoneSegments();
    }

    private void CopyUserToGuideSegments()
    {
        // 2026-02-14 00:00 UTC - Created.
        guideCountry = userCountry;
        guideArea = userArea;
        guidePrefix = userPrefix;
        guideLine = userLine;
    }

    private static void ParsePhoneSegments(string? phone, out string country, out string area, out string prefix, out string line)
    {
        // 2026-02-14 00:00 UTC - Created.
        country = "+1";
        area = string.Empty;
        prefix = string.Empty;
        line = string.Empty;

        var digits = NormalizePhoneDigits(phone);
        if (string.IsNullOrWhiteSpace(digits))
        {
            return;
        }

        if (digits.Length >= 11)
        {
            if (digits.StartsWith("1"))
            {
                country = "+1";
                digits = digits.Substring(1);
            }
            else
            {
                var countryLen = Math.Min(3, digits.Length - 10);
                if (countryLen > 0)
                {
                    country = "+" + digits.Substring(0, countryLen);
                    digits = digits.Substring(countryLen);
                }
            }
        }

        area = TakeDigits(ref digits, 3);
        prefix = TakeDigits(ref digits, 3);
        line = TakeDigits(ref digits, 4);
    }

    private bool ValidateUserPhone()
    {
        // 2026-02-14 00:00 UTC - Created.
        if (!IsPhoneComplete(userCountry, userArea, userPrefix, userLine))
        {
            userPhoneInvalid = true;
            return false;
        }

        userPhoneInvalid = false;
        return true;
    }

    private bool ValidateGuidePhone()
    {
        // 2026-02-14 00:00 UTC - Created.
        if (!IsPhoneComplete(guideCountry, guideArea, guidePrefix, guideLine))
        {
            guidePhoneInvalid = true;
            return false;
        }

        guidePhoneInvalid = false;
        return true;
    }

    private static bool IsPhoneComplete(string country, string area, string prefix, string line)
    {
        var hasDigits = !string.IsNullOrWhiteSpace(area)
            || !string.IsNullOrWhiteSpace(prefix)
            || !string.IsNullOrWhiteSpace(line);
        if (!hasDigits) return false;

        var normalizedCountry = NormalizeCountry(country);
        if (string.Equals(normalizedCountry, "+1", StringComparison.OrdinalIgnoreCase))
        {
            return area.Length == 3 && prefix.Length == 3 && line.Length == 4;
        }

        var total = area.Length + prefix.Length + line.Length;
        return total >= 7;
    }

    private static string NormalizeCountry(string? value)
    {
        var digits = NormalizePhoneDigits(value);
        if (string.IsNullOrWhiteSpace(digits))
        {
            return "+1";
        }

        if (digits.Length > 3)
        {
            digits = digits.Substring(0, 3);
        }

        return "+" + digits;
    }

    private static string SanitizeDigits(string? value, int maxLen)
    {
        var digits = NormalizePhoneDigits(value);
        if (digits.Length > maxLen)
        {
            digits = digits.Substring(0, maxLen);
        }
        return digits;
    }

    private static string NormalizePhoneDigits(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        return new string(value.Where(char.IsDigit).ToArray());
    }

    private static string TakeDigits(ref string value, int count)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var take = Math.Min(count, value.Length);
        var part = value.Substring(0, take);
        value = value.Substring(take);
        return part;
    }

    private static string BuildPhone(string country, string area, string prefix, string line)
    {
        var countryPart = NormalizeCountry(country);
        var core = string.Empty;
        if (!string.IsNullOrWhiteSpace(area))
        {
            core = $"({area})";
        }

        if (!string.IsNullOrWhiteSpace(prefix))
        {
            core = string.IsNullOrWhiteSpace(core) ? prefix : $"{core} {prefix}";
        }

        if (!string.IsNullOrWhiteSpace(line))
        {
            core = string.IsNullOrWhiteSpace(core) ? line : $"{core}-{line}";
        }

        var resultParts = new List<string>();
        if (!string.IsNullOrWhiteSpace(countryPart))
        {
            resultParts.Add(countryPart);
        }

        if (!string.IsNullOrWhiteSpace(core))
        {
            resultParts.Add(core);
        }

        return string.Join(" ", resultParts).Trim();
    }

    private async Task SaveAsync()
    {
        // 2026-02-09 00:00 UTC - Created.
        // 2026-02-20 00:00 UTC - Normalize phone input and surface validation errors inline.
        try
        {
            saveStatusLabel = null;
            saveStatusKind = null;
            editStaff.IncludeUserAccount = true;
            editStaff.IncludeGuideProfile = true;

            NormalizePhoneInputsForSave();

            if (!ValidateUsername())
            {
                saveStatusLabel = $"Error: {usernameValidationMessage}";
                saveStatusKind = "error";
                StateHasChanged();
                return;
            }

            if (!ValidateUserEmail())
            {
                saveStatusLabel = $"Error: {userEmailValidationMessage}";
                saveStatusKind = "error";
                StateHasChanged();
                return;
            }

            if (!ValidateUserPhone() || !ValidateGuidePhone())
            {
                var message = userPhoneInvalid ? userPhoneValidationMessage : guidePhoneValidationMessage;
                saveStatusLabel = $"Error: {message}";
                saveStatusKind = "error";
                StateHasChanged();
                return;
            }

            if ((IsNew || editStaff.UserId == null) && string.IsNullOrWhiteSpace(editStaff.Password))
            {
                await ToastService.ShowErrorAsync("Required", "Password is required for new users.");
                saveStatusLabel = "Error: Password is required for new users.";
                saveStatusKind = "error";
                StateHasChanged();
                return;
            }

            if (editStaff.GuideId == null)
            {
                if (string.IsNullOrWhiteSpace(editStaff.FirstName) || string.IsNullOrWhiteSpace(editStaff.GuidePhone))
                {
                    await ToastService.ShowErrorAsync("Required", "First Name and Phone are required for guides.");
                    saveStatusLabel = "Error: First Name and Phone are required for guides.";
                    saveStatusKind = "error";
                    StateHasChanged();
                    return;
                }
            }

            isSaving = true;
            StateHasChanged();

            editStaff.ContactEmail = string.IsNullOrWhiteSpace(editStaff.UserEmail)
                ? editStaff.Username
                : editStaff.UserEmail;

            await StaffService.SaveStaffMemberAsync(editStaff);
            await ToastService.ShowSuccessAsync("Saved", "Staff member saved.");
            saveStatusLabel = "Sent";
            saveStatusKind = "success";
            await OnSaved.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
#if DEBUG
            Console.WriteLine($"[StaffEditorDialog] SaveAsync failed: {ex}");
#endif
            await ToastService.ShowErrorAsync("Error", $"Save failed: {ex.Message}");
            saveStatusLabel = $"Error: {ex.Message}";
            saveStatusKind = "error";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private bool ValidateUsername()
    {
        // 2026-02-14 00:00 UTC - Created.
        try
        {
            var username = editStaff.Username?.Trim() ?? string.Empty;
            editStaff.Username = username;
            if (string.IsNullOrWhiteSpace(username))
            {
                usernameInvalid = true;
