@using Email.Models
@using Email.Models.Staff
@using Email.Services.Staff
@using System.ComponentModel.DataAnnotations
@using System.IO
@using System.Text.Json
@inject IStaffService StaffService
@inject IToastService ToastService
@inject IWebHostEnvironment WebHostEnvironment

@if (IsOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsNew ? "Add Staff" : "Edit Staff")</h5>
                    <button type="button" class="btn-close" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    <datalist id="countryCodes">
                        <option value="+1"></option>
                        <option value="+44"></option>
                        <option value="+33"></option>
                        <option value="+34"></option>
                        <option value="+39"></option>
                        <option value="+49"></option>
                        <option value="+52"></option>
                        <option value="+55"></option>
                        <option value="+61"></option>
                        <option value="+81"></option>
                        <option value="+82"></option>
                        <option value="+86"></option>
                        <option value="+91"></option>
                    </datalist>
                    @if (IsSimple)
                    {
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <div class="fw-semibold mb-2">Login Info</div>
                                    <div class="small text-muted mb-2">Login uses Username + Password. Email Address is stored on the user record.</div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small">Username (login)</label>
                                            <input type="text"
                                                   class="form-control @(usernameInvalid ? "is-invalid" : "")"
                                                   placeholder="username"
                                                   @bind="editStaff.Username"
                                                   @bind:event="oninput"
                                                   @bind:after="ValidateUsernameAfter" />
                                            @if (usernameInvalid)
                                            {
                                                <div class="invalid-feedback d-block">@usernameValidationMessage</div>
                                            }
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">Email Address (contact)</label>
                                            <input type="email"
                                                   class="form-control @(userEmailInvalid ? "is-invalid" : "")"
                                                   placeholder="email@domain.com"
                                                   @bind="editStaff.UserEmail"
                                                   @bind:event="oninput"
                                                   @bind:after="ValidateUserEmailAfter" />
                                            @if (userEmailInvalid)
                                            {
                                                <div class="invalid-feedback d-block">@userEmailValidationMessage</div>
                                            }
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">Password (login) @(IsNew ? "(required)" : "")</label>
                                            <input type="text" class="form-control" @bind="editStaff.Password" />
                                            <div class="form-text">Stored password is shown. Edit to change.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">User Phone</label>
                                            <div class="d-flex flex-wrap gap-2 phone-input-row">
                                                <input class="form-control phone-cc" type="text" inputmode="numeric" maxlength="4" list="countryCodes"
                                                       placeholder="+1" @bind="userCountry" @bind:event="oninput" @bind:after="UpdateUserPhoneSegments" />
                                                <input class="form-control phone-area" type="text" inputmode="numeric" maxlength="3"
                                                       placeholder="917" @bind="userArea" @bind:event="oninput" @bind:after="UpdateUserPhoneSegments" />
                                                <input class="form-control phone-prefix" type="text" inputmode="numeric" maxlength="3"
                                                       placeholder="673" @bind="userPrefix" @bind:event="oninput" @bind:after="UpdateUserPhoneSegments" />
                                                <input class="form-control phone-line" type="text" inputmode="numeric" maxlength="4"
                                                       placeholder="6864" @bind="userLine" @bind:event="oninput" @bind:after="UpdateUserPhoneSegments" />
                                            </div>
                                            @if (userPhoneInvalid)
                                            {
                                                <div class="invalid-feedback d-block">@userPhoneValidationMessage</div>
                                            }
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Role</label>
                                            <select class="form-select" @bind="editStaff.Role">
                                                <option value="Guide">Guide</option>
                                                <option value="Admin">Admin</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">User Active</label>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @bind="editStaff.IsUserActive" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Is Touring</label>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @bind="editStaff.IsTouring" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <div class="fw-semibold mb-2">Profile Details</div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small">First Name</label>
                                            <input type="text" class="form-control" @bind="editStaff.FirstName" />
