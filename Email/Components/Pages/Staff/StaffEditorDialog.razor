                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">Password (login) @(IsNew ? "(required)" : "")</label>
                                            <input type="text" class="form-control" @bind="editStaff.Password" />
                                            <div class="form-text">Stored password is shown. Edit to change.</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Role</label>
                                            <select class="form-select" @bind="editStaff.Role">
                                                <option value="Guide">Guide</option>
                                                <option value="Admin">Admin</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">User Active</label>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @bind="editStaff.IsUserActive" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <div class="fw-semibold mb-2">Profile Details</div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small">First Name</label>
                                            <input type="text" class="form-control" @bind="editStaff.FirstName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">Last Name</label>
                                            <input type="text" class="form-control" @bind="editStaff.LastName" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Guide Phone</label>
                                            <div class="d-flex flex-wrap gap-2 phone-input-row">
                                                <input class="form-control phone-cc" type="text" inputmode="numeric" maxlength="4" list="countryCodes"
                                                       placeholder="+1" @bind="guideCountry" @bind:event="oninput" @bind:after="UpdateGuidePhoneSegmentsAfter" />
                                                <input class="form-control phone-area" type="text" inputmode="numeric" maxlength="3"
                                                       placeholder="917" @bind="guideArea" @bind:event="oninput" @bind:after="UpdateGuidePhoneSegmentsAfter" />
                                                <input class="form-control phone-prefix" type="text" inputmode="numeric" maxlength="3"
                                                       placeholder="673" @bind="guidePrefix" @bind:event="oninput" @bind:after="UpdateGuidePhoneSegmentsAfter" />
                                                <input class="form-control phone-line" type="text" inputmode="numeric" maxlength="4"
                                                       placeholder="6864" @bind="guideLine" @bind:event="oninput" @bind:after="UpdateGuidePhoneSegmentsAfter" />
                                            </div>
                                            @if (guidePhoneInvalid)
                                            {
                                                <div class="invalid-feedback d-block">@guidePhoneValidationMessage</div>
                                            }
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Guide Active</label>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @bind="editStaff.IsGuideActive" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Is Touring</label>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @bind="editStaff.IsTouring" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">Languages</label>
                                            <select class="form-select" multiple @bind="SelectedLanguages">
                                                @foreach (var language in languageOptions)
                                                {
                                                    <option value="@language">@language</option>
                                                }
                                            </select>
                                            <div class="form-text">Hold Ctrl (Windows) or Command (Mac) to multi-select.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Description</label>
                                            <textarea class="form-control" rows="3" @bind="editStaff.Description"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <div class="fw-semibold mb-2">Permissions</div>
                                    <div class="row g-2">
                                        <div class="col-6 col-lg-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" disabled />
                                                <label class="form-check-label">Desktop Dashboard</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-lg-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" disabled />
                                                <label class="form-check-label">Mobile Dashboard</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-lg-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" disabled />
                                                <label class="form-check-label">Tours</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-lg-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" disabled />
                                                <label class="form-check-label">Schedule</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-lg-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" disabled />
                                                <label class="form-check-label">Guides</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-lg-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" disabled />
                                                <label class="form-check-label">Vendors</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-lg-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" disabled />
                                                <label class="form-check-label">Messages</label>
