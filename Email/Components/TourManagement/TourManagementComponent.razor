    private Dictionary<int, List<MasterTourTimeSlot>> BuildScheduleTimeLookup(IReadOnlyList<DbTourSchedule> schedules)
    {
        var result = new Dictionary<int, Dictionary<string, MasterTourTimeSlot>>();

        foreach (var schedule in schedules.Where(x => x.IsActive))
        {
            if (!result.TryGetValue(schedule.TourId, out var slotMap))
            {
                slotMap = new Dictionary<string, MasterTourTimeSlot>(StringComparer.OrdinalIgnoreCase);
                result[schedule.TourId] = slotMap;
            }

            foreach (var slot in ParseScheduleSlots(schedule))
            {
                UpsertSlot(slotMap, slot);
            }
        }

        return result.ToDictionary(
            pair => pair.Key,
            pair => pair.Value.Values.OrderBy(x => x.TourTime, StringComparer.OrdinalIgnoreCase).ToList());
    }

    private IEnumerable<MasterTourTimeSlot> ParseScheduleSlots(DbTourSchedule schedule)
    {
        var slots = new List<MasterTourTimeSlot>();

        if (string.IsNullOrWhiteSpace(schedule.TimeSlotsJson))
        {
            return slots;
        }

        try
        {
            if (schedule.TimeSlotsJson.TrimStart().StartsWith("[", StringComparison.Ordinal))
            {
                var parsed = JsonSerializer.Deserialize<List<TimeSlotModel>>(schedule.TimeSlotsJson) ?? new List<TimeSlotModel>();
                foreach (var slot in parsed)
                {
                    var normalized = NormalizeTime(slot.TourTime);
                    if (string.IsNullOrWhiteSpace(normalized))
                    {
                        continue;
                    }

                    slots.Add(new MasterTourTimeSlot
                    {
                        TourTime = normalized,
                        MeetingTime = NormalizeTime(string.IsNullOrWhiteSpace(slot.MeetingTime) ? schedule.MeetingTime : slot.MeetingTime),
                        MeetingPlace = string.IsNullOrWhiteSpace(slot.MeetingPlace) ? schedule.MeetingPlace : slot.MeetingPlace,
                        MeetingInstructions = string.IsNullOrWhiteSpace(slot.MeetingInstructions) ? schedule.MeetingInstructions : slot.MeetingInstructions,
                        IsOverride = schedule.IsOverride
                    });
                }
            }
            else
            {
                var values = schedule.TimeSlotsJson.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                foreach (var value in values)
                {
                    var normalized = NormalizeTime(value);
                    if (string.IsNullOrWhiteSpace(normalized))
                    {
                        continue;
                    }

                    slots.Add(new MasterTourTimeSlot
                    {
                        TourTime = normalized,
                        MeetingTime = NormalizeTime(schedule.MeetingTime),
                        MeetingPlace = schedule.MeetingPlace,
                        MeetingInstructions = schedule.MeetingInstructions,
                        IsOverride = schedule.IsOverride
                    });
                }
            }
        }
        catch
        {
            // no-op
        }

        return slots;
    }

    private static void UpsertSlot(Dictionary<string, MasterTourTimeSlot> slotMap, MasterTourTimeSlot incoming)
    {
        if (!slotMap.TryGetValue(incoming.TourTime, out var existing))
        {
            slotMap[incoming.TourTime] = incoming;
            return;
        }

        if (incoming.IsOverride && !existing.IsOverride)
        {
            slotMap[incoming.TourTime] = incoming;
            return;
        }

        if (string.IsNullOrWhiteSpace(existing.MeetingPlace) && !string.IsNullOrWhiteSpace(incoming.MeetingPlace))
        {
            existing.MeetingPlace = incoming.MeetingPlace;
        }

        if (string.IsNullOrWhiteSpace(existing.MeetingInstructions) && !string.IsNullOrWhiteSpace(incoming.MeetingInstructions))
        {
            existing.MeetingInstructions = incoming.MeetingInstructions;
        }

        if (string.IsNullOrWhiteSpace(existing.MeetingTime) && !string.IsNullOrWhiteSpace(incoming.MeetingTime))
        {
            existing.MeetingTime = incoming.MeetingTime;
        }
    }

    private int DeriveOffsetMinutes(string? tourTime, string? meetingTime)
    {
        if (!TryParseTime(tourTime, out var tourParsed) || !TryParseTime(meetingTime, out var meetingParsed))
        {
            return -10;
        }

        var offset = (int)(meetingParsed - tourParsed).TotalMinutes;
        if (offset > 720) offset -= 1440;
        if (offset < -720) offset += 1440;
        return NormalizeNegativeOffset(offset);
    }

    private static bool IsOffsetOutsideNormalScheduleRange(int offsetMinutes)
    {
        // Normal schedule-derived offsets are expected to be relatively close to tour start.
        return offsetMinutes < -30 || offsetMinutes > -1;
    }

    private static int NormalizeNegativeOffset(int offsetMinutes)
    {
        if (offsetMinutes == 0)
        {
            return -10;
        }

        var normalized = -Math.Abs(offsetMinutes);
        return Math.Clamp(normalized, -720, -1);
    }

    private static string NormalizeDurationValue(string? rawDuration)
    {
        if (string.IsNullOrWhiteSpace(rawDuration))
        {
            return "3";
        }

        if (decimal.TryParse(rawDuration.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var directHours))
        {
            return NormalizeDurationNumber(directHours);
        }

        var numeric = Regex.Match(rawDuration, @"\d+(\.\d+)?", RegexOptions.CultureInvariant).Value;
        if (decimal.TryParse(numeric, NumberStyles.Number, CultureInfo.InvariantCulture, out var extractedHours))
        {
            return NormalizeDurationNumber(extractedHours);
        }

        return "3";
    }

    private static string NormalizeDurationNumber(decimal hours)
    {
        if (hours <= 0m)
        {
            return "3";
        }

        if (hours <= 0.75m)
        {
            return "0.5";
        }

        var rounded = (int)Math.Round(hours, MidpointRounding.AwayFromZero);
        rounded = Math.Clamp(rounded, 1, 12);
        return rounded.ToString(CultureInfo.InvariantCulture);
    }

    private static bool TryParseTime(string? raw, out DateTime parsed)
    {
        if (!string.IsNullOrWhiteSpace(raw) && DateTime.TryParse(raw, out parsed))
        {
            return true;
        }

        parsed = default;
        return false;
    }

    private string ComputeMeetingTime(string? tourTime, int offsetMinutes)
    {
        if (!TryParseTime(tourTime, out var parsed))
        {
            return string.Empty;
        }

        return parsed.AddMinutes(offsetMinutes).ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    private string NormalizeTime(string? rawTime)
    {
        return TourCatalogService.NormalizeTime(rawTime ?? string.Empty);
    }

    private static string FormatUserFacingTimestamp(DateTime source)
    {
        // Mapping timestamps have historically been displayed as UTC; keep that assumption for consistency.
        var utc = source.Kind == DateTimeKind.Utc
            ? source
            : DateTime.SpecifyKind(source, DateTimeKind.Utc);

        var eastern = ResolveEasternTimeZone();
        if (eastern is null)
        {
            return utc.ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture) + " UTC";
        }

        var easternTime = TimeZoneInfo.ConvertTimeFromUtc(utc, eastern);
        var suffix = eastern.IsDaylightSavingTime(easternTime) ? "EDT" : "EST";
        return easternTime.ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture) + $" {suffix}";
    }

    private static TimeZoneInfo? ResolveEasternTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
        }
        catch (TimeZoneNotFoundException)
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
            }
            catch
            {
                return null;
            }
        }
        catch (InvalidTimeZoneException)
        {
            return null;
        }
    }

