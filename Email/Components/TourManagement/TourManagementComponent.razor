@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Routing
@using Email.Models
@using Email.Models.Reports
@using Email.Services
@implements IAsyncDisposable
@inject IToursApiService ToursApi
@inject IGuidesApiService GuidesApi
@inject IVendorsApiService VendorsApi
@inject ITourCatalogService TourCatalogService
@inject ITourNameMappingService TourNameMappingService
@inject ITourLinkService TourLinkService
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="card shadow-sm">
    <div class="card-header">
        <div class="d-flex flex-nowrap align-items-center gap-2">
            <select class="form-select form-select-sm"
                    style="width: min(38rem, calc(100% - 9rem));"
                    value="@SelectedTourIdValue"
                    @onchange="OnTopTourChangedAsync"
                    disabled="@(isLoading || !CanonicalSavedTourStates.Any())">
                <option value="">-- Select Tour --</option>
                @foreach (var state in CanonicalSavedTourStates)
                {
                    <option value="@state.Tour.Id">@BuildTourSelectLabel(state)</option>
                }
            </select>
            <button class="btn btn-primary btn-sm" type="button" @onclick="CreateNewTour">
                <i class="bi bi-plus-lg me-1"></i>Create New Tour
            </button>
        </div>
        @if (HiddenDuplicateTourRowCount > 0)
        {
            <div class="form-text text-warning mt-2">
                Canonical selection hides @HiddenDuplicateTourRowCount active duplicate master-tour row(s). Use the SQL consolidation script for cleanup.
            </div>
        }
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="text-muted mt-2">Loading tours...</div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="alert alert-danger mb-0">@loadError</div>
        }
        else if (tourStates.Count == 0)
        {
            <div class="text-muted">No tours found.</div>
        }
        else
        {
            <div>
                @{
                    var state = SelectedTourState;
                }
                @if (state is null)
                {
                    <div class="text-muted">Select a tour to view details.</div>
                }
                else
                {
                    <div class="border rounded p-3"
                         id="@($"tour-row-{state.RowKey}")"
                         @oninput="() => OnEditorInputChangedAsync(state)"
                         @onchange="() => OnEditorInputChangedAsync(state)">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <h5 class="mb-0">@BuildAccordionTitle(state)</h5>
                                @if (state.IsNew)
                                {
                                    <span class="badge bg-info">New</span>
                                }
                                @if (string.IsNullOrWhiteSpace(state.Tour.MasterTourName))
                                {
                                    <span class="badge bg-danger">Master Missing</span>
                                }
                            </div>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-success"
                                        type="button"
                                        title="Save"
                                        disabled="@state.IsBusy"
                                        @onclick="() => SaveTourAsync(state)">
                                    <i class="bi bi-check2-circle"></i>
                                </button>
                                <button class="btn btn-outline-danger"
                                        type="button"
                                        title="Delete"
                                        disabled="@state.IsBusy"
                                        @onclick="() => DeleteTourAsync(state)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div>
                            <div>
                                @if (state.ShowCreateWarning && state.IsNew)
                                {
                                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                        <strong>MANDATORY:</strong> New tours must match tour name provided by vendor.
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="@($"never-show-warning-{state.RowKey}")" @bind="state.NeverShowCreateWarning" />
                                            <label class="form-check-label" for="@($"never-show-warning-{state.RowKey}")">
                                                Never show again
                                            </label>
                                        </div>
                                        <button type="button" class="btn-close" aria-label="Close" @onclick="() => DismissCreateWarningAsync(state)"></button>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(state.ErrorMessage))
                                {
                                    <div class="alert alert-danger py-2">@state.ErrorMessage</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(state.SuccessMessage))
                                {
                                    <div class="alert alert-success py-2">@state.SuccessMessage</div>
                                }

                                <ul class="nav nav-tabs mb-3">
                                    <li class="nav-item">
                                        <button class='@($"nav-link {(state.ActiveTab == "basic" ? "active" : string.Empty)}")'
                                                type="button"
                                                @onclick='() => SetActiveTabAsync(state, "basic")'>
                                            Basic Info
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class='@($"nav-link {(state.ActiveTab == "advanced" ? "active" : string.Empty)}")'
                                                type="button"
                                                @onclick='() => SetActiveTabAsync(state, "advanced")'>
                                            Advanced
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class='@($"nav-link {(state.ActiveTab == "mappings" ? "active" : string.Empty)}")'
                                                type="button"
                                                @onclick='() => SetActiveTabAsync(state, "mappings")'>
                                            Mapping Variants
                                        </button>
                                    </li>
                                </ul>

                                @if (state.ActiveTab == "basic")
                                {
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Master Tour Name</label>
                                            <input type="text" class="form-control" @bind="state.Tour.MasterTourName" @bind:event="oninput" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Master Tour Name (Desktop)</label>
                                            <input type="text" class="form-control" @bind="state.Tour.MasterTourNameDesktop" @bind:event="oninput" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Abbreviation (Mobile)</label>
                                            <input type="text" class="form-control" @bind="state.Tour.MasterTourNameMobile" @bind:event="oninput" />
                                            <div class="form-text">If blank, a fallback abbreviation is generated on save.</div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">
                                                Add Tour Time (Optional)
                                                <span class="badge bg-success ms-1">Updates schedules</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                                <select class="form-select"
                                                        value="@GetPendingTourTimeValue(state)"
                                                        @onchange="e => OnPendingTourTimeChanged(state, e)">
                                                    <option value="">-- Optional: add a tour time --</option>
                                                    @foreach (var t in TimeOptions)
                                                    {
                                                        <option value="@t">@FormatTimeDisplay(t)</option>
                                                    }
                                                </select>
                                                <button class="btn btn-outline-secondary"
                                                        type="button"
                                                        disabled="@string.IsNullOrWhiteSpace(GetPendingTourTimeValue(state))"
                                                        @onclick="() => AddTourTimeAsync(state)">
                                                    <i class="bi bi-plus-lg me-1"></i>Add
                                                </button>
                                            </div>
                                            <div class="form-text">Optional. Use this control only when you want to add a tour time into the active standard schedule.</div>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label mb-2">Current Tour Times (from schedules)</label>
                                            @if (state.AvailableTourTimes.Count == 0)
                                            {
                                                <div class="text-muted small">No schedule times configured yet.</div>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var time in state.AvailableTourTimes)
                                                    {
                                                        var isSelected = string.Equals(time, state.SelectedTourTime, StringComparison.OrdinalIgnoreCase);
                                                        <button class='@($"btn btn-sm {(isSelected ? "btn-primary" : "btn-outline-secondary")}")'
                                                                type="button"
                                                                @onclick="() => SetSelectedTourTime(state, time)">
                                                            @FormatTimeDisplay(time)
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @* Default guide now managed in GuideSchedule; hidden here per requirement.
                                        <div class="col-md-6">
                                            <label class="form-label">Default Guide</label>
                                            <select class="form-select" value="@GetGuideSelectValue(state)" @onchange="e => OnGuideSelectionChanged(state, e)">
                                                <option value="">-- none --</option>
                                                @foreach (var guide in availableGuides.Where(g => g.IsActive))
                                                {
                                                    <option value="@guide.Id">@FormatGuideName(guide)</option>
                                                }
                                            </select>
                                        </div>
                                        *@

                                        @* Meeting time now managed in GuideSchedule; hidden here per requirement.
                                        <div class="col-md-6">
                                            <label class="form-label mb-1">Meeting Time</label>
                                            @{
                                                var selectedMeetingTime = GetMeetingTimeSelectValue(state);
                                            }
                                            <div class="d-flex align-items-end gap-2 flex-wrap">
                                                <div style="width: 12.5rem;">
                                                    <select class="form-select"
                                                            value="@selectedMeetingTime"
                                                            @onchange="e => OnMeetingTimeSelectionChanged(state, e)">
                                                        <option value="">-- Select Meeting Time --</option>
                                                        @if (!string.IsNullOrWhiteSpace(selectedMeetingTime) &&
                                                             !TimeOptions.Contains(selectedMeetingTime, StringComparer.OrdinalIgnoreCase))
                                                        {
                                                            <option value="@selectedMeetingTime">@FormatTimeDisplay(selectedMeetingTime) (Custom)</option>
                                                        }
                                                        @foreach (var t in TimeOptions)
                                                        {
                                                            <option value="@t">@FormatTimeDisplay(t)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="input-group" style="width: 12.5rem;">
                                                    <input type="number"
                                                           class="form-control text-end"
                                                           min="-720"
                                                           max="-1"
                                                           step="1"
                                                           value="@state.MeetingOffsetMinutes"
                                                           @onchange="e => OnMeetingOffsetChanged(state, e)" />
                                                    <span class="input-group-text">min</span>
                                                    <button class="btn btn-outline-secondary"
                                                            type="button"
                                                            title="Recalculate meeting time from Tour Time and offset."
                                                            @onclick="() => ApplyMeetingOffset(state)">
                                                        Apply
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        *@

                                        <div class="col-md-6">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label mb-0">Duration (hours)</label>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" @bind="state.Tour.IsActive" id="@($"tour-active-{state.RowKey}")" />
                                                    <label class="form-check-label" for="@($"tour-active-{state.RowKey}")">Is Active</label>
                                                </div>
                                            </div>
                                            <select class="form-select"
                                                    value="@GetDurationSelectValue(state)"
                                                    @onchange="e => OnDurationSelectionChanged(state, e)">
                                                @foreach (var duration in DurationHourOptions)
                                                {
                                                    <option value="@duration">@duration</option>
                                                }
                                            </select>
                                        </div>

                        <div class="col-12">
                            <label class="form-label">Meeting Place</label>
                            <textarea class="form-control"
                                      rows="3"
                                      @bind="state.Tour.MeetingPlace"
                                      @bind:event="oninput"></textarea>
                        </div>

                                        @* Meeting instructions intentionally hidden for now per requirement.
                                        <div class="col-12">
                                            <label class="form-label">Meeting Instructions</label>
                                            <textarea class="form-control" rows="3" @bind="state.Tour.MeetingInstructions"></textarea>
                                        </div>
                                        *@

                                    </div>
                                }
                                else if (state.ActiveTab == "advanced")
                                {
                                    <div class="row g-3">
                                        @{
                                            var completenessSummary = BuildVendorCompletenessSummary(state);
                                        }
                                        <div class="col-12">
                                            <div class='@($"alert py-2 mb-0 {(completenessSummary.IncompleteVendors == 0 ? "alert-success" : "alert-warning")}")'>
                                                Vendor detail completeness:
                                                <strong>@completenessSummary.CompletedVendors/@completenessSummary.TrackedVendors</strong>
                                                tracked vendors complete.
                                                @if (completenessSummary.IncompleteVendors > 0)
                                                {
                                                    <span class="ms-1">
                                                        Remaining incomplete vendors: <strong>@completenessSummary.IncompleteVendors</strong>.
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        @foreach (var vendor in state.VendorProfiles)
                                        {
                                            var completeness = BuildVendorCompleteness(vendor);
                                            <div class="col-12">
                                                <div class="border rounded p-3">
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                                            <div class="fw-semibold">@vendor.SectionTitle</div>
                                                            <div class="form-check form-switch mb-0">
                                                                <input class="form-check-input"
                                                                       type="checkbox"
                                                                       id="@($"vendor-active-{state.RowKey}-{vendor.VendorCode}")"
                                                                       @bind="vendor.IsActive" />
                                                                <label class="form-check-label small"
                                                                       for="@($"vendor-active-{state.RowKey}-{vendor.VendorCode}")">
                                                                    Active
                                                                </label>
                                                            </div>
                                                        </div>
                                                        @if (!vendor.IsActive)
                                                        {
                                                            <span class="badge bg-secondary">Inactive</span>
                                                        }
                                                        else if (completeness.IsComplete)
                                                        {
                                                            <span class="badge bg-success">Complete</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">@completeness.CompletedRequired/@completeness.RequiredFields required</span>
                                                        }
                                                    </div>
                                                    @if (vendor.IsActive && !completeness.IsComplete)
                                                    {
                                                        <div class="text-muted small mb-3">
                                                            Missing: @string.Join(", ", completeness.MissingFieldLabels)
                                                        </div>
                                                    }
                                                    <div class="row g-3">
                                                        <div class="col-12">
                                                            <label class="form-label">
                                                                @vendor.NameFieldLabel
                                                                <span class="badge bg-danger ms-1">Must exactly match email</span>
                                                            </label>
                                                            <input type="text"
                                                                   class="form-control"
                                                                   @bind="vendor.Name"
                                                                   @bind:event="oninput" />
                                                        </div>

                                                        @if (vendor.RequiresProductId)
                                                        {
                                                            <div class="col-md-6">
                                                                <label class="form-label">@vendor.IdFieldLabel</label>
                                                                <input type="text"
                                                                       class="form-control"
                                                                       @bind="vendor.ProductId"
                                                                       @bind:event="oninput"
                                                                       placeholder="@vendor.IdPlaceholder" />
                                                            </div>
                                                        }

                                                        @if (vendor.RequiresTourLink)
                                                        {
                                                            <div class="col-12">
                                                                <label class="form-label">@vendor.TourLinkLabel</label>
                                                                <input type="text"
                                                                       class="form-control"
                                                                       @bind="vendor.TourLink"
                                                                       @bind:event="oninput"
                                                                       placeholder="https://..." />
                                                                <div class="form-text">Used in Thank You messages when booking source matches this vendor.</div>
                                                            </div>
                                                        }

                                                        @if (vendor.RequiresReviewLink)
                                                        {
                                                            <div class="col-12">
                                                                <label class="form-label">@vendor.ReviewLinkLabel</label>
                                                                <input type="text"
                                                                       class="form-control"
                                                                       @bind="vendor.ReviewLink"
                                                                       @bind:event="oninput"
                                                                       placeholder="https://..." />
                                                                <div class="form-text">Used in post-tour review messages when booking source matches this vendor.</div>
                                                            </div>
                                                        }

                                                        @if (vendor.RequiresAllToursLink)
                                                        {
                                                            <div class="col-12">
                                                                <label class="form-label">@vendor.AllToursLinkLabel</label>
                                                                <input type="text"
                                                                       class="form-control"
                                                                       @bind="vendor.AllToursLink"
                                                                       @bind:event="oninput"
                                                                       placeholder="https://..." />
                                                                <div class="form-text">Today/Tomorrow/Date messages pull this link by vendor.</div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <div class="alert alert-info py-2 mb-0">
                                                Add vendor-specific aliases for incoming email tour names. These mappings drive tree parsing and master tour resolution.
                                            </div>
                                        </div>

                                        @foreach (var vendor in state.VendorProfiles)
                                        {
                                            var vendorMappings = GetMappingsForVendor(state, vendor.VendorCode);
                                            <div class="col-12">
                                                <div class="border rounded p-3">
                                                    <div class="fw-semibold mb-3">@vendor.SectionTitle</div>
                                                    <div class="input-group mb-3">
                                                        <input type="text"
                                                               class="form-control"
                                                               @bind="vendor.PendingAlias"
                                                               @bind:event="oninput"
                                                               placeholder="Add incoming alias from email..." />
                                                        <button class="btn btn-outline-secondary"
                                                                type="button"
                                                                disabled="@state.IsBusy"
                                                                @onclick="() => AddMappingAliasAsync(state, vendor)">
                                                            <i class="bi bi-plus-lg me-1"></i>Add Alias
                                                        </button>
                                                    </div>

                                                    @if (vendorMappings.Count == 0)
                                                    {
                                                        <div class="text-muted small">No aliases saved for this vendor.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="list-group list-group-flush border rounded">
                                                            @foreach (var mapping in vendorMappings)
                                                            {
                                                                <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                                                    <div>
                                                                        <div class="fw-semibold">@mapping.IncomingTourName</div>
                                                                        <div class="text-muted small">Updated @FormatUserFacingTimestamp(mapping.UpdatedAt)</div>
                                                                    </div>
                                                                    <button class="btn btn-outline-danger btn-sm"
                                                                            type="button"
                                                                            title="Deactivate alias"
                                                                            disabled="@state.IsBusy"
                                                                            @onclick="() => DeleteMappingAliasAsync(state, mapping)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @{
                                            var unassignedMappings = GetUnassignedMappings(state);
                                        }
                                        @if (unassignedMappings.Count > 0)
                                        {
                                            <div class="col-12">
                                                <div class="border rounded p-3">
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                                        <div class="fw-semibold">Unassigned Legacy Variants</div>
                                                        <button class="btn btn-outline-danger btn-sm"
                                                                type="button"
                                                                disabled="@state.IsBusy"
                                                                @onclick="() => DeactivateAllUnassignedMappingsAsync(state)">
                                                            <i class="bi bi-x-octagon me-1"></i>Deactivate All
                                                        </button>
                                                    </div>
                                                    <div class="text-muted small mb-3">
                                                        These aliases have no vendor name set. Add them under a vendor section above, then deactivate the legacy row.
                                                    </div>
                                                    <div class="list-group list-group-flush border rounded">
                                                        @foreach (var mapping in unassignedMappings)
                                                        {
                                                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                                                <div>
                                                                    <div class="fw-semibold">@mapping.IncomingTourName</div>
                                                                    <div class="text-muted small">Vendor: @mapping.VendorDisplayName</div>
                                                                </div>
                                                                <button class="btn btn-outline-danger btn-sm"
                                                                        type="button"
                                                                        title="Deactivate alias"
                                                                        disabled="@state.IsBusy"
                                                                        @onclick="() => DeleteMappingAliasAsync(state, mapping)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private const string HideCreateWarningStorageKey = "cityshuffles_hide_new_tour_warning";
    private const string ActiveMasterTourUniqueIndexName = "UX_Tours_ActiveMasterTourName";

    private readonly List<TourEditorState> tourStates = new();
    private static readonly IReadOnlyList<string> TimeOptions = BuildTimeOptions();
    private static readonly IReadOnlyList<string> DurationHourOptions = BuildDurationHourOptions();
    private static readonly IReadOnlyList<VendorProfileTemplate> VendorProfileTemplates = BuildVendorProfileTemplates();
    private readonly HashSet<int> canonicalTourIdSet = new();
    private readonly Dictionary<int, int> canonicalTourIdByTourId = new();
    private readonly Dictionary<int, int> duplicateCountByCanonicalTourId = new();

    private List<DbGuide> availableGuides = new();
    private TourCatalogSnapshot? tourCatalog;
    private bool isLoading = true;
    private string? loadError;
    private int? selectedTourId;
    private string? selectedRowKey;
    private bool hideCreateWarning;
    private IDisposable? locationChangingRegistration;

    private IEnumerable<TourEditorState> SavedTourStates =>
        tourStates
            .Where(x => !x.IsNew)
            .OrderBy(x => SortTourName(x), StringComparer.OrdinalIgnoreCase);

    private IEnumerable<TourEditorState> CanonicalSavedTourStates =>
        SavedTourStates.Where(x => canonicalTourIdSet.Count == 0 || canonicalTourIdSet.Contains(x.Tour.Id));

    private int HiddenDuplicateTourRowCount => duplicateCountByCanonicalTourId.Values.Sum();

    private string SelectedTourIdValue => selectedTourId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    private TourEditorState? SelectedTourState =>
        string.IsNullOrWhiteSpace(selectedRowKey)
            ? null
            : tourStates.FirstOrDefault(x => x.RowKey == selectedRowKey);

    private void SetSelectedState(TourEditorState? state)
    {
        if (state is not null && !state.IsNew)
        {
            var canonicalTourId = NormalizeToCanonicalTourId(state.Tour.Id);
            state = tourStates.FirstOrDefault(x => !x.IsNew && x.Tour.Id == canonicalTourId) ?? state;
        }

        selectedRowKey = state?.RowKey;
        selectedTourId = state is null || state.IsNew ? null : state.Tour.Id;
    }

    protected override async Task OnInitializedAsync()
    {
        locationChangingRegistration = NavigationManager.RegisterLocationChangingHandler(ConfirmNavigationWhenDirtyAsync);
        await RestoreCreateWarningPreferenceAsync();
        await LoadAsync();
    }

    private async Task LoadAsync(int? focusTourId = null)
    {
        try
        {
            isLoading = true;
            loadError = null;
            canonicalTourIdSet.Clear();
            canonicalTourIdByTourId.Clear();
            duplicateCountByCanonicalTourId.Clear();

            var toursTask = ToursApi.GetToursAsync();
            var guidesTask = GuidesApi.GetGuidesAsync();
            var catalogTask = TourCatalogService.BuildCatalogAsync();
            var schedulesTask = ToursApi.GetAllTourSchedulesAsync();
            var vendorsTask = VendorsApi.GetVendorsAsync();
            var vendorToursTask = VendorsApi.GetVendorToursAsync();
            var mappingsTask = TourNameMappingService.GetAllActiveMappingsAsync();
            var linksTask = TourLinkService.GetAllAsync();

            await Task.WhenAll(toursTask, guidesTask, catalogTask, schedulesTask, vendorsTask, vendorToursTask, mappingsTask, linksTask);

            var tours = toursTask.Result
                .OrderBy(t => string.IsNullOrWhiteSpace(t.MasterTourName) ? t.TourName : t.MasterTourName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(t => t.TourName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            BuildCanonicalTourSelectionMetadata(tours);

            availableGuides = guidesTask.Result
                .OrderBy(g => g.FirstName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(g => g.LastName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            tourCatalog = catalogTask.Result;
            var slotsByTourId = BuildScheduleTimeLookup(schedulesTask.Result);
            var vendorRecordsByKey = BuildVendorRecordLookup(vendorsTask.Result);
            var mappingsByTourId = BuildVendorMappingLookup(mappingsTask.Result);
            var mappingVariantsByTourId = BuildMappingVariantsLookup(mappingsTask.Result);
            var linksByTourId = BuildVendorLinkLookup(linksTask.Result);
            var activeVendorAssignmentsByMasterTour = BuildVendorTourAssignmentLookup(vendorsTask.Result, vendorToursTask.Result);

            tourStates.Clear();
            foreach (var tour in tours)
            {
                slotsByTourId.TryGetValue(tour.Id, out var slots);
                mappingsByTourId.TryGetValue(tour.Id, out var vendorMappings);
                mappingVariantsByTourId.TryGetValue(tour.Id, out var mappingVariants);
                linksByTourId.TryGetValue(tour.Id, out var vendorLinks);
                var masterTourKey = NormalizeMasterTourLookupKey(tour.MasterTourName);
                if (string.IsNullOrWhiteSpace(masterTourKey))
                {
                    masterTourKey = NormalizeMasterTourLookupKey(tour.TourName);
                }

                activeVendorAssignmentsByMasterTour.TryGetValue(masterTourKey, out var activeVendorsForTour);
                tourStates.Add(CreateState(
                    tour,
                    slots ?? new List<MasterTourTimeSlot>(),
                    vendorRecordsByKey,
                    vendorMappings,
                    mappingVariants ?? new List<TourNameMapping>(),
                    vendorLinks,
                    activeVendorsForTour));
            }

            TourEditorState? focused = null;
            if (focusTourId.HasValue)
            {
                var canonicalFocusTourId = NormalizeToCanonicalTourId(focusTourId.Value);
                focused = tourStates.FirstOrDefault(x => x.Tour.Id == canonicalFocusTourId);
            }

            if (focused is null && selectedTourId.HasValue)
            {
                var canonicalSelectedTourId = NormalizeToCanonicalTourId(selectedTourId.Value);
                focused = tourStates.FirstOrDefault(x => x.Tour.Id == canonicalSelectedTourId);
            }

            SetSelectedState(focused);
            await UpdateUnsavedChangesWarningAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load tours: {ex.Message}";
            tourStates.Clear();
            availableGuides.Clear();
            canonicalTourIdSet.Clear();
            canonicalTourIdByTourId.Clear();
            duplicateCountByCanonicalTourId.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CreateNewTour()
    {
        tourStates.RemoveAll(x => x.IsNew);

        var tour = new DbTour
        {
            IsActive = true,
            Duration = "3",
            MeetingPlace = "TBD",
            MeetingInstructions = string.Empty,
            MasterTourName = string.Empty,
            MasterTourNameDesktop = string.Empty,
            MasterTourNameMobile = string.Empty
        };

        var state = CreateState(tour, new List<MasterTourTimeSlot>(), null, null, null, null, null);
        state.ShowCreateWarning = !hideCreateWarning;
        state.ActiveTab = "basic";
        state.SuccessMessage = null;
        state.ErrorMessage = null;

        tourStates.Insert(0, state);
        SetSelectedState(state);
    }

    private async Task SaveTourAsync(TourEditorState state)
    {
        if (state.IsBusy) return;

        state.IsBusy = true;
        state.ErrorMessage = null;
        state.SuccessMessage = null;
        var tabToRestore = string.IsNullOrWhiteSpace(state.ActiveTab) ? "basic" : state.ActiveTab;
        var affectedRows = 0;

        try
        {
            var masterTourName = NormalizeOptionalText(state.Tour.MasterTourName);
            if (string.IsNullOrWhiteSpace(masterTourName))
            {
                state.ErrorMessage = "Master tour name is required.";
                return;
            }

            state.Tour.MasterTourName = masterTourName;
            state.Tour.TourName = string.IsNullOrWhiteSpace(state.Tour.TourName)
                ? masterTourName
                : state.Tour.TourName.Trim();
            state.Tour.MasterTourNameDesktop = string.IsNullOrWhiteSpace(state.Tour.MasterTourNameDesktop)
                ? state.Tour.MasterTourName
                : state.Tour.MasterTourNameDesktop.Trim();

            if (string.IsNullOrWhiteSpace(state.Tour.MasterTourNameMobile))
            {
                var source = string.IsNullOrWhiteSpace(state.Tour.MasterTourNameDesktop)
                    ? state.Tour.TourName
                    : state.Tour.MasterTourNameDesktop;
                state.Tour.MasterTourNameMobile = BuildAbbreviation(source);
            }
            else
            {
                state.Tour.MasterTourNameMobile = state.Tour.MasterTourNameMobile.Trim();
            }

            if (state.Tour.IsActive &&
                TryGetActiveMasterTourConflict(state, state.Tour.MasterTourName, out var conflictingTour))
            {
                state.ErrorMessage = $"An active tour already exists for master name '{conflictingTour.MasterTourName}' (Tour ID {conflictingTour.Id}).";
                return;
            }

            ApplyLegacyVendorFallbackFields(state);

            if (string.IsNullOrWhiteSpace(state.Tour.MeetingPlace))
            {
                state.Tour.MeetingPlace = "TBD";
            }
            else
            {
                state.Tour.MeetingPlace = state.Tour.MeetingPlace.Trim();
            }

            state.Tour.Duration = NormalizeDurationValue(state.Tour.Duration);

            state.Tour.DefaultGuideId = state.Tour.DefaultGuideId is > 0 ? state.Tour.DefaultGuideId : null;

            state.Tour.TourStartTime = string.IsNullOrWhiteSpace(state.SelectedTourTime)
                ? NormalizeTime(state.Tour.TourStartTime)
                : NormalizeTime(state.SelectedTourTime);
            state.SelectedTourTime = state.Tour.TourStartTime;

            if (string.IsNullOrWhiteSpace(state.Tour.MeetingTime))
            {
                state.Tour.MeetingTime = ComputeMeetingTime(state.Tour.TourStartTime, state.MeetingOffsetMinutes);
                state.MeetingTimeManuallySet = false;
            }
            else
            {
                state.Tour.MeetingTime = NormalizeTime(state.Tour.MeetingTime);
            }

            if (!state.GuideManuallySet)
            {
                MaybeApplyDefaultGuide(state);
            }

            DbTour? persisted;
            if (state.IsNew)
            {
                persisted = await ToursApi.CreateTourAsync(state.Tour);
                if (persisted is null)
                {
                    state.ErrorMessage = "Failed to create tour.";
                    return;
                }

                affectedRows++;
            }
            else
            {
                var updated = await ToursApi.UpdateTourAsync(state.Tour.Id, state.Tour);
                if (!updated)
                {
                    state.ErrorMessage = "Failed to update tour.";
                    return;
                }

                persisted = state.Tour;
                affectedRows++;
            }

            if (persisted.Id > 0)
            {
                affectedRows += await SaveVendorDetailsAsync(state, persisted.Id);
            }

            await LoadAsync(persisted.Id);
            var refreshedState = SelectedTourState;
            if (refreshedState is not null)
            {
                refreshedState.ActiveTab = tabToRestore;
                refreshedState.IsDirty = false;
                refreshedState.DirtyToastShown = false;
            }

            state.IsDirty = false;
            state.DirtyToastShown = false;
            await UpdateUnsavedChangesWarningAsync();
            await ToastService.ShowSuccessAsync(
                $"Tour saved successfully. Rows affected: {affectedRows}.",
                "Save Complete");
        }
        catch (Exception ex)
        {
            state.ErrorMessage = IsActiveMasterTourDuplicateConstraintViolation(ex)
                ? $"An active tour with master name '{state.Tour.MasterTourName}' already exists."
                : $"Save failed: {ex.Message}";
        }
        finally
        {
            state.IsBusy = false;
        }
    }

    private async Task DeleteTourAsync(TourEditorState state)
    {
        if (state.IsBusy) return;

        if (state.IsNew)
        {
            tourStates.Remove(state);
            if (selectedRowKey == state.RowKey)
            {
                SetSelectedState(null);
            }
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete '{BuildAccordionTitle(state)}'?");
        if (!confirmed) return;

        state.IsBusy = true;
        state.ErrorMessage = null;
        state.SuccessMessage = null;

        try
        {
            var deleted = await ToursApi.DeleteTourAsync(state.Tour.Id);
            if (!deleted)
            {
                state.ErrorMessage = "Delete failed.";
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            state.ErrorMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            state.IsBusy = false;
        }
    }

    private async Task SetActiveTabAsync(TourEditorState state, string tab)
    {
        if (state.IsDirty &&
            string.Equals(state.ActiveTab, "advanced", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(tab, "advanced", StringComparison.OrdinalIgnoreCase))
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                "You have unsaved changes in Advanced. Leave this tab without saving?");
            if (!confirmed)
            {
                return;
            }
        }

        state.ActiveTab = tab;
    }

    private async Task OnTopTourChangedAsync(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        var current = SelectedTourState;
        if (current?.IsDirty == true)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                "You have unsaved changes. Switch tours without saving?");
            if (!confirmed)
            {
                return;
            }
        }

        if (int.TryParse(raw, out var id))
        {
            var state = tourStates.FirstOrDefault(x => x.Tour.Id == id);
            SetSelectedState(state);
            return;
        }

        SetSelectedState(null);
    }

    private void SetSelectedTourTime(TourEditorState state, string? rawTime)
    {
        var normalized = NormalizeTime(rawTime);
        state.SelectedTourTime = string.IsNullOrWhiteSpace(normalized) ? null : normalized;
        state.Tour.TourStartTime = state.SelectedTourTime;
        state.CustomTourTimeInput = state.SelectedTourTime ?? TimeOptions.First();

        if (!state.MeetingTimeManuallySet || string.IsNullOrWhiteSpace(state.Tour.MeetingTime))
        {
            ApplyMeetingOffset(state);
        }

        MaybeApplyDefaultGuide(state);
    }

    private void OnPendingTourTimeChanged(TourEditorState state, ChangeEventArgs args)
    {
        var normalized = NormalizeTime(args.Value?.ToString());
        state.CustomTourTimeInput = string.IsNullOrWhiteSpace(normalized) ? null : normalized;
    }

    private async Task AddTourTimeAsync(TourEditorState state)
    {
        state.ErrorMessage = null;
        state.SuccessMessage = null;

        var normalized = NormalizeTime(state.CustomTourTimeInput);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            state.ErrorMessage = "Enter a valid custom time.";
            return;
        }

        if (!state.AvailableTourTimes.Contains(normalized, StringComparer.OrdinalIgnoreCase))
        {
            state.AvailableTourTimes.Add(normalized);
            state.AvailableTourTimes = state.AvailableTourTimes
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        state.SelectedTourTime = normalized;
        state.Tour.TourStartTime = normalized;
        state.CustomTourTimeInput = normalized;

        if (!state.MeetingTimeManuallySet || string.IsNullOrWhiteSpace(state.Tour.MeetingTime))
        {
            ApplyMeetingOffset(state);
        }

        MaybeApplyDefaultGuide(state);

        if (state.IsNew)
        {
            state.SuccessMessage = "Tour time queued. Save the tour, then add/update schedules from the Schedule page.";
            return;
        }

        try
        {
            var updatedSchedule = await ToursApi.EnsureTourScheduleTimeAsync(
                state.Tour.Id,
                normalized,
                state.Tour.MeetingTime,
                state.Tour.MeetingPlace);

            state.SuccessMessage = updatedSchedule
                ? "Tour time added to active schedules."
                : "No active standard schedule found. Create a schedule first in the Schedule page.";
        }
        catch (Exception ex)
        {
            state.ErrorMessage = $"Could not persist custom time: {ex.Message}";
        }
    }

    private string GetPendingTourTimeValue(TourEditorState state)
    {
        if (!string.IsNullOrWhiteSpace(state.CustomTourTimeInput))
        {
            return state.CustomTourTimeInput;
        }

        return !string.IsNullOrWhiteSpace(state.SelectedTourTime)
            ? state.SelectedTourTime
            : string.Empty;
    }

    private string GetMeetingTimeSelectValue(TourEditorState state)
