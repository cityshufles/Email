        return NormalizeTime(state.Tour.MeetingTime);
    }

    private static string? NormalizeOptionalText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private void InitializeVendorProfiles(
        TourEditorState state,
        IReadOnlyDictionary<string, DbVendor>? vendorRecords,
        IReadOnlyDictionary<string, TourNameMapping>? vendorMappings,
        IReadOnlyDictionary<string, TourLink>? vendorLinks,
        IReadOnlySet<string>? activeVendorCodes)
    {
        state.VendorProfiles = VendorProfileTemplates
            .Select(template =>
            {
                var profile = new VendorProfileEditorState
                {
                    VendorCode = template.VendorCode,
                    VendorRecordName = template.VendorRecordName,
                    SectionTitle = template.SectionTitle,
                    NameFieldLabel = template.NameFieldLabel,
                    IdFieldLabel = template.IdFieldLabel,
                    IdPlaceholder = template.IdPlaceholder,
                    TourLinkLabel = template.TourLinkLabel,
                    ReviewLinkLabel = template.ReviewLinkLabel,
                    AllToursLinkLabel = template.AllToursLinkLabel,
                    RequiresName = template.RequiresName,
                    RequiresProductId = template.RequiresProductId,
                    RequiresTourLink = template.RequiresTourLink,
                    RequiresReviewLink = template.RequiresReviewLink,
                    RequiresAllToursLink = template.RequiresAllToursLink
                };

                if (vendorRecords is not null &&
                    vendorRecords.TryGetValue(template.VendorCode, out var vendorRecord))
                {
                    profile.VendorId = vendorRecord.Id;
                    profile.AllToursLink = vendorRecord.AllToursLink ?? string.Empty;
                }

                if (vendorMappings is not null &&
                    vendorMappings.TryGetValue(template.VendorCode, out var mapping))
                {
                    profile.MappingId = mapping.Id;
                    profile.Name = mapping.IncomingTourName ?? string.Empty;
                }

                if (vendorLinks is not null &&
                    vendorLinks.TryGetValue(template.VendorCode, out var link))
                {
                    profile.LinkId = link.Id;
                    var linkName = NormalizeOptionalText(link.TourName);
                    if (!string.IsNullOrWhiteSpace(linkName))
                    {
                        // Prefer TourLinks canonical tour name when present to keep advanced UI aligned with link records.
                        profile.Name = linkName;
                    }
                    profile.ProductId = link.ProductId ?? string.Empty;
                    profile.TourLink = link.TourLinkUrl ?? string.Empty;
                    profile.ReviewLink = link.ReviewLink ?? string.Empty;
                }

                return profile;
            })
            .ToList();

        if (!state.VendorProfiles.Any(x => !string.IsNullOrWhiteSpace(x.Name)) &&
            !string.IsNullOrWhiteSpace(state.Tour.TourName) &&
            state.VendorProfiles.Count > 0)
        {
            state.VendorProfiles[0].Name = state.Tour.TourName;
        }

        if (!state.VendorProfiles.Any(x =>
                !string.IsNullOrWhiteSpace(x.ProductId) ||
                !string.IsNullOrWhiteSpace(x.TourLink) ||
                !string.IsNullOrWhiteSpace(x.ReviewLink)) &&
            state.VendorProfiles.Count > 0)
        {
            state.VendorProfiles[0].ProductId = state.Tour.VendorTourId ?? string.Empty;
            state.VendorProfiles[0].TourLink = state.Tour.VendorScheduleLink ?? state.Tour.VendorLink ?? string.Empty;
            state.VendorProfiles[0].ReviewLink = state.Tour.ReviewLink ?? string.Empty;
        }

        var hasExplicitActiveAssignments = activeVendorCodes is not null && activeVendorCodes.Count > 0;
        foreach (var profile in state.VendorProfiles)
        {
            profile.IsActive = hasExplicitActiveAssignments
                ? activeVendorCodes!.Contains(profile.VendorCode)
                : HasLegacyActiveVendorData(profile);
        }
    }

    private static bool HasLegacyActiveVendorData(VendorProfileEditorState profile)
    {
        return profile.MappingId is > 0 ||
               profile.LinkId is > 0 ||
               !string.IsNullOrWhiteSpace(profile.ProductId) ||
               !string.IsNullOrWhiteSpace(profile.TourLink) ||
               !string.IsNullOrWhiteSpace(profile.ReviewLink);
    }

    private void InitializeMappingVariants(TourEditorState state, IReadOnlyList<TourNameMapping>? mappings)
    {
        state.MappingVariants = (mappings ?? Array.Empty<TourNameMapping>())
            .Where(x => x.IsActive && x.TourId == state.Tour.Id)
            .Select(x =>
            {
                var vendorKey = NormalizeVendorKey(x.VendorName);
                var isSupported = IsSupportedVendor(vendorKey);
                return new TourMappingVariantState
                {
                    Id = x.Id,
                    VendorCode = isSupported ? vendorKey : "UNASSIGNED",
                    VendorDisplayName = string.IsNullOrWhiteSpace(x.VendorName) ? "Unassigned" : x.VendorName.Trim(),
                    IncomingTourName = x.IncomingTourName,
                    UpdatedAt = x.UpdatedAt
                };
            })
            .OrderBy(x => x.VendorCode, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.IncomingTourName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private List<TourMappingVariantState> GetMappingsForVendor(TourEditorState state, string vendorCode)
    {
        return state.MappingVariants
            .Where(x => string.Equals(x.VendorCode, vendorCode, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.IncomingTourName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private List<TourMappingVariantState> GetUnassignedMappings(TourEditorState state)
    {
        return state.MappingVariants
            .Where(x => !IsSupportedVendor(x.VendorCode))
            .OrderBy(x => x.IncomingTourName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task AddMappingAliasAsync(TourEditorState state, VendorProfileEditorState vendor)
    {
        if (state.IsBusy)
        {
            return;
        }

        state.ErrorMessage = null;
        state.SuccessMessage = null;

        if (state.Tour.Id <= 0)
        {
            state.ErrorMessage = "Save the tour first, then add mapping variants.";
            return;
        }

        var desiredName = NormalizeOptionalText(vendor.PendingAlias);
        if (string.IsNullOrWhiteSpace(desiredName))
        {
            state.ErrorMessage = "Enter an alias before adding.";
            return;
        }

        var vendorKey = NormalizeVendorKey(vendor.VendorCode);
        if (state.MappingVariants.Any(x =>
                string.Equals(x.VendorCode, vendorKey, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(x.IncomingTourName?.Trim(), desiredName, StringComparison.OrdinalIgnoreCase)))
        {
            state.SuccessMessage = "Alias already exists for this vendor.";
            vendor.PendingAlias = string.Empty;
            return;
        }

        state.IsBusy = true;

        try
        {
            var mappingId = await TourNameMappingService.AddMappingAsync(state.Tour.Id, desiredName, vendor.VendorRecordName);
            if (mappingId <= 0)
            {
                var refreshed = await TourNameMappingService.GetMappingsForTourAsync(state.Tour.Id);
                InitializeMappingVariants(state, refreshed);
                state.SuccessMessage = "Alias already exists.";
                vendor.PendingAlias = string.Empty;
                return;
            }

            state.MappingVariants.Add(new TourMappingVariantState
            {
                Id = mappingId,
                VendorCode = vendorKey,
                VendorDisplayName = vendor.VendorRecordName,
                IncomingTourName = desiredName,
                UpdatedAt = DateTime.UtcNow
            });
            state.MappingVariants = state.MappingVariants
                .OrderBy(x => x.VendorCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(x => x.IncomingTourName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            vendor.PendingAlias = string.Empty;
            state.SuccessMessage = $"Alias added for {vendor.SectionTitle}.";
        }
        catch (Exception ex)
        {
            state.ErrorMessage = $"Could not add alias: {ex.Message}";
        }
        finally
        {
            state.IsBusy = false;
        }
    }

    private async Task DeleteMappingAliasAsync(TourEditorState state, TourMappingVariantState mapping)
    {
        if (state.IsBusy || mapping.Id <= 0)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Deactivate alias '{mapping.IncomingTourName}'?");
        if (!confirmed)
        {
            return;
        }

        state.IsBusy = true;
        state.ErrorMessage = null;
        state.SuccessMessage = null;

        try
        {
            var deleted = await TourNameMappingService.DeleteMappingAsync(mapping.Id);
            if (!deleted)
            {
                state.ErrorMessage = "Could not deactivate alias.";
                return;
            }

            state.MappingVariants.RemoveAll(x => x.Id == mapping.Id);
            state.SuccessMessage = "Alias deactivated.";
        }
        catch (Exception ex)
        {
            state.ErrorMessage = $"Could not deactivate alias: {ex.Message}";
        }
        finally
        {
            state.IsBusy = false;
        }
    }

    private async Task DeactivateAllUnassignedMappingsAsync(TourEditorState state)
    {
        if (state.IsBusy)
        {
            return;
        }

        var targets = GetUnassignedMappings(state)
            .Where(x => x.Id > 0)
            .ToList();

        if (targets.Count == 0)
        {
            state.SuccessMessage = "No unassigned aliases found.";
            state.ErrorMessage = null;
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Deactivate {targets.Count} unassigned legacy alias(es)? This is reversible by adding aliases again.");

        if (!confirmed)
        {
            return;
        }

        state.IsBusy = true;
        state.ErrorMessage = null;
        state.SuccessMessage = null;

        try
        {
            var deactivatedIds = new List<int>(targets.Count);

            foreach (var target in targets)
            {
                var deleted = await TourNameMappingService.DeleteMappingAsync(target.Id);
                if (deleted)
                {
                    deactivatedIds.Add(target.Id);
                }
            }

            if (deactivatedIds.Count > 0)
            {
                state.MappingVariants.RemoveAll(x => deactivatedIds.Contains(x.Id));
            }

            if (deactivatedIds.Count == targets.Count)
            {
                state.SuccessMessage = $"Deactivated {deactivatedIds.Count} unassigned alias(es).";
            }
            else
            {
                state.ErrorMessage = $"Only {deactivatedIds.Count} of {targets.Count} unassigned alias(es) were deactivated.";
            }
        }
        catch (Exception ex)
        {
            state.ErrorMessage = $"Bulk deactivation failed: {ex.Message}";
        }
        finally
        {
            state.IsBusy = false;
        }
    }

    private VendorCompletenessSummary BuildVendorCompletenessSummary(TourEditorState state)
    {
        var tracked = state.VendorProfiles
            .Select(BuildVendorCompleteness)
            .Where(x => x.IsTracked)
            .ToList();

        if (tracked.Count == 0)
        {
            return new VendorCompletenessSummary
            {
                TrackedVendors = 0,
                CompletedVendors = 0,
                IncompleteVendors = 0
            };
        }

        var completed = tracked.Count(x => x.IsComplete);
        return new VendorCompletenessSummary
        {
            TrackedVendors = tracked.Count,
            CompletedVendors = completed,
            IncompleteVendors = tracked.Count - completed
        };
    }

    private VendorCompletenessState BuildVendorCompleteness(VendorProfileEditorState vendor)
    {
        if (!vendor.IsActive)
        {
            return new VendorCompletenessState
            {
                IsTracked = false,
                IsComplete = false,
                RequiredFields = 0,
                CompletedRequired = 0,
                MissingFieldLabels = new List<string>()
            };
        }

        var missing = new List<string>();
        var requiredCount = 0;
        var completedRequired = 0;

        TrackField(vendor.RequiresName, vendor.Name, vendor.NameFieldLabel, missing, ref requiredCount, ref completedRequired);
        TrackField(vendor.RequiresProductId, vendor.ProductId, vendor.IdFieldLabel, missing, ref requiredCount, ref completedRequired);
        TrackField(vendor.RequiresTourLink, vendor.TourLink, vendor.TourLinkLabel, missing, ref requiredCount, ref completedRequired);
        TrackField(vendor.RequiresReviewLink, vendor.ReviewLink, vendor.ReviewLinkLabel, missing, ref requiredCount, ref completedRequired);
        TrackField(vendor.RequiresAllToursLink, vendor.AllToursLink, vendor.AllToursLinkLabel, missing, ref requiredCount, ref completedRequired);
        var isTracked = requiredCount > 0;

        return new VendorCompletenessState
        {
            IsTracked = isTracked,
            RequiredFields = requiredCount,
            CompletedRequired = completedRequired,
            MissingFieldLabels = missing,
            IsComplete = isTracked && missing.Count == 0
        };
    }

    private static void TrackField(
        bool isRequired,
        string? value,
        string fieldLabel,
        List<string> missing,
        ref int requiredCount,
        ref int completedRequired)
    {
        if (!isRequired)
        {
            return;
        }

        requiredCount++;
        if (string.IsNullOrWhiteSpace(value))
        {
            missing.Add(fieldLabel);
            return;
        }

        completedRequired++;
    }

    private void ApplyLegacyVendorFallbackFields(TourEditorState state)
    {
        var primaryProfile = state.VendorProfiles.FirstOrDefault(x =>
                !string.IsNullOrWhiteSpace(x.Name) ||
                !string.IsNullOrWhiteSpace(x.ProductId) ||
                !string.IsNullOrWhiteSpace(x.TourLink) ||
                !string.IsNullOrWhiteSpace(x.ReviewLink))
            ?? state.VendorProfiles.FirstOrDefault();

        state.Tour.VendorTourId = NormalizeOptionalText(primaryProfile?.ProductId);
        state.Tour.VendorScheduleLink = NormalizeOptionalText(primaryProfile?.TourLink);
        state.Tour.ReviewLink = NormalizeOptionalText(primaryProfile?.ReviewLink);
        state.Tour.VendorLink = NormalizeOptionalText(primaryProfile?.TourLink);

        var activeVendors = state.VendorProfiles
            .Where(x => x.IsActive)
            .Select(x => x.VendorCode)
            .ToList();
        state.Tour.VendorNames = activeVendors.Count == 0
            ? null
            : string.Join(',', activeVendors);
    }

    private async Task<int> SaveVendorDetailsAsync(TourEditorState state, int tourId)
    {
        var existingVendors = await VendorsApi.GetVendorsAsync();
        var existingVendorTours = await VendorsApi.GetVendorToursAsync();
        var existingMappings = await TourNameMappingService.GetMappingsForTourAsync(tourId);
        var existingLinks = await TourLinkService.GetLinksForTourAsync(tourId, null);
        var activeVendorTourLookup = new HashSet<string>(
            existingVendorTours
                .Where(x => x.IsActive)
                .Select(x => BuildVendorTourLookupKey(x.VendorId, x.MasterTourName)),
            StringComparer.OrdinalIgnoreCase);
        var affectedRows = 0;

        foreach (var vendor in state.VendorProfiles)
        {
            affectedRows += await SaveVendorRecordAsync(vendor, existingVendors);
            affectedRows += await SaveVendorTourAssignmentAsync(state, vendor, activeVendorTourLookup);
            affectedRows += await SaveVendorMappingAsync(tourId, vendor, existingMappings);
            affectedRows += await SaveVendorLinkAsync(state, tourId, vendor, existingLinks);
        }

        return affectedRows;
    }

    private async Task<int> SaveVendorRecordAsync(VendorProfileEditorState vendor, List<DbVendor> existingVendors)
    {
        var desiredAllToursLink = NormalizeOptionalText(vendor.AllToursLink);
        var hasAnyData =
            vendor.IsActive ||
            !string.IsNullOrWhiteSpace(vendor.Name) ||
            !string.IsNullOrWhiteSpace(vendor.ProductId) ||
            !string.IsNullOrWhiteSpace(vendor.TourLink) ||
            !string.IsNullOrWhiteSpace(vendor.ReviewLink) ||
            !string.IsNullOrWhiteSpace(desiredAllToursLink);

        var existing = existingVendors.FirstOrDefault(x =>
            string.Equals(NormalizeVendorKey(x.VendorName), NormalizeVendorKey(vendor.VendorCode), StringComparison.OrdinalIgnoreCase));

        if (existing is null)
        {
            if (!hasAnyData)
            {
                return 0;
            }

            var created = await VendorsApi.CreateVendorAsync(new DbVendor
            {
                VendorName = vendor.VendorRecordName,
                AllToursLink = desiredAllToursLink,
                IsActive = true
            });

            if (created is not null)
            {
                vendor.VendorId = created.Id;
                existingVendors.Add(created);
                return 1;
            }

            return 0;
        }

        vendor.VendorId = existing.Id;

        var existingAllTours = NormalizeOptionalText(existing.AllToursLink);
        if (string.Equals(existingAllTours, desiredAllToursLink, StringComparison.OrdinalIgnoreCase) &&
            existing.IsActive)
        {
            return 0;
        }

        var payload = new DbVendor
        {
            VendorName = string.IsNullOrWhiteSpace(existing.VendorName) ? vendor.VendorRecordName : existing.VendorName,
            AllToursLink = desiredAllToursLink,
            IsActive = true
        };

        var updated = await VendorsApi.UpdateVendorAsync(existing.Id, payload);
        if (updated)
        {
            existing.VendorName = payload.VendorName;
            existing.AllToursLink = payload.AllToursLink;
            existing.IsActive = payload.IsActive;
            return 1;
        }

        return 0;
    }

    private async Task<int> SaveVendorTourAssignmentAsync(
        TourEditorState state,
        VendorProfileEditorState vendor,
        HashSet<string> activeVendorTourLookup)
    {
        if (vendor.VendorId is not > 0)
        {
            return 0;
        }

        var masterTourName = NormalizeOptionalText(state.Tour.MasterTourName)
            ?? NormalizeOptionalText(state.Tour.TourName);
        if (string.IsNullOrWhiteSpace(masterTourName))
        {
            return 0;
        }

        var key = BuildVendorTourLookupKey(vendor.VendorId.Value, masterTourName);
        var currentlyActive = activeVendorTourLookup.Contains(key);
        if (currentlyActive == vendor.IsActive)
        {
            return 0;
        }

        var updated = await VendorsApi.SetVendorTourActiveAsync(vendor.VendorId.Value, masterTourName, vendor.IsActive);
        if (!updated)
        {
            var detail = string.IsNullOrWhiteSpace(VendorsApi.LastError) ? "Unknown error." : VendorsApi.LastError;
            throw new InvalidOperationException($"Could not update vendor tour assignment for {vendor.SectionTitle}: {detail}");
        }

        if (vendor.IsActive)
        {
            activeVendorTourLookup.Add(key);
        }
        else
        {
            activeVendorTourLookup.Remove(key);
        }

        return 1;
    }

    private static string BuildVendorTourLookupKey(int vendorId, string? masterTourName)
    {
        return $"{vendorId}|{NormalizeMasterTourLookupKey(masterTourName)}";
    }

    private async Task<int> SaveVendorMappingAsync(
        int tourId,
        VendorProfileEditorState vendor,
        List<TourNameMapping> existingMappings)
    {
        var vendorKey = NormalizeVendorKey(vendor.VendorCode);
        var desiredName = NormalizeOptionalText(vendor.Name);

        var vendorMappings = existingMappings
            .Where(x => x.IsActive && string.Equals(NormalizeVendorKey(x.VendorName), vendorKey, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (string.IsNullOrWhiteSpace(desiredName))
        {
            vendor.MappingId = vendorMappings
                .OrderByDescending(x => x.UpdatedAt)
                .Select(x => (int?)x.Id)
                .FirstOrDefault();
            return 0;
        }

        var matching = vendorMappings.FirstOrDefault(x =>
            string.Equals(x.IncomingTourName?.Trim(), desiredName, StringComparison.OrdinalIgnoreCase));

        if (matching is null)
        {
            var mappingId = await TourNameMappingService.AddMappingAsync(tourId, desiredName, vendor.VendorRecordName);
            if (mappingId > 0)
            {
                existingMappings.Add(new TourNameMapping
                {
                    Id = mappingId,
                    TourId = tourId,
                    IncomingTourName = desiredName,
                    VendorName = vendor.VendorRecordName,
                    IsActive = true,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                });
                vendor.MappingId = mappingId;
                return 1;
            }
            else
            {
                var refreshed = await TourNameMappingService.GetMappingsForTourAsync(tourId);
                existingMappings.Clear();
                existingMappings.AddRange(refreshed);

                var refreshedMatch = refreshed
                    .Where(x => x.IsActive)
                    .FirstOrDefault(x =>
                        string.Equals(NormalizeVendorKey(x.VendorName), vendorKey, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(x.IncomingTourName?.Trim(), desiredName, StringComparison.OrdinalIgnoreCase));

                if (refreshedMatch is not null)
                {
                    vendor.MappingId = refreshedMatch.Id;
                    return await TourNameMappingService.TouchMappingAsync(refreshedMatch.Id) ? 1 : 0;
                }
                else
                {
                    vendor.MappingId = null;
                    return 0;
                }
            }
        }

        vendor.MappingId = matching.Id;
        var touched = await TourNameMappingService.TouchMappingAsync(matching.Id);
        if (touched)
        {
            matching.UpdatedAt = DateTime.UtcNow;
            return 1;
        }

        return 0;
    }

    private async Task<int> SaveVendorLinkAsync(
        TourEditorState state,
        int tourId,
        VendorProfileEditorState vendor,
        List<TourLink> existingLinks)
    {
        var vendorKey = NormalizeVendorKey(vendor.VendorCode);
        var desiredName = NormalizeOptionalText(vendor.Name);
        var desiredProductId = NormalizeOptionalText(vendor.ProductId);
        var desiredTourLink = NormalizeOptionalText(vendor.TourLink);
        var desiredReviewLink = NormalizeOptionalText(vendor.ReviewLink);

        var hasAnyData =
            !string.IsNullOrWhiteSpace(desiredName) ||
            !string.IsNullOrWhiteSpace(desiredProductId) ||
            !string.IsNullOrWhiteSpace(desiredTourLink) ||
            !string.IsNullOrWhiteSpace(desiredReviewLink);

        var vendorLinks = existingLinks
            .Where(x => string.Equals(NormalizeVendorKey(x.Vendor), vendorKey, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var editable = vendorLinks
            .Where(x => x.TourDay is null && string.IsNullOrWhiteSpace(x.TourTime))
            .OrderByDescending(x => x.UpdatedAt)
            .FirstOrDefault()
            ?? vendorLinks.OrderByDescending(x => x.UpdatedAt).FirstOrDefault();

        if (!hasAnyData)
        {
            if (editable is not null && editable.Id > 0 && editable.TourDay is null && string.IsNullOrWhiteSpace(editable.TourTime))
            {
                var deleted = await TourLinkService.DeleteAsync(editable.Id);
                if (deleted)
                {
                    existingLinks.RemoveAll(x => x.Id == editable.Id);
                    vendor.LinkId = null;
                    return 1;
                }
            }

            vendor.LinkId = null;
            return 0;
        }

        var canonicalTourName = desiredName
            ?? NormalizeOptionalText(state.Tour.MasterTourName)
            ?? NormalizeOptionalText(state.Tour.TourName)
            ?? vendor.SectionTitle;

        if (editable is not null)
        {
            var existingName = NormalizeOptionalText(editable.TourName);
            var existingProductId = NormalizeOptionalText(editable.ProductId);
            var existingTourLink = NormalizeOptionalText(editable.TourLinkUrl);
            var existingReviewLink = NormalizeOptionalText(editable.ReviewLink);
            var existingVendorName = NormalizeOptionalText(editable.Vendor);

            if (string.Equals(existingName, canonicalTourName, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(existingProductId, desiredProductId, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(existingTourLink, desiredTourLink, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(existingReviewLink, desiredReviewLink, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(existingVendorName, vendor.VendorRecordName, StringComparison.OrdinalIgnoreCase))
            {
                vendor.LinkId = editable.Id;
                return 0;
            }
        }

        var payload = editable ?? new TourLink
        {
            Vendor = vendor.VendorRecordName,
            TourId = tourId
        };

        payload.Vendor = vendor.VendorRecordName;
        payload.TourId = tourId;
        payload.TourName = canonicalTourName;
        payload.ProductId = desiredProductId;
        payload.TourLinkUrl = desiredTourLink;
        payload.ReviewLink = desiredReviewLink;

        var savedId = await TourLinkService.SaveAsync(payload);
        var resolvedId = savedId > 0 ? savedId : payload.Id;
        vendor.LinkId = resolvedId > 0 ? resolvedId : null;

        if (editable is null)
        {
            payload.Id = vendor.LinkId ?? payload.Id;
            existingLinks.Add(payload);
        }

        return resolvedId > 0 ? 1 : 0;
    }

    private static Dictionary<string, DbVendor> BuildVendorRecordLookup(IReadOnlyList<DbVendor> vendors)
    {
        var result = new Dictionary<string, DbVendor>(StringComparer.OrdinalIgnoreCase);

        foreach (var vendor in vendors)
        {
            var key = NormalizeVendorKey(vendor.VendorName);
            if (string.IsNullOrWhiteSpace(key) || !IsSupportedVendor(key))
            {
                continue;
            }

            if (!result.TryGetValue(key, out var existing) ||
                GetVendorSortDate(vendor) >= GetVendorSortDate(existing))
            {
                result[key] = vendor;
            }
        }

        return result;
    }

    private static DateTime GetVendorSortDate(DbVendor vendor)
    {
        return vendor.UpdatedAt ?? vendor.CreatedAt ?? DateTime.MinValue;
    }

    private static Dictionary<string, HashSet<string>> BuildVendorTourAssignmentLookup(
        IReadOnlyList<DbVendor> vendors,
        IReadOnlyList<DbVendorTour> vendorTours)
    {
        var result = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);
        if (vendors.Count == 0 || vendorTours.Count == 0)
        {
            return result;
        }

        var vendorsById = vendors
            .Where(x => x.Id > 0)
            .GroupBy(x => x.Id)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(GetVendorSortDate).First());

        foreach (var vendorTour in vendorTours.Where(x => x.IsActive))
        {
            if (!vendorsById.TryGetValue(vendorTour.VendorId, out var vendorRecord))
            {
                continue;
            }

            var vendorKey = NormalizeVendorKey(vendorRecord.VendorName);
            if (string.IsNullOrWhiteSpace(vendorKey) || !IsSupportedVendor(vendorKey))
            {
                continue;
            }

            var masterTourKey = NormalizeMasterTourLookupKey(vendorTour.MasterTourName);
            if (string.IsNullOrWhiteSpace(masterTourKey))
            {
                continue;
            }

            if (!result.TryGetValue(masterTourKey, out var assignedVendors))
            {
                assignedVendors = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                result[masterTourKey] = assignedVendors;
            }

            assignedVendors.Add(vendorKey);
        }

        return result;
    }

    private static Dictionary<int, Dictionary<string, TourNameMapping>> BuildVendorMappingLookup(
        IReadOnlyList<TourNameMapping> mappings)
    {
        var result = new Dictionary<int, Dictionary<string, TourNameMapping>>();

        foreach (var mapping in mappings.Where(x => x.IsActive && x.TourId > 0))
        {
            var vendorKey = NormalizeVendorKey(mapping.VendorName);
            if (string.IsNullOrWhiteSpace(vendorKey) || !IsSupportedVendor(vendorKey))
            {
                continue;
            }

            if (!result.TryGetValue(mapping.TourId, out var mapByVendor))
            {
                mapByVendor = new Dictionary<string, TourNameMapping>(StringComparer.OrdinalIgnoreCase);
                result[mapping.TourId] = mapByVendor;
            }

            if (!mapByVendor.TryGetValue(vendorKey, out var existing) ||
                mapping.UpdatedAt >= existing.UpdatedAt)
            {
                mapByVendor[vendorKey] = mapping;
            }
        }

        return result;
    }

    private static Dictionary<int, List<TourNameMapping>> BuildMappingVariantsLookup(IReadOnlyList<TourNameMapping> mappings)
    {
        var result = new Dictionary<int, List<TourNameMapping>>();

        foreach (var mapping in mappings.Where(x => x.IsActive && x.TourId > 0))
        {
            if (!result.TryGetValue(mapping.TourId, out var variants))
            {
                variants = new List<TourNameMapping>();
                result[mapping.TourId] = variants;
            }

            variants.Add(mapping);
        }

        return result;
    }

    private static Dictionary<int, Dictionary<string, TourLink>> BuildVendorLinkLookup(IReadOnlyList<TourLink> links)
    {
        var result = new Dictionary<int, Dictionary<string, TourLink>>();

        foreach (var link in links.Where(x => x.TourId is > 0))
        {
            var vendorKey = NormalizeVendorKey(link.Vendor);
            if (string.IsNullOrWhiteSpace(vendorKey) || !IsSupportedVendor(vendorKey))
            {
                continue;
            }

            var tourId = link.TourId!.Value;
            if (!result.TryGetValue(tourId, out var mapByVendor))
            {
                mapByVendor = new Dictionary<string, TourLink>(StringComparer.OrdinalIgnoreCase);
                result[tourId] = mapByVendor;
            }

            if (!mapByVendor.TryGetValue(vendorKey, out var existing) ||
                IsPreferredLink(link, existing))
            {
                mapByVendor[vendorKey] = link;
            }
        }

        return result;
    }

    private static bool IsPreferredLink(TourLink candidate, TourLink current)
    {
        var candidateScore = ScoreLink(candidate);
        var currentScore = ScoreLink(current);
        if (candidateScore != currentScore)
        {
            return candidateScore > currentScore;
        }

        return candidate.UpdatedAt >= current.UpdatedAt;
    }

    private static int ScoreLink(TourLink link)
    {
        var score = 0;
        if (link.TourDay is null) score += 2;
        if (string.IsNullOrWhiteSpace(link.TourTime)) score += 2;
        if (!string.IsNullOrWhiteSpace(link.ProductId)) score += 1;
        if (!string.IsNullOrWhiteSpace(link.TourLinkUrl)) score += 1;
        if (!string.IsNullOrWhiteSpace(link.ReviewLink)) score += 1;
        return score;
    }

    private static bool IsSupportedVendor(string vendorKey)
    {
        return VendorProfileTemplates.Any(x =>
            string.Equals(x.VendorCode, vendorKey, StringComparison.OrdinalIgnoreCase));
    }

    private static string NormalizeVendorKey(string? vendorName)
    {
        if (string.IsNullOrWhiteSpace(vendorName))
        {
            return string.Empty;
        }

        var upper = vendorName.Trim().ToUpperInvariant();
        var compact = Regex.Replace(upper, "[^A-Z0-9]", string.Empty, RegexOptions.CultureInvariant);

        if (compact.Contains("VIATOR", StringComparison.Ordinal))
        {
            return "VIATOR";
        }

        if (compact.Contains("GURUWALK", StringComparison.Ordinal) || compact.StartsWith("GURU", StringComparison.Ordinal))
        {
            return "GURUWALK";
        }

        if (compact.Contains("FREETOUR", StringComparison.Ordinal))
        {
            return "FREETOUR";
        }

        if (compact.Contains("GETYOURGUIDE", StringComparison.Ordinal) || compact.Equals("GYG", StringComparison.Ordinal))
        {
            return "GETYOURGUIDE";
        }

        if (compact.Contains("AIRBNB", StringComparison.Ordinal))
        {
            return "AIRBNB";
        }

        if (compact.Contains("CIVITATIS", StringComparison.Ordinal) || compact.Contains("CIVATASIS", StringComparison.Ordinal))
        {
            return "CIVITATIS";
        }

        if (compact.Contains("CITYSHUFFLES", StringComparison.Ordinal) || compact.Contains("WEBSITE", StringComparison.Ordinal))
        {
            return "WEBSITE";
        }

        return compact;
    }

    private string GetDurationSelectValue(TourEditorState state)
    {
        var normalized = NormalizeDurationValue(state.Tour.Duration);
        state.Tour.Duration = normalized;
        return normalized;
    }

    private void OnDurationSelectionChanged(TourEditorState state, ChangeEventArgs args)
    {
        var selected = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(selected) && DurationHourOptions.Contains(selected, StringComparer.OrdinalIgnoreCase))
        {
            state.Tour.Duration = selected;
            return;
        }

        state.Tour.Duration = "3";
    }

    private void OnMeetingTimeSelectionChanged(TourEditorState state, ChangeEventArgs args)
    {
        var normalized = NormalizeTime(args.Value?.ToString());
        state.Tour.MeetingTime = string.IsNullOrWhiteSpace(normalized) ? null : normalized;
        state.MeetingTimeManuallySet = !string.IsNullOrWhiteSpace(state.Tour.MeetingTime);

        if (!state.MeetingTimeManuallySet)
        {
            ApplyMeetingOffset(state);
        }
    }

    private void OnMeetingOffsetChanged(TourEditorState state, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed))
        {
            return;
        }

        state.MeetingOffsetMinutes = NormalizeNegativeOffset(parsed);

        if (!state.MeetingTimeManuallySet || string.IsNullOrWhiteSpace(state.Tour.MeetingTime))
        {
            ApplyMeetingOffset(state);
        }
    }

    private void ApplyMeetingOffset(TourEditorState state)
    {
        var computed = ComputeMeetingTime(state.SelectedTourTime, state.MeetingOffsetMinutes);
        if (string.IsNullOrWhiteSpace(computed))
        {
            return;
        }

        state.Tour.MeetingTime = computed;
        state.MeetingTimeManuallySet = false;
    }

    private void OnGuideSelectionChanged(TourEditorState state, ChangeEventArgs args)
    {
        state.GuideManuallySet = true;

        if (int.TryParse(args.Value?.ToString(), out var guideId) && guideId > 0)
        {
            state.Tour.DefaultGuideId = guideId;
            return;
        }

        state.Tour.DefaultGuideId = null;
    }

    private string GetGuideSelectValue(TourEditorState state)
    {
        return state.Tour.DefaultGuideId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private void MaybeApplyDefaultGuide(TourEditorState state)
    {
        if (state.GuideManuallySet || tourCatalog is null)
        {
            return;
        }

        var entry = FindCatalogEntry(state.Tour.TourName);
        if (entry is null)
        {
            return;
        }

        int? resolvedGuideId = null;
        if (entry.TourId is int tourId &&
            tourCatalog.GuideDefaultsByTourId.TryGetValue(tourId, out var defaults) &&
            defaults.Count > 0)
        {
            var normalizedTime = NormalizeTime(state.SelectedTourTime);
            if (!string.IsNullOrWhiteSpace(normalizedTime))
            {
                var byTime = defaults.FirstOrDefault(d =>
                    string.Equals(NormalizeTime(d.StartTime), normalizedTime, StringComparison.OrdinalIgnoreCase));
                resolvedGuideId = byTime?.GuideId;
            }

            resolvedGuideId ??= defaults.FirstOrDefault()?.GuideId;
        }

        resolvedGuideId ??= entry.DefaultGuideId;

        if (resolvedGuideId.HasValue && availableGuides.Any(g => g.Id == resolvedGuideId.Value))
        {
            state.Tour.DefaultGuideId = resolvedGuideId;
        }
    }

    private TourCatalogEntry? FindCatalogEntry(string? tourName)
    {
        if (tourCatalog is null || string.IsNullOrWhiteSpace(tourName))
        {
            return null;
        }

        var normalized = NormalizeName(tourName);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return null;
        }

        return tourCatalog.Entries.FirstOrDefault(entry =>
            string.Equals(entry.CanonicalName, normalized, StringComparison.OrdinalIgnoreCase) ||
            entry.Aliases.Any(alias =>
                string.Equals(NormalizeName(alias), normalized, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task DismissCreateWarningAsync(TourEditorState state)
    {
        state.ShowCreateWarning = false;

        if (!state.NeverShowCreateWarning)
        {
            return;
        }

        hideCreateWarning = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", HideCreateWarningStorageKey, "true");
        }
        catch
        {
            // no-op
        }
    }

    private async Task RestoreCreateWarningPreferenceAsync()
    {
        try
        {
            var stored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", HideCreateWarningStorageKey);
            hideCreateWarning = string.Equals(stored, "true", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            hideCreateWarning = false;
        }
    }

    private TourEditorState CreateState(
        DbTour source,
        IReadOnlyList<MasterTourTimeSlot> scheduleSlots,
        IReadOnlyDictionary<string, DbVendor>? vendorRecords,
        IReadOnlyDictionary<string, TourNameMapping>? vendorMappings,
        IReadOnlyList<TourNameMapping>? mappingVariants,
        IReadOnlyDictionary<string, TourLink>? vendorLinks,
        IReadOnlySet<string>? activeVendorCodes)
    {
        var tour = CloneTour(source);
        var state = new TourEditorState
        {
            Tour = tour,
            ScheduleTimeSlots = scheduleSlots.ToList()
        };

        InitializeVendorProfiles(state, vendorRecords, vendorMappings, vendorLinks, activeVendorCodes);
        InitializeMappingVariants(state, mappingVariants);

        state.AvailableTourTimes = state.ScheduleTimeSlots
            .Select(x => NormalizeTime(x.TourTime))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var selected = NormalizeTime(tour.TourStartTime);
        if (string.IsNullOrWhiteSpace(selected) && state.AvailableTourTimes.Count > 0)
        {
            selected = state.AvailableTourTimes[0];
        }

        if (!string.IsNullOrWhiteSpace(selected) && !state.AvailableTourTimes.Contains(selected, StringComparer.OrdinalIgnoreCase))
        {
            state.AvailableTourTimes.Add(selected);
            state.AvailableTourTimes = state.AvailableTourTimes
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        state.SelectedTourTime = selected;
        state.Tour.TourStartTime = string.IsNullOrWhiteSpace(selected) ? null : selected;
        state.CustomTourTimeInput = string.IsNullOrWhiteSpace(selected) ? null : selected;

        var selectedScheduleSlot = state.ScheduleTimeSlots
            .FirstOrDefault(x => string.Equals(NormalizeTime(x.TourTime), state.SelectedTourTime, StringComparison.OrdinalIgnoreCase));
        var scheduleMeetingTime = selectedScheduleSlot?.MeetingTime;
        var usingScheduleMeetingTime = !string.IsNullOrWhiteSpace(scheduleMeetingTime);

        var normalizedMeetingTime = NormalizeTime(usingScheduleMeetingTime ? scheduleMeetingTime : state.Tour.MeetingTime);
        var derivedOffset = DeriveOffsetMinutes(state.SelectedTourTime, normalizedMeetingTime);

        if (usingScheduleMeetingTime && IsOffsetOutsideNormalScheduleRange(derivedOffset))
        {
            // Guard against bad schedule AM/PM values (e.g. 12-hour drift).
            state.MeetingOffsetMinutes = -10;
            normalizedMeetingTime = ComputeMeetingTime(state.SelectedTourTime, state.MeetingOffsetMinutes);
        }
        else
        {
            state.MeetingOffsetMinutes = derivedOffset;
        }

        if (!string.IsNullOrWhiteSpace(state.SelectedTourTime))
        {
            // Backfill to rule-based meeting time when value is missing or equals tour start.
            if (string.IsNullOrWhiteSpace(normalizedMeetingTime) ||
                string.Equals(normalizedMeetingTime, state.SelectedTourTime, StringComparison.OrdinalIgnoreCase))
            {
                state.Tour.MeetingTime = ComputeMeetingTime(state.SelectedTourTime, state.MeetingOffsetMinutes);
            }
            else
            {
                state.Tour.MeetingTime = normalizedMeetingTime;
            }

            state.MeetingTimeManuallySet = false;
        }
        else
        {
            state.Tour.MeetingTime = string.IsNullOrWhiteSpace(normalizedMeetingTime) ? null : normalizedMeetingTime;
        }

        state.Tour.Duration = NormalizeDurationValue(state.Tour.Duration);
        state.Tour.MeetingPlace = string.IsNullOrWhiteSpace(state.Tour.MeetingPlace) ? "TBD" : state.Tour.MeetingPlace;
        state.ShowCreateWarning = state.IsNew && !hideCreateWarning;

        return state;
    }

    private async Task OnEditorInputChangedAsync(TourEditorState state)
    {
        if (state.IsBusy || state.IsDirty)
        {
            return;
        }

        state.IsDirty = true;
        if (!state.DirtyToastShown)
        {
            state.DirtyToastShown = true;
            await ToastService.ShowInfoAsync("Editing... Save to keep changes.", "Unsaved Changes");
        }

        await UpdateUnsavedChangesWarningAsync();
    }

    private bool HasUnsavedChanges()
    {
        return tourStates.Any(x => x.IsDirty);
    }

    private async Task UpdateUnsavedChangesWarningAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("setPageUnsavedChanges", HasUnsavedChanges());
        }
        catch (JSException ex) when (ex.Message.Contains("setPageUnsavedChanges", StringComparison.OrdinalIgnoreCase) ||
                                     ex.Message.Contains("undefined", StringComparison.OrdinalIgnoreCase))
        {
            // JS file not loaded yet; ignore and continue.
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("JavaScript interop calls cannot be issued at this time", StringComparison.Ordinal))
        {
            // prerender/no-op
        }
        catch (JSDisconnectedException)
        {
            // disconnected/no-op
        }
    }

    private async ValueTask ConfirmNavigationWhenDirtyAsync(LocationChangingContext context)
    {
        if (!HasUnsavedChanges())
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            "You have unsaved changes. Leave this page without saving?");

        if (!confirmed)
        {
            context.PreventNavigation();
        }
    }

