    private void BuildCanonicalTourSelectionMetadata(IReadOnlyList<DbTour> tours)
    {
        canonicalTourIdSet.Clear();
        canonicalTourIdByTourId.Clear();
        duplicateCountByCanonicalTourId.Clear();

        var groups = tours
            .GroupBy(GetMasterTourKey, StringComparer.OrdinalIgnoreCase);

        foreach (var group in groups)
        {
            var members = group.ToList();
            var canonical = SelectCanonicalTourRow(members);
            canonicalTourIdSet.Add(canonical.Id);
            duplicateCountByCanonicalTourId[canonical.Id] = members.Count(x => x.IsActive && x.Id != canonical.Id);

            foreach (var member in members)
            {
                canonicalTourIdByTourId[member.Id] = canonical.Id;
            }
        }
    }

    private int NormalizeToCanonicalTourId(int tourId)
    {
        return canonicalTourIdByTourId.TryGetValue(tourId, out var canonicalTourId)
            ? canonicalTourId
            : tourId;
    }

    private static string GetMasterTourKey(DbTour tour)
    {
        var master = tour.MasterTourName?.Trim();
        if (!string.IsNullOrWhiteSpace(master))
        {
            return $"master::{master.ToUpperInvariant()}";
        }

        var tourName = tour.TourName?.Trim();
        if (!string.IsNullOrWhiteSpace(tourName))
        {
            return $"tour::{tourName.ToUpperInvariant()}";
        }

        return $"id::{tour.Id}";
    }

    private bool TryGetActiveMasterTourConflict(TourEditorState currentState, string? candidateMasterTourName, out DbTour conflictingTour)
    {
        conflictingTour = null!;
        var candidateKey = NormalizeMasterTourLookupKey(candidateMasterTourName);
        if (string.IsNullOrWhiteSpace(candidateKey))
        {
            return false;
        }

        var conflict = tourStates
            .Where(state => !ReferenceEquals(state, currentState))
            .Select(state => state.Tour)
            .FirstOrDefault(tour =>
                tour.IsActive &&
                string.Equals(NormalizeMasterTourLookupKey(tour.MasterTourName), candidateKey, StringComparison.OrdinalIgnoreCase));

        if (conflict is null)
        {
            return false;
        }

        conflictingTour = conflict;
        return true;
    }

    private static string NormalizeMasterTourLookupKey(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Trim().ToUpperInvariant();
    }

    private static bool IsActiveMasterTourDuplicateConstraintViolation(Exception ex)
    {
        for (Exception? current = ex; current is not null; current = current.InnerException)
        {
            if (!string.IsNullOrWhiteSpace(current.Message) &&
                current.Message.Contains(ActiveMasterTourUniqueIndexName, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static DbTour SelectCanonicalTourRow(IEnumerable<DbTour> tours)
    {
        return tours
            .OrderByDescending(t => t.IsActive)
            .ThenByDescending(t => !string.IsNullOrWhiteSpace(t.MasterTourName))
            .ThenByDescending(t => t.UpdatedAt ?? DateTime.MinValue)
            .ThenByDescending(t => t.CreatedAt ?? DateTime.MinValue)
            .ThenByDescending(t => t.Id)
            .First();
    }

    private static string BuildAbbreviation(string? source)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return string.Empty;
        }

        var compact = source.Trim();
        var spaced = Regex.Replace(compact, "([a-z0-9])([A-Z])", "$1 $2", RegexOptions.CultureInvariant);

        var tokens = Regex
            .Split(spaced, "[^A-Za-z0-9]+")
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();

        if (tokens.Count <= 1)
        {
            tokens = Regex
                .Matches(compact, "[A-Z]+(?![a-z])|[A-Z]?[a-z]+|[0-9]+")
                .Select(m => m.Value)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();
        }

        if (tokens.Count > 1)
        {
            var stopWords = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                "the", "of", "and", "at", "in", "to", "for", "a", "an"
            };

            var filtered = tokens.Where(x => !stopWords.Contains(x)).ToList();
            if (filtered.Count > 0)
            {
                tokens = filtered;
            }
        }

        var initials = tokens
            .Where(x => x.Length > 0)
            .Select(x => char.ToUpperInvariant(x[0]))
            .Take(8)
            .ToArray();

        if (initials.Length > 0)
        {
            return new string(initials);
        }

        var fallback = new string(compact.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();
        return fallback.Length <= 8 ? fallback : fallback[..8];
    }

    private static IReadOnlyList<string> BuildTimeOptions()
    {
        var list = new List<string>(288);
        var start = TimeOnly.MinValue;

        for (var i = 0; i < 288; i++)
        {
            list.Add(start.AddMinutes(i * 5).ToString("HH:mm", CultureInfo.InvariantCulture));
        }

        return list;
    }

    private static IReadOnlyList<string> BuildDurationHourOptions()
    {
        var list = new List<string>(13) { "0.5" };
        for (var i = 1; i <= 12; i++)
        {
            list.Add(i.ToString(CultureInfo.InvariantCulture));
        }

        return list;
    }

