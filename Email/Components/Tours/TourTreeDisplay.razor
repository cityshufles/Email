@* 2025-11-18: CSS/Markup migration from CityShufflesWorkStation\Components\TourTreeDisplay.razor *@
@using Email.Models
@using Email.Components.Tours
@using Email.TourTreeViewShapedData.Enums
@using Email.TourTreeViewShapedData.Models
@using Microsoft.AspNetCore.Components.Web

@* Services that exist in Email project *@
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject Email.Services.ITourEmailsService EmailsService
@inject Email.Services.IBookingsInboxService BookingsInboxService

@* 2025-11-20 00:00 UTC - Verbatim Message Management port requires these services *@
@inject Email.Services.IGuidesApiService GuidesApi
@inject Email.Services.IToursApiService ToursApiService
@inject Email.Services.ITourMessagesApiService TourMessagesApi
@inject Email.Services.ITourTreeService TourTreeService
@inject Email.Services.TourDataErrorReportsSqlService ErrorReportsService
@inject Email.Services.ITourCatalogService TourCatalogService
@inject Email.Services.VCardExportService VCardExportService
@inject Email.Services.VCardLogService VCardLogService
@inject Email.Services.IGuideReportService GuideReportService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@* TODO: Services to be implemented in future migrations (kept commented)
 @inject IAuthenticationService AuthService
 @inject IToastService ToastService
 @inject NavigationManager Navigation
 @inject ITourTreeService TourTreeService
 @inject ITextbeltApiService TextbeltApiService
 @inject ITourTreeEmailContentService TourTreeEmailContentService
 @inject ILogger<TourTreeDisplay> Logger
 @inject ITourGuideDefaultsApiService TourGuideDefaultsApi
*@

 <div id="tourTreeMainContainer" class="container-fluid">
    <!-- Main Tour Tree Display -->
    <div id="tourTreeMainRow" class="row">
        <div id="tourTreeMainColumn" class="col-12">
            <div id="tourTreeCard" class="card">
                <div id="tourTreeCardHeader" class="card-header py-2">
                    <div id="tourTreeHeaderContent" class="d-flex justify-content-between align-items-center">
                        <div id="tourTreeHeaderLeft" class="d-flex align-items-center">
                          @*   <i class="bi bi-diagram-3 me-2"></i> *@
                            <ShapedTreeFilterPanel Args="@Args" OnApply="OnApply" Toolbar="true" VendorOptions="VendorFilterOptions" />
                        </div>
                        <div id="tourTreeHeaderRight" class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-warning btn-sm" style="padding:.15rem .4rem; font-size:.8rem;"
                                    title="Message confirmed walkers for a tour"
                                    @onclick="OpenMessageWalkersDialog"
                                    disabled="@(!(TourData?.TreeNodes?.Any() == true))">
                                <i class="bi bi-people-fill me-1"></i>Msg Walkers
                            </button>
                            @if (OnOpenGuideManagement.HasDelegate)
                            {
                                <button class="btn btn-outline-primary btn-sm" style="padding:.15rem .4rem; font-size:.8rem;" @onclick="(() => OnOpenGuideManagement.InvokeAsync())" title="Manage Guides">
                                    <i class="bi bi-people me-1"></i>Guides
                                </button>
                            }
                            @if (OnOpenMessageManagement.HasDelegate)
                            {
                                <button class="btn btn-outline-info btn-sm" style="padding:.15rem .4rem; font-size:.8rem;" @onclick="(() => OnOpenMessageManagement.InvokeAsync())" title="Manage Messages">
                                    <i class="bi bi-chat-text me-1"></i>Messages
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-info btn-sm" style="padding:.15rem .4rem; font-size:.8rem;" @onclick="OpenMessageManagementDialog" title="Manage Messages">
                                    <i class="bi bi-chat-text me-1"></i>Messages
                                </button>
                            }
                            @if (OnDataRefresh.HasDelegate)
                            {
                                <button class="btn btn-outline-primary btn-sm" style="padding:.15rem .4rem; font-size:.8rem;" @onclick="(() => OnDataRefresh.InvokeAsync())" title="Refresh Tour Data">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                                </button>
                            }
                            
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm ms-2" role="status"></span>
                            }
                            <div id="tourTreeWhatsAppToggleContainer" class="form-check form-switch m-0 d-flex align-items-center" title="Quick WhatsApp uses App when enabled">
                                <input class="form-check-input" type="checkbox" id="waAppQuickToggle" @bind="useWhatsAppAppQuickSend" />
                                <label class="form-check-label small ms-1" for="waAppQuickToggle">WA App</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tourTreeCardBody" class="card-body">
                    @if (IsLoading)
                    {
                        <div id="tourTreeLoadingContainer" class="text-center py-5">
                            <div id="tourTreeLoadingSpinner" class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h5 class="mt-3">Loading Tour Data</h5>
                            <p class="text-muted">Please wait while we retrieve and process the tour information...</p>
                        </div>
                    }
                    else if (TourData?.TreeNodes?.Any() == true)
                    {
                        <div id="tourTreeContainer" class="tour-tree-container">
                            @foreach (var dateNode in TourData.TreeNodes)
                            {
                                <div class="tour-date-group mb-4">
                                    <div class="tour-date-header d-flex align-items-center justify-content-between" @onclick="() => ToggleNode(dateNode)">
                                        <div class="d-flex align-items-center">
                                            <div class="tree-icon-wrapper">
                                                <i class="bi @(dateNode.IsExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                                                <i class="bi @(dateNode.Icon) text-primary me-2"></i>
                                            </div>
                                            <span class="fw-bold">@dateNode.Label</span>
                                            @if (dateNode.DailyGuestCount.HasValue && dateNode.DailyGuestCount > 0)
                                            {
                                                <span class="badge bg-secondary rounded-pill ms-3">@dateNode.DailyGuestCount guests</span>
                                            }
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-info"
                                                    @onclick="() => OpenDayMessageLogDialog(dateNode)"
                                                    @onclick:stopPropagation="true"
                                                    title="View day message log">
                                                <i class="bi bi-chat-square-quote-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info"
                                                    @onclick="() => DownloadVcardsForDay(dateNode)"
                                                    @onclick:stopPropagation="true"
                                                    title="Download vCards for all walkers on this day">
                                                <i class="bi bi-person-vcard"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => CopyWalkerInfoForDay(dateNode)"
                                                    @onclick:stopPropagation="true"
                                                    title="Copy all walker info for this day">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </div>
                                    
                                    @if (dateNode.IsExpanded)
                                    {
                                        <div class="tour-date-content ms-4">
                                            @foreach (var tourNode in dateNode.Children)
                                            {
                                                var hasSubmittedReportForTour = HasSubmittedGuideReportForTour(tourNode);
                                                var isGuideReportPastDueForTour = IsGuideReportPastDueForTour(dateNode.Label, tourNode.Label);
                                                var hasGuideGalleryInDbForTour = HasGuideGalleryInDbForTour(tourNode);
                                                var guideReportPublicIdForTour = GetGuideReportPublicIdForTour(tourNode);
                                                var guideReportGalleryUrlForTour = BuildGuideReportGalleryUrl(guideReportPublicIdForTour);
                                                <div class="tour-group mb-3">
                                                    <div class="tour-header d-flex align-items-center justify-content-between" @onclick="() => ToggleNode(tourNode)">
                                                        <div class="d-flex align-items-center">
                                                            <i class="bi @(tourNode.IsExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                                                            <i class="bi @tourNode.Icon me-2"></i>
                                                            <strong>@tourNode.Label</strong>
                                                            @if (OnAddBookingFromTour.HasDelegate)
                                                            {
                                                                <button class="btn btn-sm p-0 border-0 bg-transparent text-success ms-2"
                                                                        title="Add booking for this tour/date"
                                                                        aria-label="Add booking for this tour/date"
                                                                        @onclick="() => OpenAddBookingForTourAsync(dateNode.Label, tourNode)"
                                                                        @onclick:stopPropagation="true">
                                                                    <i class="bi bi-plus-lg"></i>
                                                                </button>
                                                            }
                                                            @if (hasSubmittedReportForTour)
                                                            {
                                                                <i class="bi bi-pencil-fill text-info ms-2" style="font-size: 1.1rem;" title="Guide report submitted"></i>
                                                            }
                                                            else if (isGuideReportPastDueForTour)
                                                            {
                                                                <button class="btn btn-link btn-sm p-0 ms-2 text-warning align-baseline"
                                                                        title="Guide report not submitted. Open guide report for this tour."
                                                                        aria-label="Open guide report for this tour"
                                                                        @onclick="() => OpenGuideReportForTour(dateNode.Label, tourNode.Label)"
                                                                        @onclick:stopPropagation="true">
                                                                    <i class="bi bi-pencil" style="font-size: 1.1rem;"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                        <div class="d-flex gap-1">
                                                            <button class="btn btn-sm @(IsBlankQuickSendEnabled(dateNode.Label, tourNode.Label) ? "btn-success" : "btn-outline-secondary")"
                                                                    title="@(IsBlankQuickSendEnabled(dateNode.Label, tourNode.Label) ? "Blank quick-send ON: quick SMS/WhatsApp opens with no preset message." : "Blank quick-send OFF: quick SMS/WhatsApp uses selected template.")"
                                                                    @onclick="() => ToggleBlankQuickSendForTour(dateNode.Label, tourNode.Label)"
                                                                    @onclick:stopPropagation="true">
                                                                <i class="bi bi-justify-left"></i>
                                                            </button>
                                                            <select class="form-select form-select-sm" style="width: 200px;" title="Guide Selection"
                                                                    value="@(selectedGuideIdByTour.TryGetValue(GetTourKey(dateNode.Label, tourNode.Label), out var gid) && gid.HasValue ? gid.Value.ToString() : string.Empty)"
                                                                    @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => OnGuideSelected(dateNode.Label, tourNode.Label, e.Value?.ToString()))"
                                                                    @onclick="() => {}" @onclick:stopPropagation="true">
                                                                <option value="" hidden></option>
                                                                @if (DbGuides != null && DbGuides.Count > 0)
                                                                {
                                                                    foreach (var g in DbGuides.OrderBy(x => x.FirstName).ThenBy(x => x.LastName))
                                                                    {
                                                                        var label = string.IsNullOrWhiteSpace(g.LastName) ? g.FirstName : ($"{g.FirstName} {g.LastName}");
                                                                        <option value="@g.Id">@label</option>
                                                                    }
                                                                }
                                                            </select>

                                                            <select class="form-select form-select-sm" style="width: 200px;" title="Message Template"
                                                                    value="@(selectedMessageIdByTour.TryGetValue(GetTourKey(dateNode.Label, tourNode.Label), out var mid) && !string.IsNullOrWhiteSpace(mid) ? mid : string.Empty)"
                                                                    @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => OnMessageSelected(dateNode.Label, tourNode.Label, e.Value?.ToString()))"
                                                                    @onclick="() => {}" @onclick:stopPropagation="true">
                                                                <option value="" hidden></option>
                                                                @if (InMemoryMessages != null && InMemoryMessages.Count > 0)
                                                                {
                                                                    foreach (var m in InMemoryMessages.OrderBy(x => x.Name))
                                                                    {
                                                                        <option value="@m.Id">@m.Name</option>
                                                                    }
                                                                }
                                                            </select>
                                                            @if (hasSubmittedReportForTour)
                                                            {
                                                                @if (hasGuideGalleryInDbForTour && !string.IsNullOrWhiteSpace(guideReportGalleryUrlForTour))
                                                                {
                                                                    <a class="btn btn-sm btn-success"
                                                                       href="@guideReportGalleryUrlForTour"
                                                                       target="_blank"
                                                                       rel="noopener"
                                                                       title="Open submitted report gallery"
                                                                       @onclick:stopPropagation="true">
                                                                        <i class="bi bi-images"></i>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <button class="btn btn-sm btn-danger"
                                                                            title="Report submitted but gallery link is missing in database. Open guide report."
                                                                            @onclick="() => OpenGuideReportForTour(dateNode.Label, tourNode.Label)"
                                                                            @onclick:stopPropagation="true">
                                                                        <i class="bi bi-images"></i>
                                                                    </button>
                                                                }
                                                            }
                                                            <button class="btn btn-sm btn-outline-info" @onclick="() => DownloadVcardsForTour(tourNode)" @onclick:stopPropagation="true" title="Download vCards for all walkers">
                                                                <i class="bi bi-person-vcard"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyWalkerInfo(tourNode)" @onclick:stopPropagation="true" title="Copy">
                                                                <i class="bi bi-clipboard"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => OpenBulkSmsDialog(tourNode)" @onclick:stopPropagation="true" title="Send bulk SMS to guide">
                                                                <i class="bi bi-chat-dots-fill"></i>
                                                            </button>
                                                            @* <button class="btn btn-sm btn-outline-info" @onclick="() => OpenPhotoDialog(tourNode, dateNode)" @onclick:stopPropagation="true" title="Upload/view group photo">
                                                                <i class="bi bi-camera-fill"></i>
                                                            </button> *@
                                                        </div>
                                                    </div>
                                                    
                                                    @if (tourNode.IsExpanded)
                                                    {
                                                        <div class="tour-content ms-4">
                                                            @foreach (var vendorNode in tourNode.Children)
                                                            {
                                                                <div class="vendor-group mb-2">
                                                                    <div class="vendor-header" @onclick="() => ToggleNode(vendorNode)">
                                                                        <i class="bi @(vendorNode.IsExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                                                                        <i class="bi @vendorNode.Icon me-2"></i>
                                                                        <strong>@vendorNode.Label</strong>
                                                                    </div>
                                                                    
                                                                    @if (vendorNode.IsExpanded)
                                                                    {
                                                                        <div class="vendor-content ms-4">
                                                                            @foreach (var walkerNode in vendorNode.Children)
                                                                            {
                                                                                @* 2025-11-18: Get status directly from WalkerData (Email project uses ShapedWalkerData) *@
                                                                                var statusClass = walkerNode.WalkerData?.StatusClass ?? "";
                                                                                var statusIcon = walkerNode.WalkerData?.StatusIcon ?? "";
                                                                                var statusTitle = walkerNode.WalkerData?.StatusTitle ?? "";
                                                                                
                                                                                @* Fallback: Determine status if not pre-calculated *@
                                                                                if (string.IsNullOrEmpty(statusClass) && walkerNode.WalkerData != null)
                                                                                {
                                                                                    if (walkerNode.WalkerData.IsCancellation)
                                                                                    {
                                                                                        statusClass = "cancelled";
                                                                                        statusIcon = "bi-x-circle-fill";
                                                                                        statusTitle = "Cancelled";
                                                                                    }
                                                                                    else if (walkerNode.WalkerData.IsConfirmation || walkerNode.WalkerData.Status?.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) == true)
                                                                                    {
                                                                                        statusClass = "confirmed";
                                                                                        statusIcon = "bi-check-circle-fill";
                                                                                        statusTitle = "Confirmed";
                                                                                    }
                                                                                }
                                                                                
                                                                                var hasPhone = !string.IsNullOrEmpty(walkerNode.WalkerData?.DisplayPhone);
                                                                                
                                                                                <div class="walker-item p-2 rounded mb-1 d-flex align-items-center justify-content-between @statusClass" @onclick="() => SelectWalker(walkerNode)">
                                                                                    <div class="d-flex align-items-center">
                                                                                        <i class="bi @walkerNode.Icon me-2"></i>
                                                                                        <span>@walkerNode.Label</span>
                                                                                        @if (IsManualWalkerEntry(walkerNode))
                                                                                        {
                                                                                            <span class="badge text-bg-info ms-2" title="Manual booking (MessageId starts with MANUAL-)">MANUAL-</span>
                                                                                        }
                                                                                        @if (walkerNode.WalkerData?.IsCheckedIn == true)
                                                                                        {
                                                                                            <i class="bi bi-person-check-fill text-success ms-2" style="font-size: 1.1rem;" title="Checked in"></i>
                                                                                        }
                                                                                        @* 2025-12-10 00:00 UTC - Message status buttons temporarily disabled per request
                                                                                        @{
                                                                                            var sent = walkerNode.WalkerData?.MessageSent == true;
                                                                                            var iconColorClass = sent ? "text-success" : "text-warning";
                                                                                            var toggleTitle = sent ? "Mark as not sent" : "Mark as sent";
                                                                                        }
                                                                                        <button type="button"
                                                                                                class="btn btn-link btn-sm p-0 ms-2"
                                                                                                title="@toggleTitle"
                                                                                                @onclick="(e) => ToggleMessageSentAsync(walkerNode)"
                                                                                                @onclick:stopPropagation="true">
                                                                                            <i class="bi bi-chat-text-fill @iconColorClass"></i>
                                                                                        </button>
                                                                                        <div class="d-flex align-items-center ms-2 flex-wrap" style="gap:4px;">
                                                                                            @foreach (var stage in stageOrder)
                                                                                            {
                                                                                                Email.TourTreeViewShapedData.Models.MessageStageStatus? st = null;
                                                                                                var hasStage = walkerNode.WalkerData?.MessageStages != null && walkerNode.WalkerData.MessageStages.TryGetValue(stage, out st);
                                                                                                var sentStage = hasStage && (st?.SentFlag == true);
                                                                                                var badgeClass = sentStage ? "badge bg-success" : "badge bg-warning text-dark";
                                                                                                var title = $"{stage} - {(sentStage ? "sent" : "not sent")}";
                                                                                                <button type="button"
                                                                                                        class="btn btn-link btn-sm p-0"
                                                                                                        title="@title"
                                                                                                        @onclick="(e) => ToggleMessageStageAsync(walkerNode, stage)"
                                                                                                        @onclick:stopPropagation="true">
                                                                                                    <span class="@badgeClass" style="min-width:20px; display:inline-block;">@GetStageAbbreviation(stage)</span>
                                                                                                </button>
                                                                                            }
                                                                                        </div>
                                                                                        *@
                                                                                        
                                                                                    </div>
                                                                                    <div class="d-flex gap-1 align-items-start">
                                                                                        @* TODO: Walker-level action buttons to be implemented
                                                                                        *@
                                                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => CopyConnectMessageToClipboard(walkerNode, dateNode)" @onclick:stopPropagation="true" title="Copy connect message">
                                                                                            <i class="bi bi-clipboard"></i>
                                                                                        </button>
                                                                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => OpenEditDialog(walkerNode, vendorNode, tourNode)" @onclick:stopPropagation="true" title="Edit booking details">
                                                                                            <i class="bi bi-pencil-square"></i>
                                                                                        </button>
                                                                                        <button class="btn btn-sm btn-outline-info" @onclick="(e) => DownloadIndividualVcard(e, walkerNode)" @onclick:stopPropagation="true" title="Download vCard for this walker">
                                                                                            <i class="bi bi-person-vcard"></i>
                                                                                        </button>
                                                                                        @* <button class="btn btn-sm @(hasPhone ? "btn-outline-primary" : "btn-outline-secondary")" @onclick="() => OpenSmsDialog(walkerNode, vendorNode, tourNode)" @onclick:stopPropagation="true" disabled="@(!hasPhone)" title="@(hasPhone ? "Send SMS message" : "No phone number available")">
                                                                                            <i class="bi bi-chat-dots"></i>
                                                                                        </button> *@
                                                                                         @{
                                                                                             var smsToggleBusy = IsContactStateBusy(walkerNode.WalkerData, ContactChannelSms);
                                                                                         }
                                                                                         <div class="d-flex flex-column align-items-center">
                                                                                             <a class="btn btn-sm @(hasPhone ? "btn-outline-info" : "btn-outline-secondary") @(!hasPhone ? "disabled" : "")"
                                                                                                href="@GetQuickSmsUrl(walkerNode, vendorNode, tourNode)"
                                                                                                @onclick='() => TrackQuickSend(walkerNode, vendorNode, tourNode, "sms")'
                                                                                                @onclick:stopPropagation="true"
                                                                                                title="@(hasPhone ? "Quick send SMS" : "No phone number available")">
                                                                                                 <i class="bi bi-chat-dots"></i>
                                                                                             </a>
                                                                                             <button class="btn btn-link btn-sm p-0 mt-1 @(smsToggleBusy ? "disabled" : "")"
                                                                                                     title="@GetContactStateToggleTitle(ContactChannelSmsLabel, walkerNode.WalkerData?.SmsContactState ?? (byte)0)"
                                                                                                     disabled="@smsToggleBusy"
                                                                                                     @onclick="() => ToggleBookingContactChannelStateAsync(walkerNode, ContactChannelSms)"
                                                                                                     @onclick:stopPropagation="true">
                                                                                                 <i class="bi bi-circle-fill @GetContactStateColorClass(walkerNode.WalkerData?.SmsContactState ?? (byte)0)"></i>
                                                                                             </button>
                                                                                         </div>
                                                                                        @* <button class="btn btn-sm @(hasPhone ? "btn-outline-success" : "btn-outline-secondary")" @onclick="() => OpenWhatsAppDialog(walkerNode, vendorNode, tourNode)" @onclick:stopPropagation="true" disabled="@(!hasPhone)" title="@(hasPhone ? "Send WhatsApp message" : "No phone number available")">
                                                                                            <i class="bi bi-whatsapp"></i>
                                                                                        </button> *@
                                                                                         @{
                                                                                             var waToggleBusy = IsContactStateBusy(walkerNode.WalkerData, ContactChannelWa);
                                                                                         }
                                                                                         <div class="d-flex flex-column align-items-center">
                                                                                             <a class="btn btn-sm @(hasPhone ? "btn-outline-success" : "btn-outline-secondary") @(!hasPhone ? "disabled" : "")"
                                                                                                href="@GetQuickWhatsAppUrl(walkerNode, vendorNode, tourNode)"
                                                                                                @onclick='() => TrackQuickSend(walkerNode, vendorNode, tourNode, "wa")'
                                                                                                @onclick:stopPropagation="true"
                                                                                                title="@(hasPhone ? "Quick send WhatsApp message" : "No phone number available")">
                                                                                                 <i class="bi bi-whatsapp"></i>
                                                                                             </a>
                                                                                             <button class="btn btn-link btn-sm p-0 mt-1 @(waToggleBusy ? "disabled" : "")"
                                                                                                     title="@GetContactStateToggleTitle(ContactChannelWaLabel, walkerNode.WalkerData?.WaContactState ?? (byte)0)"
                                                                                                     disabled="@waToggleBusy"
                                                                                                     @onclick="() => ToggleBookingContactChannelStateAsync(walkerNode, ContactChannelWa)"
                                                                                                     @onclick:stopPropagation="true">
                                                                                                 <i class="bi bi-circle-fill @GetContactStateColorClass(walkerNode.WalkerData?.WaContactState ?? (byte)0)"></i>
                                                                                             </button>
                                                                                         </div>
                                                                                         @{
                                                                                             var platformToggleBusy = IsContactStateBusy(walkerNode.WalkerData, ContactChannelPlatform);
                                                                                         }
                                                                                          <button class="btn btn-sm btn-outline-secondary @(platformToggleBusy ? "disabled" : "")"
                                                                                                  title="@GetPlatformContactToggleTitle(walkerNode.WalkerData?.PlatformContactState ?? (byte)0)"
                                                                                                  disabled="@platformToggleBusy"
                                                                                                  @onclick="() => ToggleBookingContactChannelStateAsync(walkerNode, ContactChannelPlatform)"
                                                                                                  @onclick:stopPropagation="true">
                                                                                              <i class="@GetPlatformContactIconClass(walkerNode.WalkerData?.PlatformContactState ?? (byte)0)"></i>
                                                                                          </button>
                                                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEmailDialog(walkerNode)" @onclick:stopPropagation="true" title="View email">
                                                                                            <i class="bi bi-envelope"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (!IsLoading)
                    {
                        <div id="tourTreeEmptyState" class="text-center py-5">
                            <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
                            <h5 class="mt-3">No Tour Data Available</h5>
                            <p class="text-muted">No tour data is currently available to display.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* TODO: Dialog components to be migrated in future planning docs
<!-- Template Dialog Component -->
<TemplateDialog 
    IsVisible="showTemplateDialog"
    IsVisibleChanged="@((bool value) => showTemplateDialog = value)"
    OnTemplateSelected="OnTemplateSelected"
    WalkerInfo="selectedWalkerInfo"
    TourName="@(selectedWalkerInfo?.TourName ?? "")"
    TourDate="@(selectedWalkerInfo?.TourDate ?? "")"
    VendorName="@(selectedWalkerInfo?.VendorName ?? "")" />
*@

<!-- Email Dialog -->
<TourTreeEmailDialog 
    showDialog="@showEmailDialog" 
    emailContent="@emailContent" 
    isLoading="@isEmailLoading" 
    OnClose="CloseEmailDialog" />

<!-- Edit Dialog -->
@if (showEditDialog)
{
    <div id="editDialogModal" class="modal fade show" style="display: block;" tabindex="-1">
        <div id="editDialogModalDialog" class="modal-dialog" style="max-width: fit-content;">
            <div id="editDialogModalContent" class="modal-content">
                <div id="editDialogHeader" class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>
                        Edit Booking Details
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditDialog"></button>
                </div>
                <div id="editDialogBody" class="modal-body">
                    @if (isEditLoading)
                    {
                        <div id="editDialogLoadingContainer" class="text-center py-4">
                            <div id="editDialogLoadingSpinner" class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading booking details...</p>
                        </div>
                    }
                    else if (selectedProcessedEmail != null)
                    {
                        <div id="editDialogFormRow1" class="row">
                            <div id="editDialogFormLeftColumn" class="col-md-6">
                                <div id="editDialogCustomerNameField" class="mb-2">
                                    <label class="form-label">Customer Name</label>
                                    <input type="text" class="form-control form-control-sm" @bind="selectedProcessedEmail.CustomerName" />
                                </div>
                                <div id="editDialogCustomerEmailField" class="mb-2">
                                    <label class="form-label">Customer Email</label>
                                    <input type="email" class="form-control form-control-sm" @bind="selectedProcessedEmail.CustomerEmail" />
                                </div>
                                <div id="editDialogCustomerPhoneField" class="mb-2">
                                    <label class="form-label">Customer Phone</label>
                                    <input type="tel" class="form-control form-control-sm" @bind="selectedProcessedEmail.CustomerPhone" />
                                </div>
                                <div id="editDialogNumberOfAttendeesField" class="mb-2">
                                    <label class="form-label">Number of Attendees</label>
                                    <input type="number" class="form-control form-control-sm" @bind="selectedProcessedEmail.NumberOfAttendees" />
                                </div>
                                <div id="editDialogNumberOfAdultsField" class="mb-2">
                                    <label class="form-label">Number of Adults</label>
                                    <input type="number" class="form-control form-control-sm" @bind="selectedProcessedEmail.NumberOfAdults" />
                                </div>
                                <div id="editDialogNumberOfChildrenField" class="mb-2">
                                    <label class="form-label">Number of Children</label>
                                    <input type="number" class="form-control form-control-sm" @bind="selectedProcessedEmail.NumberOfChildren" />
                                </div>
                                <div id="editDialogSpecialRequestsField" class="mb-2">
                                    <label class="form-label">Special Requests</label>
                                    <textarea class="form-control form-control-sm" rows="4" @bind="selectedProcessedEmail.BookingAlterationNotes"></textarea>
                                </div>
                                <div id="editDialogIssueReportField" class="mb-2">
                                    <label class="form-label text-danger">Booking Error / Issue</label>
                                    <div class="position-relative">
                                        <textarea class="form-control form-control-sm border border-danger pe-5"
                                                  rows="3"
                                                  style="min-height: 95px;"
                                                  @bind="editReportIssueNotes"
                                                  placeholder="Describe booking error or issue for developer review"></textarea>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger position-absolute bottom-0 end-0 m-1"
                                                title="Report booking issue"
                                                @onclick="SubmitEditIssueFromEditDialog"
                                                @onclick:stopPropagation="true"
                                                disabled="@isSubmittingEditIssue">
                                            <i class="bi bi-exclamation-octagon"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div id="editDialogFormRightColumn" class="col-md-6">
                                <div id="editDialogTourNameField" class="mb-2">
                                    <label class="form-label">Tour Name</label>
                                    <select class="form-select form-select-sm"
                                            value="@selectedProcessedEmail?.TourName"
                                            @onchange="OnEditTourNameChanged">
                                        @if (availableTourNames.Count == 0)
                                        {
                                            <option value="">No tours available</option>
                                        }
                                        else
                                        {
                                            @foreach (var tourName in availableTourNames)
                                            {
                                                <option value="@tourName">@tourName</option>
                                            }
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(selectedProcessedEmail?.TourName))
                                    {
                                        <small class="form-text text-muted">Current: @selectedProcessedEmail.TourName</small>
                                    }
                                </div>
                                <div id="editDialogTourDateField" class="mb-2">
                                    <label class="form-label">Tour Date</label>
                                    <input type="date" class="form-control form-control-sm"
                                           value="@(GetDateValue(selectedProcessedEmail?.TourDate))"
                                           @onchange="OnEditTourDateChanged" />
                                </div>
                                <div id="editDialogTourTimeField" class="mb-2">
                                    <label class="form-label">Tour Time</label>
                                    <select class="form-select form-select-sm"
                                            value="@selectedProcessedEmail?.TourTime"
                                            @onchange="OnEditTourTimeChanged">
                                        @if (editTimeOptions.Count == 0)
                                        {
                                            <option value="" disabled>No time options found</option>
                                        }
                                        else
                                        {
                                            @foreach (var time in editTimeOptions)
                                            {
                                                <option value="@time">@time</option>
                                            }
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(selectedProcessedEmail?.TourTime))
                                    {
                                        <small class="form-text text-muted">Current: @selectedProcessedEmail.TourTime</small>
                                    }
                                </div>
                                <div id="editDialogTourLocationField" class="mb-2">
                                    <label class="form-label">Tour Location</label>
                                    <input type="text" class="form-control form-control-sm" @bind="selectedProcessedEmail.TourLocation" />
                                </div>
                                <div id="editDialogVendorNameField" class="mb-2">
                                    <label class="form-label">Vendor Name</label>
                                    <select class="form-select form-select-sm"
                                            value="@selectedProcessedEmail?.VendorName"
                                            @onchange="OnEditVendorChanged"
                                            disabled="@IsEditWalkUpVendor()">
                                        @if (editVendorOptions.Count == 0)
                                        {
                                            <option value="@selectedProcessedEmail?.VendorName">@selectedProcessedEmail?.VendorName</option>
                                        }
                                        else
                                        {
                                            @foreach (var vendorName in editVendorOptions)
                                            {
                                                <option value="@vendorName">@vendorName</option>
                                            }
                                        }
                                    </select>
                                    @if (IsEditWalkUpVendor())
                                    {
                                        <small class="form-text text-muted">Walk-Up vendor is locked.</small>
                                    }
                                </div>
                                <div id="editDialogEmailTypeField" class="mb-2">
                                    <label class="form-label">Email Type</label>
                                    <select class="form-select form-select-sm" @bind="selectedProcessedEmail.EmailType" @bind:event="onchange">
                                        <option value="booking">Booking</option>
                                        <option value="modification">Modification</option>
                                        <option value="cancellation">Cancellation</option>
                                        <option value="other">Other</option>
                                    </select>
                                </div>
                                <div id="editDialogLanguageField" class="mb-2">
                                    <label class="form-label">Language</label>
                                    <input type="text" class="form-control form-control-sm" @bind="selectedProcessedEmail.Language" />
                                </div>
                                <div id="editDialogBookingCodeField" class="mb-2">
                                    <label class="form-label">Booking Code</label>
                                    <input type="text" class="form-control form-control-sm" @bind="selectedProcessedEmail.BookingCode" readonly />
                                </div>
                            </div>
                        </div>
                        <div id="editDialogFormActions" class="row mt-2">
                            <div class="col-12 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseEditDialog">Cancel</button>
                                <button type="button" class="btn btn-warning btn-sm" @onclick="SaveEditChanges">
                                    <i class="bi bi-check-lg me-1"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div id="editDialogFooter" class="modal-footer" style="display: none;">
                </div>
            </div>
        </div>
    </div>
    <div id="editDialogBackdrop" class="modal-backdrop fade show"></div>
}
@* iPhone manual copy dialog (align with Workstation) *@
@if (showCopyDialog)
{
