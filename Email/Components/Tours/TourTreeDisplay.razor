                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.TourLocation ?? "—")</div>
                                    <input type="text" class="form-control form-control-sm" @bind="reportEditedEmail.TourLocation" />
                                </div>
                                <div id="reportDialogVendorNameField" class="mb-2">
                                    <label class="form-label">Vendor Name</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.VendorName ?? "—")</div>
                                    <input type="text" class="form-control form-control-sm" @bind="reportEditedEmail.VendorName" readonly />
                                </div>
                                <div id="reportDialogEmailTypeField" class="mb-2">
                                    <label class="form-label">Email Type</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.EmailType ?? "—")</div>
                                    <select class="form-select form-select-sm" @bind="reportEditedEmail.EmailType" @bind:event="onchange">
                                        <option value="booking">Booking</option>
                                        <option value="modification">Modification</option>
                                        <option value="cancellation">Cancellation</option>
                                        <option value="other">Other</option>
                                    </select>
                                </div>
                                <div id="reportDialogLanguageField" class="mb-2">
                                    <label class="form-label">Language</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.Language ?? "—")</div>
                                    <input type="text" class="form-control form-control-sm" @bind="reportEditedEmail.Language" />
                                </div>
                                <div id="reportDialogBookingCodeField" class="mb-2">
                                    <label class="form-label">Booking Code</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.BookingCode ?? "—")</div>
                                    <input type="text" class="form-control form-control-sm" @bind="reportEditedEmail.BookingCode" readonly />
                                </div>
                            </div>
                        </div>
                        <div id="reportDialogFormActions" class="row mt-2">
                            <div class="col-12 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseReportDialog">Cancel</button>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="SubmitReport">
                                    <i class="bi bi-flag-fill me-1"></i>Submit Report
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div id="reportDialogFooter" class="modal-footer" style="display: none;">
                </div>
            </div>
        </div>
    </div>
    <div id="reportDialogBackdrop" class="modal-backdrop fade show"></div>
}
