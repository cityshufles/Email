<!-- WhatsApp Dialog -->
@if (showWhatsAppDialog)
{
    <div id="whatsAppDialogModal" class="modal fade show" style="display: block;" tabindex="-1">
        <div id="whatsAppDialogModalDialog" class="modal-dialog modal-lg">
            <div id="whatsAppDialogModalContent" class="modal-content">
                <div id="whatsAppDialogHeader" class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-whatsapp me-2 text-success"></i>
                        Send WhatsApp Message
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseWhatsAppDialog"></button>
                </div>
                <div id="whatsAppDialogBody" class="modal-body">
                    <div id="whatsAppDialogInfoRow" class="row">
                        <div id="whatsAppDialogWalkerInfoColumn" class="col-md-6">
                            <h6>Walker Information</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Name:</strong></td>
                                    <td>@selectedWalkerInfo.Name</td>
                                </tr>
                                <tr>
                                    <td><strong>Phone:</strong></td>
                                    <td>
                                        <a href="tel:@selectedWalkerInfo.Phone" class="text-decoration-none">@selectedWalkerInfo.Phone</a>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Attendees:</strong></td>
                                    <td>@(selectedWalkerInfo.Attendees?.ToString() ?? "N/A")</td>
                                </tr>
                            </table>
                        </div>
                        <div id="whatsAppDialogTourInfoColumn" class="col-md-6">
                            <h6>Tour Information</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Tour:</strong></td>
                                    <td>@selectedWalkerInfo.TourName</td>
                                </tr>
                                <tr>
                                    <td><strong>Date:</strong></td>
                                    <td>@selectedWalkerInfo.TourDate</td>
                                </tr>
                                <tr>
                                    <td><strong>Vendor:</strong></td>
                                    <td>@selectedWalkerInfo.VendorName</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs mt-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="whatsapp-app-tab" data-bs-toggle="tab" data-bs-target="#whatsapp-app" type="button" role="tab" aria-controls="whatsapp-app" aria-selected="true" @onclick="() => SetActiveWhatsAppTab(0)">
                                <i class="bi bi-phone me-1"></i>WhatsApp App
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="whatsapp-web-tab" data-bs-toggle="tab" data-bs-target="#whatsapp-web" type="button" role="tab" aria-controls="whatsapp-web" aria-selected="false" @onclick="() => SetActiveWhatsAppTab(1)">
                                <i class="bi bi-globe me-1"></i>WhatsApp Web
                            </button>
                        </li>
                    </ul>
                    
                    <!-- Tab Content -->
                    <div class="tab-content mt-3" id="whatsAppTabContent">
                        <!-- WhatsApp App Tab -->
                        <div class="tab-pane fade show active" id="whatsapp-app" role="tabpanel" aria-labelledby="whatsapp-app-tab">
                            <div id="whatsAppAppMessageContainer" class="mb-3">
                                <div class="accordion mb-2" id="whatsAppAppDialogAccordion">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="whatsAppAppTemplateEditsHeader">
                                            <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#whatsAppAppTemplateEditsCollapse" aria-expanded="false" aria-controls="whatsAppAppTemplateEditsCollapse">
                                                Template Edits
                                            </button>
                                        </h2>
                                        <div id="whatsAppAppTemplateEditsCollapse" class="accordion-collapse collapse" aria-labelledby="whatsAppAppTemplateEditsHeader" data-bs-parent="#whatsAppAppDialogAccordion">
                                            <div class="accordion-body p-2">
                                                <div class="d-flex flex-wrap gap-1">
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("whatsAppAppMessage", "{walker}"))" title="Walker name"><i class="bi bi-person me-1"></i>{walker}</button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("whatsAppAppMessage", "{walkerFirst}"))" title="Walker first name"><i class="bi bi-person me-1"></i>{walkerFirst}</button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("whatsAppAppMessage", "{walkerLast}"))" title="Walker last name"><i class="bi bi-person me-1"></i>{walkerLast}</button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("whatsAppAppMessage", "{phone}"))" title="Contact phone"><i class="bi bi-telephone me-1"></i>{phone}</button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("whatsAppAppMessage", "{tour}"))" title="Tour name"><i class="bi bi-map me-1"></i>{tour}</button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("whatsAppAppMessage", "{date}"))" title="Tour date"><i class="bi bi-calendar me-1"></i>{date}</button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("whatsAppAppMessage", "{tourDayOfWeek}"))" title="Tour day of week"><i class="bi bi-calendar-week me-1"></i>{tourDayOfWeek}</button>
