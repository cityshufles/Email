                                <div id="reportDialogCustomerNameField" class="mb-2">
                                    <label class="form-label">Customer Name</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.CustomerName ?? "—")</div>
                                    <input type="text" class="form-control form-control-sm" @bind="reportEditedEmail.CustomerName" />
                                </div>
                                <div id="reportDialogCustomerEmailField" class="mb-2">
                                    <label class="form-label">Customer Email</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.CustomerEmail ?? "—")</div>
                                    <input type="email" class="form-control form-control-sm" @bind="reportEditedEmail.CustomerEmail" />
                                </div>
                                <div id="reportDialogCustomerPhoneField" class="mb-2">
                                    <label class="form-label">Customer Phone</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.CustomerPhone ?? "—")</div>
                                    <input type="tel" class="form-control form-control-sm" @bind="reportEditedEmail.CustomerPhone" />
                                </div>
                                <div id="reportDialogNumberOfAttendeesField" class="mb-2">
                                    <label class="form-label">Number of Attendees</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.NumberOfAttendees?.ToString() ?? "—")</div>
                                    <input type="number" class="form-control form-control-sm" @bind="reportEditedEmail.NumberOfAttendees" />
                                </div>
                                <div id="reportDialogNumberOfAdultsField" class="mb-2">
                                    <label class="form-label">Number of Adults</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.NumberOfAdults?.ToString() ?? "—")</div>
                                    <input type="number" class="form-control form-control-sm" @bind="reportEditedEmail.NumberOfAdults" />
                                </div>
                                <div id="reportDialogNumberOfChildrenField" class="mb-2">
                                    <label class="form-label">Number of Children</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.NumberOfChildren?.ToString() ?? "—")</div>
                                    <input type="number" class="form-control form-control-sm" @bind="reportEditedEmail.NumberOfChildren" />
                                </div>
                                <div id="reportDialogErrorNotesField" class="mb-2">
                                    <label class="form-label">Error Notes</label>
                                    <textarea class="form-control form-control-sm" rows="4" @bind="reportErrorNotes" placeholder="Describe what was wrong so the developer can fix it"></textarea>
                                </div>
                            </div>
                            <div id="reportDialogFormRightColumn" class="col-md-6">
                                <div id="reportDialogTourNameField" class="mb-2">
                                    <label class="form-label">Tour Name</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.TourName ?? "—")</div>
                                    <select class="form-select form-select-sm"
                                            value="@reportEditedEmail?.TourName"
                                            @onchange="OnReportTourNameChanged">
                                        @if (availableTourNames.Count == 0)
                                        {
                                            <option value="">No tours available</option>
                                        }
                                        else
                                        {
                                            @foreach (var tourName in availableTourNames)
                                            {
                                                <option value="@tourName">@tourName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div id="reportDialogTourDateField" class="mb-2">
