                <div id="messageManagementDialogBody" class="modal-body">
                    <div id="messageManagementDialogContentRow" class="row g-4">
                        <div id="messageManagementDialogLeftColumn" class="col-lg-6 col-md-12">
                            <div id="messageManagementDialogAddCard" class="card h-100">
                                <div id="messageManagementDialogAddCardHeader" class="card-header">
                                    <h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Message Template</h6>
                                </div>
                                <div id="messageManagementDialogAddCardBody" class="card-body">
                                    @if (!string.IsNullOrWhiteSpace(lastMessageError))
                                    {
                                        <div id="messageManagementDialogErrorAlert" class="alert alert-warning" role="alert">
                                            <strong>Message save failed:</strong> @lastMessageError
                                        </div>
                                    }
                                    <div id="messageManagementDialogNameField" class="mb-3">
                                        <label class="form-label">Message Name:</label>
                                        <input type="text" class="form-control" @bind="newMessageName" placeholder="Enter message name (e.g., Welcome, Reminder)" />
                                    </div>
                                    <div id="messageManagementDialogTypeField" class="mb-3">
                                        <label class="form-label d-flex align-items-center gap-2 mb-2">
                                            <span>Message Type:</span>
                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-sm"
                                                    title="Messaging help"
                                                    @onclick="OpenMessageHelp">
                                                <i class="bi bi-info-circle me-1"></i>Help
                                            </button>
                                        </label>
                                        <select class="form-select" @bind="newMessageType">
                                            <option value="">Select type...</option>
                                            <option value="welcome">Welcome Message</option>
                                            <option value="tomorrow">Tomorrow</option>
                                            <option value="dayOf">Day of</option>
                                            <option value="basedOnDate">Based on date</option>
                                            <option value="custom">Custom</option>
                                        </select>
                                    </div>
                                    <div id="messageManagementDialogTourField" class="mb-3">
                                        <label class="form-label">Tour (for template context):</label>
                                        <div id="messageManagementDialogTourRow" class="row g-2">
                                            <div id="messageManagementDialogTourSelectColumn" class="col-md-12">
                                                <select class="form-select"
                                                        value="@(newMessageTourId?.ToString() ?? (string.Equals(newMessageTourName, "All", StringComparison.OrdinalIgnoreCase) ? "ALL" : string.Empty))"
                                                        @onchange="@(e => { var val = e.Value?.ToString(); if (string.Equals(val, "ALL", StringComparison.OrdinalIgnoreCase)) { newMessageTourId = null; newMessageTourName = "All"; newMessageTourStartTime = null; messageTimeOptions = new List<string>(); } else { newMessageTourId = int.TryParse(val, out var id) ? id : null; OnMessageTourChanged(); } })">
                                                    <option value="">-- select tour --</option>
                                                    <option value="ALL">All tours</option>
                                                    @foreach (var tour in distinctToursForContext)
                                                    {
                                                        <option value="@tour.Id">@FormatTourLabel(tour)</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="messageManagementDialogGuideTimeRow" class="row g-2">
                                        <div id="messageManagementDialogGuideColumn" class="col-md-6">
                                            <label class="form-label">Guide (optional):</label>
                                            <select class="form-select" @bind="newMessageGuideId">
                                                <option value="">-- none --</option>
                                                @foreach (var g in availableDbGuides)
                                                {
                                                    <option value="@g.Id">@g.FirstName @g.LastName</option>
                                                }
                                            </select>
                                        </div>
                                        <div id="messageManagementDialogTimeColumn" class="col-md-6">
                                            <label class="form-label">Tour Start Time:</label>
                                            <select class="form-select"
                                                    value="@newMessageTourStartTime"
                                                    @onchange="OnMessageTourTimeChanged">
                                                @if (string.Equals(newMessageTourName, "All", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <option value="">(not required for All)</option>
                                                }
                                                else if (messageTimeOptions.Count == 0)
                                                {
                                                    <option value="" disabled>No times available</option>
                                                }
                                                else
                                                {
                                                    @foreach (var time in messageTimeOptions)
                                                    {
                                                        <option value="@time">@time</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div id="messageManagementDialogSignatureRow" class="row g-2 mt-2">
                                        <div id="messageManagementDialogSignatureColumn" class="col-md-8">
                                            <label class="form-label">Signature:</label>
                                            <input type="text" class="form-control" @bind="newMessageSignature" placeholder="e.g., - CityShuffles Team" />
                                        </div>
                                        <div id="messageManagementDialogActiveColumn" class="col-md-4 d-flex align-items-end">
                                            <div id="messageManagementDialogActiveSwitch" class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="msgIsActive" @bind="newMessageIsActive" />
                                                <label class="form-check-label" for="msgIsActive">Active</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="messageManagementDialogContentField" class="mb-3 mt-2">
                                        <div id="messageManagementDialogContentHeader" class="d-flex justify-content-between align-items-center">
                                            <label class="form-label mb-0">Message Content</label>
                                            <div id="messageManagementDialogContentTabs" class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-secondary @(messageEditorTab=="edit"?"active":null)" @onclick="SetMessageEditorTabToEdit">Edit</button>
                                                <button type="button" class="btn btn-outline-secondary @(messageEditorTab=="preview"?"active":null)" @onclick="SetMessageEditorTabToPreview">Preview</button>
                                            </div>
                                        </div>
                                        <div id="messageManagementDialogTemplateButtonsContainer" class="mb-2">
                                            <div id="messageManagementDialogTemplateButtons" class="d-flex flex-wrap gap-1 mb-2">
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{walker}"))" title="Walker name"><i class="bi bi-person me-1"></i>{walker}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{walkerFirst}"))" title="Walker first name"><i class="bi bi-person me-1"></i>{walkerFirst}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{walkerLast}"))" title="Walker last name"><i class="bi bi-person me-1"></i>{walkerLast}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{phone}"))" title="Contact phone"><i class="bi bi-telephone me-1"></i>{phone}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tour}"))" title="Tour name"><i class="bi bi-map me-1"></i>{tour}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{date}"))" title="Tour date"><i class="bi bi-calendar me-1"></i>{date}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tourDayOfWeek}"))" title="Tour day of week"><i class="bi bi-calendar-week me-1"></i>{tourDayOfWeek}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tourMonthAndDayOrdinal}"))" title="Tour month + day ordinal (e.g., December 9th)"><i class="bi bi-calendar2-day me-1"></i>{tourMonthAndDayOrdinal}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{monthOfTour}"))" title="Month of tour (e.g., December)"><i class="bi bi-calendar3 me-1"></i>{monthOfTour}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{displayDate}"))" title="Display date (raw)"><i class="bi bi-calendar-date me-1"></i>{displayDate}</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{displayDayOrdinal}"))" title="Display day ordinal (e.g., 9th)"><i class="bi bi-123 me-1"></i>{displayDayOrdinal}</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{displayTime}"))" title="Display time (raw)"><i class="bi bi-clock-history me-1"></i>{displayTime}</button>
                                                <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guide}"))" title="Guide full name"><i class="bi bi-person-badge me-1"></i>{guide}</button>
                                                <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guideFirstName}"))" title="Guide first name"><i class="bi bi-person me-1"></i>{guideFirstName}</button>
                                                <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guideLastName}"))" title="Guide last name"><i class="bi bi-person me-1"></i>{guideLastName}</button>
                                                <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guidePhone}"))" title="Guide phone"><i class="bi bi-telephone-plus me-1"></i>{guidePhone}</button>
                                                <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guideEmail}"))" title="Guide email"><i class="bi bi-envelope me-1"></i>{guideEmail}</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tourStartTime}"))" title="Tour start time"><i class="bi bi-clock me-1"></i>{tourStartTime}</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{meetingLocation}"))" title="Meeting location"><i class="bi bi-geo-alt me-1"></i>{meetingLocation}</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{meetingTime}"))" title="Meeting time"><i class="bi bi-clock-history me-1"></i>{meetingTime}</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tempMeetingTime}"))" title="Start -10 minutes (fallback from tour start)"><i class="bi bi-clock-history me-1"></i>start -10</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{startMinus10}"))" title="Alias of {tempMeetingTime}"><i class="bi bi-clock-history me-1"></i>{startMinus10}</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tempSignature}"))" title="Temp signature link (vendor-based)"><i class="bi bi-link-45deg me-1"></i>{tempSignature}</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{meetingInstructions}"))" title="Meeting instructions"><i class="bi bi-signpost me-1"></i>{meetingInstructions}</button>
                                                <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{vendorName}"))" title="Vendor name"><i class="bi bi-building me-1"></i>{vendorName}</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{vendorTourLink}"))" title="Vendor tour link placeholder"><i class="bi bi-link-45deg me-1"></i>{vendorTourLink}</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{vendorReviewLink}"))" title="Vendor review link placeholder"><i class="bi bi-link-45deg me-1"></i>{vendorReviewLink}</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{allToursLink}"))" title="All tours link placeholder"><i class="bi bi-link-45deg me-1"></i>{allToursLink}</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{galleryLink}"))" title="Gallery link placeholder"><i class="bi bi-images me-1"></i>{galleryLink}</button>
                                            </div>
                                        </div>

                                        @if (messageEditorTab == "edit")
                                        {
                                            <textarea class="form-control" rows="8" @bind="newMessageContent" id="newMessageContent" placeholder="Enter message content..."></textarea>
                                        }
                                        else
                                        {
                                            <div id="messageManagementDialogPreviewContent" class="form-control" style="height: auto; min-height: 12rem; white-space: pre-wrap;">
                                                @RenderMessagePreview()
                                            </div>
                                        }
                                    </div>

                                    <div id="messageManagementDialogDescriptionRow" class="row g-2">
                                        <div id="messageManagementDialogDescriptionColumn" class="col-md-12">
                                            <label class="form-label">Description (optional):</label>
                                            <input type="text" class="form-control" @bind="newMessageDescription" placeholder="Internal description" />
                                        </div>
                                    </div>

                                    <div id="messageManagementDialogActions" class="d-flex gap-2 mt-3">
                                        <button class="btn btn-success btn-sm" @onclick="AddMessageTemplate" disabled="@string.IsNullOrEmpty(newMessageName)">
                                            <i class="bi bi-check2-circle me-1"></i>
                                            @(editingMessageId.HasValue ? "Save Message" : "Add Message")
                                        </button>
                                        @if (editingMessageId.HasValue)
                                        {
                                            <button class="btn btn-secondary btn-sm" @onclick="CancelMessageEdit">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Cancel Edit
                                            </button>
                                        }
                                        <button class="btn btn-warning btn-sm" @onclick="ClearMessageForm">
                                            <i class="bi bi-eraser me-1"></i>
                                            Clear
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="messageManagementDialogRightColumn" class="col-lg-6 col-md-12">
                            <div id="messageManagementDialogListCard" class="card h-100">
                                <div id="messageManagementDialogListCardHeader" class="card-header">
                                    <h6 class="mb-0"><i class="bi bi-list-ul me-2"></i>Current Message Templates (@InMemoryMessages.Count)</h6>
                                </div>
                                <div id="messageManagementDialogListCardBody" class="card-body">
                                    @if (InMemoryMessages != null && InMemoryMessages.Any())
                                    {
                                        <div id="messageManagementDialogMessageList" class="list-group list-group-flush">
                                            @foreach (var message in InMemoryMessages)
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-start border-0 px-0" style="cursor:pointer;" @onclick="@(() => LoadMessageByInMemoryId(message.Id))">
                                                    <div class="flex-grow-1">
                                                        <strong>@message.Name</strong>
                                                        <span class="badge bg-secondary ms-2">@message.Type</span><br/>
                                                        <small class="text-muted">
                                                            @if (!string.IsNullOrEmpty(message.Description))
                                                            {
                                                                @message.Description<br/>
                                                            }
                                                            <div class="mt-2" style="max-height: 120px; overflow-y: auto; border: 1px solid var(--bs-border-color); border-radius: 4px; padding: 8px; background-color: var(--bs-secondary-bg);">
                                                                <pre style="margin: 0; white-space: pre-wrap; font-size: 0.875rem; color: var(--bs-secondary-color);">@message.Content</pre>
                                                            </div>
                                                        </small>
                                                    </div>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary btn-sm" @onclick="@(() => EditDbMessageTemplate(dbMessages.First(m => m.MessageName == message.Name)))" title="Edit message">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => RemoveDbMessageTemplate(dbMessages.First(m => m.MessageName == message.Name)))" title="Remove message">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div id="messageManagementDialogClearAllContainer" class="mt-3">
                                            <button class="btn btn-outline-danger btn-sm" @onclick="ClearAllMessages">
                                                <i class="bi bi-trash me-1"></i>
                                                Clear All Messages
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="messageManagementDialogEmptyState" class="alert alert-info mb-0">
                                            <i class="bi bi-info-circle me-2"></i>
                                            No messages added yet. Add your first message using the form on the left.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="messageManagementDialogFooter" class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMessageManagementDialog">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div id="messageManagementDialogBackdrop" class="modal-backdrop fade show"></div>
}

<!-- Message Walkers Dialog -->
@if (showMessageWalkersDialog)
{
    <div id="messageWalkersDialogModal" class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div id="messageWalkersDialogModalDialog" class="modal-dialog modal-xl">
            <div id="messageWalkersDialogModalContent" class="modal-content">
                <div id="messageWalkersDialogHeader" class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-people-fill me-2 text-warning"></i>
                        Message Walkers
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseMessageWalkersDialog"></button>
                </div>
                <div id="messageWalkersDialogBody" class="modal-body">
                    <div id="messageWalkersDialogRow" class="row g-4">
                        <div id="messageWalkersDialogLeftColumn" class="col-lg-8 col-md-12">
                            <div class="card h-100">
                                <div class="card-header py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <label class="form-label mb-0">Date:</label>
                                        <input type="date" class="form-control form-control-sm" style="max-width: 180px;"
                                               value="@messageWalkersDate.ToString("yyyy-MM-dd")"
                                               @onchange="OnMessageWalkersDateChanged" />
                                        <label class="form-label mb-0 ms-2">Tour:</label>
                                        <select class="form-select form-select-sm"
                                                value="@(messageWalkersAllToursSelected ? "ALL" : (messageWalkersSelectedTour?.Label ?? string.Empty))"
                                                @onchange="OnMessageWalkersTourChanged">
                                            @if (messageWalkersAvailableTours.Count == 0)
                                            {
                                                <option value="">-- no tours for date --</option>
                                            }
                                            else
                                            {
                                                <option value="ALL">All tours</option>
                                                @foreach (var t in messageWalkersAvailableTours)
                                                {
                                                    <option value="@t.Label">@t.Label</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="card-body" style="max-height: 50vh; overflow-y: auto;">
                                    @if (!messageWalkersAllToursSelected && messageWalkersSelectedTour == null)
                                    {
                                        <div class="alert alert-info mb-0">
                                            <i class="bi bi-info-circle me-2"></i>Select a date and tour to load walkers.
                                        </div>
                                    }
                                    else if (messageWalkersWalkers.Count == 0)
                                    {
                                        <div class="alert alert-warning mb-0">
                                            <i class="bi bi-exclamation-triangle me-2"></i>No confirmed walkers with phone numbers for this tour.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var w in messageWalkersWalkers)
                                            {
                                                <div class="list-group-item d-flex align-items-center gap-2 @(ReferenceEquals(messageWalkersActiveWalker, w) ? "active" : "")"
                                                     @onclick="@(() => SetActiveWalkerForPreview(w))"
                                                     style="cursor: pointer;">
                                                    <input type="checkbox" class="form-check-input" @bind="w.Selected" @onclick:stopPropagation="true" />
                                                    <span class="flex-grow-1">@GetWalkerDisplayName(w)</span>
                                                    <small class="text-muted">@w.Phone</small>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="card-footer d-flex justify-content-between">
                                    <small class="text-muted">Selected: @messageWalkersWalkers.Count(x => x.Selected) / @messageWalkersWalkers.Count</small>
                                    <small class="text-muted">Tour: @(messageWalkersAllToursSelected ? "All" : (messageWalkersSelectedTour?.Label ?? "—"))</small>
                                </div>
                            </div>
                        </div>
                        <div id="messageWalkersDialogRightColumn" class="col-lg-4 col-md-12">
                            <div class="card h-100">
                                <div class="card-header py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <label class="form-label mb-0">Message Template:</label>
                                        <select class="form-select form-select-sm"
                                                value="@(messageWalkersSelectedMessageId ?? string.Empty)"
                                                @onchange="OnMessageWalkersTemplateChanged">
                                            <option value="">-- select message --</option>
                                            @foreach (var m in InMemoryMessages.OrderBy(x => x.Name))
                                            {
                                                <option value="@m.Id">@m.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <label class="form-label">Message Body</label>
                                    <div class="mb-2">
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{walker}"))" title="Walker name">
                                                <i class="bi bi-person me-1"></i>{walker}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{walkerFirst}"))" title="Walker first name">
                                                <i class="bi bi-person me-1"></i>{walkerFirst}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{walkerLast}"))" title="Walker last name">
                                                <i class="bi bi-person me-1"></i>{walkerLast}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{phone}"))" title="Contact phone">
                                                <i class="bi bi-telephone me-1"></i>{phone}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{tour}"))" title="Tour name">
                                                <i class="bi bi-map me-1"></i>{tour}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{date}"))" title="Tour date">
                                                <i class="bi bi-calendar me-1"></i>{date}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{tourDayOfWeek}"))" title="Tour day of week">
                                                <i class="bi bi-calendar-week me-1"></i>{tourDayOfWeek}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{tourMonthAndDayOrdinal}"))" title="Tour month + day ordinal (e.g., December 9th)">
                                                <i class="bi bi-calendar2-day me-1"></i>{tourMonthAndDayOrdinal}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{monthOfTour}"))" title="Month of tour (e.g., December)">
                                                <i class="bi bi-calendar3 me-1"></i>{monthOfTour}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{displayDate}"))" title="Display date (raw)">
                                                <i class="bi bi-calendar-date me-1"></i>{displayDate}
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{displayDayOrdinal}"))" title="Display day ordinal (e.g., 9th)">
                                                <i class="bi bi-123 me-1"></i>{displayDayOrdinal}
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{displayTime}"))" title="Display time (raw)">
                                                <i class="bi bi-clock-history me-1"></i>{displayTime}
                                            </button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{guide}"))" title="Guide full name">
                                                <i class="bi bi-person-badge me-1"></i>{guide}
                                            </button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{guideFirstName}"))" title="Guide first name">
                                                <i class="bi bi-person me-1"></i>{guideFirstName}
                                            </button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{guideLastName}"))" title="Guide last name">
                                                <i class="bi bi-person me-1"></i>{guideLastName}
                                            </button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{guidePhone}"))" title="Guide phone">
                                                <i class="bi bi-telephone-plus me-1"></i>{guidePhone}
                                            </button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{guideEmail}"))" title="Guide email">
                                                <i class="bi bi-envelope me-1"></i>{guideEmail}
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{tourStartTime}"))" title="Tour start time">
                                                <i class="bi bi-clock me-1"></i>{tourStartTime}
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{meetingLocation}"))" title="Meeting location">
                                                <i class="bi bi-geo-alt me-1"></i>{meetingLocation}
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{meetingTime}"))" title="Meeting time">
                                                <i class="bi bi-clock-history me-1"></i>{meetingTime}
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{tempMeetingTime}"))" title="Start -10 minutes (fallback from tour start)">
                                                <i class="bi bi-clock-history me-1"></i>start -10
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{startMinus10}"))" title="Alias of {tempMeetingTime}">
                                                <i class="bi bi-clock-history me-1"></i>{startMinus10}
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{tempSignature}"))" title="Temp signature link (vendor-based)">
                                                <i class="bi bi-link-45deg me-1"></i>{tempSignature}
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{meetingInstructions}"))" title="Meeting instructions">
                                                <i class="bi bi-signpost me-1"></i>{meetingInstructions}
                                            </button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{vendorName}"))" title="Vendor name">
                                                <i class="bi bi-building me-1"></i>{vendorName}
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{vendorTourLink}"))" title="Vendor tour link placeholder">
                                                <i class="bi bi-link-45deg me-1"></i>{vendorTourLink}
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{vendorReviewLink}"))" title="Vendor review link placeholder">
                                                <i class="bi bi-link-45deg me-1"></i>{vendorReviewLink}
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{allToursLink}"))" title="All tours link placeholder">
                                                <i class="bi bi-link-45deg me-1"></i>{allToursLink}
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("messageWalkersMessageBody", "{galleryLink}"))" title="Gallery link placeholder">
                                                <i class="bi bi-images me-1"></i>{galleryLink}
                                            </button>
                                        </div>
                                    </div>
                                    <textarea class="form-control" rows="12"
                                              id="messageWalkersMessageBody"
                                              @bind="messageWalkersMessageBody"
                                              placeholder="Select a template or type a custom message..."></textarea>
                                    <div class="d-flex justify-content-end mt-1">
                                        <small class="@(messageWalkersMessageBody?.Length > 120 ? "text-warning" : "text-muted")">
                                            @(messageWalkersMessageBody?.Length ?? 0) characters
                                        </small>
                                    </div>
                                    <div class="mt-2">
                                        @if (!string.IsNullOrWhiteSpace(messageWalkersMessageBody) && messageWalkersActiveWalker != null)
                                        {
                                            <div class="alert alert-info mb-0">
                                                <div class="small text-muted">Preview for: @messageWalkersActiveWalker.Name</div>
                                                <div style="white-space: pre-wrap;">@RenderMessageWalkersPreview()</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-secondary mb-0">
                                                <div class="small">Select a walker on the left to preview personalized text.</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="messageWalkersDialogFooter" class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMessageWalkersDialog">Close</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyMessageWalkersBody" disabled="@string.IsNullOrWhiteSpace(messageWalkersMessageBody)" title="Copy message to clipboard">
                        <i class="bi bi-clipboard"></i>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm"
                            @onclick="@(() => ShowServiceNotImplemented("SMS via ClickSend"))"
                            disabled="@(messageWalkersWalkers.Count(x => x.Selected) == 0 || string.IsNullOrWhiteSpace(messageWalkersMessageBody))"
                            title="Send SMS via ClickSend (not implemented yet)">
                        <i class="bi bi-chat-dots"></i>
                    </button>
                    <button type="button" class="btn btn-success btn-sm ms-1"
                            @onclick="@(() => ShowServiceNotImplemented("WhatsApp bulk messaging"))"
                            disabled="@(messageWalkersWalkers.Count(x => x.Selected) == 0 || string.IsNullOrWhiteSpace(messageWalkersMessageBody))"
                            title="Send via WhatsApp (not implemented yet)">
                        <i class="bi bi-whatsapp"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
<!-- Bulk SMS Dialog -->
@if (showBulkSmsDialog)
{
    <div id="bulkSmsDialogModal" class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div id="bulkSmsDialogModalDialog" class="modal-dialog modal-lg">
            <div id="bulkSmsDialogModalContent" class="modal-content">
                <div id="bulkSmsDialogHeader" class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-whatsapp me-2 text-success"></i>
                        Bulk WhatsApp to Guide
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseBulkSmsDialog"></button>
                </div>
                <div id="bulkSmsDialogBody" class="modal-body">
                    <div id="bulkSmsDialogInfoRow" class="row gy-3">
                        <div id="bulkSmsDialogTourInfoColumn" class="col-md-6">
                            <h6>Tour Information</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Tour:</strong></td>
                                    <td>@(selectedBulkSmsTourNode?.Label ?? "Unknown")</td>
                                </tr>
                                <tr>
                                    <td><strong>Walkers:</strong></td>
                                    <td>@bulkSmsWalkerList.Count walkers</td>
                                </tr>
                            </table>
                        </div>
                        <div id="bulkSmsDialogGuideInfoColumn" class="col-md-6">
                            <label class="form-label">Guide Name / Lookup</label>
                            <input type="text"
                                   class="form-control"
                                   value="@bulkSmsGuideName"
                                   list="bulkSmsGuideLookup"
                                   placeholder="Type or pick a guide"
                                   @oninput="OnBulkSmsGuideNameInput" />
                            <datalist id="bulkSmsGuideLookup">
                                @if (DbGuides != null && DbGuides.Count > 0)
                                {
                                    foreach (var g in DbGuides.OrderBy(x => x.FirstName).ThenBy(x => x.LastName))
                                    {
                                        var label = string.IsNullOrWhiteSpace(g.LastName) ? g.FirstName : ($"{g.FirstName} {g.LastName}");
                                        <option value="@label"></option>
                                    }
                                }
                            </datalist>
                            <div class="mt-2">
                                <label class="form-label">Guide WhatsApp Number:</label>
                                <input type="tel" class="form-control" @bind="bulkSmsPhone" placeholder="Enter guide phone number" />
                                <small class="text-muted">Used to open WhatsApp with the walker list</small>
                            </div>
                        </div>
                    </div>

                    <ul class="nav nav-tabs mt-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(bulkSmsActiveTabIndex == 0 ? "active" : null)" id="bulk-sms-app-tab" type="button" role="tab" aria-controls="bulk-sms-app" aria-selected="@(bulkSmsActiveTabIndex == 0)" @onclick="() => SetBulkSmsActiveTab(0)">
                                <i class="bi bi-phone me-1"></i>WhatsApp App
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(bulkSmsActiveTabIndex == 1 ? "active" : null)" id="bulk-sms-web-tab" type="button" role="tab" aria-controls="bulk-sms-web" aria-selected="@(bulkSmsActiveTabIndex == 1)" @onclick="() => SetBulkSmsActiveTab(1)">
                                <i class="bi bi-globe me-1"></i>WhatsApp Web
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(bulkSmsActiveTabIndex == 2 ? "active" : null)" id="bulk-sms-copy-tab" type="button" role="tab" aria-controls="bulk-sms-copy" aria-selected="@(bulkSmsActiveTabIndex == 2)" @onclick="() => SetBulkSmsActiveTab(2)">
                                <i class="bi bi-clipboard-check me-1"></i>Copy
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="bulkSmsTabContent">
                        <div class="tab-pane fade @(bulkSmsActiveTabIndex == 0 ? "show active" : null)" id="bulk-sms-app" role="tabpanel" aria-labelledby="bulk-sms-app-tab">
                            <div id="bulkSmsAppMessageContainer" class="mb-3">
                                <label class="form-label">WhatsApp Message (walker list will be appended):</label>
                                <textarea class="form-control" rows="12" @bind="bulkSmsAppMessage" @oninput="OnBulkSmsAppMessageInput"
                                          placeholder="Enter your WhatsApp message here..."></textarea>
                                <div id="bulkSmsAppMessageInfo" class="d-flex justify-content-between align-items-center mt-1">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Will open WhatsApp for @bulkSmsPhone with walker list below
                                    </small>
                                    <small class="@(bulkSmsAppMessage.Length > 3500 ? "text-warning" : "text-muted")">
                                        @bulkSmsAppMessage.Length characters
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade @(bulkSmsActiveTabIndex == 1 ? "show active" : null)" id="bulk-sms-web" role="tabpanel" aria-labelledby="bulk-sms-web-tab">
                            <div id="bulkSmsApiMessageContainer" class="mb-3">
                                <label class="form-label">WhatsApp Web Message (walker list appended):</label>
                                <textarea class="form-control" rows="12" @bind="bulkSmsMessage" @oninput="OnBulkSmsMessageInput"
                                          placeholder="Enter your WhatsApp message here..."></textarea>
                                <div id="bulkSmsApiMessageInfo" class="d-flex justify-content-between align-items-center mt-1">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Opens in the browser with walker list below
                                    </small>
                                    <small class="@(bulkSmsMessage.Length > 3500 ? "text-warning" : "text-muted")">
                                        @bulkSmsMessage.Length characters
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade @(bulkSmsActiveTabIndex == 2 ? "show active" : null)" id="bulk-sms-copy" role="tabpanel" aria-labelledby="bulk-sms-copy-tab">
                            <div class="mb-3">
                                <label class="form-label">Walker List (copyable)</label>
                                <textarea class="form-control" rows="12" readonly>@bulkSmsCopyText</textarea>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <small class="text-muted">Includes walkers even when phones are missing.</small>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyBulkSmsTextAsync" disabled="@string.IsNullOrWhiteSpace(bulkSmsCopyText)">
                                        <i class="bi bi-clipboard"></i> Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="bulkSmsDialogFooter" class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseBulkSmsDialog">Cancel</button>
                    @if (bulkSmsActiveTabIndex == 0)
                    {
                        <a class="btn btn-success @(string.IsNullOrWhiteSpace(bulkSmsPhone) ? "disabled" : "")" 
                           href="@bulkSmsAppUrl" target="_blank" @onclick="CloseBulkSmsDialog" title="Open WhatsApp app">
                            <i class="bi bi-whatsapp me-1"></i>
                            Open WhatsApp App
                        </a>
                    }
                    else if (bulkSmsActiveTabIndex == 1)
                    {
                        <a class="btn btn-primary @(string.IsNullOrWhiteSpace(bulkSmsPhone) ? "disabled" : "")" 
                           href="@bulkSmsWebUrl" target="_blank" @onclick="CloseBulkSmsDialog" title="Send via WhatsApp Web">
                            <i class="bi bi-globe me-1"></i>
                            Send via WhatsApp Web
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success" disabled title="Select WhatsApp App/Web to send">
                            <i class="bi bi-whatsapp me-1"></i>
                            Open WhatsApp
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
<!-- SMS Dialog -->
@if (showSmsDialog)
{
    <div id="smsDialogModal" class="modal fade show" style="display: block;" tabindex="-1">
        <div id="smsDialogModalDialog" class="modal-dialog modal-lg">
            <div id="smsDialogModalContent" class="modal-content">
                <div id="smsDialogHeader" class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-chat-dots me-2 text-primary"></i>
                        Send SMS Message
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseSmsDialog"></button>
                </div>
                <div id="smsDialogBody" class="modal-body">
                    <div id="smsDialogWalkerInfoContainer" class="mb-4">
                        <h6>Walker Information</h6>
                        <table class="table table-sm">
                            <tr>
                                <td style="width: 150px;"><strong>Name:</strong></td>
                                <td>@selectedSmsWalkerInfo.Name</td>
                            </tr>
                            <tr>
                                <td><strong>Phone:</strong></td>
                                <td>
                                    <a href="tel:@selectedSmsWalkerInfo.Phone" class="text-decoration-none">@selectedSmsWalkerInfo.Phone</a>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Attendees:</strong></td>
                                <td>@selectedSmsWalkerInfo.Attendees</td>
                            </tr>
                        </table>
                    </div>
                    
                    <div id="smsDialogMessageContainer" class="mb-4">
                        <div class="accordion mb-2" id="smsDialogAccordion">
                            <!-- Item 1: Template Edits -->
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="smsTemplateEditsHeader">
                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#smsTemplateEditsCollapse" aria-expanded="false" aria-controls="smsTemplateEditsCollapse">
                                        Template Edits
                                    </button>
                                </h2>
                                <div id="smsTemplateEditsCollapse" class="accordion-collapse collapse" aria-labelledby="smsTemplateEditsHeader" data-bs-parent="#smsDialogAccordion">
                                    <div class="accordion-body p-2">
                                        <div class="d-flex flex-wrap gap-1">
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{walker}"))" title="Walker name"><i class="bi bi-person me-1"></i>{walker}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{walkerFirst}"))" title="Walker first name"><i class="bi bi-person me-1"></i>{walkerFirst}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{walkerLast}"))" title="Walker last name"><i class="bi bi-person me-1"></i>{walkerLast}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{phone}"))" title="Contact phone"><i class="bi bi-telephone me-1"></i>{phone}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{tour}"))" title="Tour name"><i class="bi bi-map me-1"></i>{tour}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{date}"))" title="Tour date"><i class="bi bi-calendar me-1"></i>{date}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{tourDayOfWeek}"))" title="Tour day of week"><i class="bi bi-calendar-week me-1"></i>{tourDayOfWeek}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{tourMonthAndDayOrdinal}"))" title="Tour month + day ordinal"><i class="bi bi-calendar2-day me-1"></i>{tourMonthAndDayOrdinal}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{monthOfTour}"))" title="Month of tour"><i class="bi bi-calendar3 me-1"></i>{monthOfTour}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{displayDate}"))" title="Display date (raw)"><i class="bi bi-calendar-date me-1"></i>{displayDate}</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{displayDayOrdinal}"))" title="Display day ordinal"><i class="bi bi-123 me-1"></i>{displayDayOrdinal}</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{displayTime}"))" title="Display time (raw)"><i class="bi bi-clock-history me-1"></i>{displayTime}</button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{guide}"))" title="Guide full name"><i class="bi bi-person-badge me-1"></i>{guide}</button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{guideFirstName}"))" title="Guide first name"><i class="bi bi-person me-1"></i>{guideFirstName}</button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{guideLastName}"))" title="Guide last name"><i class="bi bi-person me-1"></i>{guideLastName}</button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{guidePhone}"))" title="Guide phone"><i class="bi bi-telephone-plus me-1"></i>{guidePhone}</button>
                                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{guideEmail}"))" title="Guide email"><i class="bi bi-envelope me-1"></i>{guideEmail}</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{tourStartTime}"))" title="Tour start time"><i class="bi bi-clock me-1"></i>{tourStartTime}</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{meetingLocation}"))" title="Meeting location"><i class="bi bi-geo-alt me-1"></i>{meetingLocation}</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{meetingTime}"))" title="Meeting time"><i class="bi bi-clock-history me-1"></i>{meetingTime}</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{tempMeetingTime}"))" title="Start -10 minutes (fallback from tour start)"><i class="bi bi-clock-history me-1"></i>start -10</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{startMinus10}"))" title="Alias of {tempMeetingTime}"><i class="bi bi-clock-history me-1"></i>{startMinus10}</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{tempSignature}"))" title="Temp signature link (vendor-based)"><i class="bi bi-link-45deg me-1"></i>{tempSignature}</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{meetingInstructions}"))" title="Meeting instructions"><i class="bi bi-signpost me-1"></i>{meetingInstructions}</button>
                                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{vendorName}"))" title="Vendor name"><i class="bi bi-building me-1"></i>{vendorName}</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{vendorTourLink}"))" title="Vendor tour link placeholder"><i class="bi bi-link-45deg me-1"></i>{vendorTourLink}</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{vendorReviewLink}"))" title="Vendor review link placeholder"><i class="bi bi-link-45deg me-1"></i>{vendorReviewLink}</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{allToursLink}"))" title="All tours link placeholder"><i class="bi bi-link-45deg me-1"></i>{allToursLink}</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("smsMessage", "{galleryLink}"))" title="Gallery link placeholder"><i class="bi bi-images me-1"></i>{galleryLink}</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Item 2: Select Message -->
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="smsSelectMessageHeader">
                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#smsSelectMessageCollapse" aria-expanded="false" aria-controls="smsSelectMessageCollapse">
                                        Select Message...
                                    </button>
                                </h2>
                                <div id="smsSelectMessageCollapse" class="accordion-collapse collapse" aria-labelledby="smsSelectMessageHeader" data-bs-parent="#smsDialogAccordion">
                                    <div class="accordion-body p-2">
                                         <select class="form-select" value="@GetSelectedMessageId(selectedSmsWalkerInfo?.TourDate, selectedSmsWalkerInfo?.TourName)" @onchange="OnSmsDialogMessageChanged">
                                            <option value="" hidden></option>
                                            @if (InMemoryMessages != null)
                                            {
                                                foreach (var m in InMemoryMessages.OrderBy(x => x.Name))
                                                {
                                                    <option value="@m.Id">@m.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* 2026-03-06: Gallery link is available whenever a vendor/default gallery exists for this tour. *@
                        @if (isLoadingGalleryUrl || !string.IsNullOrEmpty(currentGalleryUrl))
                        {
                            <div class="mt-2 border p-2 rounded">
                                <small class="d-block text-muted mb-1">Gallery Link</small>
                                @if (isLoadingGalleryUrl)
                                {
                                    <div class="text-muted small">
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        Checking for photo gallery...
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(currentGalleryUrl))
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="includeGalleryLinkSMS" @bind="includeGalleryLink">
                                        <label class="form-check-label" for="includeGalleryLinkSMS">
                                            <i class="bi bi-camera me-1"></i> Include photo gallery link
                                            <br/>
                                            <small class="text-muted" style="font-size: 0.7em;">@currentGalleryUrl</small>
                                        </label>
                                    </div>
                                }
                            </div>
                        }

                        <textarea class="form-control" rows="8" @bind="smsMessage" @oninput="OnSmsMessageInput"
                              id="smsMessage"
                                  placeholder="Enter your SMS message here..."></textarea>
                        <div id="smsDialogMessageInfo" class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Compose your message; length is unrestricted.
                            </small>
                            <small class="text-muted">
                                @smsMessage.Length characters
                            </small>
                        </div>
                        @if (HasMissingAllToursLinkWarning(smsMessage))
                        {
                            <div class="alert alert-warning mt-2 mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Message includes <code>[missing allToursLink]</code>. Update vendor all-tours link if needed before sending.
                            </div>
                        }
                    </div>
                
                    <div class="accordion mt-3" id="smsDialogPreviewAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="smsDialogPreviewHeading">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#smsDialogPreviewCollapse" aria-expanded="false" aria-controls="smsDialogPreviewCollapse">
                                    <i class="bi bi-lightbulb me-2"></i>Message Preview
                                </button>
                            </h2>
                            <div id="smsDialogPreviewCollapse" class="accordion-collapse collapse" aria-labelledby="smsDialogPreviewHeading" data-bs-parent="#smsDialogPreviewAccordion">
                                <div class="accordion-body">
                                    <div class="mb-0" style="white-space: pre-wrap;">@((string.IsNullOrEmpty(smsMessage) ? "No message entered" : smsMessage))</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="smsDialogFooter" class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseSmsDialog">Cancel</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopySmsMessage" disabled="@string.IsNullOrEmpty(smsMessage)" title="Copy SMS message to clipboard">
                        <i class="bi bi-clipboard"></i>
                    </button>
                    <a class="btn btn-primary @(string.IsNullOrEmpty(selectedSmsWalkerInfo?.Phone) ? "disabled" : "")" 
                       href="@smsAppUrl" target="_blank" @onclick="OpenSmsAppAndTrackAsync">
                        <i class="bi bi-chat-dots me-1"></i>
                        Open SMS App
                    </a>
                    @* Textbelt/API send button is commented out until service is present in Email *@
                    @* <button type="button" class="btn btn-primary" @onclick="SendSmsMessage" disabled="@(string.IsNullOrEmpty(smsMessage))">Send via API</button> *@
                </div>
            </div>
        </div>
    </div>
    <div id="smsDialogBackdrop" class="modal-backdrop fade show"></div>
}

