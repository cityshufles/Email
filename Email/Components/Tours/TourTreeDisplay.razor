                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.TourDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                                    <input type="date" class="form-control form-control-sm"
                                           value="@(GetDateValue(reportEditedEmail?.TourDate))"
                                           @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => {
                                               reportEditedEmail!.TourDate = DateTime.TryParse(e.Value?.ToString(), out var dt) ? dt : null;
                                           })"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           max="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" />
                                </div>
                                <div id="reportDialogTourTimeField" class="mb-2">
                                    <label class="form-label">Tour Time</label>
                                    <div class="form-text text-warning small">Original: @(reportOriginalEmail.TourTime ?? "—")</div>
                                    <select class="form-select form-select-sm"
