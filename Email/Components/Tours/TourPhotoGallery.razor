@* 2025-12-21 - Photo gallery component - modernized with masonry grid and improved lightbox *@
@using Email.Services
@inject ITourPhotoService PhotoService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<div class="tour-photo-gallery">
    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="ms-2">Loading photos...</span>
        </div>
    }
    else if (Photos.Count == 0)
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-images fs-1 d-block mb-2"></i>
            <p class="mb-0">No photos found</p>
        </div>
    }
    else
    {
        <div class="gallery-count mb-2 text-muted small">
            <i class="bi bi-images me-1"></i>@Photos.Count photo(s)
        </div>
        <div class="masonry-grid">
            @foreach (var photo in Photos)
            {
                var thumb = BuildThumbnailUrl(photo);
                var index = Photos.IndexOf(photo);
                <div class="masonry-item" @onclick="() => OpenLightbox(index)">
                    <img src="@thumb"
                         data-full="@photo"
                         alt="Tour photo"
                         loading="lazy"
                         onerror="this.onerror=null;this.src=this.dataset.full;" />
                    <div class="gallery-overlay">
                        <div class="gallery-actions">
                            <button class="btn btn-sm btn-outline-light" @onclick:stopPropagation="true" @onclick="() => OpenLightbox(index)" title="View full size">
                                <i class="bi bi-zoom-in"></i>
                            </button>
                            <a href="@photo" download class="btn btn-sm btn-outline-light" @onclick:stopPropagation="true" title="Download">
                                <i class="bi bi-download"></i>
                            </a>
                            @if (AllowDelete)
                            {
                                <button class="btn btn-sm btn-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(photo)" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                        <small class="gallery-filename">@GetFilename(photo)</small>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Lightbox Modal with navigation *@
@if (showLightbox && lightboxIndex >= 0 && lightboxIndex < Photos.Count)
{
    <div class="lightbox-backdrop" @onclick="CloseLightbox" @onkeydown="OnLightboxKeyDown" tabindex="0">
        <div class="lightbox-content" @onclick:stopPropagation="true">
            <button class="lightbox-close" @onclick="CloseLightbox" title="Close (Esc)">
                <i class="bi bi-x-lg"></i>
            </button>

            @* Counter *@
            <div class="lightbox-counter">
                @(lightboxIndex + 1) / @Photos.Count
            </div>

            @* Previous button *@
            @if (lightboxIndex > 0)
            {
                <button class="lightbox-nav lightbox-prev" @onclick="PrevPhoto" title="Previous">
                    <i class="bi bi-chevron-left"></i>
                </button>
            }

            <img src="@Photos[lightboxIndex]" alt="Full size photo" />

            @* Next button *@
            @if (lightboxIndex < Photos.Count - 1)
            {
                <button class="lightbox-nav lightbox-next" @onclick="NextPhoto" title="Next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            }

            <div class="lightbox-toolbar">
                <a href="@Photos[lightboxIndex]" download class="btn btn-outline-light btn-sm">
                    <i class="bi bi-download me-1"></i>Download
                </a>
                @if (AllowDelete)
                {
                    <button class="btn btn-danger btn-sm ms-2" @onclick="() => ConfirmDelete(Photos[lightboxIndex])">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                }
            </div>
        </div>
    </div>
}

@* Delete Confirmation Modal *@
@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete Photo?</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this photo? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="ExecuteDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<string> Photos { get; set; } = new();
    [Parameter] public bool AllowDelete { get; set; } = true;
    [Parameter] public EventCallback OnPhotoDeleted { get; set; }

    private bool isLoading = false;
    private bool showLightbox = false;
    private int lightboxIndex = -1;
    private bool showDeleteConfirm = false;
    private string? photoToDelete;
    private bool isDeleting = false;

    private void OpenLightbox(int index)
    {
        lightboxIndex = index;
        showLightbox = true;
        StateHasChanged();
    }

    private void CloseLightbox()
    {
        showLightbox = false;
        lightboxIndex = -1;
        StateHasChanged();
    }

    private void NextPhoto()
    {
        if (lightboxIndex < Photos.Count - 1)
        {
            lightboxIndex++;
            StateHasChanged();
        }
    }

    private void PrevPhoto()
    {
        if (lightboxIndex > 0)
        {
            lightboxIndex--;
            StateHasChanged();
        }
    }

    private void OnLightboxKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight":
                NextPhoto();
                break;
            case "ArrowLeft":
                PrevPhoto();
                break;
            case "Escape":
                CloseLightbox();
                break;
        }
    }

    private void ConfirmDelete(string photo)
    {
        photoToDelete = photo;
        showDeleteConfirm = true;
        showLightbox = false;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        photoToDelete = null;
        StateHasChanged();
    }

    private async Task ExecuteDelete()
    {
        if (string.IsNullOrWhiteSpace(photoToDelete)) return;

        try
        {
            isDeleting = true;
            StateHasChanged();

            var deleted = await PhotoService.DeletePhotoAsync(photoToDelete);

            if (deleted)
            {
                if (OnPhotoDeleted.HasDelegate)
                {
                    await OnPhotoDeleted.InvokeAsync();
                }
                await ToastService.ShowSuccessAsync("Deleted", "Photo removed successfully.");
            }
            else
            {
                await ToastService.ShowErrorAsync("Error", "Failed to delete photo.");
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync("Error", $"Deletion failed: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            showDeleteConfirm = false;
            photoToDelete = null;
            StateHasChanged();
        }
    }

    private static string GetFilename(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        var parts = path.Split('/');
        var filename = parts.Length > 0 ? parts[^1] : path;
        return filename.Length > 30 ? filename.Substring(0, 27) + "..." : filename;
    }

    private static string BuildThumbnailUrl(string photoUrl)
    {
        if (string.IsNullOrWhiteSpace(photoUrl)) return photoUrl;

        var lastSlash = photoUrl.LastIndexOf('/');
        var directory = lastSlash >= 0 ? photoUrl[..lastSlash] : string.Empty;
        var fileName = lastSlash >= 0 ? photoUrl[(lastSlash + 1)..] : photoUrl;

        if (fileName.EndsWith("_thumb.jpg", StringComparison.OrdinalIgnoreCase))
        {
            return photoUrl;
        }

        var dotIndex = fileName.LastIndexOf('.');
        var baseName = dotIndex > 0 ? fileName[..dotIndex] : fileName;
        var thumbFile = $"{baseName}_thumb.jpg";

        return string.IsNullOrEmpty(directory)
            ? thumbFile
            : $"{directory}/{thumbFile}";
    }
}

<style>
    /* Pinterest-style masonry grid */
    .masonry-grid {
        columns: 4 220px;
        column-gap: 0.75rem;
        padding: 0.5rem 0;
    }

    .masonry-item {
        break-inside: avoid;
        margin-bottom: 0.75rem;
        position: relative;
        border-radius: 0.5rem;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .masonry-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0,0,0,0.25);
    }

    .masonry-item img {
        width: 100%;
        height: auto;
        display: block;
    }

    .gallery-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 50%);
        opacity: 0;
        transition: opacity 0.2s ease;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0.75rem;
    }

    .masonry-item:hover .gallery-overlay {
        opacity: 1;
    }

    .gallery-actions {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .gallery-filename {
        color: white;
        font-size: 0.75rem;
        text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }

    .gallery-count {
        font-size: 0.85rem;
    }

    /* Lightbox styles */
    .lightbox-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.92);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        outline: none;
    }

    .lightbox-content {
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .lightbox-content img {
        max-width: 100%;
        max-height: 78vh;
        object-fit: contain;
        border-radius: 0.5rem;
    }

    .lightbox-close {
        position: absolute;
        top: -2.5rem;
        right: 0;
        background: transparent;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.5rem;
        z-index: 10;
    }

    .lightbox-close:hover {
        color: #ccc;
    }

    .lightbox-counter {
        position: absolute;
        top: -2.5rem;
        left: 0;
        color: rgba(255,255,255,0.8);
        font-size: 0.9rem;
        font-weight: 500;
    }

    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        z-index: 10;
        transition: background 0.2s;
    }

    .lightbox-nav:hover {
        background: rgba(0,0,0,0.8);
    }

    .lightbox-prev {
        left: -4rem;
    }

    .lightbox-next {
        right: -4rem;
    }

    .lightbox-toolbar {
        margin-top: 1rem;
    }

    /* Responsive */
    @@media (max-width: 991px) {
        .masonry-grid {
            columns: 3 160px;
        }

        .lightbox-prev {
            left: 0.5rem;
        }

        .lightbox-next {
            right: 0.5rem;
        }

        .lightbox-nav {
            padding: 0.5rem 0.75rem;
            font-size: 1.25rem;
        }
    }

    @@media (max-width: 575px) {
        .masonry-grid {
            columns: 2 140px;
            column-gap: 0.5rem;
        }

        .masonry-item {
            margin-bottom: 0.5rem;
        }

        .lightbox-backdrop {
            padding: 0.5rem;
        }

        .lightbox-content img {
            max-height: 70vh;
        }
    }

    /* Touch: always show overlay on mobile */
    @@media (hover: none) {
        .gallery-overlay {
            opacity: 1;
            background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 40%);
        }
    }
</style>
