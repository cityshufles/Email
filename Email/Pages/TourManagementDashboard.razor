@page "/tour-management-dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Web

@using Email.Models
@using Email.TourTreeViewShapedData.Enums
@using Email.Components.TourEmailCollectionUI
@using Email.Components.Tours

<PageTitle>Tour Management Dashboard</PageTitle>

<div class="container-fluid d-flex flex-column min-vh-100" id="TourManagementDashboard-root">
    <div class="row flex-grow-0" id="TourManagementDashboard-HeaderRow">
        <div class="col-12" id="TourManagementDashboard-HeaderCol">
            <div class="card mb-3" id="TourManagementDashboard-HeaderCard">
                <div class="card-header d-flex justify-content-between align-items-center" id="TourManagementDashboard-HeaderBar">
                    <div class="d-flex align-items-center">
                     @*    <i class="bi bi-diagram-3 me-2"></i> *@
                       @*  <h5 class="mb-0">Tour Management Dashboard</h5> *@
                        @if (!string.IsNullOrWhiteSpace(latestSubject))
                        {
                            <small class="text-muted ms-3 d-none d-sm-inline" title="@latestSubject">Last Email: @latestSubject</small>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-switch m-0 d-flex align-items-center" title="iPhone copy mode shows text dialog">
                            <input class="form-check-input" type="checkbox" id="iphoneCopyToggleDesktop" @bind="useIPhoneCopyMode" @bind:after="SaveIPhoneCopyModeAsync" />
                            <label class="form-check-label small ms-1" for="iphoneCopyToggleDesktop">iPhone</label>
                        </div>
                        <button class="btn btn-outline-primary btn-sm" style="padding:.15rem .4rem; font-size:.8rem;" @onclick="RefreshStatusesAsync" disabled="@isStatusLoading">
                            @if (isStatusLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Refresh
                        </button>
                        <a class="btn btn-outline-info btn-sm" href="/mobile-tours" title="Switch to Mobile Dashboard" aria-label="Switch to Mobile Dashboard">
                            <i class="bi bi-phone"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row flex-grow-1" style="min-height:0;" id="TourManagementDashboard-BodyRow">
        <div class="col-12 d-flex flex-column flex-grow-1" style="min-height:0;" id="TourManagementDashboard-BodyCol">
            <ul class="nav nav-tabs" role="tablist" id="TourManagementDashboard-TabsNav">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "tours" ? "active" : null)" @onclick='() => SetTab("tours")' type="button" role="tab">
                        <i class="bi bi-diagram-3 me-1"></i> Tours
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "addTour" ? "active" : null)" @onclick='() => SetTab("addTour")' type="button" role="tab">
                        <i class="bi bi-plus-lg me-1"></i> Add Booking
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "emails" ? "active" : null)" @onclick='() => SetTab("emails")' type="button" role="tab">
                        <i class="bi bi-envelope me-1"></i> Email Processing
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "bookings" ? "active" : null)" @onclick='() => SetTab("bookings")' type="button" role="tab">
                        <i class="bi bi-journal-text me-1"></i> Booking Management
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "processing" ? "active" : null)" @onclick='() => SetTab("processing")' type="button" role="tab">
                        <i class="bi bi-cpu me-1"></i> Processing/Edit
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "live" ? "active" : null)" @onclick="ActivateLiveTab" type="button" role="tab">
                        <i class="bi bi-inbox me-1"></i> Live Inbox
                    </button>
                </li>
            </ul>

            <div class="tab-content p-3 border border-top-0 d-flex flex-column flex-grow-1" style="min-height:0;" id="TourManagementDashboard-TabContent">
                <div class='@($"tab-pane fade {(activeTab == "tours" ? "show active d-flex flex-column flex-grow-1" : string.Empty)}")' style="min-height:0;" id="Tab-Tours">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3 text-muted">Loading tour data...</p>
                        </div>
                    }
                    else if (filteredTourTreeData?.TreeNodes?.Any() == true)
                    {
                        <div class="d-flex flex-column flex-grow-1" style="min-height:0;" id="Tours-ContentContainer">
                            <div class="flex-grow-1 d-flex flex-column" style="min-height:0;" id="TourTreeDisplay-host">
                                <TourTreeDisplay
                                    TourData="@filteredTourTreeData"
                                    IsLoading="@isLoading"
                                    Args="@filterArgs"
                                    OnApply="OnApplyFilters"
                                    DbGuides="@availableDbGuides"
                                    InMemoryMessages="@inMemoryMessages"
                                    OnOpenGuideManagement="OpenGuideManagementDialog"
                                    OnOpenMessageManagement="OpenMessageManagementDialog"
                                    OnWalkerSelected="OnWalkerSelected"
                                    OnVCardDownload="OnVCardDownload"
                                    OnSmsSend="OnSmsSend"
                                    OnWhatsAppSend="OnWhatsAppSend"
                                    OnEmailView="OnEmailView"
                                    OnDataRefresh="RefreshTreeDataForceFreshAsync"
                                    OnAddBookingFromTour="HandleAddBookingFromTour"
                                    UseIPhoneCopyMode="@useIPhoneCopyMode" />
                            </div>
                            <div class="d-flex justify-content-end mt-2 gap-2">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFiltersToDefaults">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                                </button>
                                <button class="btn btn-primary btn-sm" @onclick="LoadTodayAsync">
                                    <i class="bi bi-calendar-day me-1"></i>Today
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x display-5 text-muted"></i>
                            <p class="mt-3 text-muted">No upcoming tours found for the selected range.</p>
                            <div class="d-flex justify-content-center gap-2">
                                <button class="btn btn-primary" @onclick="RefreshTreeDataForceFreshAsync">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ResetFiltersToDefaults">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                                </button>
                                <button class="btn btn-outline-primary" @onclick="LoadTodayAsync">
                                    <i class="bi bi-calendar-day me-1"></i>Today
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-pane fade @(activeTab == "addTour" ? "show active" : null)" id="Tab-AddTour">
                    <AddNewTour Prefill="addBookingPrefill" />
                </div>

                <div class="tab-pane fade @(activeTab == "emails" ? "show active" : null)" id="Tab-EmailProcessing">
                    <div id="TourEmailCollectionAndProcessing-host">
                        <TourEmailCollectionAndProcessing
                            HideCollectionToolbar="true"
                            OnProcessingCompleted="OnEmailProcessingCompleted" />
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "bookings" ? "show active" : null)" id="Tab-BookingManagement">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Booking Management tab - To be implemented
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "processing" ? "show active" : null)" id="Tab-ProcessingEdit">
                    <div id="TourEmailProcessingPanel-host">
                        <Email.Components.TourEmailProcessing.TourEmailProcessingPanel />
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "live" ? "show active" : null)" id="Tab-LiveInbox">
                    <div id="LiveInboxViewer-host">
                        <LiveInboxViewer />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Placeholder dialogs removed during revert; will add back in smaller segments *@

@* Version Dialog - TODO: Implement version management *@
@if (showVersionDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Version Information</h5>
                    <button type="button" class="btn-close" @onclick="CloseVersionDialog"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Current Version:</strong> 1.0.0</p>
                    <p class="text-muted">Email Project - Tour Management Dashboard</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseVersionDialog">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* Help Panel - TODO: Implement help content *@
@if (showHelpPanel)
{
    <div class="help-panel @(showHelpPanel ? "show" : "")">
        <div class="help-panel-overlay" @onclick="ToggleHelpPanel"></div>
        <div class="help-panel-content">
            <div class="help-panel-header">
                <h5 class="mb-0">Help & Documentation</h5>
                <button type="button" class="btn-close" @onclick="ToggleHelpPanel"></button>
            </div>
            <div class="help-panel-body">
                <h6>Tour Management Dashboard</h6>
                <p>This dashboard allows you to manage tour bookings, process emails, and view live inbox data.</p>
                <hr />
                <h6>Quick Actions</h6>
                <ul>
                    <li><strong>Tours Tab:</strong> View and manage tour bookings</li>
                    <li><strong>Email Processing:</strong> Collect and process tour booking emails</li>
                    <li><strong>Live Inbox:</strong> Monitor incoming emails in real-time</li>
                </ul>
            </div>
        </div>
    </div>
}

