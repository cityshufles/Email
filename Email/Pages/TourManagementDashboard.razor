                                            @foreach (var guide in inMemoryGuides)
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-start border-0 px-0" @onclick="@(() => EditGuide(guide))" style="cursor: pointer;">
                                                    <div class="flex-grow-1">
                                                        <strong>@guide.Name</strong><br />
                                                        <small class="text-muted">
                                                            @guide.Phone | @guide.Email
                                                            @if (!string.IsNullOrEmpty(guide.MeetingLocation))
                                                            {
                                                                <br /> @guide.MeetingLocation
                                                            }
                                                        </small>
                                                        @if (!string.IsNullOrEmpty(guide.Description))
                                                        {
                                                            <br /><small class="text-muted">@guide.Description</small>
                                                        }
                                                    </div>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary btn-sm" @onclick="@(() => EditGuide(guide))" @onclick:stopPropagation="true" title="Edit guide">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => RemoveGuide(guide))" @onclick:stopPropagation="true" title="Remove guide">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="mt-3">
                                            <button class="btn btn-outline-danger btn-sm" @onclick="ClearAllGuides">
                                                <i class="bi bi-trash me-1"></i>
                                                Clear All Guides
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info mb-0">
                                            <i class="bi bi-info-circle me-2"></i>
                                            No guides added yet. Add your first guide using the form on the left.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseGuideManagementDialog">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* Message Management Dialog (migrated)
@if (showMessageManagementDialog)
{
	<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						<i class="bi bi-chat-text me-2"></i>
						Message Management
					</h5>
					<button type="button" class="btn-close" @onclick="CloseMessageManagementDialog"></button>
				</div>
				<div class="modal-body">
					<div class="row g-4">
						<div class="col-lg-6 col-md-12">
							<div class="card h-100">
								<div class="card-header">
									<h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Message Template</h6>
								</div>
								<div class="card-body">
									@if (!string.IsNullOrWhiteSpace(lastMessageError))
									{
										<div class="alert alert-warning" role="alert">
											<strong>Message save failed:</strong> @lastMessageError
										</div>
									}
									<div class="mb-3">
										<label class="form-label">Message Name:</label>
										<input type="text" class="form-control" @bind="newMessageName" placeholder="Enter message name (e.g., Welcome, Reminder)" />
									</div>
									<div class="mb-3">
										<label class="form-label">Message Type:</label>
										<select class="form-select" @bind="newMessageType">
											<option value="">Select type...</option>
											<option value="welcome">Welcome Message</option>
											<option value="tomorrow">Tomorrow</option>
											<option value="dayOf">Day of</option>
											<option value="basedOnDate">Based on date</option>
											<option value="custom">Custom</option>
										</select>
									</div>

									<div class="mb-3">
										<label class="form-label">Tour (for template context):</label>
										<select class="form-select"
												value="@(newMessageTourId?.ToString() ?? (string.Equals(newMessageTourName, "All", StringComparison.OrdinalIgnoreCase) ? "ALL" : string.Empty))"
												@onchange="@(e => { var val = e.Value?.ToString(); if (string.Equals(val, "ALL", StringComparison.OrdinalIgnoreCase)) { newMessageTourId = null; newMessageTourName = "All"; newMessageTourStartTime = null; messageTimeOptions = new List<string>(); } else { newMessageTourId = int.TryParse(val, out var id) ? id : null; OnMessageTourChanged(); } })">
											<option value="">-- select tour --</option>
											<option value="ALL">All tours</option>
											@foreach (var t in distinctToursForContext)
											{
												<option value="@t.Id">@FormatTourLabel(t)</option>
											}
										</select>
									</div>

									<div class="mb-3">
										<label class="form-label">Guide (optional context):</label>
										<select class="form-select" @bind="newMessageGuideId">
											<option value="">-- select guide --</option>
											@foreach (var g in availableDbGuides)
											{
												<option value="@g.Id">@($"{g.FirstName} {g.LastName}")</option>
											}
										</select>
									</div>

									<div class="mb-3">
										<div class="d-flex justify-content-between align-items-center">
											<label class="form-label mb-0">Message Content</label>
											<div class="btn-group btn-group-sm" role="group">
												<button type="button" class="btn btn-outline-secondary @(messageEditorTab=="edit"?"active":null)" @onclick="SetMessageEditorTabToEdit">Edit</button>
												<button type="button" class="btn btn-outline-secondary @(messageEditorTab=="preview"?"active":null)" @onclick="SetMessageEditorTabToPreview">Preview</button>
											</div>
										</div>
										<div class="mb-2">
											<div class="d-flex flex-wrap gap-1 mb-2">
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{walker}"))" title="Walker name"><i class="bi bi-person me-1"></i>{walker}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{walkerFirst}"))" title="Walker first name"><i class="bi bi-person me-1"></i>{walkerFirst}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{walkerLast}"))" title="Walker last name"><i class="bi bi-person me-1"></i>{walkerLast}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{phone}"))" title="Contact phone"><i class="bi bi-telephone me-1"></i>{phone}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tour}"))" title="Tour name"><i class="bi bi-map me-1"></i>{tour}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{date}"))" title="Tour date"><i class="bi bi-calendar me-1"></i>{date}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tourDayOfWeek}"))" title="Tour day of week"><i class="bi bi-calendar-week me-1"></i>{tourDayOfWeek}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tourMonthAndDayOrdinal}"))" title="Tour month + day ordinal"><i class="bi bi-calendar2-day me-1"></i>{tourMonthAndDayOrdinal}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{monthOfTour}"))" title="Month of tour"><i class="bi bi-calendar3 me-1"></i>{monthOfTour}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{displayDate}"))" title="Display date (raw)"><i class="bi bi-calendar-date me-1"></i>{displayDate}</button>
												<button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{displayDayOrdinal}"))" title="Display day ordinal"><i class="bi bi-123 me-1"></i>{displayDayOrdinal}</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{displayTime}"))" title="Display time (raw)"><i class="bi bi-clock-history me-1"></i>{displayTime}</button>
												<button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guide}"))" title="Guide full name"><i class="bi bi-person-badge me-1"></i>{guide}</button>
												<button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guideFirstName}"))" title="Guide first name"><i class="bi bi-person me-1"></i>{guideFirstName}</button>
												<button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guideLastName}"))" title="Guide last name"><i class="bi bi-person me-1"></i>{guideLastName}</button>
												<button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guidePhone}"))" title="Guide phone"><i class="bi bi-telephone-plus me-1"></i>{guidePhone}</button>
												<button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{guideEmail}"))" title="Guide email"><i class="bi bi-envelope me-1"></i>{guideEmail}</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tourStartTime}"))" title="Tour start time"><i class="bi bi-clock me-1"></i>{tourStartTime}</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{meetingLocation}"))" title="Meeting location"><i class="bi bi-geo-alt me-1"></i>{meetingLocation}</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{meetingTime}"))" title="Meeting time"><i class="bi bi-clock-history me-1"></i>{meetingTime}</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tempMeetingTime}"))" title="Start -10 minutes (fallback from tour start)"><i class="bi bi-clock-history me-1"></i>start -10</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{startMinus10}"))" title="Alias of {tempMeetingTime}"><i class="bi bi-clock-history me-1"></i>{startMinus10}</button>
												<button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{tempSignature}"))" title="Temp signature link (vendor-based)"><i class="bi bi-link-45deg me-1"></i>{tempSignature}</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{meetingInstructions}"))" title="Meeting instructions"><i class="bi bi-signpost me-1"></i>{meetingInstructions}</button>
												<button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newMessageContent", "{vendorName}"))" title="Vendor name"><i class="bi bi-building me-1"></i>{vendorName}</button>
											</div>
										</div>
										@if (messageEditorTab == "edit")
										{
											<textarea class="form-control" rows="8" @bind="newMessageContent" @bind:event="oninput" id="newMessageContent" placeholder="Enter message content..."></textarea>
										}
										else
										{
											<div class="form-control" style="height: auto; min-height: 12rem; white-space: pre-wrap;">
												@RenderMessagePreview()
											</div>
										}
									</div>

									<div class="row g-2">
										<div class="col-md-6">
											<label class="form-label">Signature (optional):</label>
											<input type="text" class="form-control" @bind="newMessageSignature" @bind:event="oninput" placeholder="Enter signature" />
										</div>
										<div class="col-md-6">
											<label class="form-label">Description (optional):</label>
											<input type="text" class="form-control" @bind="newMessageDescription" @bind:event="oninput" placeholder="Internal description" />
										</div>
									</div>

									<div class="form-check form-switch mt-2">
										<input class="form-check-input" type="checkbox" id="msgIsActive" @bind="newMessageIsActive" />
										<label class="form-check-label" for="msgIsActive">Is Active</label>
									</div>

									<div class="d-flex gap-2 mt-3">
										<button class="btn btn-success btn-sm" @onclick="AddMessageTemplate" disabled="@string.IsNullOrWhiteSpace(newMessageName)">
											<i class="bi bi-check2-circle me-1"></i>
											@(editingMessageId.HasValue ? "Save Message" : "Add Message")
										</button>
										@if (editingMessageId.HasValue)
										{
											<button class="btn btn-secondary btn-sm" @onclick="CancelMessageEdit">
												<i class="bi bi-x-circle me-1"></i>
												Cancel Edit
											</button>
										}
										<button class="btn btn-warning btn-sm" @onclick="ClearMessageForm">
											<i class="bi bi-eraser me-1"></i>
											Clear
										</button>
									</div>
								</div>
							</div>
						</div>
						<div class="col-lg-6 col-md-12">
							<div class="card h-100">
								<div class="card-header">
									<h6 class="mb-0"><i class="bi bi-list-ul me-2"></i>Current Messages (@inMemoryMessages.Count)</h6>
								</div>
								<div class="card-body">
									@if (inMemoryMessages.Any())
									{
										<div class="list-group list-group-flush">
											@foreach (var message in inMemoryMessages)
											{
												<div class="list-group-item d-flex justify-content-between align-items-start border-0 px-0" style="cursor:pointer;" @onclick="@(() => LoadMessageByInMemoryId(message.Id))">
													<div class="flex-grow-1">
														<strong>@message.Name</strong>
														<span class="badge bg-secondary ms-2">@message.Type</span><br/>
														<small class="text-muted">
															@if (!string.IsNullOrEmpty(message.Description))
															{
																@message.Description<br/>
															}
															<div id="messageTemplatePreviewInList" class="mt-2" style="max-height: 120px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
																<pre style="margin: 0; white-space: pre-wrap; font-size: 0.875rem; color: #6c757d;">@message.Content</pre>
															</div>
														</small>
													</div>
													<div class="btn-group btn-group-sm">
														<button class="btn btn-outline-primary btn-sm" @onclick="@(() => EditDbMessageTemplate(dbMessages.First(m => m.Id.ToString() == message.Id)))" @onclick:stopPropagation="true" title="Edit message">
															<i class="bi bi-pencil-square"></i>
														</button>
														<button class="btn btn-outline-danger btn-sm" @onclick="@(() => RemoveDbMessageTemplate(dbMessages.First(m => m.Id.ToString() == message.Id)))" @onclick:stopPropagation="true" title="Remove message">
															<i class="bi bi-trash"></i>
														</button>
													</div>
												</div>
											}
										</div>
									}
									else
									{
										<div class="alert alert-info mb-0">
											<i class="bi bi-info-circle me-2"></i>
											No messages added yet. Add your first message using the form on the left.
										</div>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" @onclick="CloseMessageManagementDialog">Close</button>
				</div>
			</div>
		</div>
	</div>
}
*@

<style>
    .help-panel {
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        width: 100%;
        z-index: 1050;
    }

    .help-panel-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        pointer-events: auto;
    }

    .help-panel-content {
        position: absolute;
        top: 0;
        right: 0;
        width: 33.333333%;
        height: 100%;
        box-shadow: -2px 0 10px rgba(0, 0, 0, 0.1);
        overflow-y: auto;
        pointer-events: auto;
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
    }

    .help-panel.show .help-panel-content {
        transform: translateX(0);
    }

    .help-panel-header {
        padding: 1rem;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .help-panel-body {
        padding: 1rem;
        height: calc(100vh - 120px);
        overflow-y: auto;
    }

    @@media (max-width: 768px) {
        .help-panel-content {
            width: 100%;
        }
    }
</style>

<script>
    // Initialize Bootstrap tooltips for disabled elements
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>

<style>
    /* Live inbox layout to prevent overlap and ensure consistent wrapping (no media queries) */
    .live-inbox .e-listview .e-list-item {
        padding: .5rem .75rem;
    }
    .live-inbox-item {
        display: flex;
        flex-wrap: wrap;
        column-gap: .75rem;
        row-gap: .5rem;
        align-items: flex-start;
    }
    .live-inbox-left {
        flex: 1 1 300px;
        min-width: 0; /* allow children to wrap */
    }
    .live-inbox-left .from,
    .live-inbox-left .subject {
        white-space: normal;
        word-break: break-word;
    }
    .live-inbox-right {
        flex: 0 0 160px; /* fixed column that wraps to next line when too narrow */
        text-align: right;
    }
    .live-inbox-right .date {
        white-space: nowrap;
    }
</style>
