@page "/mobile-tours"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Email.Services
@using Email.Models
@using Email.Models.Reports
@using Email.Models.Mobile
@using Email.TourTreeViewShapedData.Enums
@using Email.Components.Mobile
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject ITourTreeService TourTreeService
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ITourMessagesApiService TourMessagesApi
@inject IGuidesApiService GuidesApi
@inject IVendorsApiService VendorsApi
@inject ITourLinkService TourLinkService
@inject IToursApiService ToursApiService
@inject ITourCatalogService TourCatalogService
@inject TourDataErrorReportsSqlService ErrorReportsService
@inject IBookingsInboxService BookingsInboxService
@inject MessageTemplateService TemplateService
@inject VCardExportService VCardExportService
@inject VCardLogService VCardLogService
@inject SmtpVCardEmailService SmtpVCardEmailService
@inject Email.Services.State.MobileTourDashboardCacheState MobileDashboardCacheState

<!-- Created: 10/7/2025 7:30 PM (local) | 2025-10-07T19:30:00 -->
<!-- Purpose: Mobile-optimized Tour Management Dashboard (read-only essentials) -->

<PageTitle>Mobile Tours</PageTitle>

<div class="container-fluid p-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div aria-hidden="true"></div>
        <div class="d-flex gap-1">
            <button class="btn btn-sm btn-success" @onclick="OpenNewTourSheet" disabled="@isLoading" title="New Tour">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-md-inline ms-1">New Tour</span>
            </button>
            <button class="btn btn-sm btn-outline-info" @onclick="OpenTemplateManagementSheet" disabled="@isLoading" title="Templates">
                <i class="bi bi-file-earmark-text"></i>
            </button>
            <div class="form-check form-switch m-0 d-flex align-items-center border rounded px-1" title="iPhone copy mode shows text dialog">
                <input class="form-check-input my-0" type="checkbox" id="iphoneCopyToggle" @bind="useIPhoneCopyMode" @bind:after="SaveIPhoneCopyModeToLocalStorage" />
                <label class="form-check-label small ms-1 d-none d-md-inline" for="iphoneCopyToggle">iPhone</label>
                <i class="bi bi-apple d-md-none ms-1 text-muted" style="font-size: 0.8rem;"></i>
            </div>
            <button class="btn btn-sm btn-primary" @onclick="LoadForceFreshAsync" disabled="@isLoading" title="Refresh">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                }
                <span class="d-none d-md-inline ms-1">Refresh</span>
            </button>
            <a class="btn btn-sm btn-outline-info" href="/tour-management-dashboard" title="Switch to Desktop Dashboard" aria-label="Switch to Desktop Dashboard">
                <i class="bi bi-display"></i>
            </a>
        </div>
    </div>

    <MobileDateFilter @bind-SelectedDate="selectedDate"
                      OnApply="LoadForceFreshAsync" />

    @if (!isLoading && mobileTours?.Any() == true)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-secondary">Guests: @dayGuestTotal</span>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
            <div class="mt-2 small text-muted">Loading tours…</div>
        </div>
    }
    else if (mobileTours?.Any() == true)
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var group in mobileTours.GroupBy(c => c.DateLabel))
            {
                var groupTotal = group.Sum(c => c.TotalGuests);
                <div class="d-flex justify-content-between align-items-center px-1 mb-1">
                    <div class="fw-semibold small text-muted">@group.Key</div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary">Guests: @groupTotal</span>
                        <button class="btn btn-sm btn-outline-info" @onclick="() => ShowDayMessageLog(group.Key, group.ToList())" title="View day message log">
                            <i class="bi bi-chat-square-quote-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EmailDayVcards(group.Key, group.ToList())" title="Email vCards for day" disabled="@isEmailingDayVcards">
                            @if (isEmailingDayVcards)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-envelope-at"></i>
                            }
                        </button>
                        <button class="btn btn-sm btn-outline-info" @onclick="() => DownloadDayVcards(group.Key, group.ToList())" title="Download vCards for day">
                            <i class="bi bi-person-vcard"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyDayWalkers(group.Key, group.ToList())" title="Copy all walker info for day">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>
                @foreach (var card in group)
                {
                            <MobileTourCard Card="card"
                                    ShowDate="false"
                                    OnCopyWalkers="CopyTourWalkers"
                                    OnDownloadVcards="DownloadTourVcards"
                                    OnEditWalker="OpenEditBookingSheet"
                                    OnReportDataIssue="OpenReportIssueSheet"
                                    OnDownloadVcard="DownloadVcard"
                                    OnBulkSendToGuide="OpenBulkSmsDialog"
                                    MessageTemplates="inMemoryMessages"
                                    DbGuides="availableDbGuides"
                                    AvailableTours="availableTours"
                                    AvailableTourLinks="availableTourLinks"
                                    AvailableVendors="availableVendors"
                                    ActiveVendorAssignments="activeVendorAssignments"
                                    GuideId="@selectedGuideIdByTour.GetValueOrDefault(GetTourKey(card.DateLabel, card.TourName))"
                                    SelectedMessageId="@(selectedMessageIdByTour.TryGetValue(GetTourKey(card.DateLabel, card.TourName), out var mid) ? mid : string.Empty)"
                                    OnMessageSelected="@((string msgId) => OnCardMessageSelected(card.DateLabel, card.TourName, msgId))"
                                    OnGuideSelected="@((int? gid) => OnCardGuideSelected(card.DateLabel, card.TourName, gid))"
                                    OnAddBookingFromTour="OpenNewTourSheetFromTourAsync" />
                }
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size:2rem;"></i>
            <div class="mt-2">No tours found</div>
        </div>
    }

    @if (showTemplateManagementSheet)
    {
        <div class="action-sheet-backdrop" @onclick="CloseTemplateManagementSheet"></div>
        <div class="action-sheet">
            <div class="action-sheet-header">
                <i class="bi bi-file-earmark-text me-2"></i>Template Management
            </div>
            <div class="list-group">
                <button class="list-group-item list-group-item-action" @onclick="OpenGuideManagement">
                    <i class="bi bi-people me-2"></i> Manage Guides
                </button>
                <button class="list-group-item list-group-item-action" @onclick="OpenMessageManagement">
                    <i class="bi bi-chat-text me-2"></i> Manage Messages
                </button>
                <button class="list-group-item list-group-item-action text-danger" @onclick="CloseTemplateManagementSheet">
                    Cancel
                </button>
            </div>
        </div>
    }

    @if (showEditBookingSheet)
    {
        <div class="action-sheet-backdrop" @onclick="CloseEditBookingSheet"></div>
        <div class="action-sheet action-sheet-large bg-body">
            <div class="action-sheet-header bg-body d-flex justify-content-between align-items-center border-bottom">
                <h5 class="m-0">Edit Booking</h5>
                <button class="btn-close" @onclick="CloseEditBookingSheet"></button>
            </div>
            <div class="action-sheet-content">
                <MobileEditBooking MessageId="@selectedWalkerForEdit?.MessageId" 
                                   OnSaved="HandleBookingEdited"
                                   OnCancel="CloseEditBookingSheet" />
            </div>
        </div>
    }

    @if (showReportIssueSheet)
    {
        <div class="action-sheet-backdrop" @onclick="CloseReportIssueSheet"></div>
        <div class="action-sheet action-sheet-large bg-body">
            <div class="action-sheet-header bg-body d-flex justify-content-between align-items-center border-bottom">
                <h5 class="m-0"><i class="bi bi-exclamation-octagon me-2 text-danger"></i>Report Tour Data Error</h5>
                <button class="btn-close" @onclick="CloseReportIssueSheet"></button>
            </div>
            <div class="action-sheet-content p-3">
                @if (isReportIssueLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (reportIssueOriginalEmail != null && reportIssueEditedEmail != null)
                {
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">Customer Name</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.CustomerName ?? "—")</div>
                            <input type="text" class="form-control form-control-sm" @bind="reportIssueEditedEmail.CustomerName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Customer Email</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.CustomerEmail ?? "—")</div>
                            <input type="email" class="form-control form-control-sm" @bind="reportIssueEditedEmail.CustomerEmail" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Customer Phone</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.CustomerPhone ?? "—")</div>
                            <input type="tel" class="form-control form-control-sm" @bind="reportIssueEditedEmail.CustomerPhone" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Number of Attendees</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.NumberOfAttendees?.ToString() ?? "—")</div>
                            <input type="number" class="form-control form-control-sm" @bind="reportIssueEditedEmail.NumberOfAttendees" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Number of Adults</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.NumberOfAdults?.ToString() ?? "—")</div>
                            <input type="number" class="form-control form-control-sm" @bind="reportIssueEditedEmail.NumberOfAdults" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Number of Children</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.NumberOfChildren?.ToString() ?? "—")</div>
                            <input type="number" class="form-control form-control-sm" @bind="reportIssueEditedEmail.NumberOfChildren" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Email Type</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.EmailType ?? "—")</div>
                            <select class="form-select form-select-sm" @bind="reportIssueEditedEmail.EmailType" @bind:event="onchange">
                                <option value="booking">booking</option>
                                <option value="modification">modification</option>
                                <option value="cancellation">cancellation</option>
                                <option value="other">other</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Tour Name</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.TourName ?? "—")</div>
                            <select class="form-select form-select-sm" value="@reportIssueEditedEmail.TourName" @onchange="OnReportIssueTourNameChanged">
                                @if (availableTourNames.Count == 0)
                                {
                                    <option value="">No tours available</option>
                                }
                                else
                                {
                                    @foreach (var tourName in availableTourNames)
                                    {
                                        <option value="@tourName">@tourName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Tour Date</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.TourDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                            <input type="date" class="form-control form-control-sm" value="@GetReportIssueDateValue(reportIssueEditedEmail.TourDate)" @onchange="OnReportIssueDateChanged" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Tour Time</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.TourTime ?? "—")</div>
                            <select class="form-select form-select-sm" value="@reportIssueEditedEmail.TourTime" @onchange="OnReportIssueTourTimeChanged">
                                @if (reportIssueTimeOptions.Count == 0)
                                {
                                    <option value="">No time options</option>
                                }
                                else
                                {
                                    @foreach (var time in reportIssueTimeOptions)
                                    {
                                        <option value="@time">@time</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Tour Location</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.TourLocation ?? "—")</div>
                            <input type="text" class="form-control form-control-sm" @bind="reportIssueEditedEmail.TourLocation" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Vendor Name</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.VendorName ?? "—")</div>
                            <input type="text" class="form-control form-control-sm" @bind="reportIssueEditedEmail.VendorName" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Language</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.Language ?? "—")</div>
                            <input type="text" class="form-control form-control-sm" @bind="reportIssueEditedEmail.Language" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Booking Code</label>
                            <div class="form-text text-warning small">Original: @(reportIssueOriginalEmail.BookingCode ?? "—")</div>
                            <input type="text" class="form-control form-control-sm" @bind="reportIssueEditedEmail.BookingCode" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Error Notes</label>
                            <textarea class="form-control form-control-sm" rows="4" @bind="reportIssueNotes" placeholder="Describe what was wrong so the developer can fix it"></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseReportIssueSheet">Cancel</button>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="SubmitReportIssue">
                            <i class="bi bi-flag-fill me-1"></i>Submit Report
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    @if (showNewTourSheet)
    {
        <div class="action-sheet-backdrop" @onclick="CloseNewTourSheet"></div>
        <div class="action-sheet action-sheet-large bg-body">
            <div class="action-sheet-header bg-body">
                <i class="bi bi-plus-circle me-2"></i>Add New Tour
                <button class="btn-close ms-auto" @onclick="CloseNewTourSheet"></button>
            </div>
            <div class="action-sheet-content">
                <MobileAddTour OnBookingAdded="HandleBookingAdded" Prefill="mobileAddBookingPrefill" />
            </div>
        </div>
    }

    <!-- Guide Management Dialog -->
    @if (showGuideManagementDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-people me-2"></i>
                            Guide Management
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseGuideManagementDialog"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-4">
                            <div class="col-lg-6 col-md-12">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Guide</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Guide Name:</label>
                                            <input type="text" class="form-control" @bind="newGuideName" placeholder="Enter guide name" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Phone Number:</label>
                                            <input type="tel" class="form-control" @bind="newGuidePhone" placeholder="Enter phone number" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Email:</label>
                                            <input type="email" class="form-control" @bind="newGuideEmail" placeholder="Enter email address" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Where to Meet:</label>
                                            <input type="text" class="form-control" @bind="newGuideMeetingLocation" placeholder="Enter meeting location" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Description/Info:</label>
                                            <div class="mb-2">
                                                <div class="d-flex flex-wrap gap-1 mb-2">
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{name}"))" title="Customer name">
                                                        <i class="bi bi-person me-1"></i>{name}
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{tour}"))" title="Tour name">
                                                        <i class="bi bi-map me-1"></i>{tour}
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{date}"))" title="Tour date">
                                                        <i class="bi bi-calendar me-1"></i>{date}
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{phone}"))" title="Contact phone">
                                                        <i class="bi bi-telephone me-1"></i>{phone}
                                                    </button>
                                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{guide}"))" title="Guide name">
                                                        <i class="bi bi-person-badge me-1"></i>{guide}
                                                    </button>
                                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{guidePhone}"))" title="Guide phone">
                                                        <i class="bi bi-telephone-plus me-1"></i>{guidePhone}
                                                    </button>
                                                   @*  <button type="button" class="btn btn-outline-success btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{guideEmail}"))" title="Guide email">
                                                        <i class="bi bi-envelope me-1"></i>{guideEmail}
                                                    </button> *@
                                                    <button type="button" class="btn btn-outline-info btn-sm" @onclick="@(() => InsertTemplateField("newGuideDescription", "{meetingLocation}"))" title="Meeting location">
                                                        <i class="bi bi-geo-alt me-1"></i>{meetingLocation}
                                                    </button>
                                                </div>
                                            </div>
                                            <textarea class="form-control" rows="3" @bind="newGuideDescription" id="newGuideDescription" placeholder="Enter additional information, description, notes, etc."></textarea>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-success btn-sm" @onclick="AddGuide" disabled="@string.IsNullOrEmpty(newGuideName)">
                                                <i class="bi bi-plus-circle me-1"></i>
                                                Add Guide
                                            </button>
                                            <button class="btn btn-warning btn-sm" @onclick="ClearGuideForm">
                                                <i class="bi bi-eraser me-1"></i>
                                                Clear
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-12">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h6 class="mb-0"><i class="bi bi-list-ul me-2"></i>Current Guides (@inMemoryGuides.Count)</h6>
                                    </div>
                                    <div class="card-body">
                                        @if (inMemoryGuides.Any())
                                        {
                                            <div class="list-group list-group-flush">
                                                @foreach (var guide in inMemoryGuides)
                                                {
                                                    <div class="list-group-item d-flex justify-content-between align-items-start border-0 px-0">
                                                        <div class="flex-grow-1">
                                                            <strong>@guide.Name</strong><br />
                                                            <small class="text-muted">
                                                                @guide.Phone | @guide.Email
                                                                @if (!string.IsNullOrEmpty(guide.MeetingLocation))
                                                                {
                                                                    <br /> @guide.MeetingLocation
                                                                }
                                                            </small>
                                                            @if (!string.IsNullOrEmpty(guide.Description))
                                                            {
                                                                <br /><small class="text-muted">@guide.Description</small>
                                                            }
                                                        </div>
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-outline-danger btn-sm" @onclick="@(() => RemoveGuide(guide))" title="Remove guide">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="mt-3">
                                                <button class="btn btn-outline-danger btn-sm" @onclick="ClearAllGuides">
                                                    <i class="bi bi-trash me-1"></i>
                                                    Clear All Guides
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info mb-0">
                                                <i class="bi bi-info-circle me-2"></i>
                                                No guides added yet. Add your first guide using the form on the left.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseGuideManagementDialog">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }


    <!-- 2025-12-18 00:00 UTC - Message Management Dialog removed, using DB messages -->

</div>

@if (showCopyTextDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard me-2"></i>@copyTextDialogTitle
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseCopyTextDialog"></button>
                </div>
                <div class="modal-body">
                    <textarea class="form-control" rows="15" readonly style="white-space: pre-wrap; font-family: monospace; font-size: 0.9rem;" @ref="copyTextAreaRef">@copyTextDialogContent</textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCopyTextDialog">Close</button>
                    <button type="button" class="btn btn-primary" @onclick="TryAutoCopyFromDialog">
                        <i class="bi bi-clipboard me-1"></i>Copy
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* 2026-01-08 - Bulk SMS to Guide dialog *@
@if (showBulkSmsDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-whatsapp me-2 text-success"></i>
                        Bulk WhatsApp to Guide
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseBulkSmsDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="row gy-3">
                        <div class="col-12 col-md-6">
                            <h6>Tour Information</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Tour:</strong></td>
                                    <td>@(bulkSmsCard?.TourName ?? "Unknown")</td>
                                </tr>
                                <tr>
                                    <td><strong>Walkers:</strong></td>
                                    <td>@(bulkSmsCard?.TotalWalkers ?? 0) walkers</td>
                                </tr>
                            </table>
