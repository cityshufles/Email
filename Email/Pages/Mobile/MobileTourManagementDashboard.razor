    private async Task DownloadVcard(MobileWalkerInfoModel walker)
    {
        // Primary path (server headers): use messageId as stable identifier.
        string? url = null;
        if (!string.IsNullOrWhiteSpace(walker.MessageId))
        {
                url = $"/vcards/walker?messageId={Uri.EscapeDataString(walker.MessageId)}";
        }

        VCardLogService.LogAction("Mobile Button Clicked", $"DownloadVcard button clicked. Walker: {walker.DisplayName ?? "(no name)"}, MessageId: {walker.MessageId ?? "(none)"}", url ?? "(no URL - missing MessageId)");

        try
        {
            if (!string.IsNullOrWhiteSpace(walker.MessageId))
            {
                try
                {
                    VCardLogService.LogAction("Mobile Primary Path Attempt", $"Attempting to open URL via window.open for walker: {walker.DisplayName ?? "(no name)"}", url!);
                    await JSRuntime.InvokeVoidAsync("open", url!, "_blank");
                    VCardLogService.LogAction("Mobile Primary Path Success", $"Successfully opened URL via window.open for walker: {walker.DisplayName ?? "(no name)"}", url!);
                    await ToastService.ShowSuccessAsync("vCard", $"Downloading vCard for {walker.DisplayName}...");
                    return;
                }
                catch (Exception ex)
                {
                    VCardLogService.LogAction("Mobile Primary Path Failed", $"window.open failed, falling back to JS blob download. Walker: {walker.DisplayName ?? "(no name)"}", url!, ex);
                    Console.WriteLine($"[MobileVCard] window.open failed, falling back to JS blob download: {ex.Message}");
                }
            }

            // Fallback: JS blob download using centralized vCard generation.
            VCardLogService.LogAction("Mobile Fallback Started", $"Starting JS blob fallback download for walker: {walker.DisplayName ?? "(no name)"}", url ?? "(no URL)");
            var vcardContent = VCardExportService.GenerateVCard(walker);
            var content = VCardExportService.GenerateVcf(new[] { vcardContent });
            var fileName = $"{(walker.DisplayName ?? "walker").Replace(" ", "_")}.vcf";
            await JSRuntime.InvokeVoidAsync("downloadTextFile", content, fileName, "text/vcard");
            VCardLogService.LogAction("Mobile Fallback Success", $"JS blob download completed successfully. Walker: {walker.DisplayName ?? "(no name)"}, File: {fileName}", url ?? "(no URL)");
            await ToastService.ShowSuccessAsync("vCard Downloaded", $"vCard for {walker.DisplayName} downloaded successfully!");
        }
        catch (Exception ex)
        {
            VCardLogService.LogAction("Mobile Download Exception", $"Exception in DownloadVcard for walker: {walker.DisplayName ?? "(no name)"}", url ?? "(no URL)", ex);
            await ToastService.ShowErrorAsync("Download Failed", $"Failed to download vCard for {walker.DisplayName}");
        }
    }
