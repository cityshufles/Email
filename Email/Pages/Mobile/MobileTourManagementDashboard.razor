    private bool TryRestoreDashboardFromCache()
    {
        if (!MobileDashboardCacheState.TryGetFreshSnapshot(MobileDashboardCacheTtl, out var snapshot) || snapshot == null)
        {
            return false;
        }

        selectedDate = snapshot.SelectedDate ?? DateTime.Today;
        mobileTours = snapshot.MobileTours ?? new List<MobileTourCardModel>();
        selectedGuideIdByTour = snapshot.SelectedGuideIdByTour == null
            ? new Dictionary<string, int?>(StringComparer.OrdinalIgnoreCase)
            : new Dictionary<string, int?>(snapshot.SelectedGuideIdByTour, StringComparer.OrdinalIgnoreCase);
        selectedMessageIdByTour = snapshot.SelectedMessageIdByTour == null
            ? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            : new Dictionary<string, string>(snapshot.SelectedMessageIdByTour, StringComparer.OrdinalIgnoreCase);
        return true;
    }

    private void SaveDashboardSnapshotToCache()
    {
