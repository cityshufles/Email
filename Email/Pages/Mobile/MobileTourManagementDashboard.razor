        return null;
    }

    // Helper to split "Tour Name - 10:00 AM"
    private (string Name, string Time) SplitNameAndTimeLabel(string? label)
    {
        if (string.IsNullOrWhiteSpace(label)) return (string.Empty, string.Empty);
        var parts = label.Split(new[] { " - ", " \u2013 ", " \u2014 ", " \u00E2\u20AC\u201C ", " \u00E2\u20AC\u201D " }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1)
        {
            var timePart = parts.Last().Trim();
            // Simple heuristic to check if last part looks like time
            if (timePart.Any(char.IsDigit) && (timePart.Contains("AM") || timePart.Contains("PM") || timePart.Contains(":")))
            {
                var namePart = string.Join(" - ", parts.Take(parts.Length - 1)).Trim();
                return (namePart, timePart);
            }
        }
        return (label.Trim(), string.Empty);
    }

