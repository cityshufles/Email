    // 2026-01-08 - Email day vCards using SmtpVCardEmailService
    private async Task EmailDayVcards(string dateLabel, List<MobileTourCardModel> toursForDay)
    {
        if (isEmailingDayVcards) return;
        isEmailingDayVcards = true;
        StateHasChanged();

        try
        {
            await ToastService.ShowInfoAsync("Sending...", "Email");

            if (!SmtpVCardEmailService.ValidateSmtpConfig())
            {
                await ToastService.ShowErrorAsync("Email failed", "SMTP is not configured (missing Gmail:Email or Gmail:Password).");
                return;
            }

            // Collect all vCards using the same logic as DownloadDayVcards
            var vcardStrings = new List<string>();
            foreach (var tour in toursForDay)
            {
                foreach (var w in tour.EnumerateAllWalkers())
                {
                    vcardStrings.Add(VCardExportService.GenerateVCard(w));
                }
            }

            if (vcardStrings.Count == 0)
            {
                await ToastService.ShowWarningAsync("No vCards", "No walkers found for this day");
                return;
            }

            // Use same filename convention as download
            var sanitizedDate = dateLabel.Replace(" ", "_").Replace(",", "").Replace("/", "-");
            var fileName = $"walkers_{sanitizedDate}_{DateTime.Now:yyyyMMdd_HHmmss}.vcf";
            var subject = $"vCard Export - {dateLabel}";

            var ok = await SmtpVCardEmailService.SendVCardAsync("jon@cityshuffles.com", vcardStrings, subject, fileName);
            if (!ok)
            {
                var err = SmtpVCardEmailService.GetLastErrorMessage() ?? "Unable to send email";
                await ToastService.ShowErrorAsync("Email failed", err);
                return;
            }

            await ToastService.ShowSuccessAsync("Email sent", $"Sent {vcardStrings.Count} vCards for {dateLabel}");
        }
        catch (Exception ex)
        {
            try { await ToastService.ShowErrorAsync("Email failed", ex.Message); } catch { }
        }
        finally
        {
            isEmailingDayVcards = false;
            StateHasChanged();
        }
    }

