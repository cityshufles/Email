    private string BuildBulkSmsCopyText(MobileTourCardModel card)
    {
        if (card == null) return "";

        var sb = new System.Text.StringBuilder();

        sb.AppendLine($"{card.TourName}");
        if (!string.IsNullOrWhiteSpace(card.DateLabel))
        {
            sb.AppendLine(card.DateLabel);
        }
        sb.AppendLine();

        sb.AppendLine($"{card.TotalWalkers} bookings {card.TotalGuests} guests");
        sb.AppendLine();

        foreach (var vendor in card.Vendors)
        {
            var vendorGuestTotal = vendor.Walkers?.Sum(w => w.Attendees) ?? 0;
            sb.AppendLine($"*{vendor.VendorName} {vendor.TotalWalkers}/{vendorGuestTotal}*");
            sb.AppendLine();

            foreach (var walker in vendor.Walkers)
            {
                sb.AppendLine($"{walker.DisplayName} {walker.Attendees}");
                sb.AppendLine(string.IsNullOrWhiteSpace(walker.Phone) ? "No number" : walker.Phone);
                sb.AppendLine();
            }
        }

        return sb.ToString().TrimEnd();
    }

