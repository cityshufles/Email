                await EnsureCatalogAsync();

                StateHasChanged();
            }
            catch (Exception ex)
            {
                // Log error but don't break the component
                Console.WriteLine($"Error during first render operations: {ex.Message}");
            }
        }

        if (showCopyTextDialog && pendingCopyTextDialogSelect)
        {
            pendingCopyTextDialogSelect = false;
