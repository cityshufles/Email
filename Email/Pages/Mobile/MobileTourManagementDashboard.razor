    private void PreselectGuidesFromDefaults() { /* No-op stub replaced by Async version below */ }

    private async Task PreselectGuidesFromDefaultsAsync()
    {
        if (tourCatalog == null || mobileTours == null) return;
        var jonNotoGuideId = ResolveJonNotoGuideId();

        // Group by DateLabel since mobileTours is a flat list
        var toursByDate = mobileTours.GroupBy(t => t.DateLabel);

        foreach (var dateGroup in toursByDate)
        {
            var dateLabel = dateGroup.Key;
            var dateForDow = ParseDateFromLabel(dateLabel);
            var dowInt = dateForDow.HasValue ? (int)dateForDow.Value.DayOfWeek : (int?)null;

            foreach (var card in dateGroup)
            {
                var tourLabel = card.TourName;
                var key = GetTourKey(dateLabel, tourLabel);

                // If already set (e.g. by manual selection persisting), verify it's valid, otherwise overwrite? 
                // For now, if key exists, we skip to respect user selection if we persist state? 
                // Actually, LoadAsync clears everything usually unless we preserve state. 
                // The dictionary is re-initialized on page load but not on plain LoadAsync.
                // Let's assume we want to re-apply defaults if nothing selected.
                
                if (selectedGuideIdByTour.ContainsKey(key) && selectedGuideIdByTour[key].HasValue)
                {
                   continue;
                }

                var (rawName, rawTime) = SplitNameAndTimeLabel(tourLabel);
                var canonical = TourCatalogService.NormalizeName(rawName);
                var normalizedTime = TourCatalogService.NormalizeTime(rawTime ?? string.Empty); // Using public static method if available or copy local

                // 2026-02-07 - Priority 1: Check AssignedGuideId from TourTree (Manual or Schedule)
                if (card.AssignedGuideId.HasValue)
                {
                    selectedGuideIdByTour[key] = card.AssignedGuideId;
                    continue;
                }
                
                // Priority 2: Check Override (Legacy one-off override system)
                if (dateForDow.HasValue)
                {
                    try
                    {
                        var overrideGuideId = await ToursApiService.GetOverrideGuideForDateAsync(dateForDow.Value, rawName, rawTime);
                        if (overrideGuideId.HasValue)
                        {
                            selectedGuideIdByTour[key] = overrideGuideId;
                            continue;
                        }
                    }
                    catch { }
                }

                // 2. Fallback to catalog defaults
                var entry = FindCatalogEntry(canonical);
                int? guideId = null;

                if (entry?.TourId is int tourId &&
                    tourCatalog.GuideDefaultsByTourId.TryGetValue(tourId, out var defaults) &&
                    defaults.Count > 0)
                {
                    var match = defaults.FirstOrDefault(d =>
                        string.Equals(TourCatalogService.NormalizeTime(d.StartTime ?? ""), normalizedTime, StringComparison.OrdinalIgnoreCase) &&
                        (!dowInt.HasValue || d.DayOfWeek == dowInt.Value));

                    if (match == null && dowInt.HasValue)
                    {
                        match = defaults.FirstOrDefault(d => d.DayOfWeek == dowInt.Value);
                    }

                    guideId = match?.GuideId;
                }

                if (!guideId.HasValue && entry?.DefaultGuideId.HasValue == true)
                {
                    guideId = entry.DefaultGuideId;
                }

                if (!guideId.HasValue && jonNotoGuideId.HasValue)
                {
                    guideId = jonNotoGuideId;
                }

                if (guideId.HasValue)
                {
                    selectedGuideIdByTour[key] = guideId;
                }
            }
        }
    }

    private int? ResolveJonNotoGuideId()
    {
        if (availableDbGuides == null || availableDbGuides.Count == 0)
        {
            return null;
        }

        var match = availableDbGuides.FirstOrDefault(g =>
            string.Equals((g.FirstName ?? string.Empty).Trim(), "Jon", StringComparison.OrdinalIgnoreCase) &&
            string.Equals((g.LastName ?? string.Empty).Trim(), "Noto", StringComparison.OrdinalIgnoreCase) &&
            g.IsActive);

        if (match != null)
        {
            return match.Id;
        }

        match = availableDbGuides.FirstOrDefault(g =>
            string.Equals($"{(g.FirstName ?? string.Empty).Trim()} {(g.LastName ?? string.Empty).Trim()}".Trim(), "Jon Noto", StringComparison.OrdinalIgnoreCase));

        return match?.Id;
    }

    // Helper to parse date from "Monday, October 10" or "2023-10-10"
    private DateTime? ParseDateFromLabel(string? label)
