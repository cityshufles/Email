    private async Task OpenReportIssueSheet(MobileWalkerInfoModel walker)
    {
        if (walker == null || string.IsNullOrWhiteSpace(walker.MessageId))
        {
            return;
        }

        selectedWalkerForReport = walker;
        showReportIssueSheet = true;
        isReportIssueLoading = true;
        reportIssueOriginalEmail = null;
        reportIssueEditedEmail = null;
        reportIssueTimeOptions = new List<string>();
        reportIssueNotes = string.Empty;
        StateHasChanged();

        try
        {
            var catalogTask = EnsureCatalogAsync();
            var processedEmailTask = TourTreeService.GetProcessedEmailByMessageIdAsync(walker.MessageId);
            await Task.WhenAll(catalogTask, processedEmailTask);

            var response = await processedEmailTask;
            if (response == null)
            {
                CloseReportIssueSheet();
                return;
            }

            reportIssueOriginalEmail = response;
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(reportIssueOriginalEmail);
                reportIssueEditedEmail = System.Text.Json.JsonSerializer.Deserialize<ProcessedEmail>(json) ?? new ProcessedEmail();
            }
            catch
            {
                reportIssueEditedEmail = new ProcessedEmail
                {
                    Id = reportIssueOriginalEmail.Id,
                    InboxEmailId = reportIssueOriginalEmail.InboxEmailId,
                    MessageId = reportIssueOriginalEmail.MessageId,
                    VendorName = reportIssueOriginalEmail.VendorName,
                    EmailType = reportIssueOriginalEmail.EmailType,
                    CustomerName = reportIssueOriginalEmail.CustomerName,
                    CustomerEmail = reportIssueOriginalEmail.CustomerEmail,
                    CustomerPhone = reportIssueOriginalEmail.CustomerPhone,
                    NumberOfAttendees = reportIssueOriginalEmail.NumberOfAttendees,
                    NumberOfAdults = reportIssueOriginalEmail.NumberOfAdults,
                    NumberOfChildren = reportIssueOriginalEmail.NumberOfChildren,
                    TourName = TourCatalogService.NormalizeName(reportIssueOriginalEmail.TourName ?? string.Empty),
                    TourDate = reportIssueOriginalEmail.TourDate,
                    TourTime = NormalizeTimeSafe(reportIssueOriginalEmail.TourTime),
                    TourLocation = reportIssueOriginalEmail.TourLocation,
                    Language = reportIssueOriginalEmail.Language,
                    BookingCode = reportIssueOriginalEmail.BookingCode
                };
            }

            reportIssueTimeOptions = GetReportIssueTimeOptionsFor(reportIssueEditedEmail?.TourName);
            if (reportIssueEditedEmail != null && string.IsNullOrWhiteSpace(reportIssueEditedEmail.TourTime) && reportIssueTimeOptions.Count > 0)
            {
                reportIssueEditedEmail.TourTime = reportIssueTimeOptions.First();
            }
        }
        catch
        {
            CloseReportIssueSheet();
            return;
        }
        finally
        {
            isReportIssueLoading = false;
            StateHasChanged();
        }
    }

