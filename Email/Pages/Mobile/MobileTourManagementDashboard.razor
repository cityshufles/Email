            }
            catch
            {
                // Best effort for mobile text selection.
            }
        }
    }

    private async Task LoadAsync(bool forceFresh = false)
    {
        try
        {
            if (!forceFresh && TryRestoreDashboardFromCache())
            {
                StateHasChanged();
                return;
            }

            isLoading = true;
            StateHasChanged();

            // 2025-12-18 - Ensure catalog is available so we can apply meeting place/time fallbacks for templates (parity with desktop)
            await EnsureCatalogAsync();
            await LoadVendorLinkContextAsync();

            var start = (selectedDate ?? DateTime.Today).Date;
            var end = start.AddDays(2);
            var tree = await TourTreeService.GetTourTreeDataShapedAsync(TreeDataFilterType.ActiveBookings, start, end, null);
            mobileTours = TransformToMobile(tree);
            await ApplyNeedsNumberLabelsAsync();

            // 2025-12-18 - Apply catalog fallback chain for meeting place/time/start time so mobile template tokens match desktop behavior
            if (tourCatalog != null && mobileTours != null && mobileTours.Count > 0)
            {
                foreach (var card in mobileTours)
                {
                    var (rawName, _) = SplitNameAndTimeLabel(card.TourName);
                    var canonical = TourCatalogService.NormalizeName(rawName);
                    var entry = FindCatalogEntry(canonical);
                    if (entry == null) continue;

                    var catalogMeetingPlace = entry.MeetingPlace ?? string.Empty;
                    var catalogMeetingTime = entry.MeetingTime ?? entry.Times.FirstOrDefault() ?? string.Empty;

                    if (card?.Vendors == null) continue;
                    foreach (var vendor in card.Vendors)
                    {
                        if (vendor?.Walkers == null) continue;
                        foreach (var walker in vendor.Walkers)
                        {
                            if (walker == null) continue;

                            if (string.IsNullOrWhiteSpace(walker.MeetingPlace) && !string.IsNullOrWhiteSpace(catalogMeetingPlace))
                            {
                                walker.MeetingPlace = catalogMeetingPlace;
                            }

                            // If tour start is empty, use catalog meeting/time as a last resort (desktop uses catalog tiers when missing)
                            if (string.IsNullOrWhiteSpace(walker.TourStartTime) &&
                                string.IsNullOrWhiteSpace(walker.DisplayTime) &&
                                !string.IsNullOrWhiteSpace(catalogMeetingTime))
                            {
                                walker.TourStartTime = catalogMeetingTime;
                            }

                            var effectiveTourStartTime = !string.IsNullOrWhiteSpace(walker.TourStartTime)
                                ? walker.TourStartTime
                                : (walker.DisplayTime ?? string.Empty);

                            // If meeting time is missing or equals tour start, prefer catalog (desktop behavior), then service will apply -10m shift if still needed
                            if (!string.IsNullOrWhiteSpace(catalogMeetingTime) &&
                                (string.IsNullOrWhiteSpace(walker.MeetingTime) ||
                                 (!string.IsNullOrWhiteSpace(effectiveTourStartTime) &&
                                  string.Equals(walker.MeetingTime, effectiveTourStartTime, StringComparison.OrdinalIgnoreCase))))
                            {
                                walker.MeetingTime = catalogMeetingTime;
                            }
                        }
                    }
                }
            }

            // Resolve default guides
            await PreselectGuidesFromDefaultsAsync();
            PreselectMessagesFromDefaults();
            SaveDashboardSnapshotToCache();
        }
        catch (Exception)
        {
            try { await ToastService.ShowErrorAsync("Error", "Failed to load tours"); } catch { }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static List<MobileTourCardModel> TransformToMobile(Email.TourTreeViewShapedData.Models.ShapedTreeData? tree)
    {
        var result = new List<MobileTourCardModel>();
        if (tree?.TreeNodes == null) return result;

        foreach (var dateNode in tree.TreeNodes)
        {
            if (dateNode?.Children == null) continue;
            foreach (var tourNode in dateNode.Children)
            {
                var card = new MobileTourCardModel
                {
                    DateLabel = dateNode.Label,
                    TourName = tourNode.Label,
                    TourNameDisplay = string.IsNullOrWhiteSpace(tourNode.MobileLabel) ? tourNode.Label : tourNode.MobileLabel,
                    AssignedGuideId = tourNode.AssignedGuideId
                };

                if (tourNode.Children != null)
                {
                    foreach (var vendorNode in tourNode.Children)
                    {
                        var vendor = new MobileVendorGroupModel { VendorName = vendorNode.Label };
                        if (vendorNode.Children != null)
                        {
                            foreach (var walkerNode in vendorNode.Children)
                            {
                                var (name, phone, attendees, attendeeDisplay) = ParseWalkerLabel(walkerNode.Label);
                                var walkerData = walkerNode.WalkerData;
                                var walkerVendorName = !string.IsNullOrWhiteSpace(walkerData?.VendorName)
                                    ? walkerData!.VendorName
                                    : vendorNode.Label;
                                var displayPhone = !string.IsNullOrWhiteSpace(walkerData?.DisplayPhone) ? walkerData.DisplayPhone : phone;
                                vendor.Walkers.Add(new MobileWalkerInfoModel
                                {
                                    DisplayName = name,
                                    Phone = displayPhone,
                                    Attendees = attendees,
                                    AttendeeDisplay = attendeeDisplay,
                                    VendorName = walkerVendorName,
                                    TourName = tourNode.Label,
                                    DateLabel = dateNode.Label,
                                    CustomerId = walkerData?.CustomerId ?? 0,
                                    CustomerIdentifier = walkerData?.CustomerIdentifier ?? string.Empty,
                                    MessageId = walkerData?.MessageId ?? string.Empty,
                                    BookingCode = walkerData?.BookingCode ?? string.Empty,
                                    MessageSent = walkerData?.MessageSent ?? false,
                                    MessageSentAtUtc = walkerData?.MessageSentAtUtc,
                                    SmsContactState = walkerData?.SmsContactState ?? 0,
                                    WaContactState = walkerData?.WaContactState ?? 0,
                                    PlatformContactState = walkerData?.PlatformContactState ?? 0,
                                    HasSubmittedGuideReport = walkerData?.HasSubmittedGuideReport ?? false,
                                    HasUnsubmittedGuideReport = walkerData?.HasUnsubmittedGuideReport ?? false,
                                    HasGuideGalleryInDb = walkerData?.HasGuideGalleryInDb ?? false,
                                    GuideReportPublicId = walkerData?.GuideReportPublicId ?? string.Empty,
                                    IsCheckedIn = walkerData?.IsCheckedIn ?? false,
                                    BookingDate = walkerData?.BookingDate,
                                    // 2025-12-18 - Pre-computed date/time fields from ShapedWalkerData
                                    TourDayOfWeek = walkerData?.TourDayOfWeek,
                                    TourMonthAndDayOrdinal = walkerData?.TourMonthAndDayOrdinal,
                                    MonthOfTour = walkerData?.MonthOfTour,
                                    DisplayDayOrdinal = walkerData?.DisplayDayOrdinal,
                                    DisplayDate = walkerData?.DisplayDate,
                                    DisplayTime = walkerData?.DisplayTime,
                                    TourStartTime = walkerData?.TourStartTime,
                                    MeetingTime = walkerData?.MeetingTime,
                                    MeetingPlace = walkerData?.MeetingPlace,
                                    MeetingInstructions = walkerData?.MeetingInstructions,
                                    TourLocation = walkerData?.TourLocation
                                });
                            }
                        }
                        card.Vendors.Add(vendor);
                    }
                }

                result.Add(card);
            }
        }

        return result;
    }

    private async Task ApplyNeedsNumberLabelsAsync()
    {
        if (mobileTours == null || mobileTours.Count == 0)
        {
            return;
        }

        var customerIds = mobileTours
            .SelectMany(t => t.Vendors)
            .SelectMany(v => v.Walkers)
            .Select(w => w.CustomerId)
            .Where(id => id > 0)
            .Distinct()
            .ToList();

        if (customerIds.Count == 0)
        {
            return;
        }

        var labelsByCustomer = await BookingsInboxService.GetCustomerLabelsAsync(customerIds);
        foreach (var walker in mobileTours.SelectMany(t => t.Vendors).SelectMany(v => v.Walkers))
        {
            if (walker.CustomerId > 0 &&
                labelsByCustomer.TryGetValue(walker.CustomerId, out var labels))
            {
                walker.NeedsNumber = labels.NeedsNumber;
            }
        }
    }

    private static (string Name, string Phone, int Attendees, string AttendeeDisplay) ParseWalkerLabel(string walkerLabel)
    {
        try
        {
            var remaining = walkerLabel ?? string.Empty;
            string phone = string.Empty;

            var phoneMatch = System.Text.RegularExpressions.Regex.Match(remaining, @"\+?\d[\d\s\-()]{6,}");
            if (phoneMatch.Success)
            {
                phone = phoneMatch.Value.Trim();
                remaining = remaining.Remove(phoneMatch.Index, phoneMatch.Length).Trim();
            }

            int attendees = 0;
            string attendeeDisplay = string.Empty;
            var plusMatch = System.Text.RegularExpressions.Regex.Match(remaining, @"\+(\d+)");
            if (plusMatch.Success && int.TryParse(plusMatch.Groups[1].Value, out var plus))
            {
                attendees = Math.Max(0, plus) + 1;
                attendeeDisplay = attendees.ToString();
                remaining = remaining.Remove(plusMatch.Index, plusMatch.Length).Trim();
            }
            else
            {
                var decMatch = System.Text.RegularExpressions.Regex.Match(remaining, @"(?<!\d)(\d{1,2})\.(\d{1,2})(?!\d)");
                if (decMatch.Success)
                {
                    var adults = int.Parse(decMatch.Groups[1].Value);
                    var children = int.Parse(decMatch.Groups[2].Value);
                    attendees = Math.Max(0, adults) + Math.Max(0, children);
                    attendeeDisplay = decMatch.Value;
                    remaining = remaining.Remove(decMatch.Index, decMatch.Length).Trim();
                }
                else
                {
                    var attendeesMatch = System.Text.RegularExpressions.Regex.Match(remaining, @"(?<!\d)([1-9]|10)(?!\d)");
                    if (attendeesMatch.Success && int.TryParse(attendeesMatch.Groups[1].Value, out var att))
                    {
                        attendees = att;
                        attendeeDisplay = att.ToString();
                        remaining = remaining.Remove(attendeesMatch.Index, attendeesMatch.Length).Trim();
                    }
                }
            }

            if (string.IsNullOrEmpty(attendeeDisplay) && attendees > 0)
            {
                attendeeDisplay = attendees.ToString();
            }

            var name = remaining.Trim();
            return (name, phone, attendees, attendeeDisplay);
        }
        catch
        {
            return (walkerLabel ?? string.Empty, string.Empty, 0, string.Empty);
        }
    }

